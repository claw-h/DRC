---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ConstellationStage from '../components/sky/ConstellationStage.astro';
import PersistentHeader from '../components/chrome/PersistentHeader.astro';
import AcademicWorkspace from '../components/workspace/AcademicWorkspace.astro';
import { getFacultyProfile, getSystemState } from '../lib/system-state';

const publications = (await getCollection('publications')).sort(
  (a, b) => b.data.year - a.data.year
);
const books = (await getCollection('books')).sort(
  (a, b) => b.data.year - a.data.year
);
const classes = await getCollection('classes');

const profile = await getFacultyProfile();
const systemState = await getSystemState();
---

<BaseLayout
  title={`${profile.name} — Continental Philosophy & Philosophy of Technology`}
  description={`Academic portfolio, philosophical archive, publications, monographs, and university seminars of ${profile.name} (${profile.monogram}), ${profile.title} at ${profile.institution}.`}
  isPortfolioRoot={true}
>
  <PersistentHeader
    profile={profile}
    pubCount={publications.length}
    bookCount={books.length}
    classCount={classes.length}
  />

  <!-- Stage 1: Full-Viewport Generative Constellation Sky -->
  <ConstellationStage featuredConstellationId={systemState.featuredConstellationId} />

  <!-- Stage 2: Scroll-Snap Transition Pull-Up Instrument Panel (inspired by portyxb InstrumentPanel.ts) -->
  <section
    id="stage-2"
    class="snap-stage stage-pullup"
    aria-label="Observatory Transition Horizon"
  >
    <div class="pullup-card">
      <div class="chassis-bolt chassis-bolt--tl"></div>
      <div class="chassis-bolt chassis-bolt--tr"></div>
      <div class="chassis-bolt chassis-bolt--bl"></div>
      <div class="chassis-bolt chassis-bolt--br"></div>

      <div class="pullup-header-strip">
        <span class="pullup-eyebrow">{profile.institution} · {profile.department}</span>
        <span class="pullup-model-badge tabular">ORGANOLOGY // TECHNICS &amp; TIME</span>
      </div>

      <h2 class="pullup-headline">{profile.name}</h2>
      <p class="pullup-subheadline">
        {profile.title} · {profile.education || 'Ph.D. in Philosophy, Purdue University'}
      </p>

      <p class="pullup-bio">
        {profile.bio ||
          'Duncan Cordry specializes in continental philosophy and the philosophy of technology, and his primary area of research lies in understanding how technical objects and systems support specific spiritual practices, traditions, and types of social cohesion. He has abiding interests in the relation between the organic and inorganic, philosophies of time, and how such topics play a role in practices of liberation.'}
      </p>

      {profile.aos && profile.aos.length > 0 && (
        <div class="pullup-specialization-tags">
          {profile.aos.map((area) => (
            <span class="spec-chip">{area}</span>
          ))}
          {(profile.aoc || []).map((area) => (
            <span class="spec-chip spec-chip--aoc">{area}</span>
          ))}
        </div>
      )}

      <!-- Galvanic Telemetry Readout Strip (portyxb homage) -->
      <div class="pullup-telemetry-row tabular">
        <div class="pullup-cell">
          <span class="cell-label">MONOGRAPHS</span>
          <span class="cell-val">{String(books.length).padStart(2, '0')} VOLS</span>
        </div>
        <div class="pullup-cell">
          <span class="cell-label">PAPERS &amp; ESSAYS</span>
          <span class="cell-val">{String(publications.length).padStart(2, '0')} ARCHIVED</span>
        </div>
        <div class="pullup-cell">
          <span class="cell-label">SEMINARS</span>
          <span class="cell-val">{String(classes.length).padStart(2, '0')} ASHOKA</span>
        </div>
        <div class="pullup-cell">
          <span class="cell-label">FELLOWSHIP</span>
          <span class="cell-val">CLAUDIA JONES</span>
        </div>
      </div>

      <div class="pullup-coords">
        {profile.ashokaProfileUrl && (
          <>
            <a href={profile.ashokaProfileUrl} target="_blank" rel="noopener noreferrer" class="pullup-cv-link">
              Ashoka Faculty Profile ↗
            </a>
            <span aria-hidden="true">·</span>
          </>
        )}
        {profile.philPeopleUrl && (
          <>
            <a href={profile.philPeopleUrl} target="_blank" rel="noopener noreferrer" class="pullup-cv-link">
              PhilPeople Archive ↗
            </a>
            <span aria-hidden="true">·</span>
          </>
        )}
        <a href="/cv" class="pullup-cv-link">Curriculum Vitae (Print / LaTeX) ↗</a>
        <span aria-hidden="true">·</span>
        <a href="#stage-3" class="pullup-cv-link">Enter Bipartite Archive ↓</a>
      </div>
    </div>
  </section>

  <!-- Stage 3: Docked Bipartite Academic Workspace -->
  <section id="stage-3" class="snap-stage" aria-label="Academic Workspace">
    <AcademicWorkspace
      publications={publications}
      books={books}
      classes={classes}
    />
  </section>

  <script>
    let currentStageNum: 1 | 2 | 3 = 1;
    let isStageLocked = false;
    let stageWheelAccum = 0;
    let stageWheelResetTimer: number | null = null;
    let stageLockTimer: number | null = null;

    const snapToStage = (stageNum: 1 | 2 | 3) => {
      const targetId = `stage-${stageNum}`;
      const targetEl = document.getElementById(targetId);
      currentStageNum = stageNum;
      stageWheelAccum = 0;
      isStageLocked = true;

      document.body.dataset.stage = targetId;

      if (targetEl) {
        window.scrollTo({ top: targetEl.offsetTop, behavior: 'instant' as ScrollBehavior });
      }

      window.dispatchEvent(new CustomEvent('drc:stage-snap', { detail: { stage: stageNum } }));

      if (stageLockTimer) window.clearTimeout(stageLockTimer);
      stageLockTimer = window.setTimeout(() => {
        isStageLocked = false;
        stageWheelAccum = 0;
      }, 360);
    };

    (window as any).__drcSnapToStage = snapToStage;

    const syncStageFromScroll = () => {
      if (isStageLocked) return;
      const y = window.scrollY;
      const vh = window.innerHeight || 1;
      if (y < vh * 0.45) {
        currentStageNum = 1;
        document.body.dataset.stage = 'stage-1';
      } else if (y < vh * 1.55) {
        currentStageNum = 2;
        document.body.dataset.stage = 'stage-2';
      } else {
        currentStageNum = 3;
        document.body.dataset.stage = 'stage-3';
      }
    };

    syncStageFromScroll();
    window.addEventListener('scroll', syncStageFromScroll, { passive: true });
    window.addEventListener('resize', () => {
      const activeEl = document.getElementById(`stage-${currentStageNum}`);
      if (activeEl) {
        window.scrollTo({ top: activeEl.offsetTop, behavior: 'instant' as ScrollBehavior });
      }
    }, { passive: true });

    // Intercept wheel on Stage 1 (Constellations) & Stage 2 (Info Card) so sections snap in/out cleanly
    // Works continuously even when the mouse cursor is completely idle/stationary
    window.addEventListener(
      'wheel',
      (e: WheelEvent) => {
        // Ignore if modal dialog is open
        if (document.querySelector('dialog[open]')) return;

        // Stage 3 handles its own internal reader scroll & snaps back to Stage 2 via __drcSnapToStage(2)
        if (currentStageNum === 3) return;

        e.preventDefault();

        if (isStageLocked) {
          return;
        }

        stageWheelAccum += e.deltaY;
        if (stageWheelResetTimer) window.clearTimeout(stageWheelResetTimer);
        stageWheelResetTimer = window.setTimeout(() => {
          stageWheelAccum = 0;
        }, 260);

        const SNAP_THRESHOLD = 44;
        if (currentStageNum === 1 && stageWheelAccum >= SNAP_THRESHOLD) {
          snapToStage(2);
        } else if (currentStageNum === 2 && stageWheelAccum >= SNAP_THRESHOLD) {
          snapToStage(3);
        } else if (currentStageNum === 2 && stageWheelAccum <= -SNAP_THRESHOLD) {
          snapToStage(1);
        }
      },
      { passive: false }
    );

    // Intercept anchor clicks to #stage-1 and #stage-3 so they snap cleanly too
    document.querySelectorAll<HTMLAnchorElement>('a[href="#stage-1"], a[href="#stage-2"], a[href="#stage-3"]').forEach((link) => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (href === '#stage-1') {
          e.preventDefault();
          snapToStage(1);
        } else if (href === '#stage-2') {
          e.preventDefault();
          snapToStage(2);
        } else if (href === '#stage-3') {
          e.preventDefault();
          snapToStage(3);
        }
      });
    });

    // Touch swipe snapping on Stage 1 & Stage 2 for mobile/tablet
    let touchStartY = 0;
    window.addEventListener('touchstart', (e: TouchEvent) => {
      if (currentStageNum === 3) return;
      touchStartY = e.touches[0]?.clientY ?? 0;
    }, { passive: true });

    window.addEventListener('touchend', (e: TouchEvent) => {
      if (currentStageNum === 3 || isStageLocked) return;
      const endY = e.changedTouches[0]?.clientY ?? touchStartY;
      const dy = touchStartY - endY;
      if (Math.abs(dy) < 44) return;
      if (currentStageNum === 1 && dy > 0) snapToStage(2);
      else if (currentStageNum === 2 && dy > 0) snapToStage(3);
      else if (currentStageNum === 2 && dy < 0) snapToStage(1);
    }, { passive: true });
  </script>
</BaseLayout>

<style>
  .stage-pullup {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    z-index: 5;
  }

  .pullup-card {
    position: relative;
    max-width: 720px;
    padding: 2.25rem 2.5rem;
    border-radius: 0.65rem;
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklab, var(--bg-surface) 88%, transparent);
    backdrop-filter: blur(18px);
    box-shadow:
      0 35px 80px -20px rgba(0, 0, 0, 0.85),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    opacity: 0;
    transform: translate3d(0, 14px, 0) scale(0.985);
    transition:
      opacity 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(body[data-stage="stage-2"]) .pullup-card {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }

  #stage-3 {
    opacity: 0;
    transform: scale(0.992);
    transition:
      opacity 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(body[data-stage="stage-3"]) #stage-3 {
    opacity: 1;
    transform: scale(1);
  }

  .pullup-header-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .pullup-eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--accent);
  }

  .pullup-model-badge {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: #7fd4ff;
    padding: 0.15rem 0.5rem;
    border-radius: 2px;
    border: 1px solid rgba(127, 212, 255, 0.22);
    background: rgba(0, 0, 0, 0.35);
  }

  .pullup-headline {
    margin: 0.15rem 0 0;
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3.2vw, 2.45rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    color: var(--text-primary);
  }

  .pullup-subheadline {
    margin: -0.35rem 0 0.2rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.06rem;
    color: var(--accent);
  }

  .pullup-bio {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.02rem;
    line-height: 1.68;
    color: var(--text-secondary);
  }

  .pullup-specialization-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.1rem;
  }

  .spec-chip {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    padding: 0.22rem 0.55rem;
    border-radius: 3px;
    border: 1px solid rgba(232, 222, 181, 0.32);
    background: rgba(232, 222, 181, 0.08);
    color: var(--accent);
  }

  .spec-chip--aoc {
    border-color: var(--border-subtle);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-muted);
  }

  .pullup-telemetry-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.6rem;
    margin-top: 0.25rem;
    padding: 0.75rem;
    border-radius: 4px;
    background: #030706;
    border: 1px solid rgba(94, 255, 164, 0.16);
    box-shadow: inset 0 4px 10px rgba(0, 0, 0, 0.9);
  }

  .pullup-cell {
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
  }

  .cell-label {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.42);
  }

  .cell-val {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    color: #5effa4;
    text-shadow:
      -1px 0 1px rgba(255, 0, 0, 0.45),
      1px 0 1px rgba(0, 60, 255, 0.45),
      0 0 6px rgba(94, 255, 164, 0.45);
  }

  .pullup-coords {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .pullup-cv-link {
    color: var(--text-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--border-subtle);
  }

  .pullup-cv-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  @media (max-width: 600px) {
    .pullup-telemetry-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
