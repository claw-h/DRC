---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ConstellationStage from '../components/sky/ConstellationStage.astro';
import PersistentHeader from '../components/chrome/PersistentHeader.astro';
import AcademicWorkspace from '../components/workspace/AcademicWorkspace.astro';
import { loadObservatoryWorkspaceData } from '../lib/turso';

// Edge CDN Caching: Vercel Edge serves cached HTML in ~15ms and revalidates in the background
Astro.response.headers.set('Cache-Control', 'public, s-maxage=30, stale-while-revalidate=86400');

const { publications, books, classes, profile, systemState } = await loadObservatoryWorkspaceData();
---

<BaseLayout
  title={`${profile.name} — Continental Philosophy & Philosophy of Technology`}
  description={`Academic portfolio, philosophical archive, publications, monographs, and university seminars of ${profile.name} (${profile.monogram}), ${profile.title} at ${profile.institution}.`}
  isPortfolioRoot={true}
>
  <PersistentHeader
    profile={profile}
    pubCount={publications.length}
    bookCount={books.length}
    classCount={classes.length}
  />

  <!-- Stage 1: Full-Viewport Generative Constellation Sky -->
  <ConstellationStage featuredConstellationId={systemState.featuredConstellationId} />

  <!-- Stage 2: Scroll-Snap Transition Pull-Up Instrument Panel (inspired by portyxb InstrumentPanel.ts) -->
  <section
    id="stage-2"
    class="snap-stage stage-pullup"
    aria-label="Observatory Transition Horizon"
  >
    <div class="pullup-card bookplate-frame">
      <div class="bookplate-corner bookplate-corner--tl" aria-hidden="true">❦</div>
      <div class="bookplate-corner bookplate-corner--tr" aria-hidden="true">❦</div>
      <div class="bookplate-corner bookplate-corner--bl" aria-hidden="true">❦</div>
      <div class="bookplate-corner bookplate-corner--br" aria-hidden="true">❦</div>

      <div class="pullup-header-strip">
        <span class="pullup-eyebrow">{profile.institution} · {profile.department}</span>
        <span class="pullup-rubric-badge scholarly-caps">RUBRIC · PHILOSOPHY OF TECHNICS, ORGANOLOGY &amp; TIME</span>
      </div>

      <h2 class="pullup-headline">{profile.name}</h2>
      <p class="pullup-subheadline">
        {profile.title} · {profile.education || 'Ph.D. in Philosophy, Purdue University'}
      </p>

      <p class="pullup-bio">
        {profile.bio ||
          'Duncan Cordry specializes in continental philosophy and the philosophy of technology, and his primary area of research lies in understanding how technical objects and systems support specific spiritual practices, traditions, and types of social cohesion. He has abiding interests in the relation between the organic and inorganic, philosophies of time, and how such topics play a role in practices of liberation.'}
      </p>

      {profile.aos && profile.aos.length > 0 && (
        <div class="pullup-specialization-tags">
          {profile.aos.map((area) => (
            <span class="spec-chip">{area}</span>
          ))}
          {(profile.aoc || []).map((area) => (
            <span class="spec-chip spec-chip--aoc">{area}</span>
          ))}
        </div>
      )}

      <!-- Scholarly Colophon Grid -->
      <div class="pullup-colophon-grid tabular">
        <div class="colophon-cell">
          <span class="colophon-label">MONOGRAPHS</span>
          <span class="colophon-val">{String(books.length).padStart(2, '0')} VOLS</span>
        </div>
        <div class="colophon-cell">
          <span class="colophon-label">PAPERS &amp; ESSAYS</span>
          <span class="colophon-val">{String(publications.length).padStart(2, '0')} ARCHIVED</span>
        </div>
        <div class="colophon-cell">
          <span class="colophon-label">SEMINARS</span>
          <span class="colophon-val">{String(classes.length).padStart(2, '0')} ASHOKA</span>
        </div>
        <div class="colophon-cell">
          <span class="colophon-label">FELLOWSHIP</span>
          <span class="colophon-val">CLAUDIA JONES</span>
        </div>
      </div>

      <div class="pullup-coords">
        {profile.ashokaProfileUrl && (
          <>
            <a href={profile.ashokaProfileUrl} target="_blank" rel="noopener noreferrer" class="pullup-cv-link">
              Ashoka Faculty Profile ↗
            </a>
            <span aria-hidden="true">·</span>
          </>
        )}
        {profile.philPeopleUrl && (
          <>
            <a href={profile.philPeopleUrl} target="_blank" rel="noopener noreferrer" class="pullup-cv-link">
              PhilPeople Archive ↗
            </a>
            <span aria-hidden="true">·</span>
          </>
        )}
        <a href="/cv" class="pullup-cv-link">Curriculum Vitae (Print / LaTeX) ↗</a>
        <span aria-hidden="true">·</span>
        <a href="#stage-3" class="pullup-cv-link">Examine Scholarly Folios ↓</a>
      </div>
    </div>
  </section>

  <!-- Stage 3: Docked Bipartite Academic Workspace -->
  <section id="stage-3" class="snap-stage" aria-label="Academic Workspace">
    <AcademicWorkspace
      publications={publications}
      books={books}
      classes={classes}
    />
  </section>

  <script>
    let currentStageNum: 1 | 2 | 3 = 1;
    let isStageLocked = false;
    let stageWheelAccum = 0;
    let stageWheelResetTimer: number | null = null;
    let stageLockTimer: number | null = null;

    const snapToStage = (stageNum: 1 | 2 | 3) => {
      const targetId = `stage-${stageNum}`;
      const targetEl = document.getElementById(targetId);
      currentStageNum = stageNum;
      stageWheelAccum = 0;
      document.body.dataset.mobileView = stageNum === 1 ? 'sky' : stageNum === 2 ? 'identity' : 'workspace';

      if (window.matchMedia('(max-width: 767px)').matches) {
        const mobileView = document.body.dataset.mobileView;
        document.body.dataset.stage = targetId;
        isStageLocked = false;
        window.dispatchEvent(new CustomEvent('drc:stage-snap', { detail: { stage: stageNum, mobileView } }));
        return;
      }

      isStageLocked = true;
      document.body.dataset.stage = targetId;

      if (targetEl) {
        window.scrollTo({ top: targetEl.offsetTop, behavior: 'smooth' as ScrollBehavior });
      }

      window.dispatchEvent(new CustomEvent('drc:stage-snap', { detail: { stage: stageNum } }));

      if (stageLockTimer) window.clearTimeout(stageLockTimer);
      stageLockTimer = window.setTimeout(() => {
        isStageLocked = false;
        stageWheelAccum = 0;
      }, 680);
    };

    (window as any).__drcSnapToStage = snapToStage;

    const syncStageFromScroll = () => {
      if (window.matchMedia('(max-width: 767px)').matches) return;
      if (isStageLocked) return;
      const y = window.scrollY;
      const vh = window.innerHeight || 1;
      if (y < vh * 0.45) {
        currentStageNum = 1;
        document.body.dataset.stage = 'stage-1';
        document.body.dataset.mobileView = 'sky';
      } else if (y < vh * 1.55) {
        currentStageNum = 2;
        document.body.dataset.stage = 'stage-2';
        document.body.dataset.mobileView = 'identity';
      } else {
        currentStageNum = 3;
        document.body.dataset.stage = 'stage-3';
        document.body.dataset.mobileView = 'workspace';
      }
    };

    syncStageFromScroll();
    window.addEventListener('scroll', syncStageFromScroll, { passive: true });
    window.addEventListener('resize', () => {
      if (window.matchMedia('(max-width: 767px)').matches) return;
      const activeEl = document.getElementById(`stage-${currentStageNum}`);
      if (activeEl) {
        window.scrollTo({ top: activeEl.offsetTop, behavior: 'instant' as ScrollBehavior });
      }
    }, { passive: true });

    // Intercept wheel on Stage 1 (Constellations) & Stage 2 (Info Card) so sections snap in/out cleanly
    // Works continuously even when the mouse cursor is completely idle/stationary
    window.addEventListener(
      'wheel',
      (e: WheelEvent) => {
        // Phone and tablet scroll remains native so the profile plate can be read in one continuous flow.
        if (window.matchMedia('(max-width: 767px)').matches) return;
        // Ignore if modal dialog is open
        if (document.querySelector('dialog[open]')) return;

        // Stage 3 handles its own internal reader scroll & snaps back to Stage 2 via __drcSnapToStage(2)
        if (currentStageNum === 3) return;

        e.preventDefault();

        if (isStageLocked) {
          return;
        }

        stageWheelAccum += e.deltaY;
        if (stageWheelResetTimer) window.clearTimeout(stageWheelResetTimer);
        stageWheelResetTimer = window.setTimeout(() => {
          stageWheelAccum = 0;
        }, 260);

        const SNAP_THRESHOLD = 44;
        if (currentStageNum === 1 && stageWheelAccum >= SNAP_THRESHOLD) {
          snapToStage(2);
        } else if (currentStageNum === 2 && stageWheelAccum >= SNAP_THRESHOLD) {
          snapToStage(3);
        } else if (currentStageNum === 2 && stageWheelAccum <= -SNAP_THRESHOLD) {
          snapToStage(1);
        }
      },
      { passive: false }
    );

    // Intercept anchor clicks to #stage-1 and #stage-3 so they snap cleanly too
    document.querySelectorAll<HTMLAnchorElement>('a[href="#stage-1"], a[href="#stage-2"], a[href="#stage-3"]').forEach((link) => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (href === '#stage-1') {
          e.preventDefault();
          snapToStage(1);
        } else if (href === '#stage-2') {
          e.preventDefault();
          snapToStage(2);
        } else if (href === '#stage-3') {
          e.preventDefault();
          snapToStage(3);
        }
      });
    });

    // Touch remains native on mobile; views switch through the mobile tab bar and star breadcrumb.
    let touchStartY = 0;
    let touchStartedOnSky = false;
    window.addEventListener('touchstart', (e: TouchEvent) => {
      if (window.matchMedia('(max-width: 767px)').matches) {
        touchStartedOnSky = false;
        return;
      }
      touchStartedOnSky = Boolean((e.target as Element | null)?.closest?.('.sky-interactive-canvas'));
      if (touchStartedOnSky) return;
      if (currentStageNum === 3) return;
      touchStartY = e.touches[0]?.clientY ?? 0;
    }, { passive: true });

    window.addEventListener('touchend', (e: TouchEvent) => {
      if (window.matchMedia('(max-width: 767px)').matches) {
        touchStartedOnSky = false;
        return;
      }
      if (touchStartedOnSky) {
        touchStartedOnSky = false;
        return;
      }
      if (currentStageNum === 3 || isStageLocked) return;
      const endY = e.changedTouches[0]?.clientY ?? touchStartY;
      const dy = touchStartY - endY;
      if (Math.abs(dy) < 44) return;
      if (currentStageNum === 1 && dy > 0) snapToStage(2);
      else if (currentStageNum === 2 && dy > 0) snapToStage(3);
      else if (currentStageNum === 2 && dy < 0) snapToStage(1);
    }, { passive: true });
  </script>
</BaseLayout>

<style>
  .stage-pullup {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-block-size: 100vh;
    min-block-size: 100dvh;
    block-size: auto;
    padding-block-start: calc(var(--chrome-height) + 0.65rem);
    padding-block-end: clamp(1rem, 2.5vh, 1.75rem);
    padding-inline: clamp(1rem, 4vw, 2.5rem);
    box-sizing: border-box;
    z-index: 5;
  }

  .pullup-card {
    position: relative;
    max-width: 720px;
    inline-size: 100%;
    box-sizing: border-box;
    padding: clamp(1.2rem, 2.2vh, 1.75rem) clamp(1.25rem, 3vw, 2.25rem);
    border-radius: 0.65rem;
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklab, var(--bg-surface) 88%, transparent);
    backdrop-filter: blur(18px);
    box-shadow:
      0 20px 50px -15px rgba(0, 0, 0, 0.75),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: clamp(0.45rem, 1.2vh, 0.7rem);
    opacity: 0;
    transform: translate3d(0, 20px, 0);
    transition:
      opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(body[data-stage="stage-2"]) .pullup-card {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  #stage-3 {
    opacity: 0;
    transform: scale(0.992);
    transition:
      opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(body[data-stage="stage-3"]) #stage-3 {
    opacity: 1;
    transform: scale(1);
  }

  .pullup-header-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .pullup-eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--accent);
  }

  .bookplate-corner {
    position: absolute;
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: color-mix(in oklab, var(--accent) 60%, transparent);
    user-select: none;
    line-height: 1;
    pointer-events: none;
  }

  .bookplate-corner--tl { inset-block-start: 0.65rem; inset-inline-start: 0.75rem; }
  .bookplate-corner--tr { inset-block-start: 0.65rem; inset-inline-end: 0.75rem; }
  .bookplate-corner--bl { inset-block-end: 0.65rem; inset-inline-start: 0.75rem; }
  .bookplate-corner--br { inset-block-end: 0.65rem; inset-inline-end: 0.75rem; }

  .pullup-rubric-badge {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--accent);
    padding: 0.18rem 0.55rem;
    border-radius: 2px;
    border: 1px solid color-mix(in oklab, var(--accent) 35%, transparent);
    background: color-mix(in oklab, var(--bg-surface) 90%, var(--paper-vellum, #f4efe6) 10%);
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  .pullup-headline {
    margin: 0.1rem 0 0;
    font-family: var(--font-serif);
    font-size: clamp(1.45rem, 2.8vw, 2.15rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.15;
    color: var(--text-primary);
  }

  .pullup-subheadline {
    margin: -0.2rem 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(0.88rem, 1.2vw, 0.98rem);
    color: var(--accent);
  }

  .pullup-bio {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(0.88rem, 1.15vw, 0.98rem);
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .pullup-specialization-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.05rem;
  }

  .spec-chip {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.18rem 0.5rem;
    border-radius: 3px;
    border: 1px solid rgba(232, 222, 181, 0.32);
    background: rgba(232, 222, 181, 0.08);
    color: var(--accent);
  }

  .spec-chip--aoc {
    border-color: var(--border-subtle);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-muted);
  }

  .pullup-colophon-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.45rem;
    margin-top: 0.1rem;
    padding: 0.5rem 0.75rem;
    border-radius: 3px;
    background: color-mix(in oklab, var(--bg-surface) 88%, var(--paper-vellum, #f4efe6) 12%);
    border: 1px solid var(--border-subtle);
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.06);
  }

  .colophon-cell {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .colophon-label {
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.14em;
    color: var(--text-muted);
  }

  .colophon-val {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--text-primary);
  }

  .pullup-coords {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding-top: 0.45rem;
    border-top: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .pullup-cv-link {
    color: var(--text-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--border-subtle);
  }

  .pullup-cv-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  @media (max-height: 760px) {
    .pullup-card {
      padding: 0.95rem 1.35rem;
      gap: 0.35rem;
    }
    .pullup-headline {
      font-size: 1.45rem;
    }
    .pullup-subheadline {
      font-size: 0.88rem;
    }
    .pullup-bio {
      font-size: 0.88rem;
      line-height: 1.45;
    }
    .pullup-colophon-grid {
      padding: 0.35rem 0.6rem;
    }
    .pullup-coords {
      padding-top: 0.35rem;
      font-size: 0.66rem;
    }
  }

  @media (max-width: 600px) {
    .stage-pullup {
      justify-content: flex-start;
      padding-block-start: calc(var(--chrome-height) + env(safe-area-inset-top, 0px) + 0.75rem);
      padding-block-end: calc(var(--public-mobile-bar-size, 60px) + 0.75rem);
    }
    .pullup-card {
      max-block-size: none;
      overflow: visible;
      padding: 1rem 1rem 0.9rem;
      gap: 0.5rem;
    }
    .pullup-rubric-badge { max-inline-size: 100%; line-height: 1.5; }
    .pullup-bio { font-size: 0.9rem; line-height: 1.45; }
    .pullup-colophon-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
