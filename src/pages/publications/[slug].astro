---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PersistentHeader from '../../components/chrome/PersistentHeader.astro';
import { loadObservatoryWorkspaceData } from '../../lib/turso';

// Edge CDN Caching: Vercel Edge serves cached HTML in ~15ms and revalidates in the background
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=86400');

const { slug } = Astro.params;
const { publications, books, classes, profile } = await loadObservatoryWorkspaceData();

const pub = publications.find((p) => p.data.id === slug);
if (!pub) {
  return Astro.redirect('/#stage-3');
}

const pubCount = publications.length;
const bookCount = books.length;
const classCount = classes.length;

let Content: any = null;
if (typeof (pub as any).render === 'function') {
  try {
    const rendered = await (pub as any).render();
    Content = rendered.Content;
  } catch {}
}
---

<BaseLayout
  title={`${pub.data.title} — ${profile.name}`}
  description={pub.data.abstract}
  citationMeta={{
    title: pub.data.title,
    authors: pub.data.coAuthors,
    year: pub.data.year,
    venue: pub.data.venue,
    doi: pub.data.doi,
    pdfUrl: pub.data.pdfUrl,
  }}
>
  <PersistentHeader
    profile={profile}
    pubCount={pubCount}
    bookCount={bookCount}
    classCount={classCount}
  />

  <main class="standalone-paper">
    <nav class="paper-breadcrumb" aria-label="Breadcrumb">
      <a href="/#stage-3">← Return to Bipartite Observatory Workspace</a>
      <span class="crumb-sep">·</span>
      <span class="crumb-id">{pub.data.id}</span>
      <button type="button" id="save-paper-offline" class="paper-save-offline" aria-pressed="false">⇩ Save paper offline</button>
    </nav>

    <article class="paper-container">
      <header class="paper-header">
        <div class="paper-meta">
          <span class="meta-year">{pub.data.year}</span>
          <span class="meta-venue">{pub.data.venue}</span>
          {pub.data.volumeIssue && <span>{pub.data.volumeIssue}</span>}
          {pub.data.doi && (
            <a
              href={`https://doi.org/${pub.data.doi}`}
              target="_blank"
              rel="noopener noreferrer"
              class="meta-doi"
            >
              DOI: {pub.data.doi} ↗
            </a>
          )}
        </div>
        <h1>{pub.data.title}</h1>
        {pub.data.subtitle && <p class="paper-subtitle">{pub.data.subtitle}</p>}
        <p class="paper-authors">
          {[profile.name, ...pub.data.coAuthors].join(', ')}
        </p>
      </header>

      <section class="paper-abstract" aria-label="Abstract">
        <h2>Abstract</h2>
        <p>{pub.data.abstract}</p>
      </section>

      <div class="paper-body">
        {pub.data.sections.map((sec) => (
          <section id={sec.id} class="paper-sec">
            <h2>{sec.heading}</h2>
            <p>{sec.body}</p>
          </section>
        ))}
        {Content && <Content />}
      </div>

      {pub.data.citationBibtex && (
        <footer class="paper-footer">
          <h2>BibTeX Record</h2>
          <pre><code>{pub.data.citationBibtex}</code></pre>
        </footer>
      )}
    </article>
  </main>

  <script>
    document.body.dataset.stage = 'stage-3';

    const saveButton = document.getElementById('save-paper-offline') as HTMLButtonElement | null;
    const savedPagesKey = 'drc-saved-public-pages-v1';
    const getSavedPages = (): string[] => {
      try {
        const saved = JSON.parse(localStorage.getItem(savedPagesKey) || '[]');
        return Array.isArray(saved) ? saved.filter((item) => typeof item === 'string') : [];
      } catch {
        return [];
      }
    };
    const currentPath = `${location.pathname}${location.search}`;
    const syncSaveButton = () => {
      const isSaved = getSavedPages().includes(currentPath);
      saveButton?.setAttribute('aria-pressed', String(isSaved));
      if (saveButton) saveButton.textContent = isSaved ? '✓ Saved for offline' : '⇩ Save paper offline';
    };

    syncSaveButton();
    saveButton?.addEventListener('click', async () => {
      if (!('serviceWorker' in navigator)) return;
      const savedPages = getSavedPages();
      const isSaved = savedPages.includes(currentPath);
      saveButton.disabled = true;
      try {
        const registration = await navigator.serviceWorker.ready;
        const worker = registration.active;
        if (!worker) return;
        const result = await new Promise<{ ok: boolean }>((resolve) => {
          const channel = new MessageChannel();
          const timeout = window.setTimeout(() => resolve({ ok: false }), 5000);
          channel.port1.onmessage = (event) => {
            window.clearTimeout(timeout);
            resolve(event.data || { ok: false });
          };
          worker.postMessage({
            type: isSaved ? 'UNSAVE_PUBLIC_PAGE' : 'SAVE_PUBLIC_PAGE',
            url: currentPath,
          }, [channel.port2]);
        });
        if (!result.ok) {
          saveButton.textContent = 'Could not save · retry';
          return;
        }
        const updated = isSaved ? savedPages.filter((page) => page !== currentPath) : [...savedPages, currentPath];
        localStorage.setItem(savedPagesKey, JSON.stringify(updated));
        syncSaveButton();
      } catch {
        saveButton.textContent = 'Could not save · retry';
      } finally {
        saveButton.disabled = false;
      }
    });
  </script>
</BaseLayout>

<style>
  .paper-save-offline { display: none; }
  @media (max-width: 767px) {
    .standalone-paper { padding-block-end: calc(6rem + env(safe-area-inset-bottom, 0px)); }
    .paper-save-offline {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-block-size: 44px;
      padding: 0.45rem 0.7rem;
      border: 1px solid var(--border-subtle);
      border-radius: 999px;
      background: var(--bg-surface);
      color: var(--text-primary);
      font: 600 0.68rem/1.1 var(--font-mono);
      cursor: pointer;
    }
    .paper-save-offline[aria-pressed="true"] { border-color: var(--accent); color: var(--accent); }
    .paper-save-offline:disabled { opacity: 0.6; }
  }

  .standalone-paper {
    max-width: 780px;
    margin: 0 auto;
    padding: 7.5rem 1.5rem 4rem;
  }

  .paper-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    margin-bottom: 2rem;
  }

  .paper-breadcrumb a {
    color: var(--accent);
    text-decoration: none;
  }

  .crumb-sep,
  .crumb-id {
    color: var(--text-muted);
  }

  .paper-container {
    padding: 2.5rem;
    border-radius: 0.75rem;
    border: 1px solid var(--border-subtle);
    background: var(--bg-surface);
  }

  .paper-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .meta-doi {
    color: var(--accent);
    text-decoration: none;
  }

  .paper-header h1 {
    margin: 0 0 0.4rem;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    line-height: 1.25;
  }

  .paper-subtitle {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    color: var(--text-secondary);
  }

  .paper-authors {
    margin: 0 0 1.5rem;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--text-muted);
  }

  .paper-abstract {
    padding: 1rem 1.25rem;
    border-left: 2px solid var(--accent);
    background: var(--bg-elevated);
    margin-bottom: 2rem;
  }

  .paper-abstract h2 {
    margin: 0 0 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .paper-abstract p {
    margin: 0;
    font-family: var(--font-serif);
    line-height: 1.65;
  }

  .paper-body {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .paper-sec {
    margin-bottom: 1.75rem;
  }

  .paper-sec h2 {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    margin: 0 0 0.5rem;
  }

  .paper-footer {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .paper-footer h2 {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .paper-footer pre {
    margin: 0;
    padding: 1rem;
    border-radius: 0.375rem;
    background: var(--bg-canvas);
    border: 1px solid var(--border-subtle);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
</style>
