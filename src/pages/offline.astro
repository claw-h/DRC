---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import MainSiteOffline from '../components/offline/MainSiteOffline.astro';
import MobileOffline from '../components/offline/MobileOffline.astro';
import { getSystemState, getFacultyProfile } from '../lib/system-state';

const state = await getSystemState();
const profile = await getFacultyProfile();

// Return 200 OK so browsers and CDNs (Vercel) never intercept or replace our custom UI with generic browser error pages
Astro.response.status = 200;
Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');
Astro.response.headers.set('X-DRC-Offline-Page', 'true');

// Allow explicit forced view via URL query (?view=mobile or ?view=desktop) or User-Agent
const forcedView = Astro.url.searchParams.get('view');
const reason = Astro.url.searchParams.get('reason');
const isMaintenance = reason === 'maintenance' || (state.offlineMode && reason !== 'offline');

const userAgent = Astro.request.headers.get('user-agent') || '';
const isMobileUA = /Android|iPhone|iPad|iPod|webOS|BlackBerry|IEMobile|Opera Mini/i.test(userAgent);
const isForcedMobile = forcedView === 'mobile' || (forcedView !== 'desktop' && isMobileUA);
const isForcedDesktop = forcedView === 'desktop';
---

<BaseLayout
  title={isMaintenance ? "Observatory Dome Closed · Duncan R. Cordry" : "You are offline! · Duncan R. Cordry"}
  description={isMaintenance ? "The celestial observatory is temporarily closed for scheduled maintenance." : "You are offline. Preserved celestial star charts and folios remain available locally."}
>
  {isForcedMobile ? (
    <MobileOffline state={state} profile={profile} isMaintenance={isMaintenance} />
  ) : isForcedDesktop ? (
    <MainSiteOffline state={state} profile={profile} isMaintenance={isMaintenance} />
  ) : (
    <>
      <div class="offline-desktop-wrapper">
        <MainSiteOffline state={state} profile={profile} isMaintenance={isMaintenance} />
      </div>
      <div class="offline-mobile-wrapper">
        <MobileOffline state={state} profile={profile} isMaintenance={isMaintenance} />
      </div>
    </>
  )}
</BaseLayout>

<style>
  /* Clean Media-Query Isolation Between Desktop & Mobile Views */
  .offline-desktop-wrapper {
    display: block;
  }

  .offline-mobile-wrapper {
    display: none;
  }

  @media (max-width: 768px) {
    .offline-desktop-wrapper {
      display: none !important;
    }
    .offline-mobile-wrapper {
      display: block !important;
    }
  }
</style>
