---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSystemState } from '../../lib/system-state';
import fs from 'node:fs/promises';
import path from 'node:path';

const systemState = await getSystemState();

// Live archive telemetry
let pubCount = 0;
let bookCount = 0;
let classCount = 0;
try {
  const pubs = await fs.readdir(path.resolve(process.cwd(), 'src/data/publications'));
  pubCount = pubs.filter(f => f.endsWith('.md')).length;
} catch {}
try {
  const books = await fs.readdir(path.resolve(process.cwd(), 'src/data/books'));
  bookCount = books.filter(f => f.endsWith('.md') || f.endsWith('.json')).length;
} catch {}
try {
  const classes = await fs.readdir(path.resolve(process.cwd(), 'src/data/classes'));
  classCount = classes.filter(f => f.endsWith('.md') || f.endsWith('.json')).length;
} catch {}

// Server runtime telemetry
const mem = process.memoryUsage();
const rssMB = (mem.rss / 1024 / 1024).toFixed(1);
const heapMB = (mem.heapUsed / 1024 / 1024).toFixed(1);
const uptimeMin = Math.floor(process.uptime() / 60);
const uptimeHrs = (uptimeMin / 60).toFixed(1);
const hostPid = process.pid;
---

<AdminLayout title="System & Maintenance" activeModule="system">
  <div class="module-container">
    <div class="module-header">
      <h2>System Status, Archival Backups &amp; Maintenance Controls</h2>
      <p class="module-sub">
        Monitor host runtime status, download archival data backups, and manage maintenance mode or server processes.
      </p>
    </div>

    <!-- Host Environment Status Deck -->
    <section class="telemetry-deck" aria-label="Host Server Environment Status">
      <div class="deck-stat">
        <span class="stat-label">RUNTIME ENGINE</span>
        <strong class="stat-value">{process.version} ({process.platform}-{process.arch})</strong>
      </div>
      <div class="deck-stat">
        <span class="stat-label">MEMORY ALLOCATION</span>
        <strong class="stat-value">{rssMB} MB <span class="stat-detail">(Heap: {heapMB} MB)</span></strong>
      </div>
      <div class="deck-stat">
        <span class="stat-label">SERVER UPTIME</span>
        <strong class="stat-value">{uptimeHrs} hrs <span class="stat-detail">({uptimeMin} min)</span></strong>
      </div>
      <div class="deck-stat">
        <span class="stat-label">ARCHIVED RECORDS</span>
        <strong class="stat-value">{pubCount} articles · {bookCount} monographs · {classCount} syllabi</strong>
      </div>
    </section>

    <div class="lifecycle-stack">
      <!-- Tier 0: Sovereign Archive Snapshot (.tar.gz) -->
      <section class="lifecycle-card tier-archive" aria-labelledby="tier-archive-heading">
        <div class="tier-lead">
          <div class="tier-header-row">
            <span class="tier-badge tier-badge-archive">BACKUP</span>
            <span class="tier-type">FULL ARCHIVE EXPORT</span>
          </div>
          <h3 id="tier-archive-heading" class="tier-title">Download Full Archive Backup (.tar.gz)</h3>
          <p class="tier-desc">
            Instantly packages the entire repository's academic data—including Markdown manuscripts, monograph files,
            course syllabi, and faculty portrait media—into a portable gzip tarball archive.
            All files are stored in standard, open formats with zero proprietary lock-in.
          </p>
          <div class="archive-spec-row">
            <span class="spec-tag">FORMAT: POSIX TAR.GZ</span>
            <span class="spec-tag">CONTENTS: src/data/ &amp; public/</span>
            <span class="spec-tag">ZERO DATABASE LOCK-IN</span>
          </div>
        </div>

        <div class="tier-action-box">
          <a
            href="/api/admin/lifecycle?action=download-archive"
            download
            id="download-archive-btn"
            class="study-btn study-btn--seal study-btn--lg btn-tier btn-tier-archive"
          >
            <span class="btn-icon">↓</span>
            <span>Download Full Archive (.tar.gz)</span>
          </a>
        </div>
      </section>

      <!-- Tier 1: Maintenance Mode (HTTP 503) -->
      <section class="lifecycle-card tier-soft" aria-labelledby="tier-1-heading">
        <div class="tier-lead">
          <div class="tier-header-row">
            <span class="tier-badge">MAINTENANCE</span>
            <span class="tier-type">PUBLIC ACCESS SWITCH</span>
          </div>
          <h3 id="tier-1-heading" class="tier-title">Maintenance Mode (Take Site Offline)</h3>
          <p class="tier-desc">
            Immediately places public portfolio pages into maintenance mode with an HTTP 503 status.
            The faculty <code>/admin</code> control panel remains 100% accessible to you for updates and preparations.
          </p>
          <div class="status-indicator-row">
            <span>Public Site Status:</span>
            <strong id="shutter-status-label" class={systemState.offlineMode ? 'text-amber' : 'text-green'}>
              {systemState.offlineMode ? '● Offline (Maintenance Mode Active)' : '● Online (Public Access Enabled)'}
            </strong>
          </div>
        </div>

        <div class="tier-action-box">
          <button
            type="button"
            id="toggle-offline-btn"
            data-currently-offline={String(systemState.offlineMode)}
            class={`study-btn study-btn--lg btn-tier ${systemState.offlineMode ? 'study-btn--ignite btn-tier-success' : 'study-btn--hazard btn-tier-warning'}`}
          >
            {systemState.offlineMode ? 'Restore Public Site (Disable Maintenance Mode)' : 'Take Site Offline (Enable Maintenance Mode)'}
          </button>
        </div>
      </section>

      <!-- Tier 2: Server Process Halt -->
      <section class="lifecycle-card tier-hard" aria-labelledby="tier-2-heading">
        <div class="tier-lead">
          <div class="tier-header-row">
            <span class="tier-badge">PROCESS</span>
            <span class="tier-type">HOST SERVER CONTROLS</span>
          </div>
          <h3 id="tier-2-heading" class="tier-title">Restart / Stop Server Process</h3>
          <p class="tier-desc">
            Gracefully terminates active socket connections and halts the Node.js server process (SIGTERM).
            If managed under a process manager (such as systemd, Docker, or PM2), the service will automatically restart fresh.
          </p>
        </div>

        <div class="tier-action-box">
          <button
            type="button"
            id="open-shutdown-modal-btn"
            class="study-btn study-btn--hazard study-btn--lg btn-tier btn-tier-danger"
          >
            <span class="btn-icon">⏹</span>
            <span>Stop Server Process (SIGTERM)…</span>
          </button>
        </div>
      </section>

      <!-- Tier 3: Permanent Codebase & Data Reset -->
      <section class="lifecycle-card tier-purge" aria-labelledby="tier-3-heading">
        <div class="tier-lead">
          <div class="tier-header-row">
            <span class="tier-badge tier-badge-critical">PERMANENT RESET</span>
            <span class="tier-type text-red">DESTRUCTIVE OPERATION</span>
          </div>
          <h3 id="tier-3-heading" class="tier-title">Permanent Archive &amp; Server Excision</h3>
          <p class="tier-desc">
            Irreversibly removes content collection files, research archives, and cached assets from disk.
            Requires explicit two-factor authentication and confirmation phrase.
          </p>
        </div>

        <div class="tier-action-box">
          <button
            type="button"
            id="open-purge-modal-btn"
            class="study-btn study-btn--purge study-btn--lg btn-tier btn-tier-critical"
          >
            <span class="btn-icon">✕</span>
            <span>Initiate Archive &amp; Server Reset…</span>
          </button>
        </div>
      </section>
    </div>

    <!-- Tier 2 Confirmation Modal (<dialog>) -->
    <dialog
      id="shutdown-confirm-dialog"
      class="sovereign-modal shutdown-dialog"
      closedby="any"
      aria-labelledby="shutdown-dialog-title"
      aria-describedby="shutdown-dialog-desc"
    >
      <div class="modal-chassis shutdown-shell">
        <div class="modal-glow-bar shutdown-modal-glow" aria-hidden="true"></div>
        <span class="modal-corner modal-corner--tl" aria-hidden="true">✠</span>
        <span class="modal-corner modal-corner--tr" aria-hidden="true">✠</span>
        <span class="modal-corner modal-corner--bl" aria-hidden="true">✠</span>
        <span class="modal-corner modal-corner--br" aria-hidden="true">✠</span>

        <header class="modal-header">
          <div class="modal-kicker-row">
            <div class="kicker-badge-lockup kicker-warning">
              <span class="hazard-pip" aria-hidden="true">⏹</span>
              <span class="modal-kicker">TIER 02 · HOST RUNTIME PROCESS HALT</span>
            </div>
            <button
              type="button"
              id="btn-close-shutdown-x"
              class="study-btn study-btn--ghost study-btn--icon-only study-btn--sm modal-close-btn"
              aria-label="Dismiss Modal"
            >
              ✕
            </button>
          </div>
          <h3 id="shutdown-dialog-title" class="modal-title">Halt Server Runtime Process</h3>
          <p id="shutdown-dialog-desc" class="modal-desc">
            Dispatches a graceful termination signal (<code>SIGTERM</code>) to the active Node.js server. Active socket connections will flush before process termination.
          </p>
        </header>

        <div class="runtime-manifest" role="region" aria-label="Host Runtime Telemetry">
          <div class="manifest-header">
            <span class="manifest-title">ACTIVE RUNTIME TARGET</span>
            <span class="manifest-tag text-amber">GRACEFUL SHUTDOWN</span>
          </div>
          <div class="manifest-grid">
            <div class="manifest-cell">
              <span class="cell-label">PROCESS PID</span>
              <strong class="cell-val tabular">{hostPid}</strong>
              <span class="cell-path">Node.js {process.version}</span>
            </div>
            <div class="manifest-cell">
              <span class="cell-label">SERVER UPTIME</span>
              <strong class="cell-val tabular">{uptimeHrs} hrs</strong>
              <span class="cell-path">{uptimeMin} min elapsed</span>
            </div>
            <div class="manifest-cell">
              <span class="cell-label">MEMORY ALLOCATION</span>
              <strong class="cell-val tabular">{rssMB} MB</strong>
              <span class="cell-path">Heap: {heapMB} MB</span>
            </div>
            <div class="manifest-cell">
              <span class="cell-label">SUPERVISOR RESTART</span>
              <strong class="cell-val">Auto-Spawn</strong>
              <span class="cell-path">systemd / Docker / PM2</span>
            </div>
          </div>
        </div>

        <form id="shutdown-form" class="modal-form">
          <div class="safety-gate-group">
            <label for="shutdown-modal-pw" class="gate-label">
              <span class="step-num">✦</span>
              <span>Administrator Master Passphrase</span>
            </label>
            <div class="password-input-wrap">
              <input
                type="password"
                id="shutdown-modal-pw"
                name="password"
                placeholder="Enter administrator passphrase…"
                autocomplete="current-password"
                required
                class="gate-input"
              />
            </div>
          </div>

          <div class="modal-actions-footer">
            <button type="button" id="cancel-shutdown-btn" class="study-btn study-btn--ledger btn-dialog-abort">
              <span>Abort</span>
              <span class="btn-keycap">Esc</span>
            </button>
            <button
              type="submit"
              id="btn-execute-shutdown"
              class="study-btn study-btn--hazard study-btn--lg btn-dialog-execute"
            >
              <span class="btn-icon">⏹</span>
              <span id="shutdown-btn-label">Halt Server Process</span>
              <span class="btn-keycap">↵</span>
            </button>
          </div>
        </form>
      </div>
    </dialog>

    <!-- Tier 3 Confirmation Modal (<dialog>) -->
    <dialog
      id="purge-confirm-dialog"
      class="sovereign-modal purge-dialog"
      closedby="any"
      aria-labelledby="purge-dialog-title"
      aria-describedby="purge-dialog-desc"
    >
      <div class="modal-chassis purge-shell">
        <div class="modal-glow-bar purge-modal-glow" aria-hidden="true"></div>
        <span class="modal-corner modal-corner--tl" aria-hidden="true">✠</span>
        <span class="modal-corner modal-corner--tr" aria-hidden="true">✠</span>
        <span class="modal-corner modal-corner--bl" aria-hidden="true">✠</span>
        <span class="modal-corner modal-corner--br" aria-hidden="true">✠</span>

        <header class="modal-header">
          <div class="modal-kicker-row">
            <div class="kicker-badge-lockup kicker-critical">
              <span class="hazard-pip" aria-hidden="true">⚠</span>
              <span class="modal-kicker">TIER 03 · IRREVERSIBLE EXCISION PROTOCOL</span>
            </div>
            <button
              type="button"
              id="btn-close-purge-x"
              class="study-btn study-btn--ghost study-btn--icon-only study-btn--sm modal-close-btn"
              aria-label="Dismiss Modal"
            >
              ✕
            </button>
          </div>
          <h3 id="purge-dialog-title" class="modal-title">Irreversible Server &amp; Archive Purge</h3>
          <p id="purge-dialog-desc" class="modal-desc">
            You are initiating the highest-tier destructive protocol. This action permanently deletes academic manuscripts, book monographs, curricula syllabi, and celestial plate files from the filesystem.
          </p>
        </header>

        <div class="destruction-manifest" role="region" aria-label="Target Destruction Manifest">
          <div class="manifest-header">
            <span class="manifest-title">TARGET DESTRUCTION MANIFEST</span>
            <span class="manifest-tag">FATAL · PERMANENT</span>
          </div>
          <div class="manifest-grid">
            <div class="manifest-cell">
              <span class="cell-label">ARTICLES</span>
              <strong class="cell-val">{pubCount} Records</strong>
              <span class="cell-path">src/data/publications/</span>
            </div>
            <div class="manifest-cell">
              <span class="cell-label">MONOGRAPHS</span>
              <strong class="cell-val">{bookCount} Records</strong>
              <span class="cell-path">src/data/books/</span>
            </div>
            <div class="manifest-cell">
              <span class="cell-label">SYLLABI</span>
              <strong class="cell-val">{classCount} Records</strong>
              <span class="cell-path">src/data/classes/</span>
            </div>
            <div class="manifest-cell">
              <span class="cell-label">CELESTIAL ATLAS</span>
              <strong class="cell-val">88 Plates &amp; Shards</strong>
              <span class="cell-path">public/data/sky/</span>
            </div>
          </div>
        </div>

        <form id="purge-form" class="purge-form">
          <!-- Step 1: Confirmation Phrase Interlock -->
          <div class="safety-gate-group">
            <div class="gate-header">
              <label for="purge-phrase" class="gate-label">
                <span class="step-num">1</span>
                <span>Type safety disengage phrase</span>
              </label>
              <button type="button" id="btn-copy-phrase" class="phrase-helper-btn" title="Click to auto-fill safety phrase">
                <span>Insert <code>CONFIRM-PERMANENT-RESET</code></span>
              </button>
            </div>
            <div class="phrase-input-wrap">
              <input
                type="text"
                id="purge-phrase"
                name="confirmationPhrase"
                placeholder="Type CONFIRM-PERMANENT-RESET"
                autocomplete="off"
                spellcheck="false"
                required
                class="gate-input"
              />
              <div id="phrase-verification-badge" class="verification-badge is-waiting">
                <span class="badge-dot"></span>
                <span id="verification-badge-text">LOCKED</span>
              </div>
            </div>
          </div>

          <!-- Step 2: Master Administrator Passphrase -->
          <div class="safety-gate-group">
            <label for="purge-pw" class="gate-label">
              <span class="step-num">2</span>
              <span>Administrator Master Passphrase</span>
            </label>
            <div class="password-input-wrap">
              <input
                type="password"
                id="purge-pw"
                name="password"
                placeholder="Enter administrator passphrase…"
                autocomplete="current-password"
                required
                class="gate-input"
              />
            </div>
          </div>

          <div class="purge-actions-footer">
            <button type="button" id="cancel-purge-btn" class="study-btn study-btn--ledger btn-dialog-abort">
              <span>Abort Excision</span>
              <span class="btn-keycap">Esc</span>
            </button>
            <button
              type="submit"
              id="btn-execute-purge"
              class="study-btn study-btn--purge study-btn--lg btn-dialog-execute"
              disabled
            >
              <span class="btn-icon">✕</span>
              <span id="purge-btn-label">Execute Irreversible Excision</span>
              <span class="btn-keycap">↵</span>
            </button>
          </div>
        </form>
      </div>
    </dialog>
  </div>

  <script>
    declare const notify: (message: string, status?: string) => void;
    declare const postAdmin: (url: string, payload: Record<string, any>) => Promise<any>;

    // Tier 0: Archive Snapshot Download
    const downloadBtn = document.getElementById('download-archive-btn') as HTMLAnchorElement | null;
    downloadBtn?.addEventListener('click', () => {
      notify('Packaging complete archive backup (src/data/ & public/) into .tar.gz…', 'info');
    });

    // Tier 1: Soft Shutter Toggle
    const offlineBtn = document.getElementById('toggle-offline-btn') as HTMLButtonElement | null;
    const statusLabel = document.getElementById('shutter-status-label');

    offlineBtn?.addEventListener('click', async () => {
      const currentlyOffline = offlineBtn.getAttribute('data-currently-offline') === 'true';
      const nextOffline = !currentlyOffline;
      offlineBtn.disabled = true;

      notify(nextOffline ? 'Enabling maintenance mode…' : 'Restoring public site access…', 'info');
      const data = await postAdmin('/api/admin/lifecycle', {
        action: 'toggle-offline',
        offline: nextOffline,
      });

      offlineBtn.disabled = false;
      if (data.ok) {
        offlineBtn.setAttribute('data-currently-offline', String(nextOffline));
        offlineBtn.textContent = nextOffline
          ? 'Restore Public Site (Disable Maintenance Mode)'
          : 'Take Site Offline (Enable Maintenance Mode)';
        offlineBtn.className = `study-btn study-btn--lg btn-tier ${nextOffline ? 'study-btn--ignite btn-tier-success' : 'study-btn--hazard btn-tier-warning'}`;

        if (statusLabel) {
          statusLabel.textContent = nextOffline ? '● Offline (Maintenance Mode Active)' : '● Online (Public Access Enabled)';
          statusLabel.className = nextOffline ? 'text-amber' : 'text-green';
        }
        notify(data.message, 'success');
      } else {
        notify(data.error || 'Failed to toggle maintenance state.', 'error');
      }
    });

    function closeDialogWithAnim(dlg: HTMLDialogElement | null) {
      if (!dlg || !dlg.open) return;
      dlg.setAttribute('data-closing', 'true');
      setTimeout(() => {
        dlg.close();
        dlg.removeAttribute('data-closing');
      }, 220);
    }

    // Tier 2: Hard Server Shutdown Modal (SIGTERM)
    const shutdownDialog = document.getElementById('shutdown-confirm-dialog') as HTMLDialogElement | null;
    const openShutdownBtn = document.getElementById('open-shutdown-modal-btn');
    const cancelShutdownBtn = document.getElementById('cancel-shutdown-btn');
    const closeShutdownX = document.getElementById('btn-close-shutdown-x');
    const shutdownForm = document.getElementById('shutdown-form') as HTMLFormElement | null;
    const shutdownPw = document.getElementById('shutdown-modal-pw') as HTMLInputElement | null;
    const shutdownBtn = document.getElementById('btn-execute-shutdown') as HTMLButtonElement | null;
    const shutdownBtnLabel = document.getElementById('shutdown-btn-label');

    openShutdownBtn?.addEventListener('click', () => {
      if (shutdownDialog && !shutdownDialog.open) {
        shutdownDialog.removeAttribute('data-closing');
        shutdownDialog.showModal();
        setTimeout(() => shutdownPw?.focus(), 80);
      }
    });

    cancelShutdownBtn?.addEventListener('click', () => closeDialogWithAnim(shutdownDialog));
    closeShutdownX?.addEventListener('click', () => closeDialogWithAnim(shutdownDialog));

    shutdownDialog?.addEventListener('click', (e) => {
      if (e.target === shutdownDialog) closeDialogWithAnim(shutdownDialog);
    });

    shutdownDialog?.addEventListener('cancel', (e) => {
      e.preventDefault();
      closeDialogWithAnim(shutdownDialog);
    });

    shutdownForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const pw = shutdownPw?.value || '';
      if (!pw) {
        notify('Passphrase is required to stop the server process.', 'warn');
        shutdownPw?.focus();
        return;
      }

      if (shutdownBtn) {
        shutdownBtn.disabled = true;
        if (shutdownBtnLabel) shutdownBtnLabel.textContent = 'Halting process…';
      }

      notify('Sending server shutdown signal…', 'warn');
      try {
        const data = await postAdmin('/api/admin/lifecycle', {
          action: 'shutdown-server',
          password: pw,
        });

        closeDialogWithAnim(shutdownDialog);
        if (data.ok) {
          notify(data.message || 'Server halting in 600ms.', 'warn');
          if (shutdownPw) shutdownPw.value = '';
        } else {
          notify(data.error || 'Passphrase verification failed.', 'error');
        }
      } catch (err: any) {
        notify(err.message || 'Failed to dispatch shutdown signal.', 'error');
      } finally {
        if (shutdownBtn) {
          shutdownBtn.disabled = false;
          if (shutdownBtnLabel) shutdownBtnLabel.textContent = 'Halt Server Process';
        }
      }
    });

    // Tier 3: Decommission & Excision Dialog
    const purgeDialog = document.getElementById('purge-confirm-dialog') as HTMLDialogElement | null;
    const openPurgeBtn = document.getElementById('open-purge-modal-btn');
    const cancelPurgeBtn = document.getElementById('cancel-purge-btn');
    const closePurgeX = document.getElementById('btn-close-purge-x');
    const purgeForm = document.getElementById('purge-form') as HTMLFormElement | null;
    const purgePhraseInput = document.getElementById('purge-phrase') as HTMLInputElement | null;
    const purgePwInput = document.getElementById('purge-pw') as HTMLInputElement | null;
    const executePurgeBtn = document.getElementById('btn-execute-purge') as HTMLButtonElement | null;
    const purgeBtnLabel = document.getElementById('purge-btn-label');
    const phraseBadge = document.getElementById('phrase-verification-badge');
    const phraseBadgeText = document.getElementById('verification-badge-text');
    const copyPhraseBtn = document.getElementById('btn-copy-phrase');

    const REQUIRED_PHRASE = 'CONFIRM-PERMANENT-RESET';

    function checkPhraseMatch() {
      const val = (purgePhraseInput?.value || '').trim();
      const isMatched = val === REQUIRED_PHRASE || val === 'DESTROY-DRC-OBSERVATORY';

      if (isMatched) {
        purgePhraseInput?.classList.add('is-valid');
        if (phraseBadge) {
          phraseBadge.classList.remove('is-waiting');
          phraseBadge.classList.add('is-verified');
        }
        if (phraseBadgeText) phraseBadgeText.textContent = 'MATCH VERIFIED ✓';
        if (executePurgeBtn) executePurgeBtn.disabled = false;
      } else {
        purgePhraseInput?.classList.remove('is-valid');
        if (phraseBadge) {
          phraseBadge.classList.remove('is-verified');
          phraseBadge.classList.add('is-waiting');
        }
        if (phraseBadgeText) phraseBadgeText.textContent = val.length > 0 ? `${val.length}/${REQUIRED_PHRASE.length}` : 'LOCKED';
        if (executePurgeBtn) executePurgeBtn.disabled = true;
      }
    }

    purgePhraseInput?.addEventListener('input', checkPhraseMatch);

    copyPhraseBtn?.addEventListener('click', () => {
      if (purgePhraseInput) {
        purgePhraseInput.value = REQUIRED_PHRASE;
        checkPhraseMatch();
        purgePwInput?.focus();
      }
    });

    openPurgeBtn?.addEventListener('click', () => {
      if (purgeDialog && !purgeDialog.open) {
        purgeDialog.removeAttribute('data-closing');
        purgeDialog.showModal();
        checkPhraseMatch();
        setTimeout(() => purgePhraseInput?.focus(), 80);
      }
    });

    cancelPurgeBtn?.addEventListener('click', () => closeDialogWithAnim(purgeDialog));
    closePurgeX?.addEventListener('click', () => closeDialogWithAnim(purgeDialog));

    purgeDialog?.addEventListener('click', (e) => {
      if (e.target === purgeDialog) closeDialogWithAnim(purgeDialog);
    });

    purgeDialog?.addEventListener('cancel', (e) => {
      e.preventDefault();
      closeDialogWithAnim(purgeDialog);
    });

    purgeForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const confirmationPhrase = String(purgePhraseInput?.value || '').trim();
      const password = String(purgePwInput?.value || '');

      if (confirmationPhrase !== REQUIRED_PHRASE && confirmationPhrase !== 'DESTROY-DRC-OBSERVATORY') {
        notify(`Confirmation phrase must match ${REQUIRED_PHRASE}`, 'warn');
        purgePhraseInput?.focus();
        return;
      }

      if (!password) {
        notify('Administrator master passphrase is required.', 'warn');
        purgePwInput?.focus();
        return;
      }

      if (executePurgeBtn) {
        executePurgeBtn.disabled = true;
        if (purgeBtnLabel) purgeBtnLabel.textContent = 'Excision in progress…';
      }

      notify('Verifying administrator credentials…', 'warn');
      try {
        const data = await postAdmin('/api/admin/lifecycle', {
          action: 'purge-codebase',
          confirmationPhrase,
          password,
        });

        closeDialogWithAnim(purgeDialog);
        if (data.ok) {
          notify(data.message || 'Purge initiated.', 'error');
          setTimeout(() => window.location.reload(), 1500);
        } else {
          notify(data.error || 'Credentials mismatch.', 'error');
        }
      } catch (err: any) {
        notify(err.message || 'Purge request failed.', 'error');
      } finally {
        if (executePurgeBtn) {
          executePurgeBtn.disabled = false;
          if (purgeBtnLabel) purgeBtnLabel.textContent = 'Execute Irreversible Excision';
        }
      }
    });
  </script>
</AdminLayout>

