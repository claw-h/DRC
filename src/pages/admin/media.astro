---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { getFacultyProfile } from '../../lib/system-state';

const profile = await getFacultyProfile();
---

<AdminLayout title="Media Atelier & Visiting Card" activeModule="media">
  <div class="module-container">
    <div class="module-header">
      <div class="header-split">
        <div>
          <span class="module-kicker">MODULE 02 · MEDIA & CREDENTIALS ATELIER</span>
          <h2>Interactive Canvas Cropper & Faculty Credentials</h2>
          <p class="module-sub">
            Crop portraits and book covers on a browser `<canvas>` with pan, zoom, and rotation controls. 100% zero server C++ dependencies.
          </p>
        </div>
        <div class="mode-toggles">
          <button type="button" class="mode-btn is-active" id="mode-btn-portrait" data-mode="portrait">
            <span>4:5 Faculty Portrait</span>
          </button>
          <button type="button" class="mode-btn" id="mode-btn-book" data-mode="book-cover">
            <span>2:3 Monograph Cover</span>
          </button>
        </div>
      </div>
    </div>

    <div class="studio-grid">
      <!-- Left Column: Interactive Canvas & Pan/Zoom Controls -->
      <section class="studio-card" aria-labelledby="canvas-heading">
        <div class="card-top">
          <span class="card-kicker" id="cropper-aspect-label">4:5 ASPECT RATIO // 320 × 400</span>
          <h3 id="canvas-heading">Interactive Viewport</h3>
          <p class="card-desc">Click and drag inside the frame to pan. Use the slider or mouse wheel to zoom.</p>
        </div>

        <div class="viewport-stage" id="viewport-dropzone">
          <canvas id="studio-canvas" width="320" height="400" class="crop-canvas"></canvas>
          <div class="canvas-crosshairs"></div>
          <div class="canvas-watermark" id="canvas-watermark">DRC ATELIER · 4:5 FRAME</div>
          <div class="drop-hint" id="drop-hint">Drop image file here</div>
        </div>

        <!-- Interactive Transformation Controls -->
        <div class="transform-controls">
          <div class="zoom-row">
            <span class="control-label">Zoom:</span>
            <button type="button" id="zoom-out-btn" class="btn-tool" title="Zoom Out">−</button>
            <input type="range" id="zoom-slider" min="0.5" max="3" step="0.05" value="1" class="tool-slider" />
            <button type="button" id="zoom-in-btn" class="btn-tool" title="Zoom In">+</button>
            <span id="zoom-val-display" class="zoom-val">100%</span>
          </div>

          <div class="tool-actions-row">
            <button type="button" id="rotate-btn" class="btn-tool-action">
              ↻ Rotate 90°
            </button>
            <button type="button" id="reset-view-btn" class="btn-tool-action">
              ⟲ Reset View
            </button>
            <label class="btn-file-select">
              <span>Choose Image…</span>
              <input type="file" id="image-file-input" accept="image/*" class="sr-only" />
            </label>
          </div>
          <span class="file-name-sub" id="file-status">No file loaded. Showing default sample.</span>
        </div>
      </section>

      <!-- Right Column: Context-Aware Target Controls & Live Card Preview -->
      <div class="studio-sidebar">
        <!-- MODE A: Portrait & Faculty ID Card Telemetry Form -->
        <section class="studio-card" id="portrait-panel">
          <div class="card-top">
            <span class="card-kicker">CREDENTIALS TARGET</span>
            <h3>Faculty ID Card & Office Telemetry</h3>
            <p class="card-desc">Synchronizes with the expanding Faculty ID Card modal on the public portfolio.</p>
          </div>

          <form id="portrait-form" class="studio-form">
            <div class="form-group">
              <label for="office-input">Office Location</label>
              <input
                type="text"
                id="office-input"
                name="office"
                value={profile.office}
                placeholder="Faculty Block · Rajiv Gandhi Education City"
                required
              />
            </div>

            <div class="form-group">
              <label for="hours-input">Office / Consultation Hours</label>
              <input
                type="text"
                id="hours-input"
                name="officeHours"
                value={profile.officeHours}
                placeholder="By Appointment · Semesters I & II"
                required
              />
            </div>

            <div class="form-group">
              <label for="phone-input">Office Telephone Telemetry</label>
              <input
                type="text"
                id="phone-input"
                name="phone"
                value={profile.phone}
                placeholder="+91 (0130) 230-0000"
              />
            </div>

            <button type="submit" id="save-portrait-btn" class="btn-primary">
              Export WebP & Update Faculty ID Card
            </button>
          </form>

          <!-- Live Faculty ID Card Mockup -->
          <div class="id-card-preview-wrap">
            <span class="mini-kicker">LIVE FACULTY ID CARD PREVIEW</span>
            <div class="id-card-mock">
              <div class="id-card-photo">
                <img id="live-preview-photo" src={profile.portraitUrl} alt="Duncan R. Cordry" />
              </div>
              <div class="id-card-details">
                <div class="id-card-badge">ASHOKA UNIVERSITY · FACULTY</div>
                <h4 class="id-card-name">{profile.name}</h4>
                <div class="id-card-title">{profile.title}</div>
                <div class="id-card-meta">
                  <span id="preview-office">{profile.office}</span>
                  <span id="preview-hours">{profile.officeHours}</span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- MODE B: Book Cover Monograph Export Form -->
        <section class="studio-card" id="book-cover-panel" hidden>
          <div class="card-top">
            <span class="card-kicker">MONOGRAPH TARGET</span>
            <h3>Book Cover Publisher (2:3 Ratio)</h3>
            <p class="card-desc">Exports high-resolution WebP monograph artwork into <code>public/images/books/</code>.</p>
          </div>

          <form id="book-cover-form" class="studio-form">
            <div class="form-group">
              <label for="book-slug-input">Monograph Short Slug / Title</label>
              <input
                type="text"
                id="book-slug-input"
                placeholder="e.g. technical-objects-spiritual-practices"
                value="monograph-cover"
                required
              />
              <span class="help-text">Will be saved to: <code>/images/books/[slug]-[timestamp].webp</code></span>
            </div>

            <button type="submit" id="save-book-cover-btn" class="btn-primary">
              Export 2:3 Monograph Cover WebP
            </button>
          </form>

          <div id="cover-result-box" class="result-box" hidden>
            <span class="mini-kicker">EXPORT READY</span>
            <p class="result-text">Image generated and written to server filesystem:</p>
            <div class="url-copy-row">
              <input type="text" id="cover-url-output" readonly class="mono-input" />
              <button type="button" id="copy-url-btn" class="btn-copy">Copy URL</button>
            </div>
            <p class="help-text">Paste this URL into the "Cover Image Path" field in Module 01 (Monographs).</p>
          </div>
        </section>
      </div>
    </div>
  </div>

  <script>
    declare const notify: (message: string, status?: string) => void;
    declare const postAdmin: (url: string, payload: Record<string, any>) => Promise<any>;

    // State Variables
    let currentMode: 'portrait' | 'book-cover' = 'portrait';
    let currentImage: HTMLImageElement | null = null;
    let zoomLevel = 1.0;
    let rotationDeg = 0;
    let panX = 0;
    let panY = 0;
    let isDragging = false;
    let dragStartX = 0;
    let dragStartY = 0;

    const canvas = document.getElementById('studio-canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d');
    const zoomSlider = document.getElementById('zoom-slider') as HTMLInputElement;
    const zoomValDisplay = document.getElementById('zoom-val-display');
    const fileStatus = document.getElementById('file-status');
    const dropzone = document.getElementById('viewport-dropzone');
    const aspectLabel = document.getElementById('cropper-aspect-label');
    const watermark = document.getElementById('canvas-watermark');
    const livePhoto = document.getElementById('live-preview-photo') as HTMLImageElement;

    // Render Canvas Loop
    function renderCanvas() {
      if (!ctx) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      if (!currentImage) {
        ctx.fillStyle = '#0e1117';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.strokeStyle = 'rgba(215, 185, 120, 0.3)';
        ctx.lineWidth = 1;
        ctx.strokeRect(16, 16, canvas.width - 32, canvas.height - 32);

        ctx.fillStyle = '#8b949e';
        ctx.font = '11px monospace';
        ctx.textAlign = 'center';
        ctx.fillText('SELECT IMAGE OR DRAG & DROP HERE', canvas.width / 2, canvas.height / 2 - 8);
        ctx.fillStyle = '#586069';
        ctx.fillText(`FRAME: ${canvas.width} × ${canvas.height}`, canvas.width / 2, canvas.height / 2 + 14);
        return;
      }

      ctx.save();
      // Clip to viewport canvas
      ctx.beginPath();
      ctx.rect(0, 0, canvas.width, canvas.height);
      ctx.clip();

      // Background fill
      ctx.fillStyle = '#0a0d14';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Translate to canvas center + pan
      ctx.translate(canvas.width / 2 + panX, canvas.height / 2 + panY);
      ctx.rotate((rotationDeg * Math.PI) / 180);
      ctx.scale(zoomLevel, zoomLevel);

      // Draw image centered
      const imgW = currentImage.width;
      const imgH = currentImage.height;
      ctx.drawImage(currentImage, -imgW / 2, -imgH / 2, imgW, imgH);

      ctx.restore();

      // Update live ID card preview if in portrait mode
      if (currentMode === 'portrait' && livePhoto) {
        livePhoto.src = canvas.toDataURL('image/webp', 0.85);
      }
    }

    // Set Aspect Ratio Mode
    function setMode(mode: 'portrait' | 'book-cover') {
      currentMode = mode;
      const portraitBtn = document.getElementById('mode-btn-portrait');
      const bookBtn = document.getElementById('mode-btn-book');
      const portraitPanel = document.getElementById('portrait-panel');
      const bookPanel = document.getElementById('book-cover-panel');

      if (mode === 'portrait') {
        canvas.width = 320;
        canvas.height = 400; // 4:5
        if (aspectLabel) aspectLabel.textContent = '4:5 ASPECT RATIO // 320 × 400 (FACULTY ID)';
        if (watermark) watermark.textContent = 'DRC ATELIER · 4:5 FRAME';
        portraitBtn?.classList.add('is-active');
        bookBtn?.classList.remove('is-active');
        if (portraitPanel) portraitPanel.hidden = false;
        if (bookPanel) bookPanel.hidden = true;
      } else {
        canvas.width = 300;
        canvas.height = 450; // 2:3
        if (aspectLabel) aspectLabel.textContent = '2:3 ASPECT RATIO // 300 × 450 (MONOGRAPH)';
        if (watermark) watermark.textContent = 'DRC ATELIER · 2:3 MONOGRAPH';
        portraitBtn?.classList.remove('is-active');
        bookBtn?.classList.add('is-active');
        if (portraitPanel) portraitPanel.hidden = true;
        if (bookPanel) bookPanel.hidden = false;
      }

      resetTransform();
    }

    function resetTransform() {
      if (!currentImage) return;
      const scaleX = canvas.width / currentImage.width;
      const scaleY = canvas.height / currentImage.height;
      zoomLevel = Math.max(scaleX, scaleY);
      panX = 0;
      panY = 0;
      rotationDeg = 0;
      if (zoomSlider) {
        zoomSlider.value = String(zoomLevel);
        zoomSlider.min = String(zoomLevel * 0.5);
        zoomSlider.max = String(zoomLevel * 3.0);
      }
      if (zoomValDisplay) zoomValDisplay.textContent = `${Math.round(zoomLevel * 100)}%`;
      renderCanvas();
    }

    function loadImageFromFile(file: File) {
      if (!file) return;
      if (fileStatus) fileStatus.textContent = `${file.name} (${Math.round(file.size / 1024)} KB)`;
      const reader = new FileReader();
      reader.onload = () => {
        const img = new Image();
        img.onload = () => {
          currentImage = img;
          resetTransform();
          notify(`Loaded ${file.name} into atelier viewport.`, 'info');
        };
        img.src = String(reader.result);
      };
      reader.readAsDataURL(file);
    }

    // Load initial profile portrait as starting canvas image
    const initialImg = new Image();
    initialImg.crossOrigin = 'anonymous';
    initialImg.onload = () => {
      currentImage = initialImg;
      resetTransform();
    };
    initialImg.src = livePhoto?.src || '/images/duncan-cordry-portrait.jpg';

    // File Input
    document.getElementById('image-file-input')?.addEventListener('change', (e) => {
      const file = (e.currentTarget as HTMLInputElement).files?.[0];
      if (file) loadImageFromFile(file);
    });

    // Drag and Drop onto canvas dropzone
    dropzone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('is-dragover');
    });

    dropzone?.addEventListener('dragleave', () => {
      dropzone.classList.remove('is-dragover');
    });

    dropzone?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('is-dragover');
      const file = e.dataTransfer?.files?.[0];
      if (file) loadImageFromFile(file);
    });

    // Pan (Mouse / Touch)
    canvas.addEventListener('mousedown', (e) => {
      isDragging = true;
      dragStartX = e.clientX - panX;
      dragStartY = e.clientY - panY;
      canvas.style.cursor = 'grabbing';
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      panX = e.clientX - dragStartX;
      panY = e.clientY - dragStartY;
      renderCanvas();
    });

    window.addEventListener('mouseup', () => {
      if (isDragging) {
        isDragging = false;
        canvas.style.cursor = 'grab';
      }
    });

    // Mouse wheel zoom
    canvas.addEventListener('wheel', (e) => {
      e.preventDefault();
      const delta = e.deltaY * -0.002;
      zoomLevel = Math.max(0.2, Math.min(4.0, zoomLevel + delta));
      if (zoomSlider) zoomSlider.value = String(zoomLevel);
      if (zoomValDisplay) zoomValDisplay.textContent = `${Math.round(zoomLevel * 100)}%`;
      renderCanvas();
    });

    // Zoom Slider & Buttons
    zoomSlider?.addEventListener('input', (e) => {
      zoomLevel = Number((e.currentTarget as HTMLInputElement).value);
      if (zoomValDisplay) zoomValDisplay.textContent = `${Math.round(zoomLevel * 100)}%`;
      renderCanvas();
    });

    document.getElementById('zoom-in-btn')?.addEventListener('click', () => {
      zoomLevel = Math.min(4.0, zoomLevel + 0.1);
      if (zoomSlider) zoomSlider.value = String(zoomLevel);
      if (zoomValDisplay) zoomValDisplay.textContent = `${Math.round(zoomLevel * 100)}%`;
      renderCanvas();
    });

    document.getElementById('zoom-out-btn')?.addEventListener('click', () => {
      zoomLevel = Math.max(0.2, zoomLevel - 0.1);
      if (zoomSlider) zoomSlider.value = String(zoomLevel);
      if (zoomValDisplay) zoomValDisplay.textContent = `${Math.round(zoomLevel * 100)}%`;
      renderCanvas();
    });

    document.getElementById('rotate-btn')?.addEventListener('click', () => {
      rotationDeg = (rotationDeg + 90) % 360;
      renderCanvas();
    });

    document.getElementById('reset-view-btn')?.addEventListener('click', resetTransform);

    // Mode Toggle Buttons
    document.getElementById('mode-btn-portrait')?.addEventListener('click', () => setMode('portrait'));
    document.getElementById('mode-btn-book')?.addEventListener('click', () => setMode('book-cover'));

    // Real-time Text Mirroring for Mockup Card
    const officeInput = document.getElementById('office-input') as HTMLInputElement;
    const hoursInput = document.getElementById('hours-input') as HTMLInputElement;
    const previewOffice = document.getElementById('preview-office');
    const previewHours = document.getElementById('preview-hours');

    officeInput?.addEventListener('input', () => {
      if (previewOffice) previewOffice.textContent = officeInput.value || 'Office Location';
    });
    hoursInput?.addEventListener('input', () => {
      if (previewHours) previewHours.textContent = hoursInput.value || 'Consultation Hours';
    });

    // 1. Submit Portrait & Telemetry
    document.getElementById('portrait-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('save-portrait-btn') as HTMLButtonElement;
      if (submitBtn) submitBtn.disabled = true;

      const webpDataUrl = canvas.toDataURL('image/webp', 0.90);
      const office = officeInput.value;
      const officeHours = hoursInput.value;
      const phone = (document.getElementById('phone-input') as HTMLInputElement)?.value || '';

      notify('Encoding 4:5 WebP and saving to /public/images/…', 'info');
      const data = await postAdmin('/api/admin/media', {
        target: 'portrait',
        dataUrl: webpDataUrl,
        office,
        officeHours,
        phone,
      });

      if (submitBtn) submitBtn.disabled = false;
      if (data.ok) {
        notify('Faculty ID portrait and telemetry updated successfully!', 'success');
      } else {
        notify(data.error || 'Failed to update credentials.', 'error');
      }
    });

    // 2. Submit Monograph Book Cover
    document.getElementById('book-cover-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('save-book-cover-btn') as HTMLButtonElement;
      if (submitBtn) submitBtn.disabled = true;

      const slugInput = document.getElementById('book-slug-input') as HTMLInputElement;
      const webpDataUrl = canvas.toDataURL('image/webp', 0.90);

      notify('Encoding 2:3 Monograph cover to /public/images/books/…', 'info');
      const data = await postAdmin('/api/admin/media', {
        target: 'book-cover',
        dataUrl: webpDataUrl,
        customFileName: slugInput.value,
      });

      if (submitBtn) submitBtn.disabled = false;
      if (data.ok && data.imageUrl) {
        notify(data.message || 'Book cover saved!', 'success');
        const resultBox = document.getElementById('cover-result-box');
        const urlOutput = document.getElementById('cover-url-output') as HTMLInputElement;
        if (resultBox && urlOutput) {
          resultBox.hidden = false;
          urlOutput.value = data.imageUrl;
        }
      } else {
        notify(data.error || 'Failed to export cover.', 'error');
      }
    });

    // Copy URL to Clipboard
    document.getElementById('copy-url-btn')?.addEventListener('click', () => {
      const urlOutput = document.getElementById('cover-url-output') as HTMLInputElement;
      if (urlOutput?.value) {
        navigator.clipboard.writeText(urlOutput.value);
        notify('Copied image path to clipboard!', 'success');
      }
    });
  </script>
</AdminLayout>

<style>
  .module-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .module-header {
    border-bottom: 1px solid var(--border-hairline);
    padding-bottom: 1.25rem;
  }

  .header-split {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .module-kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--accent);
  }

  .header-split h2 {
    margin: 0.25rem 0 0.25rem;
    font-size: var(--step-1);
    font-weight: 500;
  }

  .module-sub {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .mode-toggles {
    display: flex;
    gap: 0.5rem;
  }

  .mode-btn {
    padding: 0.55rem 0.95rem;
    border-radius: 0.375rem;
    border: 1px solid var(--border-hairline);
    background: var(--bg-surface);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .mode-btn:hover {
    color: var(--text-primary);
    border-color: var(--accent);
  }

  .mode-btn.is-active {
    background: var(--bg-elevated);
    border-color: var(--accent);
    color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }

  /* Studio Grid */
  .studio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: 1.5rem;
    align-items: start;
  }

  .studio-card {
    padding: 1.5rem;
    border-radius: 0.75rem;
    border: 1px solid var(--border-hairline);
    background: var(--bg-elevated);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .card-top {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .card-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .card-top h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 500;
  }

  .card-desc {
    margin: 0;
    font-size: 0.82rem;
    color: var(--text-secondary);
  }

  /* Viewport Stage */
  .viewport-stage {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    background: var(--bg-canvas);
    border: 1px solid var(--border-hairline);
    border-radius: 0.5rem;
    padding: 1.5rem;
    overflow: hidden;
    cursor: grab;
    user-select: none;
    transition: border-color 0.2s ease;
  }

  .viewport-stage.is-dragover {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent);
  }

  .crop-canvas {
    max-width: 100%;
    height: auto;
    border-radius: 0.35rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    background: #000;
  }

  .canvas-watermark {
    position: absolute;
    bottom: 0.75rem;
    right: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    pointer-events: none;
  }

  .drop-hint {
    display: none;
  }

  /* Transform Controls */
  .transform-controls {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-hairline);
    border-radius: 0.5rem;
  }

  .zoom-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .control-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    min-width: 48px;
  }

  .tool-slider {
    flex: 1;
    accent-color: var(--accent);
  }

  .zoom-val {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    min-width: 42px;
    text-align: right;
  }

  .btn-tool {
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.25rem;
    border: 1px solid var(--border-hairline);
    background: var(--bg-elevated);
    color: var(--text-primary);
    cursor: pointer;
    font-weight: bold;
    font-size: 0.9rem;
  }

  .btn-tool:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .tool-actions-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .btn-tool-action {
    padding: 0.45rem 0.75rem;
    border-radius: 0.25rem;
    border: 1px solid var(--border-hairline);
    background: var(--bg-elevated);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-tool-action:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .btn-file-select {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.85rem;
    border-radius: 0.25rem;
    border: 1px solid var(--accent);
