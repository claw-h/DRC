---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';

const publications = (await getCollection('publications').catch(() => [])).sort((a, b) => b.data.year - a.data.year);
const books = (await getCollection('books').catch(() => [])).sort((a, b) => b.data.year - a.data.year);
const classes = await getCollection('classes').catch(() => []);

const totalCount = publications.length + books.length + classes.length;
---

<AdminLayout title="Content & Syllabi Ledger" activeModule="content">
  <div class="module-container">
    <!-- Module Header with Telemetry Stats -->
    <div class="module-header">
      <div class="header-split">
        <div>
          <h2>Publications, Monographs &amp; Syllabi</h2>
          <p class="module-sub">
            Manage refereed journal articles, authored monographs, and university course syllabi.
          </p>
        </div>
        <div class="telemetry-stats">
          <div class="stat-box">
            <span class="stat-number">{publications.length}</span>
            <span class="stat-label">Articles</span>
          </div>
          <div class="stat-box">
            <span class="stat-number">{books.length}</span>
            <span class="stat-label">Monographs</span>
          </div>
          <div class="stat-box">
            <span class="stat-number">{classes.length}</span>
            <span class="stat-label">Syllabi</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Action Launchpad -->
    <div class="launchpad-bar">
      <div class="launchpad-left">
        <button type="button" id="btn-quick-ingest" class="study-btn study-btn--ignite btn-launch btn-accent-glow" title="Fast intake: Drop PDF or paste DOI">
          <span class="btn-icon">⚡</span>
          <span>Quick Intake Ingest</span>
        </button>
        <span class="launchpad-subtext">Unified scholarly intake studio for papers, monographs, and syllabi</span>
      </div>

      <div class="launchpad-right">
        <span class="ledger-total-badge tabular">{totalCount} TOTAL ARCHIVED WORKS</span>
      </div>
    </div>

    <!-- ========================================================
         FASCICLE WORKBENCH (GOLDEN SPINE RAIL + ACTIVE CATALOG SHELF)
         ======================================================== -->
    <div class="ledger-workbench-stage" id="ledger-workbench-stage">
      <!-- Leftmost Fascicle Spine Rail -->
      <aside class="fascicle-spine-rail" id="fascicle-spine-rail" aria-label="Academic Fascicles">
        <!-- Continuous Golden Axis Trim Line (Matches Admin Sidebar) -->
        <div class="fascicle-golden-axis" aria-hidden="true"></div>

        <nav class="fascicle-nav-list" role="tablist" aria-label="Fascicle Catalog Tabs">
          <!-- Fascicle I: Publications -->
          <button
            type="button"
            class="fascicle-tab-btn is-active"
            id="tab-fascicle-publications"
            data-fascicle-target="publications"
            role="tab"
            aria-selected="true"
            aria-controls="panel-publications"
            title="Fascicle I: Publications (Press 1)"
          >
            <div class="fascicle-node-badge">
              <span class="fascicle-numeral">I</span>
              <span class="fascicle-glow-ring" aria-hidden="true"></span>
            </div>
            <div class="fascicle-meta-lockup">
              <span class="fascicle-kicker">FASCICLE I</span>
              <span class="fascicle-title">Publications</span>
              <span class="fascicle-count tabular" id="rail-count-publications">{publications.length} Works</span>
            </div>
            <span class="fascicle-hotkey" aria-hidden="true" title="Hot-key: 1">1</span>
          </button>

          <!-- Fascicle II: Books / Monographs -->
          <button
            type="button"
            class="fascicle-tab-btn"
            id="tab-fascicle-books"
            data-fascicle-target="books"
            role="tab"
            aria-selected="false"
            aria-controls="panel-books"
            title="Fascicle II: Monographs (Press 2)"
          >
            <div class="fascicle-node-badge">
              <span class="fascicle-numeral">II</span>
              <span class="fascicle-glow-ring" aria-hidden="true"></span>
            </div>
            <div class="fascicle-meta-lockup">
              <span class="fascicle-kicker">FASCICLE II</span>
              <span class="fascicle-title">Monographs</span>
              <span class="fascicle-count tabular" id="rail-count-books">{books.length} Volumes</span>
            </div>
            <span class="fascicle-hotkey" aria-hidden="true" title="Hot-key: 2">2</span>
          </button>

          <!-- Fascicle III: Classes / Syllabi -->
          <button
            type="button"
            class="fascicle-tab-btn"
            id="tab-fascicle-classes"
            data-fascicle-target="classes"
            role="tab"
            aria-selected="false"
            aria-controls="panel-classes"
            title="Fascicle III: Classes (Press 3)"
          >
            <div class="fascicle-node-badge">
              <span class="fascicle-numeral">III</span>
              <span class="fascicle-glow-ring" aria-hidden="true"></span>
            </div>
            <div class="fascicle-meta-lockup">
              <span class="fascicle-kicker">FASCICLE III</span>
              <span class="fascicle-title">Classes</span>
              <span class="fascicle-count tabular" id="rail-count-classes">{classes.length} Seminars</span>
            </div>
            <span class="fascicle-hotkey" aria-hidden="true" title="Hot-key: 3">3</span>
          </button>
        </nav>
      </aside>

      <!-- Right Stage: Active Fascicle Catalog Shelf -->
      <section class="fascicle-catalog-shelf" id="fascicle-catalog-shelf" aria-live="polite">
        <!-- Shelf Action Header: Category Breadcrumb, Search, 2-Way View Switch, + Add Button -->
        <header class="shelf-action-header">
          <div class="shelf-heading-lockup">
            <span class="shelf-fleuron" aria-hidden="true">❧</span>
            <div class="shelf-titles">
              <span class="shelf-kicker mono" id="shelf-kicker">FASCICLE I · ARTICLES &amp; MANUSCRIPTS</span>
              <h3 class="shelf-main-title serif" id="shelf-main-title">Refereed Articles &amp; Critical Essays</h3>
            </div>
            <span class="shelf-count-pill tabular" id="shelf-count-pill">{publications.length} RECORDS</span>
          </div>

          <div class="shelf-tools-cluster">
            <!-- Real-time Filter Search Input -->
            <div class="shelf-search-box">
              <label for="ledger-search-input" class="sr-only">Search active fascicle</label>
              <span class="search-icon" aria-hidden="true">🔍</span>
              <input
                type="search"
                id="ledger-search-input"
                placeholder="Filter articles by title, journal, DOI, co-author, year…"
                spellcheck="false"
                autocomplete="off"
              />
              <button type="button" id="btn-search-clear" class="btn-search-clear" aria-label="Clear search" title="Clear search (Esc)" hidden>✕</button>
              <span id="search-count-readout" class="search-readout tabular" hidden></span>
            </div>

            <!-- Single 2-Way View Switcher (Tiles ⇄ Rows) -->
            <button
              type="button"
              id="btn-view-toggle-2way"
              class="view-toggle-2way"
              role="switch"
              aria-checked="false"
              aria-label="Toggle display between Tiles and Rows"
              title="Toggle between Pictographic Tiles and Dense Rows (Hot-key: V)"
            >
              <span class="toggle-track">
                <span class="toggle-indicator-thumb" id="toggle-thumb" aria-hidden="true"></span>
                <span class="toggle-segment segment-tiles is-active" id="seg-tiles">
                  <span class="seg-icon">⊞</span>
                  <span class="seg-text">Tiles</span>
                </span>
                <span class="toggle-segment segment-rows" id="seg-rows">
                  <span class="seg-icon">☰</span>
                  <span class="seg-text">Rows</span>
                </span>
              </span>
            </button>

            <!-- Contextual Add Action Button -->
            <button
              type="button"
              id="btn-shelf-context-add"
              class="study-btn study-btn--ignite study-btn--sm btn-shelf-add"
              data-active-fascicle="publications"
            >
              <span class="btn-icon">+</span>
              <span id="shelf-btn-add-label">New Article</span>
            </button>
          </div>
        </header>

        <!-- Cross-Fascicle Discovery Banner (Informs user when query matches in other fascicles) -->
        <div class="shelf-cross-discovery-bar" id="shelf-cross-discovery-bar" hidden>
          <div class="cross-discovery-inner" id="cross-discovery-inner"></div>
        </div>

        <!-- Shelf Panels Container (only active panel is displayed) -->
        <div class="shelf-panels-wrap is-gallery-view" id="shelf-panels-wrap">
          <!-- 1. Publications Panel -->
          <div class="fascicle-panel is-active" id="panel-publications" data-panel-type="publications" role="tabpanel">
            <!-- Tactile Pictographic Specimen Gallery -->
            <div class="specimen-gallery" data-gallery-section="publications">
              {publications.map((pub) => (
                <article
                  class="specimen-card specimen-card--publication"
                  data-item-card={`publications-${pub.id}`}
                  data-search-text={`${pub.data.year} ${pub.data.title} ${pub.data.subtitle || ''} ${pub.data.venue} ${pub.data.volumeIssue || ''} ${pub.data.doi || ''} ${(pub.data.coAuthors || []).join(' ')} ${pub.data.abstract || ''}`.toLowerCase()}
                  data-card-id={pub.id}
                  data-card-type="publications"
                  tabindex="0"
                  role="button"
                  aria-label={`Inspect manuscript: ${pub.data.title}`}
                >
                  <script type="application/json" class="specimen-payload" set:html={JSON.stringify({
                    type: 'publications',
                    id: pub.id,
                    title: pub.data.title,
                    subtitle: pub.data.subtitle || '',
                    year: pub.data.year,
                    venue: pub.data.venue,
                    volumeIssue: pub.data.volumeIssue || '',
                    doi: pub.data.doi || '',
                    pdfUrl: pub.data.pdfUrl || '',
                    coAuthors: pub.data.coAuthors || [],
                    excerpt: pub.data.abstract || '',
                    citation: pub.data.citationBibtex || '',
                    publicUrl: `/publications/${pub.id}`
                  })} />
                  
                  <div class="card-face">
                    <div class="card-eyebrow-line">
                      <span class="card-year mono">{pub.data.year}</span>
                      <span class="card-fleuron" aria-hidden="true">❧</span>
                      <span class="card-venue-tag">{pub.data.venue}</span>
                    </div>

                    <div class="card-body-lockup">
                      <h4 class="card-main-title">{pub.data.title}</h4>
                      {pub.data.subtitle && <p class="card-sub-title">{pub.data.subtitle}</p>}
                    </div>

                    <div class="card-footer-line">
                      <div class="card-chips-cluster">
                        {pub.data.pdfUrl && <span class="specimen-chip chip-accent">📄 PDF</span>}
                        {pub.data.doi && <span class="specimen-chip chip-mono">⌖ DOI</span>}
                        {pub.data.coAuthors && pub.data.coAuthors.length > 0 && (
                          <span class="specimen-chip chip-subtle">+{pub.data.coAuthors.length} co-author</span>
                        )}
                      </div>
                      <div class="card-hover-prompt">
                        <span class="prompt-icon">👁</span>
                        <span class="prompt-text">Inspect</span>
                      </div>
                      <button type="button" class="mobile-expand-btn" aria-expanded="false" aria-label="Toggle details">
                        <span class="expand-icon" aria-hidden="true">▾</span>
                      </button>
                    </div>
                  </div>

                  <!-- Collapsible Mobile Drawer for Publications -->
                  <div class="card-collapsible-drawer">
                    {pub.data.abstract && (
                      <div class="card-drawer-extract">
                        <span class="drawer-kicker">ABSTRACT</span>
                        <p class="drawer-text">{pub.data.abstract}</p>
                      </div>
                    )}
                    <div class="card-drawer-actions">
                      <button
                        type="button"
                        class="study-btn study-btn--ignite study-btn--sm btn-card-edit"
                        data-edit-type="publications"
                        data-edit-id={pub.id}
                      >
                        <span>✎ Edit in Atelier</span>
                      </button>
                      <a
                        href={`/publications/${pub.id}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="study-btn study-btn--ghost study-btn--sm btn-card-view"
                      >
                        <span>↗ View</span>
                      </a>
                      <button
                        type="button"
                        class="study-btn study-btn--hazard study-btn--sm btn-card-delete"
                        data-delete-type="publications"
                        data-delete-id={pub.id}
                        data-delete-name={pub.data.title}
                      >
                        <span>✕ Delete</span>
                      </button>
                    </div>
                  </div>
                </article>
              ))}
            </div>

            <div class="table-wrap">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th style="width: 80px;">Year</th>
                    <th>Title &amp; Subtitle</th>
                    <th>Venue / Journal</th>
                    <th style="width: 140px;">DOI</th>
                    <th class="text-right" style="width: 150px;">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {publications.map((pub) => (
                    <tr
                      data-item-row={`publications-${pub.id}`}
                      data-search-text={`${pub.data.year} ${pub.data.title} ${pub.data.subtitle || ''} ${pub.data.venue} ${pub.data.volumeIssue || ''} ${pub.data.doi || ''} ${(pub.data.coAuthors || []).join(' ')} ${pub.data.abstract || ''}`.toLowerCase()}
                    >
                      <td class="mono">{pub.data.year}</td>
                      <td>
                        <strong>{pub.data.title}</strong>
                        {pub.data.subtitle && <span class="sub-text"> — {pub.data.subtitle}</span>}
                      </td>
                      <td class="text-secondary">{pub.data.venue} {pub.data.volumeIssue ? `(${pub.data.volumeIssue})` : ''}</td>
                      <td class="mono-doi">{pub.data.doi || '—'}</td>
                      <td class="text-right">
                        <div class="row-actions">
                          <button
                            type="button"
                            class="study-btn study-btn--ledger study-btn--sm btn-table-edit"
                            data-edit-type="publications"
                            data-edit-id={pub.id}
                            title="Edit Article in Atelier"
                          >
                            ✎ Edit
                          </button>
                          <a href={`/publications/${pub.id}`} target="_blank" rel="noopener noreferrer" class="study-btn study-btn--ghost study-btn--sm btn-table-view" title="View Public Page">
                            ↗
                          </a>
                          <button
                            type="button"
                            class="study-btn study-btn--hazard study-btn--sm btn-table-delete"
                            data-delete-type="publications"
                            data-delete-id={pub.id}
                            data-delete-name={pub.data.title}
                            title="Delete Article"
                          >
                            ✕
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <!-- Search Zero State for Publications -->
            <div class="search-empty-state" id="empty-state-publications" hidden>
              <span class="empty-seal" aria-hidden="true">❦</span>
              <h4>No Manuscripts Found in Fascicle I</h4>
              <p class="empty-msg">No publications match "<span class="empty-query-label"></span>".</p>
              <div class="cross-fascicle-suggestions" id="cross-suggest-publications"></div>
              <button type="button" class="study-btn study-btn--ghost study-btn--sm btn-reset-search">Clear Search Filter</button>
            </div>
          </div>

          <!-- 2. Books Panel -->
          <div class="fascicle-panel" id="panel-books" data-panel-type="books" role="tabpanel" hidden>
            <!-- Tactile Pictographic Specimen Gallery for Books -->
            <div class="specimen-gallery" data-gallery-section="books">
              {books.map((b) => (
                <article
                  class="specimen-card specimen-card--monograph"
                  data-item-card={`books-${b.id}`}
                  data-search-text={`${b.data.year} ${b.data.title} ${b.data.subtitle || ''} ${b.data.publisher} ${b.data.isbn} ${b.data.synopsis || ''}`.toLowerCase()}
                  data-card-id={b.id}
                  data-card-type="books"
                  tabindex="0"
                  role="button"
                  aria-label={`Inspect monograph: ${b.data.title}`}
                >
                  <script type="application/json" class="specimen-payload" set:html={JSON.stringify({
                    type: 'books',
                    id: b.id,
                    title: b.data.title,
                    subtitle: b.data.subtitle || '',
                    year: b.data.year,
                    publisher: b.data.publisher,
                    isbn: b.data.isbn,
                    pages: b.data.pages,
                    coverImage: b.data.coverImage,
                    chapterCount: (b.data.chapters || []).length,
                    excerpt: b.data.synopsis || '',
                    publicUrl: '/#books'
                  })} />
                  
                  <div class="monograph-plate-layout">
                    <div class="monograph-cover-slot">
                      <img src={b.data.coverImage} alt={b.data.title} class="monograph-cover-art" loading="lazy" />
                      <span class="monograph-year-foil mono">{b.data.year}</span>
                      <button
                        type="button"
                        class="btn-cover-quick-edit"
                        data-action="edit-book-cover"
                        data-book-id={b.id}
                        data-book-title={b.data.title}
                        data-book-cover={b.data.coverImage}
                        title={`Adjust or replace cover for "${b.data.title}"`}
                      >
                        ✎ Cover
                      </button>
                    </div>
                    <div class="monograph-meta-slot">
                      <div class="card-eyebrow-line">
                        <span class="card-fleuron" aria-hidden="true">📖</span>
                        <span class="card-venue-tag">{b.data.publisher}</span>
                      </div>
                      <h4 class="card-main-title">{b.data.title}</h4>
                      {b.data.subtitle && <p class="card-sub-title">{b.data.subtitle}</p>}
                      <div class="card-footer-line">
                        <div class="card-chips-cluster">
                          <span class="specimen-chip mono">{b.data.pages}pp</span>
                          <span class="specimen-chip chip-mono">{b.data.isbn}</span>
                        </div>
                        <div class="card-hover-prompt">
                          <span class="prompt-icon">👁</span>
                          <span class="prompt-text">Inspect</span>
                        </div>
                        <button type="button" class="mobile-expand-btn" aria-expanded="false" aria-label="Toggle details">
                          <span class="expand-icon" aria-hidden="true">▾</span>
                        </button>
                      </div>
                    </div>
                  </div>

                  <!-- Collapsible Mobile Drawer for Books -->
                  <div class="card-collapsible-drawer">
                    {b.data.synopsis && (
                      <div class="card-drawer-extract">
                        <span class="drawer-kicker">SYNOPSIS</span>
                        <p class="drawer-text">{b.data.synopsis}</p>
                      </div>
                    )}
                    <div class="card-drawer-actions">
                      <button
                        type="button"
                        class="study-btn study-btn--ignite study-btn--sm btn-card-edit"
                        data-edit-type="books"
                        data-edit-id={b.id}
                      >
                        <span>✎ Edit in Atelier</span>
                      </button>
                      <button
                        type="button"
                        class="study-btn study-btn--ledger study-btn--sm btn-cover-quick-edit"
                        data-action="edit-book-cover"
                        data-book-id={b.id}
                        data-book-title={b.data.title}
                        data-book-cover={b.data.coverImage}
                      >
                        <span>🖼 Cover</span>
                      </button>
                      <a
                        href="/#books"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="study-btn study-btn--ghost study-btn--sm btn-card-view"
                      >
                        <span>↗ View</span>
                      </a>
                      <button
                        type="button"
                        class="study-btn study-btn--hazard study-btn--sm btn-card-delete"
                        data-delete-type="books"
                        data-delete-id={b.id}
                        data-delete-name={b.data.title}
                      >
                        <span>✕ Delete</span>
                      </button>
                    </div>
                  </div>
                </article>
              ))}
            </div>

            <div class="table-wrap">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th style="width: 80px;">Year</th>
                    <th style="width: 50px;">Cover</th>
                    <th>Title &amp; Subtitle</th>
                    <th>Publisher Imprint</th>
                    <th style="width: 140px;">ISBN</th>
                    <th class="text-right" style="width: 150px;">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {books.map((b) => (
                    <tr
                      data-item-row={`books-${b.id}`}
                      data-search-text={`${b.data.year} ${b.data.title} ${b.data.subtitle || ''} ${b.data.publisher} ${b.data.isbn} ${b.data.synopsis || ''}`.toLowerCase()}
                    >
                      <td class="mono">{b.data.year}</td>
                      <td>
                        <button
                          type="button"
                          class="mini-cover-thumb mini-cover-thumb--action"
                          data-action="edit-book-cover"
                          data-book-id={b.id}
                          data-book-title={b.data.title}
                          data-book-cover={b.data.coverImage}
                          title={`Click to adjust cover for "${b.data.title}"`}
                        >
                          <img src={b.data.coverImage} alt={b.data.title} class="mini-thumb-img" />
                          <span class="mini-thumb-overlay" aria-hidden="true">✎</span>
                        </button>
                      </td>
                      <td>
                        <strong>{b.data.title}</strong>
                        {b.data.subtitle && <span class="sub-text"> — {b.data.subtitle}</span>}
                      </td>
                      <td class="text-secondary">{b.data.publisher}</td>
                      <td class="mono-doi">{b.data.isbn}</td>
                      <td class="text-right">
                        <div class="row-actions">
                          <button
                            type="button"
                            class="study-btn study-btn--ledger study-btn--sm btn-table-edit"
                            data-edit-type="books"
                            data-edit-id={b.id}
                            title="Edit Monograph in Atelier"
                          >
                            ✎ Edit
                          </button>
                          <a href="/#books" target="_blank" rel="noopener noreferrer" class="study-btn study-btn--ghost study-btn--sm btn-table-view" title="View Public Page">
                            ↗
                          </a>
                          <button
                            type="button"
                            class="study-btn study-btn--hazard study-btn--sm btn-table-delete"
                            data-delete-type="books"
                            data-delete-id={b.id}
                            data-delete-name={b.data.title}
                            title="Delete Monograph"
                          >
                            ✕
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <!-- Search Zero State for Books -->
            <div class="search-empty-state" id="empty-state-books" hidden>
              <span class="empty-seal" aria-hidden="true">❦</span>
              <h4>No Monographs Found in Fascicle II</h4>
              <p class="empty-msg">No monograph volumes match "<span class="empty-query-label"></span>".</p>
              <div class="cross-fascicle-suggestions" id="cross-suggest-books"></div>
              <button type="button" class="study-btn study-btn--ghost study-btn--sm btn-reset-search">Clear Search Filter</button>
            </div>
          </div>

          <!-- 3. Classes Panel -->
          <div class="fascicle-panel" id="panel-classes" data-panel-type="classes" role="tabpanel" hidden>
            <!-- Tactile Pictographic Specimen Gallery for Classes -->
            <div class="specimen-gallery" data-gallery-section="classes">
              {classes.map((c) => (
                <article
                  class="specimen-card specimen-card--class"
                  data-item-card={`classes-${c.id}`}
                  data-search-text={`${c.data.courseCode} ${c.data.title} ${c.data.term} ${c.data.academicYear} ${c.data.level} ${c.data.schedule || ''} ${c.data.summary || ''}`.toLowerCase()}
                  data-card-id={c.id}
                  data-card-type="classes"
                  tabindex="0"
                  role="button"
                  aria-label={`Inspect syllabus: ${c.data.title}`}
                >
                  <script type="application/json" class="specimen-payload" set:html={JSON.stringify({
                    type: 'classes',
                    id: c.id,
                    courseCode: c.data.courseCode,
                    title: c.data.title,
                    term: c.data.term,
                    academicYear: c.data.academicYear,
                    level: c.data.level,
                    schedule: c.data.schedule || '',
                    syllabusPdf: c.data.syllabusPdf || '',
                    weekCount: (c.data.weeks || []).length,
                    excerpt: c.data.summary || '',
                    publicUrl: '/#classes'
                  })} />
                  
                  <div class="card-face">
                    <div class="card-eyebrow-line">
                      <span class="course-code-monogram mono">{c.data.courseCode}</span>
                      <span class="card-venue-tag">{c.data.term} ({c.data.academicYear})</span>
                      <span class="level-pill-mini">{c.data.level}</span>
                    </div>

                    <div class="card-body-lockup">
                      <h4 class="card-main-title">{c.data.title}</h4>
                    </div>

                    <div class="card-footer-line">
                      <div class="card-chips-cluster">
                        <span class="specimen-chip">{(c.data.weeks || []).length} Modules</span>
                        {c.data.syllabusPdf && <span class="specimen-chip chip-accent">📋 PDF</span>}
                      </div>
                      <div class="card-hover-prompt">
                        <span class="prompt-icon">👁</span>
                        <span class="prompt-text">Inspect</span>
                      </div>
                      <button type="button" class="mobile-expand-btn" aria-expanded="false" aria-label="Toggle details">
                        <span class="expand-icon" aria-hidden="true">▾</span>
                      </button>
                    </div>
                  </div>

                  <!-- Collapsible Mobile Drawer for Classes -->
                  <div class="card-collapsible-drawer">
                    {c.data.summary && (
                      <div class="card-drawer-extract">
                        <span class="drawer-kicker">COURSE OVERVIEW</span>
                        <p class="drawer-text">{c.data.summary}</p>
                      </div>
                    )}
                    {c.data.schedule && (
                      <div class="card-drawer-meta-row">
                        <span class="drawer-kicker">SCHEDULE:</span>
                        <span class="drawer-val mono">{c.data.schedule}</span>
                      </div>
                    )}
                    <div class="card-drawer-actions">
                      <button
                        type="button"
                        class="study-btn study-btn--ignite study-btn--sm btn-card-edit"
                        data-edit-type="classes"
                        data-edit-id={c.id}
                      >
                        <span>✎ Edit in Atelier</span>
                      </button>
                      <a
                        href="/#classes"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="study-btn study-btn--ghost study-btn--sm btn-card-view"
                      >
                        <span>↗ View</span>
                      </a>
                      <button
                        type="button"
                        class="study-btn study-btn--hazard study-btn--sm btn-card-delete"
                        data-delete-type="classes"
                        data-delete-id={c.id}
                        data-delete-name={c.data.title}
                      >
                        <span>✕ Delete</span>
                      </button>
                    </div>
                  </div>
                </article>
              ))}
            </div>

            <div class="table-wrap">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th style="width: 100px;">Code</th>
                    <th>Course Title</th>
                    <th>Term &amp; Year</th>
                    <th style="width: 120px;">Level</th>
                    <th class="text-right" style="width: 150px;">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {classes.map((c) => (
                    <tr
                      data-item-row={`classes-${c.id}`}
                      data-search-text={`${c.data.courseCode} ${c.data.title} ${c.data.term} ${c.data.academicYear} ${c.data.level} ${c.data.schedule || ''} ${c.data.summary || ''}`.toLowerCase()}
                    >
                      <td class="mono font-bold">{c.data.courseCode}</td>
                      <td><strong>{c.data.title}</strong></td>
                      <td class="text-secondary">{c.data.term} ({c.data.academicYear})</td>
                      <td><span class="level-pill">{c.data.level}</span></td>
                      <td class="text-right">
                        <div class="row-actions">
                          <button
                            type="button"
                            class="study-btn study-btn--ledger study-btn--sm btn-table-edit"
                            data-edit-type="classes"
                            data-edit-id={c.id}
                            title="Edit Syllabus in Atelier"
                          >
                            ✎ Edit
                          </button>
                          <a href="/#classes" target="_blank" rel="noopener noreferrer" class="study-btn study-btn--ghost study-btn--sm btn-table-view" title="View Public Page">
                            ↗
                          </a>
                          <button
                            type="button"
                            class="study-btn study-btn--hazard study-btn--sm btn-table-delete"
                            data-delete-type="classes"
                            data-delete-id={c.id}
                            data-delete-name={c.data.title}
                            title="Delete Seminar"
                          >
                            ✕
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <!-- Search Zero State for Classes -->
            <div class="search-empty-state" id="empty-state-classes" hidden>
              <span class="empty-seal" aria-hidden="true">❦</span>
              <h4>No Syllabi Found in Fascicle III</h4>
              <p class="empty-msg">No university courses match "<span class="empty-query-label"></span>".</p>
              <div class="cross-fascicle-suggestions" id="cross-suggest-classes"></div>
              <button type="button" class="study-btn study-btn--ghost study-btn--sm btn-reset-search">Clear Search Filter</button>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- ========================================================
         FLOATING COLOPHON INSPECTOR (HOVERABLE LOUPE HUD)
         ======================================================== -->
    <aside
      id="colophon-inspector-hud"
      class="colophon-inspector-hud"
      role="tooltip"
      aria-hidden="true"
      hidden
    >
      <div class="hud-inner">
        <div class="hud-eyebrow-row">
          <div class="hud-eyebrow-left">
            <span class="hud-seal" aria-hidden="true">❧</span>
            <span class="hud-kicker mono" id="hud-kicker">01 · PUBLICATION</span>
            <span class="hud-badge tabular" id="hud-year-badge">2024</span>
          </div>
          <span class="hud-status-chip" id="hud-status">PEER-REVIEWED</span>
        </div>

        <div class="hud-title-lockup">
          <h4 class="hud-title" id="hud-title">Title</h4>
          <p class="hud-subtitle" id="hud-subtitle"></p>
          <div class="hud-venue-meta" id="hud-venue-meta"></div>
        </div>

        <!-- Abstract / Synopsis Bookplate Frame -->
        <div class="hud-abstract-frame">
          <div class="hud-abstract-corner tl" aria-hidden="true">❦</div>
          <div class="hud-abstract-corner tr" aria-hidden="true">❦</div>
          <div class="hud-abstract-corner bl" aria-hidden="true">❦</div>
          <div class="hud-abstract-corner br" aria-hidden="true">❦</div>
          <span class="hud-abstract-kicker">SYNOPSIS · ARCHIVAL EXTRACT</span>
          <p class="hud-abstract-text" id="hud-abstract-text"></p>
        </div>

        <!-- Direct Actions Dock -->
        <div class="hud-actions-dock">
          <button type="button" class="study-btn study-btn--ignite study-btn--sm" id="hud-btn-edit">
            <span>✎ Edit in Atelier</span>
            <span class="btn-keycap">⌘E</span>
          </button>
          <a href="#" target="_blank" rel="noopener noreferrer" class="study-btn study-btn--ghost study-btn--sm" id="hud-link-view">
            <span>↗ Public View</span>
          </a>
          <button type="button" class="study-btn study-btn--hazard study-btn--sm" id="hud-btn-delete">
            <span>✕ Delete</span>
          </button>
        </div>
      </div>
    </aside>
  </div>

  <script>
    declare const notify: (message: string, status?: string) => void;
    declare const postAdmin: (url: string, payload: Record<string, any>) => Promise<any>;
    declare const confirmAction: (options: {
      title?: string;
      message?: string;
      itemName?: string;
      itemId?: string;
      itemType?: string;
      confirmLabel?: string;
      onConfirm: () => Promise<void> | void;
    }) => void;
    declare const openContentEditor: (options?: {
      type?: 'publications' | 'books' | 'classes';
      mode?: 'create' | 'edit';
      id?: string;
      focusIngest?: boolean;
      onSaved?: (item: any) => void;
    }) => void;

    // 1. Quick Ingest Launcher
    document.getElementById('btn-quick-ingest')?.addEventListener('click', () => {
      (window as any).openContentEditor?.({
        type: currentFascicle || 'publications',
        mode: 'create',
        focusIngest: true,
      });
    });

    // 2. Single 2-Way View Switcher (Tiles ⇄ Rows)
    const shelfPanelsWrap = document.getElementById('shelf-panels-wrap');
    const btnViewToggle2Way = document.getElementById('btn-view-toggle-2way');
    const segTiles = document.getElementById('seg-tiles');
    const segRows = document.getElementById('seg-rows');

    let currentLayoutMode: 'gallery' | 'table' = 'gallery';

    function setLayoutMode(mode: 'gallery' | 'table') {
      currentLayoutMode = mode;
      if (shelfPanelsWrap) {
        shelfPanelsWrap.classList.toggle('is-gallery-view', mode === 'gallery');
        shelfPanelsWrap.classList.toggle('is-table-view', mode === 'table');
      }

      if (btnViewToggle2Way) {
        btnViewToggle2Way.setAttribute('aria-checked', mode === 'table' ? 'true' : 'false');
      }
      segTiles?.classList.toggle('is-active', mode === 'gallery');
      segRows?.classList.toggle('is-active', mode === 'table');

      try {
        localStorage.setItem('drc_admin_ledger_view', mode);
      } catch {}
    }

    const savedLayoutMode = (localStorage.getItem('drc_admin_ledger_view') as any) || 'gallery';
    setLayoutMode(savedLayoutMode === 'table' ? 'table' : 'gallery');

    btnViewToggle2Way?.addEventListener('click', () => {
      setLayoutMode(currentLayoutMode === 'gallery' ? 'table' : 'gallery');
    });

    // 3. Fascicle Spine Navigation & Smart Lineage Arrow
    const fascicleTabs = document.querySelectorAll<HTMLButtonElement>('.fascicle-tab-btn');
    const fasciclePanels = document.querySelectorAll<HTMLElement>('.fascicle-panel');
    const smartLineageArrow = document.getElementById('smart-lineage-arrow');
    const fascicleSpineRail = document.getElementById('fascicle-spine-rail');
    const shelfKicker = document.getElementById('shelf-kicker');
    const shelfMainTitle = document.getElementById('shelf-main-title');
    const shelfCountPill = document.getElementById('shelf-count-pill');
    const shelfBtnAddLabel = document.getElementById('shelf-btn-add-label');
    const btnShelfContextAdd = document.getElementById('btn-shelf-context-add') as HTMLButtonElement | null;

    const fascicleMeta: Record<string, { kicker: string; title: string; addLabel: string }> = {
      publications: {
        kicker: 'FASCICLE I · ARTICLES & MANUSCRIPTS',
        title: 'Refereed Articles & Critical Essays',
        addLabel: 'New Article',
      },
      books: {
        kicker: 'FASCICLE II · AUTHORED MONOGRAPHS',
        title: 'Authored Academic Monographs',
        addLabel: 'New Monograph',
      },
      classes: {
        kicker: 'FASCICLE III · SEMINARS & SYLLABI',
        title: 'Pedagogical Syllabi & Curricula',
        addLabel: 'New Syllabus',
      },
    };

    let currentFascicle: 'publications' | 'books' | 'classes' = 'publications';

    function setFascicle(target: 'publications' | 'books' | 'classes') {
      currentFascicle = target;

      fascicleTabs.forEach((tab) => {
        const isTarget = tab.dataset.fascicleTarget === target;
        tab.classList.toggle('is-active', isTarget);
        tab.setAttribute('aria-selected', isTarget ? 'true' : 'false');
      });

      fasciclePanels.forEach((panel) => {
        const isTarget = panel.dataset.panelType === target;
        panel.classList.toggle('is-active', isTarget);
        panel.hidden = !isTarget;
      });

      const meta = fascicleMeta[target];
      if (meta) {
        if (shelfKicker) shelfKicker.textContent = meta.kicker;
        if (shelfMainTitle) shelfMainTitle.textContent = meta.title;
        if (shelfBtnAddLabel) shelfBtnAddLabel.textContent = meta.addLabel;
        if (btnShelfContextAdd) btnShelfContextAdd.dataset.activeFascicle = target;
      }

      // Update count pill for active panel
      const activePanel = document.getElementById(`panel-${target}`);
      const itemCount = activePanel?.querySelectorAll('.specimen-card').length || 0;
      if (shelfCountPill) {
        shelfCountPill.textContent = `${itemCount} RECORDS`;
      }

      const searchInput = document.getElementById('ledger-search-input') as HTMLInputElement | null;
      if (searchInput) {
        if (target === 'publications') {
          searchInput.placeholder = 'Filter publications by title, venue, DOI, co-author, abstract, year…';
        } else if (target === 'books') {
          searchInput.placeholder = 'Filter monographs by title, publisher, ISBN, synopsis, year…';
        } else {
          searchInput.placeholder = 'Filter syllabi by course code, title, term, level, summary…';
        }
      }

      try {
        localStorage.setItem('drc_admin_active_fascicle', target);
      } catch {}

      // Re-filter search if search input has active value
      executeContextAwareSearch();
    }

    fascicleTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.fascicleTarget as any;
        if (target) setFascicle(target);
      });
    });

    btnShelfContextAdd?.addEventListener('click', () => {
      (window as any).openContentEditor?.({ type: currentFascicle, mode: 'create' });
    });

    const savedFascicle = (localStorage.getItem('drc_admin_active_fascicle') as any) || 'publications';
    setFascicle(['publications', 'books', 'classes'].includes(savedFascicle) ? savedFascicle : 'publications');

    // 4. Shared Delete Logic
    function confirmDeleteItem(type: string, id: string, name: string) {
      (window as any).confirmAction?.({
        title: `Permanently Delete ${type === 'publications' ? 'Manuscript' : type === 'books' ? 'Monograph' : 'Seminar'}?`,
        message: `You are about to irreversibly purge "${name}" from ${type}. This action cannot be undone.`,
        itemName: name,
        itemId: id,
        itemType: type,
        confirmLabel: 'Confirm Permanent Delete',
        onConfirm: async () => {
          (window as any).notify?.(`Purging ${id} from ${type}…`, 'info');
          const res = await (window as any).postAdmin?.('/api/admin/content', {
            action: 'delete-content',
            type,
            id,
          });

          if (res?.ok) {
            (window as any).notify?.(res.message || `Deleted ${id}.`, 'success');
            const row = document.querySelector(`[data-item-row="${type}-${id}"]`);
            const card = document.querySelector(`[data-item-card="${type}-${id}"]`);
            if (row) {
              row.classList.add('row-deleted');
              setTimeout(() => row.remove(), 350);
            }
            if (card) {
              card.classList.add('card-deleted');
              setTimeout(() => {
                card.remove();
                // Update live count readout on spine rail and shelf header
                const activePanel = document.getElementById(`panel-${type}`);
                const remaining = activePanel?.querySelectorAll('.specimen-card').length || 0;
                const railCount = document.getElementById(`rail-count-${type}`);
                if (railCount) {
                  railCount.textContent = `${remaining} ${type === 'publications' ? 'Works' : type === 'books' ? 'Volumes' : 'Seminars'}`;
                }
                if (shelfCountPill && currentFascicle === type) {
                  shelfCountPill.textContent = `${remaining} RECORDS`;
                }
              }, 350);
            }
          } else {
            (window as any).notify?.(res?.error || 'Failed to delete record.', 'error');
          }
        },
      });
    }

    // 5. Edit Actions (Cards & Table Rows)
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.btn-table-edit, .btn-card-edit') as HTMLButtonElement | null;
      if (!btn) return;
      const type = btn.dataset.editType as any;
      const id = btn.dataset.editId;
      if (type && id) {
        (window as any).openContentEditor?.({
          type,
          id,
          mode: 'edit',
          onSaved: () => {
            setTimeout(() => window.location.reload(), 1000);
          },
        });
      }
    });

    // 5. Delete Actions from Table Rows & Mobile Cards
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.btn-table-delete, .btn-card-delete') as HTMLButtonElement | null;
      if (!btn) return;
      const type = btn.dataset.deleteType;
      const id = btn.dataset.deleteId;
      const name = btn.dataset.deleteName || id;
      if (type && id) {
        confirmDeleteItem(type, id, name);
      }
    });

    // 5b. Direct In-Situ Book Cover Adjustment
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-action="edit-book-cover"]') as HTMLElement | null;
      if (!btn) return;
      e.stopPropagation();
      e.preventDefault();

      const bookId = btn.dataset.bookId || '';
      const bookTitle = btn.dataset.bookTitle || 'Monograph';
      const currentCover = btn.dataset.bookCover || '';

      (window as any).openMediaCropper?.({
        aspect: 'book-cover',
        targetEntity: { type: 'book', id: bookId, title: bookTitle },
        title: `Adjust Cover: ${bookTitle}`,
        kicker: '02 · MONOGRAPH COVER ATELIER',
        initialImageUrl: currentCover,
        fileNameSlug: bookId,
        applyLabel: 'Save & Update Monograph Cover ✓',
        onApply: (res: any) => {
          if (res?.imageUrl) {
            const newSrc = `${res.imageUrl}?t=${Date.now()}`;
            document.querySelectorAll(`[data-item-card="books-${bookId}"] .monograph-cover-art, [data-item-row="books-${bookId}"] .mini-thumb-img`).forEach((img) => {
              (img as HTMLImageElement).src = newSrc;
            });
            document.querySelectorAll(`[data-book-id="${bookId}"]`).forEach((el) => {
              (el as HTMLElement).dataset.bookCover = res.imageUrl;
            });
          }
        },
      });
    });

    // 6. Floating Colophon Inspector HUD Controller
    const hud = document.getElementById('colophon-inspector-hud');
    const hudKicker = document.getElementById('hud-kicker');
    const hudYear = document.getElementById('hud-year-badge');
    const hudStatus = document.getElementById('hud-status');
    const hudTitle = document.getElementById('hud-title');
    const hudSubtitle = document.getElementById('hud-subtitle');
    const hudVenueMeta = document.getElementById('hud-venue-meta');
    const hudAbstractText = document.getElementById('hud-abstract-text');
    const hudBtnEdit = document.getElementById('hud-btn-edit');
    const hudLinkView = document.getElementById('hud-link-view') as HTMLAnchorElement | null;
    const hudBtnDelete = document.getElementById('hud-btn-delete');

    let hudOpenTimer: any = null;
    let hudCloseTimer: any = null;
    let currentPayload: any = null;

    function populateHud(data: any) {
      if (!hud) return;
      currentPayload = data;

      if (hudKicker) {
        if (data.type === 'publications') hudKicker.textContent = '01 · PUBLICATION';
        else if (data.type === 'books') hudKicker.textContent = '02 · MONOGRAPH';
        else hudKicker.textContent = '03 · CURRICULUM';
      }

      if (hudYear) {
        hudYear.textContent = String(data.year || data.academicYear || '2025');
      }

      if (hudStatus) {
        if (data.type === 'publications') hudStatus.textContent = 'PEER-REVIEWED';
        else if (data.type === 'books') hudStatus.textContent = `${data.chapterCount || 0} CHAPTERS`;
        else hudStatus.textContent = `${data.level || 'SEMINAR'} (${data.weekCount || 0} WKS)`;
      }

      if (hudTitle) hudTitle.textContent = data.title;
      if (hudSubtitle) {
        hudSubtitle.textContent = data.subtitle || '';
        hudSubtitle.hidden = !data.subtitle;
      }

      if (hudVenueMeta) {
        if (data.type === 'publications') {
          hudVenueMeta.textContent = `${data.venue} ${data.volumeIssue ? `· ${data.volumeIssue}` : ''}`;
        } else if (data.type === 'books') {
          hudVenueMeta.textContent = `${data.publisher} · ISBN: ${data.isbn} · ${data.pages} Pages`;
        } else {
          hudVenueMeta.textContent = `${data.courseCode} · ${data.term} (${data.academicYear}) · ${data.schedule || 'Ashoka University'}`;
        }
      }

      if (hudAbstractText) {
        hudAbstractText.textContent = data.excerpt || 'Archival synopsis recorded in sovereign faculty repository.';
      }

      if (hudLinkView) {
        hudLinkView.href = data.publicUrl || '/';
      }
    }

    function positionHud(card: HTMLElement) {
      if (!hud) return;
      const rect = card.getBoundingClientRect();
      const hudWidth = Math.min(460, window.innerWidth - 32);
      const hudHeight = 340;

      // Horizontal: prefer right of card, fallback to left
      let left = rect.right + 14;
      if (left + hudWidth > window.innerWidth - 16) {
        left = rect.left - hudWidth - 14;
      }
      if (left < 16) {
        left = Math.max(16, (window.innerWidth - hudWidth) / 2);
      }

      // Vertical: align with card top, clamp to viewport
      let top = rect.top;
      if (top + hudHeight > window.innerHeight - 16) {
        top = Math.max(16, window.innerHeight - hudHeight - 16);
      }
      if (top < 16) top = 16;

      hud.style.left = `${Math.round(left)}px`;
      hud.style.top = `${Math.round(top)}px`;
    }

    function showHud(card: HTMLElement) {
      const payloadEl = card.querySelector('.specimen-payload');
      if (!payloadEl) return;

      try {
        const data = JSON.parse(payloadEl.textContent || '{}');
        populateHud(data);
        positionHud(card);

        if (hud) {
          hud.hidden = false;
          hud.setAttribute('aria-hidden', 'false');
          requestAnimationFrame(() => {
            hud.classList.add('is-visible');
          });
        }
      } catch (err) {
        console.error('Failed to parse specimen payload', err);
      }
    }

    function hideHud() {
      if (!hud) return;
      hud.classList.remove('is-visible');
      setTimeout(() => {
        if (!hud.classList.contains('is-visible')) {
          hud.hidden = true;
          hud.setAttribute('aria-hidden', 'true');
        }
      }, 260);
    }

    // Attach hover listeners to all specimen cards
    document.querySelectorAll<HTMLElement>('.specimen-card').forEach((card) => {
      card.addEventListener('mouseenter', () => {
        clearTimeout(hudCloseTimer);
        clearTimeout(hudOpenTimer);
        hudOpenTimer = setTimeout(() => showHud(card), 140);
      });

      card.addEventListener('mouseleave', () => {
        clearTimeout(hudOpenTimer);
        hudCloseTimer = setTimeout(() => hideHud(), 180);
      });

      card.addEventListener('focus', () => {
        clearTimeout(hudCloseTimer);
        clearTimeout(hudOpenTimer);
        showHud(card);
      });

      card.addEventListener('blur', () => {
        clearTimeout(hudOpenTimer);
        hudCloseTimer = setTimeout(() => hideHud(), 180);
      });

      // Clicking card toggles accordion expansion on mobile, launches atelier edit on desktop
      card.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('button:not(.mobile-expand-btn), a, .btn-cover-quick-edit')) return;

        if (window.innerWidth <= 768 || target.closest('.mobile-expand-btn')) {
          e.stopPropagation();
          const isExpanded = card.classList.toggle('is-mobile-expanded');
          const toggleBtn = card.querySelector('.mobile-expand-btn');
          if (toggleBtn) {
            toggleBtn.setAttribute('aria-expanded', String(isExpanded));
          }
          return;
        }

        const type = card.dataset.cardType as any;
        const id = card.dataset.cardId;
        if (type && id) {
          hideHud();
          (window as any).openContentEditor?.({
            type,
            id,
            mode: 'edit',
            onSaved: () => setTimeout(() => window.location.reload(), 1000),
          });
        }
      });
    });

    // Keep HUD open when hovering directly inside it
    hud?.addEventListener('mouseenter', () => {
      clearTimeout(hudCloseTimer);
    });

    hud?.addEventListener('mouseleave', () => {
      hudCloseTimer = setTimeout(() => hideHud(), 180);
    });

    // Close HUD on scroll or escape
    window.addEventListener('scroll', () => hideHud(), { passive: true });
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') hideHud();
    });

    // HUD Actions
    hudBtnEdit?.addEventListener('click', () => {
      if (currentPayload) {
        hideHud();
        (window as any).openContentEditor?.({
          type: currentPayload.type,
          id: currentPayload.id,
          mode: 'edit',
          onSaved: () => setTimeout(() => window.location.reload(), 1000),
        });
      }
    });

    hudBtnDelete?.addEventListener('click', () => {
      if (currentPayload) {
        const { type, id, title } = currentPayload;
        hideHud();
        confirmDeleteItem(type, id, title);
      }
    });

    // 7. Smart Context-Aware Archival Search Engine (2-Pass Intelligence)
    function executeContextAwareSearch() {
      const searchInput = document.getElementById('ledger-search-input') as HTMLInputElement | null;
      const searchClearBtn = document.getElementById('btn-search-clear') as HTMLButtonElement | null;
      const searchReadout = document.getElementById('search-count-readout');
      const rawQ = (searchInput?.value || '').trim();
      const q = rawQ.toLowerCase();
      const tokens = q.split(/\s+/).filter(Boolean);

      if (searchClearBtn) {
        searchClearBtn.hidden = !rawQ;
      }

      const fascicleCounts: Record<string, { total: number; visible: number }> = {
        publications: { total: 0, visible: 0 },
        books: { total: 0, visible: 0 },
        classes: { total: 0, visible: 0 },
      };

      const fascicleTypes: Array<'publications' | 'books' | 'classes'> = ['publications', 'books', 'classes'];

      // --- PASS 1: Calculate matches & toggle visibility for all fascicles ---
      fascicleTypes.forEach((fType) => {
        const panel = document.getElementById(`panel-${fType}`);
        if (!panel) return;

        const cards = panel.querySelectorAll<HTMLElement>('.specimen-card');
        const rows = panel.querySelectorAll<HTMLElement>('[data-item-row]');

        fascicleCounts[fType].total = cards.length;
        let visibleInFascicle = 0;

        cards.forEach((card) => {
          const text = (card.dataset.searchText || '').toLowerCase();
          const match = tokens.length === 0 || tokens.every((tok) => text.includes(tok));

          card.classList.toggle('is-search-hidden', !match);
          card.hidden = !match;

          if (match) visibleInFascicle++;
        });

        rows.forEach((row) => {
          const text = (row.dataset.searchText || '').toLowerCase();
          const match = tokens.length === 0 || tokens.every((tok) => text.includes(tok));

          row.classList.toggle('is-search-hidden', !match);
          row.hidden = !match;
        });

        fascicleCounts[fType].visible = visibleInFascicle;
      });

      // --- PASS 2: Update UI, Rail Badges, Empty States, and Cross-Fascicle Banners ---
      fascicleTypes.forEach((fType) => {
        const visibleInFascicle = fascicleCounts[fType].visible;
        const totalInFascicle = fascicleCounts[fType].total;

        // Update rail count badge
        const railCount = document.getElementById(`rail-count-${fType}`);
        if (railCount) {
          if (tokens.length === 0) {
            const noun = fType === 'publications' ? 'Works' : fType === 'books' ? 'Volumes' : 'Seminars';
            railCount.textContent = `${totalInFascicle} ${noun}`;
            railCount.classList.remove('is-filtering');
          } else {
            railCount.textContent = `${visibleInFascicle} match${visibleInFascicle === 1 ? '' : 'es'}`;
            railCount.classList.add('is-filtering');
          }
        }

        // Handle Panel Empty State
        const emptyState = document.getElementById(`empty-state-${fType}`);
        const emptyQueryLabel = emptyState?.querySelector('.empty-query-label');
        const crossSuggest = document.getElementById(`cross-suggest-${fType}`);

        if (emptyState) {
          const showEmpty = tokens.length > 0 && visibleInFascicle === 0;
          emptyState.hidden = !showEmpty;
          emptyState.classList.toggle('is-hidden', !showEmpty);

          if (showEmpty) {
            if (emptyQueryLabel) emptyQueryLabel.textContent = rawQ;

            // Accurate cross-fascicle suggestions because Pass 1 has finished!
            if (crossSuggest) {
              const otherMatches = fascicleTypes
                .filter((other) => other !== fType && fascicleCounts[other].visible > 0)
                .map((other) => ({
                  type: other,
                  name: other === 'publications' ? 'Fascicle I: Publications' : other === 'books' ? 'Fascicle II: Monographs' : 'Fascicle III: Classes',
                  count: fascicleCounts[other].visible,
                }));

              if (otherMatches.length > 0) {
                crossSuggest.innerHTML = `
                  <div class="cross-match-banner">
                    <span class="cross-sparkle">✦</span>
                    <span>Found matching records in other fascicles:</span>
                    <div class="cross-pills">
                      ${otherMatches.map((m) => `
                        <button type="button" class="cross-jump-btn" data-jump-to="${m.type}">
                          <span>${m.name}</span>
                          <span class="jump-pill-count">${m.count}</span>
                          <span class="pill-arrow" aria-hidden="true">→</span>
                        </button>
                      `).join('')}
                    </div>
                  </div>
                `;
                crossSuggest.querySelectorAll<HTMLButtonElement>('.cross-jump-btn').forEach((btn) => {
                  btn.addEventListener('click', () => {
                    const jumpTarget = btn.dataset.jumpTo as any;
                    if (jumpTarget) setFascicle(jumpTarget);
                  });
                });
              } else {
                crossSuggest.innerHTML = '';
              }
            }
          }
        }
      });

      // --- PASS 3: Top Cross-Fascicle Discovery Strip for Active View ---
      const crossDiscoveryBar = document.getElementById('shelf-cross-discovery-bar');
      const crossDiscoveryInner = document.getElementById('cross-discovery-inner');

      if (crossDiscoveryBar && crossDiscoveryInner) {
        const otherMatchesForActive = fascicleTypes
          .filter((other) => other !== currentFascicle && fascicleCounts[other].visible > 0)
          .map((other) => ({
            type: other,
            name: other === 'publications' ? 'Fascicle I: Publications' : other === 'books' ? 'Fascicle II: Monographs' : 'Fascicle III: Classes',
            count: fascicleCounts[other].visible,
          }));

        if (tokens.length > 0 && otherMatchesForActive.length > 0) {
          crossDiscoveryBar.hidden = false;
          crossDiscoveryBar.classList.remove('is-hidden');
          crossDiscoveryInner.innerHTML = `
            <div class="cross-discovery-left">
              <span class="cross-seal">✦</span>
              <span>Search query "${rawQ}" also matches in other fascicles:</span>
            </div>
            <div class="cross-discovery-pills">
              ${otherMatchesForActive.map((m) => `
                <button type="button" class="cross-jump-pill" data-jump-to="${m.type}">
                  <span>${m.name}</span>
                  <span class="pill-num">${m.count}</span>
                  <span class="pill-arrow" aria-hidden="true">→</span>
                </button>
              `).join('')}
            </div>
          `;

          crossDiscoveryInner.querySelectorAll<HTMLButtonElement>('.cross-jump-pill').forEach((btn) => {
            btn.addEventListener('click', () => {
              const jumpTarget = btn.dataset.jumpTo as any;
              if (jumpTarget) setFascicle(jumpTarget);
            });
          });
        } else {
          crossDiscoveryBar.hidden = true;
          crossDiscoveryBar.classList.add('is-hidden');
          crossDiscoveryInner.innerHTML = '';
        }
      }

      // Shelf header pill & live count readout
      const activeStats = fascicleCounts[currentFascicle];
      if (shelfCountPill && activeStats) {
        if (tokens.length === 0) {
          shelfCountPill.textContent = `${activeStats.total} RECORDS`;
          shelfCountPill.classList.remove('pill-filtering');
        } else {
          shelfCountPill.textContent = `${activeStats.visible} of ${activeStats.total} MATCHES`;
          shelfCountPill.classList.add('pill-filtering');
        }
      }

      if (searchReadout && activeStats) {
        if (tokens.length === 0) {
          searchReadout.hidden = true;
        } else {
          searchReadout.textContent = `${activeStats.visible} match${activeStats.visible === 1 ? '' : 'es'}`;
          searchReadout.hidden = false;
        }
      }
    }

    const searchInputEl = document.getElementById('ledger-search-input') as HTMLInputElement | null;
    const searchClearBtnEl = document.getElementById('btn-search-clear');

    searchInputEl?.addEventListener('input', executeContextAwareSearch);

    function clearSearch() {
      if (searchInputEl) {
        searchInputEl.value = '';
        executeContextAwareSearch();
        searchInputEl.focus();
      }
    }

    searchClearBtnEl?.addEventListener('click', clearSearch);

    document.querySelectorAll('.btn-reset-search').forEach((btn) => {
      btn.addEventListener('click', clearSearch);
    });

    // 8. Sovereign Hotkeys (1: Publications, 2: Books, 3: Classes, V: Toggle View, / or ⌘K: Search)
    window.addEventListener('keydown', (e) => {
      const activeEl = document.activeElement;
      const tagName = (activeEl?.tagName || '').toLowerCase();
      const isInput = ['input', 'textarea', 'select'].includes(tagName) || (activeEl as HTMLElement)?.isContentEditable;

      // Escape while searching clears query
      if (e.key === 'Escape' && activeEl === searchInputEl) {
        clearSearch();
        searchInputEl?.blur();
        return;
      }

      // Quick focus search hotkey (/ or ⌘K)
      if ((e.key === '/' || (e.key === 'k' && (e.metaKey || e.ctrlKey))) && !isInput) {
        e.preventDefault();
        searchInputEl?.focus();
        searchInputEl?.select();
        return;
      }

      if (isInput) return;

      if (e.key === '1') {
        e.preventDefault();
        setFascicle('publications');
      } else if (e.key === '2') {
        e.preventDefault();
        setFascicle('books');
      } else if (e.key === '3') {
        e.preventDefault();
        setFascicle('classes');
      } else if (e.key === 'v' || e.key === 'V') {
        e.preventDefault();
        setLayoutMode(currentLayoutMode === 'gallery' ? 'table' : 'gallery');
      }
    });

    // 9. Listen for Content Update Events
    window.addEventListener('drc:content-updated', () => {
      setTimeout(() => window.location.reload(), 1200);
    });
  </script>
</AdminLayout>

