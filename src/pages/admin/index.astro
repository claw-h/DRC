---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';

const publications = (await getCollection('publications').catch(() => [])).sort((a, b) => b.data.year - a.data.year);
const books = (await getCollection('books').catch(() => [])).sort((a, b) => b.data.year - a.data.year);
const classes = await getCollection('classes').catch(() => []);
---

<AdminLayout title="Content & Classes Dispatch" activeModule="content">
  <div class="module-container">
    <div class="module-header">
      <div class="header-split">
        <div>
          <span class="module-kicker">MODULE 01 · ACADEMIC CONTENT ENGINE</span>
          <h2>Publications, Monographs & Curriculum Dispatch</h2>
          <p class="module-sub">
            Ingest manuscripts via Crossref DOI / BibTeX automation, author monographs, and publish university syllabi.
          </p>
        </div>
        <div class="telemetry-stats">
          <div class="stat-box">
            <span class="stat-number">{publications.length}</span>
            <span class="stat-label">Publications</span>
          </div>
          <div class="stat-box">
            <span class="stat-number">{books.length}</span>
            <span class="stat-label">Monographs</span>
          </div>
          <div class="stat-box">
            <span class="stat-number">{classes.length}</span>
            <span class="stat-label">Seminars</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Content Engine Navigation Switcher -->
    <div class="content-tab-bar" role="tablist" aria-label="Content Dispatch Types">
      <button type="button" class="tab-btn is-active" id="tab-btn-pubs" role="tab" aria-selected="true" aria-controls="tab-pubs">
        <span>01 · Papers & Manuscripts</span>
        <span class="badge-count">{publications.length}</span>
      </button>
      <button type="button" class="tab-btn" id="tab-btn-books" role="tab" aria-selected="false" aria-controls="tab-books">
        <span>02 · Books & Monographs</span>
        <span class="badge-count">{books.length}</span>
      </button>
      <button type="button" class="tab-btn" id="tab-btn-classes" role="tab" aria-selected="false" aria-controls="tab-classes">
        <span>03 · Courses & Syllabi</span>
        <span class="badge-count">{classes.length}</span>
      </button>
      <button type="button" class="tab-btn" id="tab-btn-ledger" role="tab" aria-selected="false" aria-controls="tab-ledger">
        <span>04 · Master Collections Ledger</span>
      </button>
    </div>

    <!-- TAB 1: Publications & Manuscripts -->
    <div id="tab-pubs" class="tab-content is-active" role="tabpanel" aria-labelledby="tab-btn-pubs">
      <div class="two-col-layout">
        <!-- Ingestion Hub -->
        <div class="panel-card">
          <div class="card-head">
            <span class="card-kicker">AUTOMATION HUB</span>
            <h3>One-Paste DOI & BibTeX Auto-Importer</h3>
            <p class="card-desc">Instantly populate publication metadata from Crossref REST APIs or BibTeX strings.</p>
          </div>

          <div class="importer-stack">
            <div class="input-action-row">
              <input
                type="text"
                id="doi-input"
                placeholder="Paste DOI (e.g. 10.1086/734192 or 10.5840/ipq2022…)"
                aria-label="DOI Input"
              />
              <button type="button" id="doi-fetch-btn" class="btn-accent">
                Resolve DOI
              </button>
            </div>

            <div class="bibtex-paste-box">
              <label for="bibtex-quick-paste" class="mini-label">Or paste BibTeX entry snippet:</label>
              <textarea
                id="bibtex-quick-paste"
                rows="3"
                placeholder="@article{cordry2024, author = {Cordry, Duncan R.}, title = {...}, year = {2024}}"
              ></textarea>
              <button type="button" id="bibtex-parse-btn" class="btn-outline-sm">
                Parse BibTeX →
              </button>
            </div>
          </div>
        </div>

        <!-- Publication Form -->
        <div class="panel-card">
          <div class="card-head">
            <span class="card-kicker">MANUSCRIPT SCHEMA</span>
            <h3>Publish Manuscript Record</h3>
          </div>

          <form id="pub-form" class="editor-form">
            <div class="form-row-2">
              <label>
                <span>Article Title *</span>
                <input type="text" name="title" id="pub-title" placeholder="e.g. Epistemic Horizons in..." required />
              </label>
              <label>
                <span>Publication Year *</span>
                <input type="number" name="year" id="pub-year" value="2026" required />
              </label>
            </div>

            <div class="form-row-2">
              <label>
                <span>Journal / Venue *</span>
                <input type="text" name="venue" id="pub-venue" placeholder="e.g. Journal of French and Francophone Philosophy" required />
              </label>
              <label>
                <span>Volume & Issue</span>
                <input type="text" name="volumeIssue" id="pub-volume" placeholder="e.g. Vol. 42, Issue 1" />
              </label>
            </div>

            <div class="form-row-2">
              <label>
                <span>DOI Identifier</span>
                <input type="text" name="doi" id="pub-doi" placeholder="e.g. 10.xxxx/yyyy" />
              </label>
              <label>
                <span>Co-Authors (comma-separated)</span>
                <input type="text" name="coAuthors" id="pub-authors" placeholder="e.g. Wynter, S., Stiegler, B." />
              </label>
            </div>

            <label>
              <span>PDF Asset Link / URL</span>
              <input type="text" name="pdfUrl" id="pub-pdf" placeholder="e.g. /papers/cordry-2026.pdf" />
            </label>

            <label>
              <span>Abstract / Executive Summary *</span>
              <textarea name="abstract" id="pub-abstract" rows="4" placeholder="Enter abstract…" required></textarea>
            </label>

            <label>
              <span>BibTeX Citation Code</span>
              <textarea name="citationBibtex" id="pub-bibtex" rows="3" class="mono-code" placeholder="BibTeX citation block…"></textarea>
            </label>

            <button type="submit" id="pub-submit-btn" class="btn-primary">
              Commit Manuscript to Content Layer
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- TAB 2: Books & Monographs -->
    <div id="tab-books" class="tab-content" role="tabpanel" aria-labelledby="tab-btn-books" hidden>
      <div class="panel-card max-w-form">
        <div class="card-head">
          <span class="card-kicker">MONOGRAPH ARCHIVE</span>
          <h3>Author Academic Monograph</h3>
          <p class="card-desc">Generates a validated Markdown record in <code>src/data/books/</code>.</p>
        </div>

        <form id="book-form" class="editor-form">
          <div class="form-row-2">
            <label>
              <span>Monograph Title *</span>
              <input type="text" name="title" id="book-title" placeholder="e.g. Technical Objects & Spiritual Practices" required />
            </label>
            <label>
              <span>Subtitle</span>
              <input type="text" name="subtitle" id="book-subtitle" placeholder="e.g. Organology, the Organic & Inorganic" />
            </label>
          </div>

          <div class="form-row-3">
            <label>
              <span>Publication Year *</span>
              <input type="number" name="year" id="book-year" value="2026" required />
            </label>
            <label>
              <span>Publisher Imprint *</span>
              <input type="text" name="publisher" id="book-publisher" value="Ashoka University · Philosophy Monograph" required />
            </label>
            <label>
              <span>ISBN / Catalog ID *</span>
              <input type="text" name="isbn" id="book-isbn" value="ASHOKA-PHIL-2026-DRC" required />
            </label>
          </div>

          <div class="form-row-2">
            <label>
              <span>Page Count</span>
              <input type="number" name="pages" id="book-pages" value="220" />
            </label>
            <label>
              <span>Cover Image Path</span>
              <input type="text" name="coverImage" id="book-cover" value="/images/books/celestial-mechanics.svg" />
            </label>
          </div>

          <label>
            <span>Monograph Synopsis *</span>
            <textarea name="synopsis" id="book-synopsis" rows="4" placeholder="Overview of the core thesis, philosophical lineages, and arguments…" required></textarea>
          </label>

          <!-- Chapters Builder -->
          <div class="repeater-section">
            <div class="repeater-head">
              <span class="mini-label">Monograph Chapters</span>
              <button type="button" id="add-chapter-btn" class="btn-outline-sm">+ Add Chapter</button>
            </div>
            <div id="chapters-container" class="repeater-list">
              <div class="repeater-item chapter-row">
                <input type="text" class="ch-num" placeholder="01" value="01" />
                <input type="text" class="ch-title" placeholder="Chapter Title" value="Between the Organic and the Inorganic" />
                <input type="text" class="ch-summary" placeholder="Summary statement" value="Investigates ontological continuity..." />
                <button type="button" class="btn-remove-row" title="Remove chapter">✕</button>
              </div>
            </div>
          </div>

          <button type="submit" id="book-submit-btn" class="btn-primary">
            Publish Monograph to Book Shelf
          </button>
        </form>
      </div>
    </div>

    <!-- TAB 3: Courses & Seminars -->
    <div id="tab-classes" class="tab-content" role="tabpanel" aria-labelledby="tab-btn-classes" hidden>
      <div class="panel-card max-w-form">
        <div class="card-head">
          <span class="card-kicker">CURRICULUM SUITE</span>
          <h3>Dispatch University Seminar Syllabus</h3>
          <p class="card-desc">Generates course schedules and weekly reading lists in <code>src/data/classes/</code>.</p>
        </div>

        <form id="class-form" class="editor-form">
          <div class="form-row-3">
            <label>
              <span>Course Code *</span>
              <input type="text" name="code" id="class-code" placeholder="e.g. PHIL 3070" required />
            </label>
            <label>
              <span>Academic Term *</span>
              <input type="text" name="term" id="class-term" value="Monsoon 2026" required />
            </label>
            <label>
              <span>Academic Year *</span>
              <input type="text" name="academicYear" id="class-year" value="2025–2026" required />
            </label>
          </div>

          <div class="form-row-2">
            <label>
              <span>Seminar Title *</span>
              <input type="text" name="title" id="class-title" placeholder="e.g. Continental Philosophy of Technology" required />
            </label>
            <label>
              <span>Level *</span>
              <select name="level" id="class-level" class="admin-select">
                <option value="Graduate">Graduate</option>
                <option value="Undergraduate">Undergraduate</option>
                <option value="Seminar" selected>Seminar</option>
              </select>
            </label>
          </div>

          <div class="form-row-2">
            <label>
              <span>Meeting Schedule / Room Location *</span>
              <input type="text" name="location" id="class-location" value="Ashoka University · Department of Philosophy" required />
            </label>
            <label>
              <span>Syllabus PDF Route</span>
              <input type="text" name="syllabusPdf" id="class-pdf" value="/cv" />
            </label>
          </div>

          <label>
            <span>Course Summary & Objectives *</span>
            <textarea name="description" id="class-desc" rows="4" placeholder="Course syllabus overview…" required></textarea>
          </label>

          <!-- Weekly Modules Builder -->
          <div class="repeater-section">
            <div class="repeater-head">
              <span class="mini-label">Syllabus Weekly Schedule</span>
              <button type="button" id="add-week-btn" class="btn-outline-sm">+ Add Week</button>
            </div>
            <div id="weeks-container" class="repeater-list">
              <div class="repeater-item week-row">
                <input type="text" class="wk-num" placeholder="WK 01" value="WK 01" />
                <input type="text" class="wk-topic" placeholder="Weekly Topic" value="Foundational Norms & Technics" />
                <textarea class="wk-readings" rows="2" placeholder="Readings (one per line)">Georges Canguilhem (1952), Machine and Organism&#10;André Leroi-Gourhan (1964), Gesture and Speech</textarea>
                <button type="button" class="btn-remove-row" title="Remove week">✕</button>
              </div>
            </div>
          </div>

          <button type="submit" id="class-submit-btn" class="btn-primary">
            Publish Seminar Syllabus
          </button>
        </form>
      </div>
    </div>

    <!-- TAB 4: Master Collections Ledger -->
    <div id="tab-ledger" class="tab-content" role="tabpanel" aria-labelledby="tab-btn-ledger" hidden>
      <div class="ledger-stack">
        <!-- Publications Ledger Table -->
        <div class="ledger-box">
          <div class="box-head">
            <span class="card-kicker">COLLECTION: PUBLICATIONS ({publications.length})</span>
            <h3>Manuscripts & Refereed Articles</h3>
          </div>
          <div class="table-wrap">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Year</th>
                  <th>Title</th>
                  <th>Venue</th>
                  <th>DOI</th>
                  <th class="text-right">Actions</th>
                </tr>
              </thead>
              <tbody>
                {publications.map((pub) => (
                  <tr data-item-row={`publications-${pub.id}`}>
                    <td class="mono">{pub.data.year}</td>
                    <td>
                      <strong>{pub.data.title}</strong>
                      {pub.data.subtitle && <span class="sub-text"> — {pub.data.subtitle}</span>}
                    </td>
                    <td class="text-secondary">{pub.data.venue}</td>
                    <td class="mono-doi">{pub.data.doi || '—'}</td>
                    <td class="text-right">
                      <div class="row-actions">
                        <a href={`/publications/${pub.id}`} target="_blank" rel="noopener noreferrer" class="btn-table-view">
                          View ↗
                        </a>
                        <button
                          type="button"
                          class="btn-table-delete"
                          data-delete-type="publications"
                          data-delete-id={pub.id}
                          data-delete-name={pub.data.title}
                        >
                          ✕
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Books Ledger Table -->
        <div class="ledger-box">
          <div class="box-head">
            <span class="card-kicker">COLLECTION: BOOKS ({books.length})</span>
            <h3>Authored Monographs</h3>
          </div>
          <div class="table-wrap">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Year</th>
                  <th>Title</th>
                  <th>Publisher</th>
                  <th>ISBN</th>
                  <th class="text-right">Actions</th>
                </tr>
              </thead>
              <tbody>
                {books.map((b) => (
                  <tr data-item-row={`books-${b.id}`}>
                    <td class="mono">{b.data.year}</td>
                    <td>
                      <strong>{b.data.title}</strong>
                      {b.data.subtitle && <span class="sub-text"> — {b.data.subtitle}</span>}
                    </td>
                    <td class="text-secondary">{b.data.publisher}</td>
                    <td class="mono-doi">{b.data.isbn}</td>
                    <td class="text-right">
                      <div class="row-actions">
                        <a href="/#books" target="_blank" rel="noopener noreferrer" class="btn-table-view">
                          View ↗
                        </a>
                        <button
                          type="button"
                          class="btn-table-delete"
                          data-delete-type="books"
                          data-delete-id={b.id}
                          data-delete-name={b.data.title}
                        >
                          ✕
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Classes Ledger Table -->
        <div class="ledger-box">
          <div class="box-head">
            <span class="card-kicker">COLLECTION: CLASSES ({classes.length})</span>
            <h3>University Courses & Seminars</h3>
          </div>
          <div class="table-wrap">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Code</th>
                  <th>Title</th>
                  <th>Term</th>
                  <th>Level</th>
                  <th class="text-right">Actions</th>
                </tr>
              </thead>
              <tbody>
                {classes.map((c) => (
                  <tr data-item-row={`classes-${c.id}`}>
                    <td class="mono font-bold">{c.data.courseCode}</td>
                    <td><strong>{c.data.title}</strong></td>
                    <td class="text-secondary">{c.data.term} ({c.data.academicYear})</td>
                    <td><span class="level-pill">{c.data.level}</span></td>
                    <td class="text-right">
                      <div class="row-actions">
                        <a href="/#classes" target="_blank" rel="noopener noreferrer" class="btn-table-view">
                          View ↗
                        </a>
                        <button
                          type="button"
                          class="btn-table-delete"
                          data-delete-type="classes"
                          data-delete-id={c.id}
                          data-delete-name={c.data.title}
                        >
                          ✕
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    declare const notify: (message: string, status?: string) => void;
    declare const postAdmin: (url: string, payload: Record<string, any>) => Promise<any>;

    // 1. Content Tab Bar Navigation
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.content-tab-bar .tab-btn');
    const tabContents = document.querySelectorAll<HTMLElement>('.tab-content');

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('aria-controls');
        if (!targetId) return;

        tabBtns.forEach((b) => {
          b.classList.remove('is-active');
          b.setAttribute('aria-selected', 'false');
        });
        tabContents.forEach((c) => {
          c.classList.remove('is-active');
          c.hidden = true;
        });

        btn.classList.add('is-active');
        btn.setAttribute('aria-selected', 'true');
        const targetEl = document.getElementById(targetId);
        if (targetEl) {
          targetEl.classList.add('is-active');
          targetEl.hidden = false;
        }
      });
    });

    // 2. DOI Auto-Populate Resolver
    const doiBtn = document.getElementById('doi-fetch-btn') as HTMLButtonElement | null;
    doiBtn?.addEventListener('click', async () => {
      const doiInput = document.getElementById('doi-input') as HTMLInputElement | null;
      const doi = doiInput?.value.trim() || '';
      if (!doi) {
        notify('Please enter a valid DOI.', 'warn');
        doiInput?.focus();
        return;
      }

      if (doiBtn) {
        doiBtn.disabled = true;
        doiBtn.textContent = 'Resolving…';
      }

      notify('Querying Crossref metadata index…', 'info');
      const data = await postAdmin('/api/admin/content', {
        action: 'import-doi',
        doi,
      });

      if (doiBtn) {
        doiBtn.disabled = false;
        doiBtn.textContent = 'Resolve DOI';
      }

      if (data.ok && data.metadata) {
        const m = data.metadata;
        (document.getElementById('pub-title') as HTMLInputElement).value = m.title || '';
        (document.getElementById('pub-year') as HTMLInputElement).value = String(m.year || 2026);
        (document.getElementById('pub-venue') as HTMLInputElement).value = m.venue || '';
        (document.getElementById('pub-doi') as HTMLInputElement).value = m.doi || '';
        (document.getElementById('pub-volume') as HTMLInputElement).value = m.volumeIssue || '';
        (document.getElementById('pub-authors') as HTMLInputElement).value = (m.coAuthors || []).join(', ');
        (document.getElementById('pub-abstract') as HTMLTextAreaElement).value = m.abstract || '';
        (document.getElementById('pub-bibtex') as HTMLTextAreaElement).value = m.citationBibtex || '';
        notify(`Resolved metadata: "${m.title}"`, 'success');
      } else {
        notify(data.error || 'Failed to resolve DOI.', 'error');
      }
    });

    // 3. BibTeX Parser Quick Import
    document.getElementById('bibtex-parse-btn')?.addEventListener('click', async () => {
      const textarea = document.getElementById('bibtex-quick-paste') as HTMLTextAreaElement | null;
      const rawBib = textarea?.value.trim() || '';
      if (!rawBib) {
        notify('Please paste BibTeX code first.', 'warn');
        textarea?.focus();
        return;
      }

      notify('Parsing BibTeX snippet…', 'info');
      const data = await postAdmin('/api/admin/content', {
        action: 'parse-bibtex',
        bibtex: rawBib,
      });

      if (data.ok && data.metadata) {
        const m = data.metadata;
        (document.getElementById('pub-title') as HTMLInputElement).value = m.title || '';
        (document.getElementById('pub-year') as HTMLInputElement).value = String(m.year || 2026);
        (document.getElementById('pub-venue') as HTMLInputElement).value = m.venue || '';
        (document.getElementById('pub-doi') as HTMLInputElement).value = m.doi || '';
        (document.getElementById('pub-volume') as HTMLInputElement).value = m.volumeIssue || '';
        (document.getElementById('pub-authors') as HTMLInputElement).value = (m.coAuthors || []).join(', ');
        (document.getElementById('pub-abstract') as HTMLTextAreaElement).value = m.abstract || '';
        (document.getElementById('pub-bibtex') as HTMLTextAreaElement).value = m.citationBibtex || rawBib;
        notify('Parsed BibTeX fields into form.', 'success');
      } else {
        notify(data.error || 'Unable to parse BibTeX.', 'error');
      }
    });

    // 4. Submit Publication
    document.getElementById('pub-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.currentTarget as HTMLFormElement;
      const submitBtn = document.getElementById('pub-submit-btn') as HTMLButtonElement | null;
      if (submitBtn) submitBtn.disabled = true;

      const fd = new FormData(form);
      notify('Writing manuscript markdown to src/data/publications/…', 'info');

      const data = await postAdmin('/api/admin/content', {
        action: 'create-publication',
        title: fd.get('title'),
        year: fd.get('year'),
        venue: fd.get('venue'),
        volumeIssue: fd.get('volumeIssue'),
        doi: fd.get('doi'),
        coAuthors: fd.get('coAuthors'),
        pdfUrl: fd.get('pdfUrl'),
        abstract: fd.get('abstract'),
        citationBibtex: fd.get('citationBibtex'),
      });

      if (submitBtn) submitBtn.disabled = false;
      if (data.ok) {
        notify(data.message || 'Committed publication successfully.', 'success');
        form.reset();
        setTimeout(() => window.location.reload(), 1200);
      } else {
        notify(data.error || 'Failed to save publication.', 'error');
      }
    });

    // 5. Dynamic Chapter Repeater
    document.getElementById('add-chapter-btn')?.addEventListener('click', () => {
      const container = document.getElementById('chapters-container');
      if (!container) return;
      const count = container.querySelectorAll('.chapter-row').length + 1;
      const numStr = String(count).padStart(2, '0');

      const row = document.createElement('div');
      row.className = 'repeater-item chapter-row';
      row.innerHTML = `
        <input type="text" class="ch-num" placeholder="${numStr}" value="${numStr}" />
        <input type="text" class="ch-title" placeholder="Chapter Title" />
        <input type="text" class="ch-summary" placeholder="Summary statement" />
        <button type="button" class="btn-remove-row" title="Remove chapter">✕</button>
      `;
      container.appendChild(row);
      (row.querySelector('.ch-title') as HTMLInputElement)?.focus();
    });

    // 6. Submit Book
    document.getElementById('book-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.currentTarget as HTMLFormElement;
      const submitBtn = document.getElementById('book-submit-btn') as HTMLButtonElement | null;
      if (submitBtn) submitBtn.disabled = true;

      const fd = new FormData(form);
      const chapterRows = document.querySelectorAll<HTMLElement>('.chapter-row');
      const chapters: Array<{ number: string; title: string; summary: string }> = [];

      chapterRows.forEach((row) => {
        const num = (row.querySelector('.ch-num') as HTMLInputElement)?.value || '';
        const title = (row.querySelector('.ch-title') as HTMLInputElement)?.value || '';
        const summary = (row.querySelector('.ch-summary') as HTMLInputElement)?.value || '';
        if (title.trim()) chapters.push({ number: num, title, summary });
      });

      notify('Writing monograph to src/data/books/…', 'info');
      const data = await postAdmin('/api/admin/content', {
        action: 'create-book',
        title: fd.get('title'),
        subtitle: fd.get('subtitle'),
        year: fd.get('year'),
        publisher: fd.get('publisher'),
        isbn: fd.get('isbn'),
        pages: fd.get('pages'),
        coverImage: fd.get('coverImage'),
        synopsis: fd.get('synopsis'),
        chapters,
      });

      if (submitBtn) submitBtn.disabled = false;
      if (data.ok) {
        notify(data.message || 'Published monograph successfully.', 'success');
        form.reset();
        setTimeout(() => window.location.reload(), 1200);
      } else {
        notify(data.error || 'Failed to save monograph.', 'error');
      }
    });

    // 7. Dynamic Week Repeater
    document.getElementById('add-week-btn')?.addEventListener('click', () => {
      const container = document.getElementById('weeks-container');
      if (!container) return;
      const count = container.querySelectorAll('.week-row').length + 1;
      const numStr = `WK ${String(count).padStart(2, '0')}`;

      const row = document.createElement('div');
      row.className = 'repeater-item week-row';
      row.innerHTML = `
        <input type="text" class="wk-num" placeholder="${numStr}" value="${numStr}" />
        <input type="text" class="wk-topic" placeholder="Weekly Topic" />
        <textarea class="wk-readings" rows="2" placeholder="Readings (one per line)"></textarea>
        <button type="button" class="btn-remove-row" title="Remove week">✕</button>
      `;
      container.appendChild(row);
      (row.querySelector('.wk-topic') as HTMLInputElement)?.focus();
    });

    // Generic row deletion in repeaters
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.btn-remove-row');
      if (btn) btn.closest('.repeater-item')?.remove();
    });

    // 8. Submit Class
    document.getElementById('class-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.currentTarget as HTMLFormElement;
      const submitBtn = document.getElementById('class-submit-btn') as HTMLButtonElement | null;
      if (submitBtn) submitBtn.disabled = true;

      const fd = new FormData(form);
      const weekRows = document.querySelectorAll<HTMLElement>('.week-row');
      const weeks: Array<{ weekNumber: string; topic: string; readings: string[] }> = [];

      weekRows.forEach((row) => {
        const wkNum = (row.querySelector('.wk-num') as HTMLInputElement)?.value || '';
        const topic = (row.querySelector('.wk-topic') as HTMLInputElement)?.value || '';
        const readingsRaw = (row.querySelector('.wk-readings') as HTMLTextAreaElement)?.value || '';
        const readings = readingsRaw.split('\n').map((r) => r.trim()).filter(Boolean);
        if (topic.trim()) weeks.push({ weekNumber: wkNum, topic, readings });
      });

      notify('Writing seminar syllabus to src/data/classes/…', 'info');
      const data = await postAdmin('/api/admin/content', {
        action: 'create-class',
        code: fd.get('code'),
        term: fd.get('term'),
        academicYear: fd.get('academicYear'),
        title: fd.get('title'),
        level: fd.get('level'),
        location: fd.get('location'),
        syllabusPdf: fd.get('syllabusPdf'),
        description: fd.get('description'),
        weeks,
      });

      if (submitBtn) submitBtn.disabled = false;
      if (data.ok) {
        notify(data.message || 'Published course syllabus successfully.', 'success');
        form.reset();
        setTimeout(() => window.location.reload(), 1200);
      } else {
        notify(data.error || 'Failed to save course.', 'error');
      }
    });

    // 9. Prune & Delete Content Rows
    document.querySelectorAll<HTMLButtonElement>('[data-delete-type]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const type = btn.dataset.deleteType;
        const id = btn.dataset.deleteId;
        const name = btn.dataset.deleteName || id;
        if (!type || !id) return;

        if (!confirm(`Are you sure you want to permanently delete "${name}" from ${type}?`)) {
          return;
        }

        btn.disabled = true;
        btn.textContent = '…';
        notify(`Deleting ${id} from ${type}…`, 'info');

        const data = await postAdmin('/api/admin/content', {
          action: 'delete-content',
          type,
          id,
        });

        if (data.ok) {
          notify(data.message || `Deleted ${id}.`, 'success');
          document.querySelector(`[data-item-row="${type}-${id}"]`)?.remove();
        } else {
          btn.disabled = false;
          btn.textContent = '✕';
          notify(data.error || 'Failed to delete record.', 'error');
        }
      });
    });
  </script>
</AdminLayout>

