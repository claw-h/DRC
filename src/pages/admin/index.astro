---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';

const publications = await getCollection('publications').catch(() => []);
const classes = await getCollection('classes').catch(() => []);
---

<AdminLayout title="Content & Classes Dispatch" activeModule="content">
  <div class="module-container">
    <div class="module-header">
      <span class="module-kicker">MODULE 01 · ARCHIVAL INGESTION & DISPATCH</span>
      <h2>Manuscript Publisher & Curriculum Dispatch</h2>
      <p class="module-sub">
        Ingest academic papers via Crossref DOI automation and publish university seminars directly into Astro Content Collections.
      </p>
    </div>

    <div class="admin-grid">
      <!-- Section A: One-Paste DOI Importer & Manuscript Form -->
      <section class="admin-panel" aria-labelledby="panel-doi">
        <div class="panel-head">
          <span class="panel-kicker">AUTOMATION · ONE-PASTE DOI INGESTION</span>
          <h3 id="panel-doi">Crossref Metadata Ingestion & Paper Dispatch</h3>
        </div>

        <div class="doi-bar">
          <input
            type="text"
            id="doi-input"
            placeholder="Paste DOI (e.g. 10.1086/734192 or 10.5840/ipq2022…)"
            aria-label="Digital Object Identifier"
          />
          <button type="button" id="doi-fetch-btn" class="btn-accent">
            Auto-Populate via Crossref
          </button>
        </div>

        <form id="pub-create-form" class="admin-form">
          <div class="form-row-2">
            <label>
              <span>Manuscript Title</span>
              <input type="text" name="title" id="pub-title" placeholder="e.g. The Architecture of Technical Memory" required />
            </label>
            <label>
              <span>Publication Year</span>
              <input type="number" name="year" id="pub-year" value="2026" required />
            </label>
          </div>

          <div class="form-row-2">
            <label>
              <span>Journal / Conference Venue</span>
              <input type="text" name="venue" id="pub-venue" placeholder="e.g. Journal of French and Francophone Philosophy" required />
            </label>
            <label>
              <span>DOI Identifier</span>
              <input type="text" name="doi" id="pub-doi" placeholder="10.xxxx/yyyy" />
            </label>
          </div>

          <label>
            <span>Abstract / Summary</span>
            <textarea name="abstract" id="pub-abstract" rows="4" placeholder="Enter academic abstract…" required></textarea>
          </label>

          <button type="submit" id="pub-submit-btn" class="btn-primary">
            Commit Manuscript to Content Collection
          </button>
        </form>
      </section>

      <!-- Section B: Seminar & Course Dispatch -->
      <section class="admin-panel" aria-labelledby="panel-classes">
        <div class="panel-head">
          <span class="panel-kicker">CURRICULUM · SYLLABUS DISPATCH</span>
          <h3 id="panel-classes">Add University Seminar / Course</h3>
        </div>

        <form id="class-create-form" class="admin-form">
          <div class="form-row-2">
            <label>
              <span>Course Code</span>
              <input type="text" name="code" placeholder="e.g. PHIL 3070" required />
            </label>
            <label>
              <span>Academic Term</span>
              <input type="text" name="term" value="Monsoon 2026" required />
            </label>
          </div>

          <div class="form-row-2">
            <label>
              <span>Course Title</span>
              <input type="text" name="title" placeholder="e.g. Continental Philosophies of Technology" required />
            </label>
            <label>
              <span>Level</span>
              <select name="level" class="admin-select">
                <option value="Graduate">Graduate</option>
                <option value="Undergraduate">Undergraduate</option>
                <option value="Seminar">Seminar</option>
              </select>
            </label>
          </div>

          <label>
            <span>Lecture Hall / Institution Location</span>
            <input type="text" name="location" value="Ashoka University · Department of Philosophy" required />
          </label>

          <label>
            <span>Syllabus Synopsis</span>
            <textarea name="description" rows="4" placeholder="Course overview and foundational themes…" required></textarea>
          </label>

          <button type="submit" id="class-submit-btn" class="btn-primary">
            Publish Course to Academic Interface
          </button>
        </form>
      </section>
    </div>

    <!-- Section C: Active Collection Ledger -->
    <div class="ledger-section">
      <div class="ledger-header">
        <span class="panel-kicker">COLLECTIONS LEDGER</span>
        <h3>Currently Live Records in Sovereign Archive</h3>
      </div>

      <div class="ledger-grid">
        <!-- Publications Ledger -->
        <div class="ledger-card">
          <h4 class="ledger-title">Publications ({publications.length})</h4>
          <ul class="ledger-list">
            {publications.map((pub) => (
              <li class="ledger-item">
                <span class="ledger-year">{pub.data.year}</span>
                <div class="ledger-info">
                  <strong>{pub.data.title}</strong>
                  <span class="ledger-venue">{pub.data.venue}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <!-- Classes Ledger -->
        <div class="ledger-card">
          <h4 class="ledger-title">Courses & Seminars ({classes.length})</h4>
          <ul class="ledger-list">
            {classes.map((cls) => (
              <li class="ledger-item">
                <span class="ledger-code">{cls.data.courseCode}</span>
                <div class="ledger-info">
                  <strong>{cls.data.title}</strong>
                  <span class="ledger-term">{cls.data.term} · {cls.data.level}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>

  <script>
    declare const notify: (message: string, status?: string) => void;
    declare const postAdmin: (url: string, payload: Record<string, any>) => Promise<any>;

    // 1. One-Paste DOI Importer
    const fetchBtn = document.getElementById('doi-fetch-btn') as HTMLButtonElement | null;
    fetchBtn?.addEventListener('click', async () => {
      const doiInput = document.getElementById('doi-input') as HTMLInputElement | null;
      const doi = doiInput?.value.trim() || '';
      if (!doi) {
        notify('Please enter a valid DOI.', 'warn');
        doiInput?.focus();
        return;
      }

      if (fetchBtn) {
        fetchBtn.disabled = true;
        fetchBtn.textContent = 'Resolving via Crossref…';
      }

      notify('Querying Crossref metadata registry…', 'info');
      const data = await postAdmin('/api/admin/content', {
        action: 'import-doi',
        doi,
      });

      if (fetchBtn) {
        fetchBtn.disabled = false;
        fetchBtn.textContent = 'Auto-Populate via Crossref';
      }

      if (data.ok && data.metadata) {
        (document.getElementById('pub-title') as HTMLInputElement).value = data.metadata.title;
        (document.getElementById('pub-year') as HTMLInputElement).value = String(data.metadata.year);
        (document.getElementById('pub-venue') as HTMLInputElement).value = data.metadata.venue;
        (document.getElementById('pub-doi') as HTMLInputElement).value = data.metadata.doi;
        notify(`Imported metadata: "${data.metadata.title}"`, 'success');
      } else {
        notify(data.error || 'Could not resolve DOI from Crossref.', 'error');
      }
    });

    // 2. Commit Publication
    document.getElementById('pub-create-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.currentTarget as HTMLFormElement;
      const submitBtn = document.getElementById('pub-submit-btn') as HTMLButtonElement | null;
      if (submitBtn) submitBtn.disabled = true;

      const fd = new FormData(form);
      notify('Writing manuscript markdown to src/data/publications/…', 'info');

      const data = await postAdmin('/api/admin/content', {
        action: 'create-publication',
        title: fd.get('title'),
        year: fd.get('year'),
        venue: fd.get('venue'),
        doi: fd.get('doi'),
        abstract: fd.get('abstract'),
      });

      if (submitBtn) submitBtn.disabled = false;

      if (data.ok) {
        notify(data.message || 'Manuscript committed to collection!', 'success');
        form.reset();
        setTimeout(() => window.location.reload(), 1500);
      } else {
        notify(data.error || 'Failed to save publication.', 'error');
      }
    });

    // 3. Dispatch Class
    document.getElementById('class-create-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.currentTarget as HTMLFormElement;
      const submitBtn = document.getElementById('class-submit-btn') as HTMLButtonElement | null;
      if (submitBtn) submitBtn.disabled = true;

      const fd = new FormData(form);
      notify('Writing course markdown to src/data/classes/…', 'info');

      const data = await postAdmin('/api/admin/content', {
        action: 'create-class',
        code: fd.get('code'),
        term: fd.get('term'),
        title: fd.get('title'),
        level: fd.get('level'),
        location: fd.get('location'),
        description: fd.get('description'),
      });

      if (submitBtn) submitBtn.disabled = false;

      if (data.ok) {
        notify(data.message || 'Course published to collection!', 'success');
        form.reset();
        setTimeout(() => window.location.reload(), 1500);
      } else {
        notify(data.error || 'Failed to save class.', 'error');
      }
    });
  </script>
</AdminLayout>

<style>
  .module-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .module-header {
    border-bottom: 1px solid var(--border-hairline);
    padding-bottom: 1rem;
  }

  .module-kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--accent);
  }

  .module-header h2 {
    margin: 0.25rem 0 0.25rem;
    font-size: var(--step-1);
    font-weight: 500;
  }

  .module-sub {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .admin-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 540px), 1fr));
    gap: 1.5rem;
  }

  .admin-panel {
    padding: 1.5rem;
    border-radius: 0.75rem;
    border: 1px solid var(--border-hairline);
    background: var(--bg-elevated);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .panel-head h3 {
    margin: 0.25rem 0 0;
    font-size: 1.05rem;
    font-weight: 500;
  }

  .doi-bar {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .doi-bar input {
    flex: 1;
    min-width: 220px;
    padding: 0.6rem 0.8rem;
    border-radius: 0.375rem;
    border: 1px solid var(--border-hairline);
    background: var(--bg-canvas);
    color: var(--text-primary);
    font-family: inherit;
    font-size: 0.85rem;
  }

  .doi-bar input:focus {
    outline: none;
    border-color: var(--accent);
  }

  .btn-accent {
    padding: 0.6rem 0.95rem;
    border-radius: 0.375rem;
    background: color-mix(in oklch, var(--accent) 18%, var(--bg-surface));
    border: 1px solid var(--accent);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.18s ease;
    white-space: nowrap;
  }

  .btn-accent:hover {
    background: var(--accent);
    color: var(--bg-canvas);
  }

  .admin-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-row-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.85rem;
  }

  .admin-form label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
  }

  .admin-form input,
  .admin-form textarea,
  .admin-select {
    padding: 0.6rem 0.8rem;
    border-radius: 0.375rem;
    border: 1px solid var(--border-hairline);
    background: var(--bg-canvas);
    color: var(--text-primary);
    font-family: inherit;
    font-size: 0.88rem;
  }

  .admin-form input:focus,
  .admin-form textarea:focus,
  .admin-select:focus {
    outline: none;
    border-color: var(--accent);
  }

  .btn-primary {
    padding: 0.75rem 1.25rem;
    border-radius: 0.375rem;
    border: 1px solid var(--accent);
    background: color-mix(in oklch, var(--accent) 18%, var(--bg-surface));
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.18s ease;
    margin-top: 0.35rem;
  }

  .btn-primary:hover {
    background: var(--accent);
    color: var(--bg-canvas);
  }

  /* Collections Ledger */
  .ledger-section {
    padding: 1.5rem;
    border-radius: 0.75rem;
    border: 1px solid var(--border-hairline);
    background: var(--bg-surface);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .ledger-header h3 {
    margin: 0.2rem 0 0;
    font-size: 1.05rem;
    font-weight: 500;
  }

  .ledger-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
    gap: 1.5rem;
  }

  .ledger-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .ledger-title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    border-bottom: 1px solid var(--border-hairline);
    padding-bottom: 0.4rem;
  }

  .ledger-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: 280px;
    overflow-y: auto;
  }

  .ledger-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.45rem 0.65rem;
    border-radius: 0.375rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-hairline);
    font-size: 0.82rem;
  }

  .ledger-year,
  .ledger-code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    padding: 0.15rem 0.35rem;
    background: var(--bg-surface);
    border-radius: 0.25rem;
    white-space: nowrap;
  }

  .ledger-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .ledger-venue,
  .ledger-term {
    font-size: 0.74rem;
    color: var(--text-secondary);
  }
</style>
