---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/admin-buttons.css';
import profile from '../../data/profile.json';

const errorCode = Astro.url.searchParams.get('error');
const waitMinutes = Astro.url.searchParams.get('wait') || '15';
const isInvalid = errorCode === 'invalid';
const isRateLimited = errorCode === 'ratelimit';
---

<BaseLayout
  title="The Study · Faculty Archive Sign In"
  description="Restricted academic archive and study console for Professor Duncan R. Cordry."
  isAdmin={true}
>
  <main class="login-shell">
    <section class="login-card" aria-labelledby="login-heading">
      <div class="login-header">
        <span class="login-eyebrow">❧ THE STUDY · FACULTY ARCHIVE</span>
        <h1 id="login-heading">Academic Archive Sign In</h1>
        <p class="login-sub">
          Sign in to access faculty administrative controls, manage publications, monographs, syllabi, and server configuration.
        </p>
      </div>

      {isInvalid && (
        <div class="login-alert" role="alert">
          Authentication failed. Verify your administrator passphrase.
        </div>
      )}

      {isRateLimited && (
        <div class="login-alert login-alert-danger" role="alert">
          Sign in temporarily locked due to repeated attempts. Please wait <strong>{waitMinutes} minute(s)</strong> before retrying.
        </div>
      )}

      <form method="POST" action="/api/admin/auth" class="login-form">
        <input type="hidden" name="action" value="login" />

        <div class="field-group">
          <label for="username">Faculty Identifier / Email</label>
          <input
            id="username"
            name="username"
            type="text"
            value={profile.email}
            autocomplete="username"
            required
          />
        </div>

        <div class="field-group">
          <div class="password-label-row">
            <label for="current-password">Administrator Passphrase</label>
            <button
              type="button"
              id="toggle-password"
              class="toggle-pw-btn"
              aria-label="Show password as plain text"
            >
              Show passphrase
            </button>
          </div>
          <input
            id="current-password"
            name="password"
            type="password"
            autocomplete="current-password"
            placeholder="Enter passphrase…"
            minlength="8"
            required
          />
        </div>

        <button type="submit" class="study-btn study-btn--seal study-btn--lg login-submit">
          <span>Sign In to The Study</span>
          <span class="btn-icon">→</span>
          <span class="btn-keycap">↵</span>
        </button>
      </form>

      <footer class="login-footer">
        <a href="/">← Return to Portfolio</a>
      </footer>
    </section>
  </main>

  <script>
    const pwInput = document.getElementById('current-password') as HTMLInputElement | null;
    const toggleBtn = document.getElementById('toggle-password');
    toggleBtn?.addEventListener('click', () => {
      if (!pwInput) return;
      const isPassword = pwInput.type === 'password';
      pwInput.type = isPassword ? 'text' : 'password';
      toggleBtn.textContent = isPassword ? 'Hide passphrase' : 'Show passphrase';
    });
  </script>
</BaseLayout>

<style>
  .login-shell {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .login-card {
    width: min(440px, 100%);
    padding: 2.25rem;
    border-radius: 4px;
    border: 1px solid var(--border-hairline, #1e2d4a);
    background: var(--bg-surface, #0b1220);
    box-shadow: 0 16px 48px -12px rgba(0, 0, 0, 0.7);
  }

  .login-eyebrow {
    font-family: var(--font-serif);
    font-size: 0.76rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent, #d8b257);
    font-weight: 500;
  }

  .login-header h1 {
    margin: 0.35rem 0 0.5rem;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .login-sub {
    margin: 0 0 1.5rem;
    font-family: var(--font-serif);
    font-size: 0.88rem;
    color: var(--text-secondary, #c8c3b6);
    line-height: 1.5;
  }

  .login-alert {
    padding: 0.75rem 1rem;
    margin-bottom: 1.25rem;
    border-radius: 3px;
    border: 1px solid #b83a28;
    background: color-mix(in oklch, #b83a28 14%, transparent);
    font-family: var(--font-serif);
    font-size: 0.84rem;
    color: #f09a8a;
  }

  .login-alert-danger {
    border-color: #b83a28;
    background: color-mix(in oklch, #b83a28 22%, transparent);
    color: #fcece9;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field-group label {
    font-family: var(--font-serif);
    font-size: 0.82rem;
    color: var(--text-secondary, #c8c3b6);
  }

  .password-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .toggle-pw-btn {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-serif);
    font-size: 0.78rem;
    color: var(--accent, #d8b257);
    cursor: pointer;
  }

  .field-group input {
    padding: 0.65rem 0.8rem;
    border-radius: 3px;
    border: 1px solid var(--border-hairline, #1e2d4a);
    background: var(--bg-canvas, #060a12);
    color: var(--text-primary, #f5f2ea);
    font-family: var(--font-serif);
    font-size: 0.9rem;
  }

  .field-group input:focus {
    outline: none;
    border-color: var(--accent, #d8b257);
  }

  .login-submit {
    margin-top: 0.4rem;
    padding: 0.75rem 1rem;
    border-radius: 3px;
    border: 1px solid var(--accent, #d8b257);
    background: color-mix(in oklch, var(--accent, #d8b257) 18%, transparent);
    color: var(--text-primary, #f5f2ea);
    font-family: var(--font-serif);
    font-size: 0.88rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .login-submit:hover {
    background: var(--accent, #d8b257);
    color: var(--bg-canvas, #060a12);
  }

  .login-footer {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-hairline, #1e2d4a);
    font-family: var(--font-serif);
    font-size: 0.84rem;
  }

  .login-footer a {
    color: var(--text-secondary, #c8c3b6);
    text-decoration: none;
  }

  .login-footer a:hover {
    color: var(--accent, #d8b257);
  }
</style>
