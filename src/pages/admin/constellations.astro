---
export const prerender = false;

import fs from 'node:fs/promises';
import path from 'node:path';
import AdminLayout from '../../layouts/AdminLayout.astro';

const skyIndexPath = path.resolve(process.cwd(), 'public/data/sky/index.json');
const skyIndexRaw = await fs.readFile(skyIndexPath, 'utf8');
const skyIndex = JSON.parse(skyIndexRaw);
const sampleCatalog = skyIndex.catalog || [];
---

<AdminLayout title="Constellation Shard Registry" activeModule="constellations">
  <div class="module-container">
    <div class="module-header">
      <div class="header-split">
        <div>
          <span class="module-kicker">MODULE 03 · URANOMETRIA SHARD REGISTRY</span>
          <h2>Constellation Shard & Vertex Inspector</h2>
          <p class="module-sub">
            Browse, inspect, and prune coordinate shards across the {skyIndex.total} active celestial artifacts.
          </p>
        </div>
        <div class="telemetry-stats">
          <div class="stat-box">
            <span class="stat-number">{skyIndex.total}</span>
            <span class="stat-label">Active Constellations</span>
          </div>
          <div class="stat-box">
            <span class="stat-number">J2000.0</span>
            <span class="stat-label">Astrometric Epoch</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="search-bar-row">
      <div class="search-input-wrap">
        <span class="search-icon">⌕</span>
        <input
          type="search"
          id="constellation-filter"
          placeholder="Filter by IAU code, Latin designation, or English name (e.g. ORI, Orion, Andromeda, DRC-0001)…"
          aria-label="Filter constellations"
        />
      </div>
      <div class="filter-count" id="filter-count-badge">
        Showing {sampleCatalog.length} of {skyIndex.total}
      </div>
    </div>

    <!-- Constellation Catalog Table -->
    <div class="catalog-card">
      <div class="table-responsive">
        <table class="constellation-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Designation</th>
              <th>English Equivalent</th>
              <th>Epoch Coordinates (RA · Dec)</th>
              <th>Shard File</th>
              <th class="th-actions">Actions</th>
            </tr>
          </thead>
          <tbody id="constellation-tbody">
            {sampleCatalog.map((item: any) => (
              <tr data-con-row={`${item.id} ${item.name} ${item.english} ${item.ra} ${item.dec}`.toLowerCase()}>
                <td class="mono-id">{item.id}</td>
                <td>
                  <strong class="const-name">{item.name}</strong>
                </td>
                <td class="text-secondary-sub">{item.english}</td>
                <td class="mono-coords">{item.ra} · {item.dec}</td>
                <td class="mono-shard">{item.shard || 'shard-00.json'}</td>
                <td class="td-actions">
                  <div class="action-buttons">
                    <a href={`/?sky=${item.id}`} target="_blank" rel="noopener noreferrer" class="btn-inspect">
                      View ↗
                    </a>
                    <button
                      type="button"
                      class="btn-purge"
                      data-delete-constellation={item.id}
                      data-constellation-name={item.name}
                    >
                      Purge
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    declare const notify: (message: string, status?: string) => void;
    declare const postAdmin: (url: string, payload: Record<string, any>) => Promise<any>;

    // Real-time client-side filter
    const filterInput = document.getElementById('constellation-filter') as HTMLInputElement | null;
    const countBadge = document.getElementById('filter-count-badge');
    const rows = document.querySelectorAll<HTMLElement>('[data-con-row]');

    filterInput?.addEventListener('input', (e) => {
      const q = (e.currentTarget as HTMLInputElement).value.trim().toLowerCase();
      let visible = 0;

      rows.forEach((row) => {
        const text = row.dataset.conRow || '';
        const match = q.length === 0 || text.includes(q);
        row.hidden = !match;
        if (match) visible++;
      });

      if (countBadge) {
        countBadge.textContent = `Showing ${visible} of ${rows.length}`;
      }
    });

    // Prune / Delete Constellation Handler
    document.querySelectorAll<HTMLButtonElement>('[data-delete-constellation]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.deleteConstellation;
        const name = btn.dataset.constellationName || id;
        if (!id) return;

        const confirmed = confirm(`Are you sure you want to permanently purge constellation ${id} (${name}) from the celestial catalog?`);
        if (!confirmed) return;

        btn.disabled = true;
        btn.textContent = '…';
        notify(`Purging constellation ${id} from shard index…`, 'info');

        const data = await postAdmin('/api/admin/constellations', { id });
        if (data.ok) {
          notify(data.message || `Constellation ${id} pruned.`, 'success');
          btn.closest('tr')?.remove();
        } else {
          btn.disabled = false;
          btn.textContent = 'Purge';
          notify(data.error || 'Failed to prune constellation.', 'error');
        }
      });
    });
  </script>
</AdminLayout>

<style>
  .module-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .module-header {
    border-bottom: 1px solid var(--border-hairline);
    padding-bottom: 1rem;
  }

  .header-split {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .module-kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--accent);
  }

  .header-split h2 {
    margin: 0.25rem 0 0.25rem;
    font-size: var(--step-1);
    font-weight: 500;
  }

  .module-sub {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .telemetry-stats {
    display: flex;
    gap: 0.75rem;
  }

  .stat-box {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 0.85rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-hairline);
    border-radius: 0.375rem;
  }

  .stat-number {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--accent);
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-tertiary);
    letter-spacing: 0.05em;
  }

  /* Search row */
  .search-bar-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .search-input-wrap {
    flex: 1;
    min-width: 280px;
    display: flex;
    align-items: center;
    background: var(--bg-canvas);
    border: 1px solid var(--border-hairline);
    border-radius: 0.375rem;
    padding: 0 0.75rem;
  }

  .search-input-wrap:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }

  .search-icon {
    color: var(--text-tertiary);
    font-size: 1.1rem;
    margin-right: 0.5rem;
  }

  .search-input-wrap input {
    width: 100%;
    padding: 0.65rem 0;
    border: none;
    background: transparent;
    color: var(--text-primary);
    font-family: inherit;
    font-size: 0.88rem;
  }

  .search-input-wrap input:focus {
    outline: none;
  }

  .filter-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    padding: 0.45rem 0.75rem;
    background: var(--bg-surface);
    border-radius: 0.375rem;
    border: 1px solid var(--border-hairline);
  }

  /* Table styling */
  .catalog-card {
    border-radius: 0.75rem;
    border: 1px solid var(--border-hairline);
    background: var(--bg-elevated);
    overflow: hidden;
  }

  .table-responsive {
    overflow-x: auto;
    max-height: 640px;
  }

  .constellation-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    text-align: left;
  }

  .constellation-table thead {
    position: sticky;
    top: 0;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border-hairline);
    z-index: 2;
  }

  .constellation-table th {
    padding: 0.75rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    font-weight: 600;
  }

  .constellation-table td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid color-mix(in oklch, var(--border-hairline) 40%, transparent);
  }

  .constellation-table tr:hover td {
    background: color-mix(in oklch, var(--accent) 4%, transparent);
  }

  .mono-id {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--accent);
  }

  .const-name {
    color: var(--text-primary);
  }

  .text-secondary-sub {
    color: var(--text-secondary);
  }

  .mono-coords {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .mono-shard {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }

  .th-actions, .td-actions {
    text-align: right;
  }

  .action-buttons {
    display: inline-flex;
    gap: 0.4rem;
  }

  .btn-inspect {
    padding: 0.25rem 0.55rem;
    border-radius: 0.25rem;
    border: 1px solid var(--border-hairline);
    background: transparent;
    color: var(--text-primary);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    transition: all 0.15s ease;
  }

  .btn-inspect:hover {
    background: var(--bg-surface);
    border-color: var(--accent);
    color: var(--accent);
  }

  .btn-purge {
    padding: 0.25rem 0.55rem;
    border-radius: 0.25rem;
    border: 1px solid color-mix(in oklch, oklch(65% 0.2 25) 30%, transparent);
    background: color-mix(in oklch, oklch(65% 0.2 25) 10%, transparent);
    color: oklch(75% 0.16 25);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-purge:hover {
    background: color-mix(in oklch, oklch(65% 0.2 25) 20%, transparent);
    border-color: oklch(75% 0.16 25);
  }
</style>
