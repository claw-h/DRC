            </button>
            <button type="button" class="study-btn study-btn--instrument tool-btn" id="tool-edge" data-tool="edge" title="Click two stars to connect chords (Key: C)">
              <span>☍ Chords</span>
              <span class="btn-keycap">C</span>
            </button>
            <button type="button" class="study-btn study-btn--instrument tool-btn" id="tool-add" data-tool="add" title="Click on sky to drop star (Key: A)">
              <span>+ Add Star</span>
              <span class="btn-keycap">A</span>
            </button>
            <button type="button" class="study-btn study-btn--hazard study-btn--sm tool-btn-outline" id="btn-revert" title="Revert to last saved shard state">
              <span>↺ Revert</span>
            </button>
          </div>
        </div>

        <div class="canvas-viewport-wrap" id="canvas-container">
          <div class="astrolabe-stage">
