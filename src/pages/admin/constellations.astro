        </div>
        <div class="telemetry-stats">
          <div class="stat-box">
            <span class="stat-number">{catalog.length}</span>
            <span class="stat-label">Plates Cataloged</span>
          </div>
          <div class="stat-box">
            <span class="stat-number" id="featured-sky-display">
              {systemState.featuredConstellationId || 'RANDOM'}
            </span>
            <span class="stat-label">Featured Sky Chart</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile Segmented View Switcher: Strictly Gated for Mobile (<= 800px) -->
    <nav class="atlas-mobile-tabs" id="atlas-mobile-tabs" aria-label="Atlas Studio View Switcher">
      <button type="button" class="atlas-tab-btn is-active" data-atlas-tab="canvas" aria-selected="true">
        <span class="tab-icon">🌌</span>
        <span class="tab-label">01 · Canvas</span>
      </button>
      <button type="button" class="atlas-tab-btn" data-atlas-tab="specs" aria-selected="false">
        <span class="tab-icon">⚙️</span>
        <span class="tab-label">02 · Specs</span>
      </button>
      <button type="button" class="atlas-tab-btn" data-atlas-tab="catalog" aria-selected="false">
        <span class="tab-icon">📜</span>
        <span class="tab-label">03 · Catalog</span>
        <span class="tab-badge">{catalog.length}</span>
      </button>
    </nav>

    <!-- Top Section: Interactive Canvas Studio & Telemetry Inspector -->
    <div class="studio-split">
      <!-- Left: Interactive Astrolabe Canvas Stage -->
      <section class="canvas-panel" aria-labelledby="canvas-stage-heading">
        <div class="panel-head-bar">
          <div class="panel-meta">
