            </div>

            <div class="form-row-2">
              <label>
                <span class="meta-label">Bayer Designation</span>
                <input type="text" id="star-bayer-input" placeholder="e.g. α, β, γ" />
              </label>
              <label>
                <span class="meta-label">Proper Name</span>
                <input type="text" id="star-name-input" placeholder="e.g. Almach" />
              </label>
            </div>

            <div class="vertex-actions">
              <button type="button" id="btn-delete-vertex" class="study-btn study-btn--hazard study-btn--sm btn-danger-sm">
                ✕ Delete Selected Star
              </button>
            </div>
          </div>
        </div>

        <!-- Commit Actions -->
        <div class="commit-row">
          <button type="button" id="btn-save-mutations" class="study-btn study-btn--seal study-btn--lg btn-primary">
            <span>Save Constellation Chart</span>
            <span class="btn-keycap">⌘S</span>
          </button>
          <button type="button" id="btn-purge-constellation" class="study-btn study-btn--hazard btn-danger-outline">
            Reset Chart to Baseline
          </button>
        </div>
      </section>
    </div>

    <!-- Bottom Section: Searchable Catalog Table with Adaptive Row Density -->
    <section class="catalog-section" aria-labelledby="catalog-table-heading">
      <div class="catalog-header-bar">
        <div>
          <span class="card-kicker">03 · URANOMETRIA CATALOG ({catalog.length} PLATES)</span>
          <h3 id="catalog-table-heading">Canonical 88-Plate Constellation Catalog</h3>
        </div>

        <div class="catalog-controls-deck">
          <div class="search-wrap">
            <span class="search-icon">⌕</span>
            <input
              type="search"
              id="catalog-filter-input"
              placeholder="Filter by code, Latin name, or coords…"
              aria-label="Filter catalog"
            />
          </div>
          <div class="catalog-density-wrap" role="group" aria-label="Plates displayed per page">
            <span class="density-label">Show:</span>
            <button type="button" class="density-btn is-active" data-page-size="10" title="Display 10 plates per page">10</button>
            <button type="button" class="density-btn" data-page-size="25" title="Display 25 plates per page">25</button>
            <button type="button" class="density-btn" data-page-size="all" title="Display all 88 plates">All</button>
          </div>
        </div>
      </div>

      <div class="table-responsive">
        <table class="catalog-table">
          <thead>
            <tr>
              <th>Plate</th>
              <th>IAU Code</th>
              <th>Latin Designation</th>
              <th>Meaning / English</th>
              <th>Epoch Coordinates</th>
              <th>Shard</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="catalog-tbody">
            {catalog.map((item: any) => (
              <tr data-cat-row={`${item.id} ${item.name} ${item.genitive || ''} ${item.meaning || ''} ${item.ra} ${item.dec}`.toLowerCase()}>
                <td class="mono-plate">{item.plate || '—'}</td>
                <td class="mono-code">{item.id}</td>
                <td>
                  <strong>{item.name}</strong>
                  {item.genitive && <span class="text-secondary"> ({item.genitive})</span>}
                </td>
                <td class="text-secondary">{item.meaning || item.english || '—'}</td>
                <td class="mono-coords">{item.ra} · {item.dec}</td>
                <td class="mono-shard">{item.shard || 'shard-00.json'}</td>
                <td class="text-right">
                  <div class="row-actions">
                    <button
                      type="button"
                      class="study-btn study-btn--ledger study-btn--sm btn-table-edit"
                      data-load-constellation={item.id}
                      title="Load this constellation into the Canvas Editor above"
                    >
                      ✎ Edit
                    </button>
                    <a href={`/?sky=${item.id}`} target="_blank" rel="noopener noreferrer" class="study-btn study-btn--ghost study-btn--sm btn-table-view">
                      Sky ↗
                    </a>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <footer class="catalog-pagination-bar" id="catalog-pagination-bar">
        <div class="pagination-info">
          <span id="catalog-page-range">Showing 1–10 of {catalog.length} plates</span>
        </div>
        <div class="pagination-actions">
          <button type="button" class="study-btn study-btn--ledger study-btn--sm" id="btn-page-prev" disabled>
            ‹ Prev
          </button>
          <span class="pagination-current-page" id="catalog-page-indicator">Page 1 of {Math.ceil(catalog.length / 10)}</span>
          <button type="button" class="study-btn study-btn--ledger study-btn--sm" id="btn-page-next">
            Next ›
          </button>
        </div>
      </footer>
    </section>
  </div>

  <script>
    declare const notify: (message: string, status?: string) => void;
    declare const postAdmin: (url: string, payload: Record<string, any>) => Promise<any>;

    // State Variables
    let activeTool: 'drag' | 'edge' | 'add' = 'drag';
    let currentId = (document.querySelector('.module-container') as HTMLElement)?.dataset.initialId || 'And';
    let currentConstellation: any = null;
    let selectedStarIndex: number | null = null;
    let edgeStartIndex: number | null = null;
    let isDragging = false;

    const canvas = document.getElementById('constellation-canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d');
    const selectEl = document.getElementById('constellation-select') as HTMLSelectElement;
    const instructionsEl = document.getElementById('canvas-instructions');

    // Convert normalized 0..10000 space to canvas pixel space
    function toCanvas(val: number): number {
      return (val / 10000) * canvas.width;
    }

    function toNorm(px: number): number {
      return Math.round((px / canvas.width) * 10000);
    }

    // Render Canvas
    function renderConstellation() {
      if (!ctx) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Deep celestial background
      ctx.fillStyle = '#080a0f';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Draw Astrolabe Concentric Meridian Rings
      const cx = canvas.width / 2;
      const cy = canvas.height / 2;
      ctx.strokeStyle = 'rgba(215, 185, 120, 0.08)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(cx, cy, 260, 0, Math.PI * 2);
      ctx.arc(cx, cy, 180, 0, Math.PI * 2);
      ctx.arc(cx, cy, 100, 0, Math.PI * 2);
      ctx.stroke();

      // Cardinal axis crosshair
      ctx.beginPath();
      ctx.moveTo(cx, 16);
      ctx.lineTo(cx, canvas.height - 16);
      ctx.moveTo(16, cy);
      ctx.lineTo(canvas.width - 16, cy);
      ctx.stroke();

      if (!currentConstellation || !Array.isArray(currentConstellation.stars)) {
        ctx.fillStyle = '#6b7280';
        ctx.font = '12px monospace';
        ctx.textAlign = 'center';
        ctx.fillText('Loading celestial shards…', cx, cy);
        return;
      }

      const stars = currentConstellation.stars;
      const edges = currentConstellation.edges || [];

      // 1. Draw Connecting Silverpoint Chords with 9px Breathing Halo
      ctx.strokeStyle = 'rgba(215, 195, 145, 0.55)';
      ctx.lineWidth = 1.25;

      edges.forEach(([i, j]: [number, number]) => {
        const starA = stars[i];
        const starB = stars[j];
        if (!starA || !starB) return;

        const x1 = toCanvas(starA[0]);
        const y1 = toCanvas(starA[1]);
        const x2 = toCanvas(starB[0]);
        const y2 = toCanvas(starB[1]);

        const dx = x2 - x1;
        const dy = y2 - y1;
        const dist = Math.hypot(dx, dy);
        if (dist <= 18) return;

        const ux = dx / dist;
        const uy = dy / dist;

        // 9px breathing gap from both star centers
        const startX = x1 + ux * 9;
        const startY = y1 + uy * 9;
        const endX = x2 - ux * 9;
        const endY = y2 - uy * 9;

        ctx.beginPath();
        ctx.moveTo(startX, startY);
        ctx.lineTo(endX, endY);
        ctx.stroke();
      });

      // 2. Draw Stars & Bayer Letter Labels
      stars.forEach((s: any, idx: number) => {
        const x = toCanvas(s[0]);
        const y = toCanvas(s[1]);
        const mag = Number(s[2]) || 3.0;
        const properName = s[5] || '';
        const bayer = s[6] || '';
        const isSelected = selectedStarIndex === idx;
        const isEdgeStart = edgeStartIndex === idx;

        // Radius inversely proportional to magnitude
        const radius = Math.max(2.5, 6.5 - mag * 0.7);

        // Halo / Airy disk
        const haloGrad = ctx.createRadialGradient(x, y, 0, x, y, radius * 3);
        haloGrad.addColorStop(0, 'rgba(255, 255, 255, 0.95)');
        haloGrad.addColorStop(0.3, isSelected ? 'rgba(235, 195, 100, 0.6)' : 'rgba(215, 225, 255, 0.4)');
        haloGrad.addColorStop(1, 'rgba(200, 220, 255, 0)');

        ctx.fillStyle = haloGrad;
        ctx.beginPath();
        ctx.arc(x, y, radius * 3, 0, Math.PI * 2);
        ctx.fill();

        // Star Core
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.arc(x, y, radius, 0, Math.PI * 2);
        ctx.fill();

        // Selected Reticle
        if (isSelected || isEdgeStart) {
          ctx.strokeStyle = isEdgeStart ? '#ff7043' : 'rgba(215, 185, 120, 0.9)';
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          ctx.arc(x, y, radius + 7, 0, Math.PI * 2);
          ctx.stroke();
        }

        // Star Typography (Bayer Greek + Proper Name)
        ctx.fillStyle = isSelected ? '#ffde8a' : 'rgba(235, 235, 245, 0.75)';
        ctx.font = 'italic 11px serif';
        ctx.textAlign = 'left';
        const label = [bayer, properName].filter(Boolean).join(' ');
        if (label) {
          ctx.fillText(label, x + radius + 7, y + 4);
        }
      });
    }

    // Apply Constellation Shard Data & Update DOM
    function applyConstellationData(data: any, shouldNotify = false) {
      if (!data || !data.constellation) return;
      currentConstellation = data.constellation;
      currentId = data.constellation.id || currentId;
      const cat = data.catalogEntry || currentConstellation;

      // Update header & meta displays
      const titleEl = document.getElementById('active-const-title');
      const codeEl = document.getElementById('active-const-code');
      const nameEl = document.getElementById('meta-name');
      const genitiveEl = document.getElementById('meta-genitive');
      const coordsEl = document.getElementById('meta-coords');
      const shardEl = document.getElementById('meta-shard');
      const pinBtn = document.getElementById('btn-pin-featured');

      if (titleEl) titleEl.textContent = cat.name;
      if (codeEl) codeEl.textContent = cat.id;
      if (nameEl) nameEl.textContent = cat.name;
      if (genitiveEl) genitiveEl.textContent = cat.genitive || cat.meaning || '—';
      if (coordsEl) coordsEl.textContent = `${cat.ra} · ${cat.dec}`;
      if (shardEl) shardEl.textContent = cat.shard || 'shard-00.json';

      if (pinBtn) {
        pinBtn.textContent = data.isFeatured ? '★ Pinned as Default Sky' : 'Pin as Default Sky';
        pinBtn.className = data.isFeatured ? 'btn-pin is-pinned' : 'btn-pin';
      }

      if (selectEl) selectEl.value = cat.id;

      // Select primary alpha star by default
      if (Array.isArray(currentConstellation.stars) && currentConstellation.stars.length > 0) {
        selectStar(0);
      } else {
        selectStar(null);
      }

      renderConstellation();
      if (shouldNotify) {
        notify(`Loaded Plate: ${cat.name} (${cat.id})`, 'success');
      }
    }

    // Load Constellation Shard from Server
    async function loadConstellation(id: string) {
      currentId = id;
      selectedStarIndex = null;
      edgeStartIndex = null;
      notify(`Retrieving coordinates for ${id}…`, 'info');

      try {
        const data = await postAdmin('/api/admin/constellations', {
          action: 'get-constellation',
          id,
        });

        if (data.ok && data.constellation) {
          applyConstellationData(data, true);
        } else {
          notify(data.error || 'Failed loading constellation shard.', 'error');
        }
      } catch (err: any) {
        notify('Network error retrieving constellation shard.', 'error');
      }
    }

    // Star Selection Handler
    function selectStar(idx: number | null) {
      selectedStarIndex = idx;
      const inspector = document.getElementById('vertex-inspector-card');
      const idxLabel = document.getElementById('vertex-index-label');
      const xInput = document.getElementById('star-x-input') as HTMLInputElement;
      const yInput = document.getElementById('star-y-input') as HTMLInputElement;
      const magSlider = document.getElementById('star-mag-slider') as HTMLInputElement;
      const magDisplay = document.getElementById('star-mag-display');
      const bayerInput = document.getElementById('star-bayer-input') as HTMLInputElement;
      const nameInput = document.getElementById('star-name-input') as HTMLInputElement;

      if (idx === null || !currentConstellation?.stars?.[idx]) {
        if (inspector) inspector.classList.add('is-dimmed');
        if (idxLabel) idxLabel.textContent = 'None';
        return;
      }

      if (inspector) inspector.classList.remove('is-dimmed');
      const star = currentConstellation.stars[idx];
      if (idxLabel) idxLabel.textContent = `#${idx} (${star[6] || 'Star'})`;
      if (xInput) xInput.value = String(star[0]);
      if (yInput) yInput.value = String(star[1]);
      if (magSlider) magSlider.value = String(star[2]);
      if (magDisplay) magDisplay.textContent = Number(star[2]).toFixed(2);
      if (bayerInput) bayerInput.value = String(star[6] || '');
      if (nameInput) nameInput.value = String(star[5] || '');

      renderConstellation();
    }

    // Find star under mouse click
    function getStarAt(px: number, py: number): number | null {
      if (!currentConstellation?.stars) return null;
      for (let i = 0; i < currentConstellation.stars.length; i++) {
        const s = currentConstellation.stars[i];
        const sx = toCanvas(s[0]);
        const sy = toCanvas(s[1]);
        if (Math.hypot(px - sx, py - sy) < 14) {
          return i;
        }
      }
      return null;
    }

    // Canvas Mouse Interactions
    canvas.addEventListener('mousedown', (e) => {
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      const mouseX = (e.clientX - rect.left) * scaleX;
      const mouseY = (e.clientY - rect.top) * scaleY;

      const clickedStar = getStarAt(mouseX, mouseY);

      // Tool: Drag Vertex
      if (activeTool === 'drag') {
        if (clickedStar !== null) {
          selectStar(clickedStar);
          isDragging = true;
          canvas.style.cursor = 'grabbing';
        } else {
          selectStar(null);
        }
      }

      // Tool: Connect / Cut Chord
      if (activeTool === 'edge') {
        if (clickedStar !== null) {
          if (edgeStartIndex === null) {
            edgeStartIndex = clickedStar;
            selectStar(clickedStar);
            notify(`Star #${clickedStar} selected as chord origin. Click second star to connect/unlink.`, 'info');
          } else {
            if (edgeStartIndex !== clickedStar) {
              const a = Math.min(edgeStartIndex, clickedStar);
              const b = Math.max(edgeStartIndex, clickedStar);
              const edges: Array<[number, number]> = currentConstellation.edges || [];
              const exists = edges.findIndex(([i, j]) => i === a && j === b);

              if (exists !== -1) {
                edges.splice(exists, 1);
                notify(`Removed chord between #${a} and #${b}.`, 'warn');
              } else {
                edges.push([a, b]);
                notify(`Linked chord between #${a} and #${b}.`, 'success');
              }
              currentConstellation.edges = edges;
            }
            edgeStartIndex = null;
            renderConstellation();
          }
        }
      }

      // Tool: Add Star Vertex
      if (activeTool === 'add') {
        const normX = toNorm(mouseX);
        const normY = toNorm(mouseY);
        const newStar = [normX, normY, 3.2, 5, 0, '', '', 12];
        currentConstellation.stars.push(newStar);
        selectStar(currentConstellation.stars.length - 1);
        notify(`Added new star vertex at coordinates [${normX}, ${normY}].`, 'success');
      }
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging || selectedStarIndex === null || !currentConstellation?.stars?.[selectedStarIndex]) return;
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      const mouseX = (e.clientX - rect.left) * scaleX;
      const mouseY = (e.clientY - rect.top) * scaleY;

      const normX = Math.max(0, Math.min(10000, toNorm(mouseX)));
      const normY = Math.max(0, Math.min(10000, toNorm(mouseY)));

      currentConstellation.stars[selectedStarIndex][0] = normX;
      currentConstellation.stars[selectedStarIndex][1] = normY;

      (document.getElementById('star-x-input') as HTMLInputElement).value = String(normX);
      (document.getElementById('star-y-input') as HTMLInputElement).value = String(normY);

      renderConstellation();
    });

    window.addEventListener('mouseup', () => {
      if (isDragging) {
        isDragging = false;
        canvas.style.cursor = 'crosshair';
      }
    });

    // Touch Support for Mobile / Tablet Canvas Interaction
    function getTouchPos(e: TouchEvent) {
      const touch = e.touches[0] || e.changedTouches[0];
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      return {
        x: (touch.clientX - rect.left) * scaleX,
        y: (touch.clientY - rect.top) * scaleY
      };
    }

    canvas.addEventListener('touchstart', (e) => {
      const { x, y } = getTouchPos(e);
      const clickedStar = getStarAt(x, y);

      if (activeTool === 'drag') {
        if (clickedStar !== null) {
          e.preventDefault();
          selectStar(clickedStar);
          isDragging = true;
        } else {
          selectStar(null);
        }
      } else if (activeTool === 'edge') {
        if (clickedStar !== null) {
          e.preventDefault();
          if (edgeStartIndex === null) {
            edgeStartIndex = clickedStar;
            selectStar(clickedStar);
            notify(`Star #${clickedStar} selected as chord origin. Tap second star to link.`, 'info');
          } else {
            if (edgeStartIndex !== clickedStar) {
              const a = Math.min(edgeStartIndex, clickedStar);
              const b = Math.max(edgeStartIndex, clickedStar);
              const edges: Array<[number, number]> = currentConstellation.edges || [];
              const exists = edges.findIndex(([i, j]) => i === a && j === b);

              if (exists !== -1) {
                edges.splice(exists, 1);
                notify(`Removed chord between #${a} and #${b}.`, 'warn');
              } else {
                edges.push([a, b]);
                notify(`Linked chord between #${a} and #${b}.`, 'success');
              }
              currentConstellation.edges = edges;
            }
            edgeStartIndex = null;
            renderConstellation();
          }
        }
      } else if (activeTool === 'add') {
        e.preventDefault();
        const normX = toNorm(x);
        const normY = toNorm(y);
        const newStar = [normX, normY, 3.2, 5, 0, '', '', 12];
        currentConstellation.stars.push(newStar);
        selectStar(currentConstellation.stars.length - 1);
        notify(`Added star vertex at coordinates [${normX}, ${normY}].`, 'success');
      }
    }, { passive: false });

    window.addEventListener('touchmove', (e) => {
      if (!isDragging || selectedStarIndex === null || !currentConstellation?.stars?.[selectedStarIndex]) return;
      e.preventDefault();
      const { x, y } = getTouchPos(e);
      const normX = Math.max(0, Math.min(10000, toNorm(x)));
      const normY = Math.max(0, Math.min(10000, toNorm(y)));

      currentConstellation.stars[selectedStarIndex][0] = normX;
      currentConstellation.stars[selectedStarIndex][1] = normY;

      (document.getElementById('star-x-input') as HTMLInputElement).value = String(normX);
      (document.getElementById('star-y-input') as HTMLInputElement).value = String(normY);

      renderConstellation();
    }, { passive: false });

    window.addEventListener('touchend', () => {
      if (isDragging) {
        isDragging = false;
      }
    });

    // Property Inspector Synchronizers
    document.getElementById('star-x-input')?.addEventListener('input', (e) => {
      if (selectedStarIndex === null) return;
      currentConstellation.stars[selectedStarIndex][0] = Number((e.target as HTMLInputElement).value);
      renderConstellation();
    });

    document.getElementById('star-y-input')?.addEventListener('input', (e) => {
      if (selectedStarIndex === null) return;
      currentConstellation.stars[selectedStarIndex][1] = Number((e.target as HTMLInputElement).value);
      renderConstellation();
    });

    document.getElementById('star-mag-slider')?.addEventListener('input', (e) => {
      if (selectedStarIndex === null) return;
      const val = Number((e.target as HTMLInputElement).value);
      currentConstellation.stars[selectedStarIndex][2] = val;
      const disp = document.getElementById('star-mag-display');
      if (disp) disp.textContent = val.toFixed(2);
      renderConstellation();
    });

    document.getElementById('star-bayer-input')?.addEventListener('input', (e) => {
      if (selectedStarIndex === null) return;
      currentConstellation.stars[selectedStarIndex][6] = (e.target as HTMLInputElement).value;
      renderConstellation();
    });

    document.getElementById('star-name-input')?.addEventListener('input', (e) => {
      if (selectedStarIndex === null) return;
      currentConstellation.stars[selectedStarIndex][5] = (e.target as HTMLInputElement).value;
      renderConstellation();
    });

    // Delete Vertex
    document.getElementById('btn-delete-vertex')?.addEventListener('click', () => {
      if (selectedStarIndex === null || !currentConstellation?.stars) return;
      const removedIdx = selectedStarIndex;

      // Remove star
      currentConstellation.stars.splice(removedIdx, 1);

      // Re-index edges
      const nextEdges: Array<[number, number]> = [];
      (currentConstellation.edges || []).forEach(([a, b]: [number, number]) => {
        if (a === removedIdx || b === removedIdx) return; // remove connected edge
        nextEdges.push([a > removedIdx ? a - 1 : a, b > removedIdx ? b - 1 : b]);
      });
      currentConstellation.edges = nextEdges;

      selectStar(null);
      notify(`Removed star vertex #${removedIdx}.`, 'warn');
    });

    // Tool Toggles
    const toolButtons = document.querySelectorAll<HTMLButtonElement>('.tool-btn');
    toolButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        toolButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        activeTool = btn.dataset.tool as any;
        edgeStartIndex = null;

        if (instructionsEl) {
          if (activeTool === 'drag') instructionsEl.textContent = '✦ Drag Mode: Click & drag star vertices to reposition coordinates (0–10,000).';
          if (activeTool === 'edge') instructionsEl.textContent = '☍ Chord Mode: Click origin star, then click target star to link or unlink.';
          if (activeTool === 'add') instructionsEl.textContent = '✚ Add Mode: Click anywhere on the sky canvas to drop a new star vertex.';
        }
        renderConstellation();
      });
    });

    // Revert to saved shard state
    document.getElementById('btn-revert')?.addEventListener('click', () => {
      loadConstellation(currentId);
    });

    // Save Shard Mutations
    document.getElementById('btn-save-mutations')?.addEventListener('click', async () => {
      if (!currentConstellation) return;
      const btn = document.getElementById('btn-save-mutations') as HTMLButtonElement;
      btn.disabled = true;
      btn.innerHTML = '<span>Writing Shard…</span>';

      notify(`Committing coordinate mutations for ${currentId} to shard…`, 'info');
      const data = await postAdmin('/api/admin/constellations', {
        action: 'update-coordinates',
        id: currentId,
        stars: currentConstellation.stars,
        edges: currentConstellation.edges,
      });

      btn.disabled = false;
      btn.innerHTML = '<span>Save Constellation Chart</span><span class="btn-keycap">⌘S</span>';

      if (data.ok) {
        notify(data.message || 'Shard coordinates committed successfully.', 'success');
      } else {
        notify(data.error || 'Failed saving shard mutations.', 'error');
      }
    });

    // Keyboard Shortcuts for Astrolabe Studio
    window.addEventListener('keydown', (e) => {
      const activeTag = (document.activeElement?.tagName || '').toLowerCase();
      const isInput = activeTag === 'input' || activeTag === 'textarea' || activeTag === 'select';

      // ⌘S or Ctrl+S to save chart
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 's') {
        e.preventDefault();
        document.getElementById('btn-save-mutations')?.click();
        return;
      }

      if (isInput) return;

      if (e.key === 'd' || e.key === 'D') {
        document.getElementById('tool-drag')?.click();
      } else if (e.key === 'c' || e.key === 'C') {
        document.getElementById('tool-edge')?.click();
      } else if (e.key === 'a' || e.key === 'A') {
        document.getElementById('tool-add')?.click();
      } else if (e.key === 'Escape') {
        selectStar(null);
      }
    });

    // Pin Featured Sky
    const pinBtn = document.getElementById('btn-pin-featured');
    pinBtn?.addEventListener('click', async () => {
      const isCurrentlyPinned = pinBtn.classList.contains('is-pinned');
      const nextPin = !isCurrentlyPinned;

      const data = await postAdmin('/api/admin/constellations', {
        action: 'pin-featured',
        id: currentId,
        pin: nextPin,
      });

      if (data.ok) {
        pinBtn.className = nextPin ? 'btn-pin is-pinned' : 'btn-pin';
        pinBtn.textContent = nextPin ? '★ Pinned as Default Sky' : 'Pin as Default Sky';
        const display = document.getElementById('featured-sky-display');
        if (display) display.textContent = nextPin ? currentId : 'RANDOM';
        notify(data.message, 'success');
      } else {
        notify(data.error || 'Failed to pin featured sky.', 'error');
      }
    });

    // Purge Constellation
    document.getElementById('btn-purge-constellation')?.addEventListener('click', async () => {
      if (!confirm(`Are you sure you want to permanently purge constellation "${currentId}" from the master celestial shards?`)) {
        return;
      }

      notify(`Purging constellation ${currentId}…`, 'warn');
      const data = await postAdmin('/api/admin/constellations', {
        action: 'delete',
        id: currentId,
      });

      if (data.ok) {
        notify(data.message, 'success');
        setTimeout(() => window.location.reload(), 1200);
      } else {
        notify(data.error || 'Failed to purge constellation.', 'error');
      }
    });

    // Dropdown Quick Switcher
    selectEl?.addEventListener('change', () => {
      loadConstellation(selectEl.value);
    });

    // Adaptive Catalog Pagination & Slicing (Shrinks rows on mobile & desktop)
    let currentPage = 1;
    let pageSize: number | 'all' = 10;
    const filterInput = document.getElementById('catalog-filter-input') as HTMLInputElement;
    const catRows = Array.from(document.querySelectorAll<HTMLElement>('[data-cat-row]'));
    const densityButtons = document.querySelectorAll<HTMLButtonElement>('.density-btn');
    const prevBtn = document.getElementById('btn-page-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('btn-page-next') as HTMLButtonElement | null;
    const pageRangeEl = document.getElementById('catalog-page-range');
    const pageIndicatorEl = document.getElementById('catalog-page-indicator');

    function updateCatalogPagination() {
      const q = (filterInput?.value || '').trim().toLowerCase();
      const matchingRows: HTMLElement[] = [];
      catRows.forEach((row) => {
        const text = row.dataset.catRow || '';
        const matches = q.length === 0 || text.includes(q);
        if (matches) matchingRows.push(row);
      });

      const totalMatching = matchingRows.length;
      const actualSize = pageSize === 'all' ? (totalMatching || 1) : pageSize;
      const totalPages = Math.max(1, Math.ceil(totalMatching / actualSize));

      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      const startIndex = (currentPage - 1) * actualSize;
      const endIndex = pageSize === 'all' ? totalMatching : Math.min(startIndex + actualSize, totalMatching);

      // Hide all rows, then reveal only current slice
      catRows.forEach((row) => {
        row.hidden = true;
      });

      for (let i = startIndex; i < endIndex; i++) {
        if (matchingRows[i]) {
          matchingRows[i].hidden = false;
        }
      }

      if (pageRangeEl) {
        if (totalMatching === 0) {
          pageRangeEl.textContent = 'No matching celestial plates found';
        } else {
          pageRangeEl.textContent = `Showing ${startIndex + 1}–${endIndex} of ${totalMatching} plate${totalMatching === 1 ? '' : 's'}`;
        }
      }

      if (pageIndicatorEl) {
        pageIndicatorEl.textContent = `Page ${currentPage} of ${totalPages}`;
      }

      if (prevBtn) prevBtn.disabled = currentPage <= 1;
      if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
    }

    densityButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        densityButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        const val = btn.dataset.pageSize;
        pageSize = val === 'all' ? 'all' : Number(val) || 10;
        currentPage = 1;
        updateCatalogPagination();
      });
    });

    prevBtn?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        updateCatalogPagination();
      }
    });

    nextBtn?.addEventListener('click', () => {
      currentPage++;
      updateCatalogPagination();
    });

    filterInput?.addEventListener('input', () => {
      currentPage = 1;
      updateCatalogPagination();
    });

    // Initialize pagination
    updateCatalogPagination();

    // Mobile Tab Switching for Atlas Studio (Gated <= 800px)
    const atlasContainer = document.getElementById('atlas-module-container');
    const atlasTabButtons = document.querySelectorAll<HTMLButtonElement>('.atlas-tab-btn');

    function setAtlasMobileView(view: 'canvas' | 'specs' | 'catalog') {
      if (atlasContainer) {
        atlasContainer.dataset.mobileView = view;
      }
      atlasTabButtons.forEach((btn) => {
        const matches = btn.dataset.atlasTab === view;
        btn.classList.toggle('is-active', matches);
        btn.setAttribute('aria-selected', String(matches));
      });
      if (view === 'canvas') {
        renderConstellation();
      }
    }

    atlasTabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const view = btn.dataset.atlasTab as any;
        if (view) setAtlasMobileView(view);
      });
    });

    // Table "Edit" Button Handlers
    document.querySelectorAll<HTMLButtonElement>('[data-load-constellation]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.loadConstellation;
        if (id) {
          loadConstellation(id);
          // Auto-switch to canvas view on mobile so user sees the loaded constellation
          if (window.innerWidth <= 800) {
            setAtlasMobileView('canvas');
          }
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    });

    // Initial Load: Render preloaded server shard immediately (0ms blank delay)
    const preloadedEl = document.getElementById('initial-constellation-json');
    let loadedFromSSR = false;
    if (preloadedEl) {
      try {
        const preloaded = JSON.parse(preloadedEl.textContent || '{}');
        if (preloaded?.constellation) {
          applyConstellationData(preloaded, false);
          loadedFromSSR = true;
        }
      } catch (e) {
        console.error('Could not parse preloaded constellation JSON:', e);
      }
    }

    if (!loadedFromSSR) {
      loadConstellation(currentId);
    }
  </script>
</AdminLayout>

