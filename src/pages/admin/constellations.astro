---
export const prerender = false;

import fs from 'node:fs/promises';
import path from 'node:path';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSystemState } from '../../lib/system-state';

const systemState = await getSystemState();
const skyIndexPath = path.resolve(process.cwd(), 'public/data/sky/index.json');
const skyIndexRaw = await fs.readFile(skyIndexPath, 'utf8');
const skyIndex = JSON.parse(skyIndexRaw);

// Filter down strictly to the 88 unique canonical IAU constellations (no aliases)
// and sort them sequentially by plateNumber 1..88
const catalog = (skyIndex.catalog || [])
  .filter((c: any) => !c.canonicalId)
  .sort((a: any, b: any) => (a.plateNumber || 0) - (b.plateNumber || 0));

const initialId = systemState.featuredConstellationId || (catalog[0]?.id || 'And');
const initialEntry = catalog.find((c: any) => c.id.toLowerCase() === initialId.toLowerCase()) || catalog[0];

// Preload initial constellation shard data directly on server for 0ms first-frame render
let initialConstellation = null;
if (initialEntry) {
  try {
    const rawShard = String(initialEntry.shard || 'shard-00.json');
    const shardFile = rawShard.endsWith('.json') ? rawShard : `shard-${rawShard.padStart(2, '0')}.json`;
    const shardPath = path.resolve(process.cwd(), `public/data/sky/shards/${shardFile}`);
    const shardRaw = await fs.readFile(shardPath, 'utf8');
    const shardArr = JSON.parse(shardRaw);
    initialConstellation = shardArr.find((c: any) => c.id.toLowerCase() === initialEntry.id.toLowerCase());
  } catch (err) {
    console.error('Failed preloading initial constellation shard:', err);
  }
}
---

<AdminLayout title="Celestial Atlas & Astrolabe Studio" activeModule="constellations">
  <div class="module-container" id="atlas-module-container" data-initial-id={initialId} data-mobile-view="canvas">
    <script id="initial-constellation-json" type="application/json" set:html={JSON.stringify({
      catalogEntry: initialEntry,
      constellation: initialConstellation,
      isFeatured: systemState.featuredConstellationId === initialEntry?.id
    })}></script>

    <div class="module-header">
      <div class="header-split">
        <div>
          <h2>Celestial Atlas &amp; Constellation Cartography</h2>
          <p class="module-sub">
            Adjust star coordinates, apparent magnitudes, link constellation chords, and configure the featured celestial chart.
