          </div>
          <button
            type="button"
            id="btn-pin-featured"
            class={`study-btn study-btn--instrument ${systemState.featuredConstellationId === initialEntry?.id ? 'btn-pin is-pinned' : 'btn-pin'}`}
          >
            {systemState.featuredConstellationId === initialEntry?.id ? '★ Pinned as Default Sky' : 'Pin as Default Sky'}
          </button>
        </div>

        <!-- Selected Vertex Inspector Box -->
        <div class="vertex-inspector-card" id="vertex-inspector-card">
          <div class="inspector-head">
            <span class="mini-label">SELECTED STAR VERTEX</span>
            <span id="vertex-index-label" class="badge-vertex">#0</span>
          </div>

          <div class="inspector-body" id="inspector-body">
            <div class="coord-display-row">
              <div class="coord-col">
                <span class="meta-label">X Coordinate (0–10,000)</span>
                <input type="number" id="star-x-input" min="0" max="10000" class="mono-num" />
              </div>
              <div class="coord-col">
                <span class="meta-label">Y Coordinate (0–10,000)</span>
