---
// src/components/admin/ContentEditorModal.astro
// Unified Persistent In-Situ Content Atelier Modal (Papers, Monographs & Seminars)
// Authentic Public Reader Fidelity, Greyed-Out Scholarly Sample Data & Auto-Split Curation
---

<div id="content-editor-backdrop" class="content-editor-backdrop" aria-hidden="true"></div>

<dialog
  id="content-editor-modal"
  class="content-editor-dialog persistent-content-studio"
  closedby="any"
  aria-labelledby="content-modal-title"
>
  <div class="content-studio-shell" id="content-modal-shell">
    <!-- Top Instrument Header Bar -->
    <header class="studio-header">
      <div class="header-lead">
        <span class="seal-mark" aria-hidden="true">❧</span>
        <div class="header-titles">
          <nav class="studio-breadcrumb" id="atelier-breadcrumb" aria-label="Atelier Hierarchy Breadcrumb">
            <span class="crumb-segment crumb-root">Atelier</span>
            <span class="crumb-separator" aria-hidden="true">/</span>
            <span class="crumb-segment crumb-type" id="atelier-breadcrumb-type">01 · Publication</span>
            <span class="crumb-separator" aria-hidden="true">/</span>
            <span class="crumb-segment crumb-state" id="atelier-breadcrumb-state">New Intake</span>
            <span class="crumb-file-tag" id="atelier-file-tag" hidden></span>
            <span class="status-chip" id="editor-mode-chip">READY</span>
            <span class="studio-kicker sr-only" id="atelier-domain-kicker" aria-hidden="true">ARTICLE &amp; MANUSCRIPT ATELIER</span>
          </nav>
          <h3 id="content-modal-title" class="studio-title">New Manuscript Dispatch</h3>
        </div>
      </div>

      <!-- Center: Type Switcher Tabs (Publications | Monographs | Syllabi) -->
      <nav class="type-pill-nav" id="atelier-type-pill-nav" role="tablist" aria-label="Content Collection Switcher">
        <button
          type="button"
          class="type-pill is-active"
          id="type-pill-publications"
          data-type="publications"
          role="tab"
          aria-selected="true"
        >
          <span class="type-pill-num">01</span>
          <span class="type-pill-label">Publication</span>
        </button>
        <button
          type="button"
          class="type-pill"
          id="type-pill-books"
          data-type="books"
          role="tab"
          aria-selected="false"
        >
          <span class="type-pill-num">02</span>
          <span class="type-pill-label">Monograph</span>
        </button>
        <button
          type="button"
          class="type-pill"
          id="type-pill-classes"
          data-type="classes"
          role="tab"
          aria-selected="false"
        >
          <span class="type-pill-num">03</span>
          <span class="type-pill-label">Syllabus</span>
        </button>
      </nav>

      <div class="header-controls">
        <!-- Single Live Preview Toggle Button -->
        <button
          type="button"
          id="btn-header-preview-toggle"
          class="study-btn study-btn--instrument study-btn--sm header-preview-btn"
          aria-pressed="false"
          title="Toggle Live Public Reader Preview (⌘P)"
        >
          <span class="preview-btn-icon">👁</span>
          <span class="preview-btn-label" id="header-preview-label">Preview</span>
          <span class="btn-keycap">⌘P</span>
        </button>

        <button
          type="button"
          id="btn-close-content-modal"
          class="study-btn study-btn--ghost study-btn--icon-only study-btn--sm modal-close-btn"
          aria-label="Close Content Atelier (Esc)"
          title="Close (Esc)"
        >
          ✕
        </button>
      </div>
    </header>

    <!-- Golden Telemetry Shimmer Line (Active During Lazy Archival Loading) -->
    <div class="atelier-shimmer-progress" id="atelier-shimmer-progress" aria-hidden="true"></div>

    <!-- Main Studio Stage: Split or Focus -->
    <main class="studio-main-stage is-focus-mode" id="studio-main-stage">
      
      <!-- ========================================================
           LEFT STAGE: INTAKE & SCHEMATIC CURATION WORKBENCH
           ======================================================== -->
      <section class="stage-workbench-pane" id="stage-workbench-pane" aria-label="Content Schema Workbench">
        <!-- Fast Sync Pill for Immediate Pre-filled Catalog Records -->
        <div class="atelier-sync-pill" id="atelier-sync-pill" aria-live="polite" hidden>
          <span class="sync-pip" aria-hidden="true">✦</span>
          <span class="sync-text" id="atelier-sync-text">Syncing full manuscript archive…</span>
        </div>

        <!-- In-Situ Lazy Retrieval Skeleton Overlay (When fetching uncached records) -->
        <div class="atelier-lazy-scrim" id="atelier-lazy-scrim" aria-hidden="true" hidden>
          <div class="lazy-scrim-chassis">
            <div class="lazy-astrolabe-orb">
              <span class="lazy-astrolabe-glyph">❧</span>
              <div class="lazy-astrolabe-ring ring-1"></div>
              <div class="lazy-astrolabe-ring ring-2"></div>
            </div>
            <div class="lazy-text-lockup">
              <span class="lazy-kicker">OBSERVATORY RECORD ATELIER</span>
              <h4 class="lazy-title" id="lazy-scrim-title">Retrieving Archival Record…</h4>
              <p class="lazy-desc" id="lazy-scrim-desc">Querying edge repository and assembling scholarly frontmatter.</p>
            </div>
            <div class="lazy-skeleton-stack">
              <div class="lazy-skeleton-line sk-title"></div>
              <div class="lazy-skeleton-row">
                <div class="lazy-skeleton-line sk-half"></div>
                <div class="lazy-skeleton-line sk-half"></div>
              </div>
              <div class="lazy-skeleton-line sk-block"></div>
            </div>
          </div>
        </div>

        <!-- In-Situ Error Retrieval Card -->
        <div class="atelier-error-card" id="atelier-error-card" hidden>
          <span class="error-fleuron" aria-hidden="true">✠</span>
          <h4 class="error-title">Archival Record Unavailable</h4>
          <p class="error-msg" id="atelier-error-msg">Could not establish contact with the edge database.</p>
          <button type="button" id="btn-retry-atelier-fetch" class="study-btn study-btn--ignite study-btn--sm">
            <span>↺ Retry Retrieval</span>
          </button>
        </div>

        <div class="workbench-scroll-area">
          
          <!-- 1. PUBLICATIONS FORM -->
          <div id="form-container-publications" class="type-form-container is-active">
            <!-- Dedicated Intake Header -->
            <div class="intake-hub-card">
              <div class="intake-hub-header">
                <span class="hub-kicker">✦ ONE-STOP MANUSCRIPT INTAKE</span>
                <span class="hub-hint">DOI, BibTeX or PDF Auto-Extraction</span>
              </div>

              <!-- Universal Dropzone -->
              <div class="universal-dropzone" id="dropzone-pub">
                <input type="file" id="file-input-pub" accept=".pdf,.bib" hidden />
                <div class="dropzone-visual">
                  <span class="dropzone-icon">📄</span>
                  <div class="dropzone-text">
                    <strong class="dropzone-label">Drop Manuscript PDF or .bib File Here</strong>
                    <span class="dropzone-sub">Uploads to repository and auto-extracts bibliographic fields</span>
                  </div>
                </div>
              </div>

              <!-- DOI Auto-Resolver Lockup -->
              <div class="intake-quick-row">
                <div class="resolver-input-wrap">
                  <input
                    type="text"
                    id="ingest-doi-input"
                    placeholder="Paste DOI identifier (e.g. 10.5195/jffp.2021.995 or https://doi.org/...)"
                    aria-label="DOI Identifier"
                  />
                </div>
                <button type="button" id="btn-ingest-doi" class="study-btn study-btn--ignite study-btn--sm">
                  ✦ Auto-Resolve DOI
                </button>
              </div>

              <!-- Collapsible BibTeX parser -->
              <details class="bibtex-details">
                <summary class="bibtex-summary">Or paste raw BibTeX cartouche snippet ▾</summary>
                <div class="bibtex-expand-box">
                  <textarea
                    id="ingest-bibtex-input"
                    rows="3"
                    placeholder={"@article{cordry2024, author = {Cordry, Duncan R.}, title = {...}, year = {2024}}"}
                  ></textarea>
                  <button type="button" id="btn-ingest-bibtex" class="study-btn study-btn--ledger study-btn--sm">
                    Parse BibTeX Snippet →
                  </button>
                </div>
              </details>
            </div>

            <!-- Publications Form Inputs -->
            <form id="form-pub-workbench" class="workbench-form">
              <!-- Fieldset 1: Publication Identity -->
              <fieldset class="workbench-fieldset">
                <legend class="fieldset-legend">01 · Scholarly Identity &amp; Venue</legend>
                <div class="form-row-2">
                  <label>
                    <span>Article Title *</span>
                    <input
                      type="text"
                      name="title"
                      id="wb-pub-title"
                      placeholder="Epistemic Horizons: Insurrectionist Empiricism and Critical Pragmatism"
                      required
                    />
                  </label>
                  <label>
                    <span>Publication Year *</span>
                    <input
                      type="number"
                      name="year"
                      id="wb-pub-year"
                      placeholder="2024"
                      required
                    />
                  </label>
                </div>

                <label>
                  <span>Subtitle / Secondary Heading</span>
                  <input
                    type="text"
                    name="subtitle"
                    id="wb-pub-subtitle"
                    placeholder="Philosophy Born of Struggle, Necro-Being, and the Imperative of Liberation"
                  />
                </label>

                <div class="form-row-2">
                  <label>
                    <span>Journal / Refereed Venue *</span>
                    <input
                      type="text"
                      name="venue"
                      id="wb-pub-venue"
                      placeholder="Journal of French and Francophone Philosophy"
                      required
                    />
                  </label>
                  <label>
                    <span>Volume &amp; Issue</span>
                    <input
                      type="text"
                      name="volumeIssue"
                      id="wb-pub-volume"
                      placeholder="Vol. 32, No. 1–2, pp. 142–168"
                    />
                  </label>
                </div>
              </fieldset>

              <!-- Fieldset 2: Authorship & Academic Identifiers -->
              <fieldset class="workbench-fieldset">
                <legend class="fieldset-legend">02 · Authorship &amp; Identifiers</legend>
                <div class="form-row-2">
                  <label>
                    <span>DOI Identifier</span>
                    <input
                      type="text"
                      name="doi"
                      id="wb-pub-doi"
                      placeholder="10.5195/jffp.2024.1102"
                    />
                  </label>
                  <label>
                    <span>Co-Authors (comma-separated)</span>
                    <input
                      type="text"
                      name="coAuthors"
                      id="wb-pub-authors"
                      placeholder="Wynter, S., Harris, L."
                    />
                  </label>
                </div>

                <div class="asset-dropzone-lockup">
                  <label>
                    <span>PDF Manuscript Asset Route</span>
                    <div class="asset-input-row">
                      <input
                        type="text"
                        name="pdfUrl"
                        id="wb-pub-pdf"
                        placeholder="/papers/cordry-2024-epistemic-horizons.pdf"
                        class="mono"
                      />
                      <div class="asset-drop-inline" id="drop-inline-pub-pdf">
                        <input type="file" id="inline-file-pub" accept=".pdf" hidden />
                        <span>⇩ Drop PDF to link</span>
                      </div>
                    </div>
                  </label>
                </div>
              </fieldset>

              <!-- Fieldset 3: Abstract & Archival Cartouche -->
              <fieldset class="workbench-fieldset">
                <legend class="fieldset-legend">03 · Abstract &amp; Archival Cartouche</legend>
                <label>
                  <span>Abstract / Executive Summary *</span>
                  <textarea
                    name="abstract"
                    id="wb-pub-abstract"
                    rows="4"
                    placeholder="This paper articulates an insurrectionist epistemology situated at the intersection of Leonard Harris's philosophy born of struggle and Alain Locke's critical pragmatism. Investigating how normative categories of epistemic agency emerge within contested terrains of racialized violence and social survival, the essay demonstrates why melioristic consensus often masks structural necro-being."
                    required
                  ></textarea>
                </label>

                <label>
                  <span>Archival BibTeX Cartouche</span>
                  <textarea
                    name="citationBibtex"
                    id="wb-pub-bibtex"
                    rows="5"
                    class="mono-code"
                    placeholder={"@article{cordry_2024_epistemic,\n  author = {Cordry, Duncan R. and Wynter, Sylvia and Harris, Leonard},\n  title = {Epistemic Horizons: Insurrectionist Empiricism and Critical Pragmatism},\n  journal = {Journal of French and Francophone Philosophy},\n  year = {2024},\n  volume = {32},\n  number = {1-2},\n  pages = {142--168},\n  doi = {10.5195/jffp.2024.1102}\n}"}
                  ></textarea>
                </label>
              </fieldset>
            </form>
          </div>

          <!-- 2. BOOKS & MONOGRAPHS FORM -->
          <div id="form-container-books" class="type-form-container" hidden>
            <!-- Dedicated Intake Header -->
            <div class="intake-hub-card">
              <div class="intake-hub-header">
                <span class="hub-kicker">✦ ONE-STOP MONOGRAPH INTAKE</span>
                <span class="hub-hint">ISBN Catalog Resolution &amp; 2:3 Cover Staging</span>
              </div>

              <!-- Universal Dropzone for Covers -->
              <div class="universal-dropzone" id="dropzone-book">
                <input type="file" id="file-input-book" accept="image/*,.pdf" hidden />
                <div class="dropzone-visual">
                  <span class="dropzone-icon">🖼</span>
                  <div class="dropzone-text">
                    <strong class="dropzone-label">Drop Monograph Cover Artwork (2:3) or PDF Here</strong>
                    <span class="dropzone-sub">Accepts .webp, .svg, .png, .jpg (auto-scales to 2:3 book ratio)</span>
                  </div>
                </div>
              </div>

              <!-- ISBN Auto-Resolver Lockup -->
              <div class="intake-quick-row">
                <div class="resolver-input-wrap">
                  <input
                    type="text"
                    id="ingest-isbn-input"
                    placeholder="Paste ISBN (e.g. 978-0-262-52936-5 or catalog code)"
                    aria-label="ISBN Identifier"
                  />
                </div>
                <button type="button" id="btn-ingest-isbn" class="study-btn study-btn--ignite study-btn--sm">
                  ✦ Auto-Resolve Book
                </button>
              </div>
            </div>

            <!-- Monograph Form Inputs -->
            <form id="form-book-workbench" class="workbench-form">
              <!-- Fieldset 1: Specification -->
              <fieldset class="workbench-fieldset">
                <legend class="fieldset-legend">01 · Monograph Specification</legend>
                <div class="form-row-2">
                  <label>
                    <span>Monograph Title *</span>
                    <input
                      type="text"
                      name="title"
                      id="wb-book-title"
                      placeholder="Technical Objects &amp; Spiritual Practices"
                      required
                    />
                  </label>
                  <label>
                    <span>Publication Year *</span>
                    <input
                      type="number"
                      name="year"
                      id="wb-book-year"
                      placeholder="2025"
                      required
                    />
                  </label>
                </div>

                <label>
                  <span>Subtitle</span>
                  <input
                    type="text"
                    name="subtitle"
                    id="wb-book-subtitle"
                    placeholder="Organology, the Organic &amp; Inorganic, and Social Cohesion"
                  />
                </label>

                <div class="form-row-3">
                  <label>
                    <span>Publisher Imprint *</span>
                    <input
                      type="text"
                      name="publisher"
                      id="wb-book-publisher"
                      placeholder="Ashoka University · Philosophy Working Monograph"
                      required
                    />
                  </label>
                  <label>
                    <span>ISBN / Catalog ID *</span>
                    <input
                      type="text"
                      name="isbn"
                      id="wb-book-isbn"
                      placeholder="ASHOKA-PHIL-2025-DRC"
                      required
                    />
                  </label>
                  <label>
                    <span>Pages</span>
                    <input
                      type="number"
                      name="pages"
                      id="wb-book-pages"
                      placeholder="214"
                    />
                  </label>
                </div>
              </fieldset>

              <!-- Fieldset 2: Monograph Cover Artwork -->
              <fieldset class="workbench-fieldset">
                <legend class="fieldset-legend">02 · Monograph Cover Artwork (2:3 Aspect)</legend>
                <div class="cover-picker-field">
                  <div class="cover-picker-lockup">
                    <div class="cover-thumb-box">
                      <img
                        id="wb-book-cover-thumb"
                        src="/images/books/monograph-cover-0080.webp"
                        alt="Cover Preview"
                        class="cover-thumb-img"
                      />
                    </div>
                    <div class="cover-picker-details">
                      <label>
                        <span>Cover Image Path</span>
                        <input
                          type="text"
                          name="coverImage"
                          id="wb-book-cover"
                          placeholder="/images/books/monograph-cover-0080.webp"
                          class="cover-path-readonly mono"
                          readonly
                        />
                      </label>
                      <div class="cover-actions-row">
                        <div class="asset-drop-inline" id="drop-inline-book-cover">
                          <input type="file" id="inline-file-book-cover" accept="image/*" hidden />
                          <span>⇩ Drop replacement image</span>
                        </div>
                        <button
                          type="button"
                          id="wb-btn-launch-cover-cropper"
                          class="btn-cover-edit"
                        >
                          ✎ Fine-Tune in Media Cropper
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </fieldset>

              <!-- Fieldset 3: Synopsis -->
              <fieldset class="workbench-fieldset">
                <legend class="fieldset-legend">03 · Monograph Synopsis</legend>
                <label>
                  <span>Monograph Synopsis *</span>
                  <textarea
                    name="synopsis"
                    id="wb-book-synopsis"
                    rows="4"
                    placeholder="An ongoing research project investigating how technical objects and systems support specific spiritual practices, traditions, and forms of social cohesion. Examining the ontological boundary between the organic and the inorganic across continental philosophy of technology—from Georges Canguilhem and Gilbert Simondon to Bernard Stiegler and Yuk Hui—this work explores how technical milieus sustain liturgical, contemplative, and liberatory forms of life."
                    required
                  ></textarea>
                </label>
              </fieldset>

              <!-- Fieldset 4: Chapters Repeater -->
              <fieldset class="workbench-fieldset">
                <legend class="fieldset-legend">04 · Table of Contents</legend>
                <div class="repeater-section">
                  <div class="repeater-head">
                    <span class="mini-label">Monograph Chapters Table of Contents</span>
                    <button type="button" id="wb-add-chapter-btn" class="study-btn study-btn--ignite study-btn--sm btn-outline-sm">+ Add Chapter</button>
                  </div>
                  <div id="wb-chapters-container" class="repeater-list">
                    <div class="repeater-item repeater-card chapter-row">
                      <div class="repeater-card-header">
                        <div class="repeater-card-lead">
                          <span class="repeater-card-tag">CH.</span>
                          <input type="text" class="ch-num" placeholder="01" value="" aria-label="Chapter Number" />
                        </div>
                        <div class="repeater-card-main">
                          <input type="text" class="ch-title" placeholder="Between the Organic and the Inorganic" value="" aria-label="Chapter Title" />
                        </div>
                        <button type="button" class="btn-remove-row" title="Remove chapter" aria-label="Remove chapter">✕</button>
                      </div>
                      <div class="repeater-card-body">
                        <textarea class="ch-summary" rows="2" placeholder="Investigates ontological continuity between living organisms and technical artifacts." aria-label="Chapter Summary"></textarea>
                      </div>
                    </div>
                    <div class="repeater-item repeater-card chapter-row">
                      <div class="repeater-card-header">
                        <div class="repeater-card-lead">
                          <span class="repeater-card-tag">CH.</span>
                          <input type="text" class="ch-num" placeholder="02" value="" aria-label="Chapter Number" />
                        </div>
                        <div class="repeater-card-main">
                          <input type="text" class="ch-title" placeholder="Technical Milieus &amp; Ritual Cohesion" value="" aria-label="Chapter Title" />
                        </div>
                        <button type="button" class="btn-remove-row" title="Remove chapter" aria-label="Remove chapter">✕</button>
                      </div>
                      <div class="repeater-card-body">
                        <textarea class="ch-summary" rows="2" placeholder="Shows how spiritual traditions rely upon material inscriptions and calendar instruments." aria-label="Chapter Summary"></textarea>
                      </div>
                    </div>
                  </div>
                </div>
              </fieldset>
            </form>
          </div>

          <!-- 3. CLASSES & SEMINARS FORM -->
          <div id="form-container-classes" class="type-form-container" hidden>
            <!-- Dedicated Intake Header -->
            <div class="intake-hub-card">
              <div class="intake-hub-header">
                <span class="hub-kicker">✦ ONE-STOP SYLLABUS INTAKE</span>
                <span class="hub-hint">Syllabus PDF Staging &amp; Course Code Initializer</span>
              </div>

              <!-- Universal Dropzone for Syllabi -->
              <div class="universal-dropzone" id="dropzone-class">
                <input type="file" id="file-input-class" accept=".pdf,.md,.txt" hidden />
                <div class="dropzone-visual">
                  <span class="dropzone-icon">📋</span>
                  <div class="dropzone-text">
                    <strong class="dropzone-label">Drop Course Syllabus PDF or Markdown File</strong>
                    <span class="dropzone-sub">Uploads to repository and sets up reading modules</span>
                  </div>
                </div>
              </div>

              <!-- Course Code Initializer Lockup -->
              <div class="intake-quick-row">
                <div class="resolver-input-wrap">
                  <input
                    type="text"
                    id="ingest-class-code-input"
                    placeholder="Enter Course Code (e.g. PHIL 3042 or PHIL 2040)"
                    aria-label="Course Code"
                  />
                </div>
                <button type="button" id="btn-ingest-class-code" class="study-btn study-btn--ignite study-btn--sm">
                  Initialize Course →
                </button>
              </div>
            </div>

            <!-- Syllabus Form Inputs -->
            <form id="form-class-workbench" class="workbench-form">
              <!-- Fieldset 1: Course Identity -->
              <fieldset class="workbench-fieldset">
                <legend class="fieldset-legend">01 · Course Identity &amp; Logistics</legend>
                <div class="form-row-3">
                  <label>
                    <span>Course Code *</span>
                    <input
                      type="text"
                      name="code"
                      id="wb-class-code"
                      placeholder="PHIL 3042"
                      required
                    />
                  </label>
                  <label>
                    <span>Academic Term *</span>
                    <input
                      type="text"
                      name="term"
                      id="wb-class-term"
                      placeholder="Monsoon"
                      required
                    />
                  </label>
                  <label>
                    <span>Academic Year *</span>
                    <input
                      type="text"
                      name="academicYear"
                      id="wb-class-year"
                      placeholder="2025–2026"
                      required
                    />
                  </label>
                </div>

                <div class="form-row-2">
                  <label>
                    <span>Seminar Title *</span>
                    <input
                      type="text"
                      name="title"
                      id="wb-class-title"
                      placeholder="Philosophy of Technology: Organology, the Organic &amp; the Inorganic"
                      required
                    />
                  </label>
                  <label>
                    <span>Pedagogical Level *</span>
                    <select name="level" id="wb-class-level" class="admin-select">
                      <option value="Graduate">Graduate</option>
                      <option value="Undergraduate">Undergraduate</option>
                      <option value="Seminar" selected>Seminar</option>
                    </select>
                  </label>
                </div>

                <div class="form-row-2">
                  <label>
                    <span>Location / Schedule *</span>
                    <input
                      type="text"
                      name="location"
                      id="wb-class-location"
                      placeholder="Ashoka University · Department of Philosophy"
                      required
                    />
                  </label>
                  <label>
                    <span>Syllabus PDF Route</span>
                    <div class="asset-input-row">
                      <input
                        type="text"
                        name="syllabusPdf"
                        id="wb-class-pdf"
                        placeholder="/syllabi/phil-3042.pdf"
                        class="mono"
                      />
                      <div class="asset-drop-inline" id="drop-inline-class-pdf">
                        <input type="file" id="inline-file-class" accept=".pdf" hidden />
                        <span>⇩ Drop PDF</span>
                      </div>
                    </div>
                  </label>
                </div>
              </fieldset>

              <!-- Fieldset 2: Description -->
              <fieldset class="workbench-fieldset">
                <legend class="fieldset-legend">02 · Course Summary &amp; Objectives</legend>
                <label>
                  <span>Course Summary &amp; Objectives *</span>
                  <textarea
                    name="description"
                    id="wb-class-desc"
                    rows="4"
