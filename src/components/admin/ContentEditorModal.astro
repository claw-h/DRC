  function getFieldVal(id: string, fallback: string): string {
    const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
    const val = el?.value.trim();
    return val ? val : (el?.placeholder || fallback);
  }

  function updateTargetSlugDisplay() {
    if (!slugDisplay) return;
    const type = ATELIER_STATE.activeType;
    let slug = ATELIER_STATE.activeId;

    if (!slug) {
      if (type === 'publications') {
        const title = getFieldVal('wb-pub-title', 'epistemic-horizons');
        const year = getFieldVal('wb-pub-year', '2024');
        slug = slugify(`cordry-${year}-${title}`);
      } else if (type === 'books') {
        const title = getFieldVal('wb-book-title', 'technical-objects');
        const year = getFieldVal('wb-book-year', '2025');
        slug = slugify(`book-${title}-${year}`);
      } else {
        const code = getFieldVal('wb-class-code', 'PHIL-3042');
        const title = getFieldVal('wb-class-title', 'philosophy-of-technology');
        slug = slugify(`${code}-${title}`);
      }
    }

    slugDisplay.textContent = `src/data/${type}/${slug}.md`;
  }

