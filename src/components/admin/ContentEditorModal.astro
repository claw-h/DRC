            <div class="repeater-card-body">
              <div class="repeater-card-subhead">
                <span class="subhead-label">Required Readings &amp; Sources (one entry per line)</span>
              </div>
              <textarea class="wk-readings" rows="2" placeholder="Required readings (one per line)" aria-label="Required Readings">${readingsStr}</textarea>
            </div>
          `;
          wkContainer.appendChild(row);
        });
      }
    }

    updateTargetSlugDisplay();
    updateLiveMirror();
  }

  // Global Specimen Record Hover Prefetcher
  (window as any).prefetchContentRecord = async (type: string, id: string) => {
    if (!type || !id) return;
    const key = `${type}:${id}`;
    if (ATELIER_RECORD_CACHE.has(key)) return;
    try {
      const res = await (window as any).postAdmin?.('/api/admin/content', {
        action: 'get-content',
        type,
        id,
      });
      if (res?.ok && res?.data) {
        ATELIER_RECORD_CACHE.set(key, { data: res.data, body: res.body || '', timestamp: Date.now() });
      }
    } catch {}
  };

  // ==========================================
  // GLOBAL SINGLETON DISPATCHER (0ms Instant Modal + Distributed Lazy Loading)
  // ==========================================

  (window as any).openContentEditor = async (options: OpenContentEditorOptions = {}) => {
    ATELIER_STATE.lastFocused = document.activeElement as HTMLElement | null;
    ATELIER_STATE.activeMode = options.mode || 'create';
    ATELIER_STATE.savedCallback = options.onSaved || null;

    const targetType = options.type || 'publications';
    ATELIER_STATE.activeType = targetType;
    setDirty(false);

    // 1. OPEN PERSISTENT MODAL IMMEDIATELY ON FIRST FRAME (0ms Latency!)
    if (dialog && !dialog.open) {
      dialog.removeAttribute('data-closing');
      dialog.show();
      const backdrop = document.getElementById('content-editor-backdrop');
      backdrop?.classList.add('is-visible');
    }

    if (options.mode === 'edit' && options.id) {
      ATELIER_STATE.activeId = options.id;
      ATELIER_STATE.originalEditType = targetType;
      ATELIER_STATE.originalEditId = options.id;

      setDomainType(targetType);
      setViewMode('split'); // Open in Split View so they see form + preview immediately

      const cacheKey = `${targetType}:${options.id}`;
      const cached = ATELIER_RECORD_CACHE.get(cacheKey);

      // Case 1: Record already in memory cache (Instant 0ms display!)
      if (cached) {
        setAtelierLoading(false);
        populateAtelierForm(targetType, cached.data, cached.body);
        return;
      }

      // Case 2: Preliminary record data available in local catalog
      const catalogItem = (window as any).__DRC_CATALOG?.[targetType]?.find?.((it: any) => it.id === options.id);
      if (catalogItem?.data) {
        populateAtelierForm(targetType, catalogItem.data, catalogItem.body || '');
        setAtelierLoading(true, `Syncing full archival record for ${options.id}…`, true);
      } else {
        // Case 3: Fresh record, display animated astrolabe skeleton loader
        setAtelierLoading(true, `Retrieving ${options.id} from ${targetType}…`, false);
      }

      // Asynchronous background lazy fetch
      try {
        const res = await (window as any).postAdmin?.('/api/admin/content', {
          action: 'get-content',
          type: targetType,
          id: options.id,
        });

        if (res?.ok && res?.data) {
          ATELIER_RECORD_CACHE.set(cacheKey, { data: res.data, body: res.body || '', timestamp: Date.now() });
          populateAtelierForm(targetType, res.data, res.body || '');
          setAtelierLoading(false);
        } else {
          setAtelierError(res?.error || 'Could not load record details.', () => {
            (window as any).openContentEditor?.(options);
          });
        }
      } catch (err: any) {
        setAtelierError(`Failed to fetch record: ${err.message}`, () => {
          (window as any).openContentEditor?.(options);
        });
      }
    } else {
      // Create New Record Mode
      ATELIER_STATE.activeId = '';
      ATELIER_STATE.originalEditType = '';
      ATELIER_STATE.originalEditId = '';
      setAtelierLoading(false);

      setDomainType(targetType);

      const pubForm = document.getElementById('form-pub-workbench') as HTMLFormElement | null;
      const bookForm = document.getElementById('form-book-workbench') as HTMLFormElement | null;
      const classForm = document.getElementById('form-class-workbench') as HTMLFormElement | null;
      pubForm?.reset();
      bookForm?.reset();
      classForm?.reset();

      // Clear repeater rows
      const chContainer = document.getElementById('wb-chapters-container');
      if (chContainer) chContainer.innerHTML = '';
      const wkContainer = document.getElementById('wb-weeks-container');
      if (wkContainer) wkContainer.innerHTML = '';

      setViewMode('focus');
      updateTargetSlugDisplay();
      updateLiveMirror();
    }
  };
</script>

