<script>
  interface OpenContentEditorOptions {
    type?: 'publications' | 'books' | 'classes';
    mode?: 'create' | 'edit';
    id?: string;
    initialData?: Record<string, any>;
    onSaved?: (item: any) => void;
  }

  const dialog = document.getElementById('content-editor-modal') as HTMLDialogElement | null;
  const dialogBackdrop = document.getElementById('content-editor-backdrop');
  // The admin shell creates a stacking context for its fixed chrome. Keep the
  // non-modal atelier at document level so it can layer above that chrome.
  if (dialog && dialogBackdrop && dialog.parentElement !== document.body) {
    document.body.append(dialogBackdrop, dialog);
  }
  const modalShell = document.getElementById('content-modal-shell');
  const crumbType = document.getElementById('atelier-breadcrumb-type');
  const crumbState = document.getElementById('atelier-breadcrumb-state');
  const domainKicker = document.getElementById('atelier-domain-kicker');
  const titleDisplay = document.getElementById('content-modal-title');
  const modeChip = document.getElementById('editor-mode-chip');
  const slugDisplay = document.getElementById('editor-slug-display');
  const syncIndicator = document.getElementById('editor-sync-indicator');
  const saveBtn = document.getElementById('btn-save-content-modal') as HTMLButtonElement | null;
  const saveLabel = document.getElementById('btn-save-label');
  const closeBtn = document.getElementById('btn-close-content-modal');
  const cancelBtn = document.getElementById('btn-cancel-content-modal');
  const toggleViewBtn = document.getElementById('btn-toggle-view-mode');
  const toggleViewLabel = document.getElementById('btn-view-toggle-label');
  const headerPreviewBtn = document.getElementById('btn-header-preview-toggle') as HTMLButtonElement | null;
  const headerPreviewLabel = document.getElementById('header-preview-label');

  // Stage Panes
  const stageWorkbench = document.getElementById('stage-workbench-pane');
  const stageMirror = document.getElementById('stage-mirror-pane');
  const mainStage = document.getElementById('studio-main-stage');

  // Segmented Type Switcher Pills & Nav
  const typePillNav = document.getElementById('atelier-type-pill-nav');
  const typePills = document.querySelectorAll<HTMLButtonElement>('.type-pill');

  // Ingestion & Form Containers
  const formContainers = document.querySelectorAll<HTMLElement>('.type-form-container');
  const previewBoxes = document.querySelectorAll<HTMLElement>('.public-preview-card');
  const mirrorTypeTag = document.getElementById('mirror-type-tag');

  // Active Atelier State
  const ATELIER_STATE = {
    activeType: 'publications' as 'publications' | 'books' | 'classes',
    activeMode: 'create' as 'create' | 'edit',
    showPreview: false,
    activeId: '',
    originalEditType: '' as 'publications' | 'books' | 'classes' | '',
    originalEditId: '',
    isDirty: false,
    savedCallback: null as ((item: any) => void) | null,
    lastFocused: null as HTMLElement | null,
  };

  // Helper to slugify
  function slugify(input: string): string {
    return input
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '')
      .slice(0, 72);
  }

  function setDirty(dirty: boolean) {
    ATELIER_STATE.isDirty = dirty;
    if (syncIndicator) {
      if (dirty) {
        syncIndicator.textContent = '● Unsaved changes';
        syncIndicator.className = 'sync-indicator is-dirty';
      } else {
        syncIndicator.textContent = '✓ Ready to commit';
        syncIndicator.className = 'sync-indicator';
      }
    }
  }

  // Close Studio with Smooth Cubic Bezier Transition
  function closeStudio() {
    if (!dialog || !dialog.open) return;
    const backdrop = document.getElementById('content-editor-backdrop');
    dialog.setAttribute('data-closing', 'true');
    backdrop?.classList.remove('is-visible');
    setTimeout(() => {
      dialog.close();
      dialog.removeAttribute('data-closing');
      if (ATELIER_STATE.lastFocused) {
        ATELIER_STATE.lastFocused.focus();
        ATELIER_STATE.lastFocused = null;
      }
    }, 320);
  }

  (window as any).closeContentStudio = closeStudio;

  closeBtn?.addEventListener('click', closeStudio);
  cancelBtn?.addEventListener('click', closeStudio);

  const backdropEl = document.getElementById('content-editor-backdrop');
  backdropEl?.addEventListener('click', closeStudio);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && dialog?.open && !dialog.hasAttribute('data-closing')) {
      closeStudio();
    }
  });

  dialog?.addEventListener('cancel', (e) => {
    e.preventDefault();
    closeStudio();
  });

  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) {
      closeStudio();
    }
  });

  // ==========================================
  // PREVIEW TOGGLE (Live Reader Mirror)
  // Replaces the 2-button Focus/Split View segmented group
  // ==========================================

  function setPreviewState(show: boolean) {
    ATELIER_STATE.showPreview = show;

    // Synchronize Header Preview Button
    if (headerPreviewBtn) {
      headerPreviewBtn.classList.toggle('is-active', show);
      headerPreviewBtn.setAttribute('aria-pressed', show ? 'true' : 'false');
    }
    if (headerPreviewLabel) {
      headerPreviewLabel.textContent = show ? 'Hide Preview' : 'Preview';
    }

    // Synchronize Dock Preview Button
    if (toggleViewBtn) {
      toggleViewBtn.classList.toggle('is-active', show);
      toggleViewBtn.setAttribute('aria-pressed', show ? 'true' : 'false');
    }
    if (toggleViewLabel) {
      toggleViewLabel.textContent = show ? 'Hide Preview' : 'Preview';
    }

    // Synchronize Stage Layout
    if (!mainStage) return;
    mainStage.classList.toggle('is-split-mode', show);
    mainStage.classList.toggle('is-focus-mode', !show);

    if (show) {
      if (stageWorkbench) stageWorkbench.hidden = false;
      if (stageMirror) stageMirror.hidden = false;
      updateLiveMirror();
    } else {
      if (stageWorkbench) stageWorkbench.hidden = false;
      if (stageMirror) stageMirror.hidden = true;
    }
  }

  function togglePreview() {
    setPreviewState(!ATELIER_STATE.showPreview);
  }

  // Backward compatibility alias for auto-switching callers
  function setViewMode(mode: 'focus' | 'split') {
    setPreviewState(mode === 'split');
  }

  headerPreviewBtn?.addEventListener('click', togglePreview);
  toggleViewBtn?.addEventListener('click', togglePreview);

  // ==========================================
  // BREADCRUMBS & TYPE SWITCHER (Publication | Monograph | Syllabus)
  // ==========================================

  function updateHeaderBreadcrumbs() {
    const type = ATELIER_STATE.activeType;
    const isEdit = ATELIER_STATE.activeMode === 'edit' && Boolean(ATELIER_STATE.activeId);

    // 1. Breadcrumb Type Segment
    if (crumbType) {
      if (type === 'publications') crumbType.textContent = '01 · Publication';
      else if (type === 'books') crumbType.textContent = '02 · Monograph';
      else crumbType.textContent = '03 · Syllabus';
    }

    // 2. Breadcrumb State Segment & File Tag
    const fileTagEl = document.getElementById('atelier-file-tag');
    if (crumbState) {
      if (isEdit) {
        crumbState.textContent = 'Edit Record';
      } else {
        if (type === 'publications') crumbState.textContent = 'New Manuscript';
        else if (type === 'books') crumbState.textContent = 'New Volume';
        else crumbState.textContent = 'New Course';
      }
    }

    if (fileTagEl) {
      if (isEdit && ATELIER_STATE.activeId) {
        fileTagEl.hidden = false;
        fileTagEl.textContent = `#${ATELIER_STATE.activeId}`;
        fileTagEl.title = `File Identifier: ${ATELIER_STATE.activeId}`;
      } else {
        fileTagEl.hidden = true;
        fileTagEl.textContent = '';
      }
    }

    // 3. Backward-Compatible Domain Kicker
    if (domainKicker) {
      if (type === 'publications') domainKicker.textContent = 'ARTICLE & MANUSCRIPT ATELIER';
      else if (type === 'books') domainKicker.textContent = 'MONOGRAPH ATELIER';
      else domainKicker.textContent = 'SEMINAR SYLLABUS ATELIER';
    }

    // 4. Modal Header Title Display
    if (titleDisplay) {
      if (isEdit) {
        if (type === 'publications') titleDisplay.textContent = 'Edit Manuscript Record';
        else if (type === 'books') titleDisplay.textContent = 'Edit Monograph Volume';
        else titleDisplay.textContent = 'Edit Course Syllabus';
      } else {
        if (type === 'publications') titleDisplay.textContent = 'New Manuscript Dispatch';
        else if (type === 'books') titleDisplay.textContent = 'New Monograph Volume';
        else titleDisplay.textContent = 'New Course Syllabus';
      }
    }

    // 5. Mode Status Chip
    if (modeChip) {
      if (isEdit) {
        modeChip.textContent = 'EDIT MODE';
        modeChip.className = 'status-chip is-edit';
      } else {
        modeChip.textContent = 'READY';
        modeChip.className = 'status-chip';
      }
    }

    // 6. Save Button Label
    if (saveLabel) {
      if (isEdit) {
        saveLabel.textContent = 'Save Changes';
      } else {
        saveLabel.textContent = type === 'publications' ? 'Save Article' : type === 'books' ? 'Save Monograph' : 'Save Syllabus';
      }
    }

    // 7. Mirror Reader Mode Tag
    if (mirrorTypeTag) {
      if (type === 'publications') mirrorTypeTag.textContent = 'ARTICLE PREVIEW';
      else if (type === 'books') mirrorTypeTag.textContent = 'MONOGRAPH PREVIEW';
      else mirrorTypeTag.textContent = 'SYLLABUS PREVIEW';
    }

    // 8. Context-Aware Type Switcher Visibility:
    // Only display the 3-button switcher when CREATING new records.
    // When EDITING an existing publication, monograph, or syllabus, hide the switcher completely
    // so the atelier is strictly context-aware and dedicated solely to that category.
    if (typePillNav) {
      typePillNav.hidden = isEdit;
      typePillNav.classList.toggle('is-hidden', isEdit);
    }
  }

  function setDomainType(type: 'publications' | 'books' | 'classes') {
    // If switching types from an active edit session of a different type
    if (ATELIER_STATE.activeMode === 'edit' && ATELIER_STATE.activeType !== type) {
      if (ATELIER_STATE.originalEditType === type && ATELIER_STATE.originalEditId) {
        ATELIER_STATE.activeMode = 'edit';
        ATELIER_STATE.activeId = ATELIER_STATE.originalEditId;
      } else {
        ATELIER_STATE.activeMode = 'create';
        ATELIER_STATE.activeId = '';
      }
    }

    ATELIER_STATE.activeType = type;

    // Update Type Pills
    typePills.forEach((p) => {
      const match = p.dataset.type === type;
      p.classList.toggle('is-active', match);
      p.setAttribute('aria-selected', match ? 'true' : 'false');
    });

    // Update Breadcrumbs & Labels across the modal
    updateHeaderBreadcrumbs();

    // Toggle Forms: STRICTLY SHOW ONLY ACTIVE FORM
    formContainers.forEach((fc) => {
      const isMatch = fc.id === `form-container-${type}`;
      fc.classList.toggle('is-active', isMatch);
      fc.hidden = !isMatch;
    });

    // Toggle Previews: STRICTLY SHOW ONLY ACTIVE PREVIEW
    previewBoxes.forEach((pv) => {
      const isMatch = pv.id === `preview-box-${type}`;
      pv.classList.toggle('is-active', isMatch);
      pv.hidden = !isMatch;
    });

    updateTargetSlugDisplay();
    updateLiveMirror();
  }

  typePills.forEach((pill) => {
    pill.addEventListener('click', () => {
      if (ATELIER_STATE.activeMode === 'edit') return;
      const t = pill.dataset.type as any;
      if (t && t !== ATELIER_STATE.activeType) {
        setDomainType(t);
      }
    });
  });

