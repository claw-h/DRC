  const ATELIER_RECORD_CACHE = new Map<string, { data: any; body: string; timestamp: number }>();

  function setAtelierLoading(loading: boolean, message?: string, isSilentSync: boolean = false) {
    const shell = document.getElementById('content-modal-shell');
    const chip = document.getElementById('editor-mode-chip');
    const breadcrumbState = document.getElementById('atelier-breadcrumb-state');
    const scrim = document.getElementById('atelier-lazy-scrim');
    const syncPill = document.getElementById('atelier-sync-pill');
    const syncText = document.getElementById('atelier-sync-text');
    const errorCard = document.getElementById('atelier-error-card');

    if (errorCard) errorCard.hidden = true;

    if (loading) {
      shell?.classList.add('is-atelier-loading');
      if (isSilentSync) {
        if (scrim) scrim.hidden = true;
        if (syncPill) {
          if (syncText && message) syncText.textContent = message;
          syncPill.hidden = false;
        }
        if (chip) chip.textContent = 'SYNCING ✦';
      } else {
        if (syncPill) syncPill.hidden = true;
        if (scrim) {
          scrim.hidden = false;
          const scrimTitle = document.getElementById('lazy-scrim-title');
          if (scrimTitle && message) scrimTitle.textContent = message;
        }
        if (chip) chip.textContent = 'RETRIEVING ✦';
      }
      if (breadcrumbState && message) {
        breadcrumbState.textContent = message;
      }
    } else {
      shell?.classList.remove('is-atelier-loading');
      if (scrim) scrim.hidden = true;
      if (syncPill) syncPill.hidden = true;
      if (chip) chip.textContent = ATELIER_STATE.activeMode === 'edit' ? 'EDITING' : 'READY';
      if (breadcrumbState) {
        breadcrumbState.textContent = ATELIER_STATE.activeMode === 'edit' ? (ATELIER_STATE.activeId || 'Active Record') : 'New Intake';
      }
    }
  }

  function setAtelierError(errorMsg: string, retryFn?: () => void) {
    setAtelierLoading(false);
    const errorCard = document.getElementById('atelier-error-card');
    const errorText = document.getElementById('atelier-error-msg');
    const retryBtn = document.getElementById('btn-retry-atelier-fetch') as HTMLButtonElement | null;
    if (errorCard) {
      if (errorText) errorText.textContent = errorMsg;
      errorCard.hidden = false;
      if (retryBtn) {
        retryBtn.onclick = () => {
          errorCard.hidden = true;
          retryFn?.();
        };
      }
    }
    (window as any).notify?.(errorMsg, 'error');
  }

