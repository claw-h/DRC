        (window as any).notify?.('Monograph title is required.', 'warn');
        document.getElementById('wb-book-title')?.focus();
        return;
      }

      const chapterRows = document.querySelectorAll<HTMLElement>('#wb-chapters-container .chapter-row');
      const chapters: Array<{ number: string; title: string; summary: string }> = [];
      chapterRows.forEach((row) => {
        const num = (row.querySelector('.ch-num') as HTMLInputElement)?.value.trim() || '01';
        const t = (row.querySelector('.ch-title') as HTMLInputElement)?.value.trim() || '';
        const s = (row.querySelector('.ch-summary') as HTMLInputElement | HTMLTextAreaElement)?.value.trim() || '';
        if (t) chapters.push({ number: num, title: t, summary: s });
      });

      payload = {
        action: 'create-book',
        existingId,
        title,
        subtitle: (document.getElementById('wb-book-subtitle') as HTMLInputElement)?.value.trim(),
        year: Number((document.getElementById('wb-book-year') as HTMLInputElement)?.value) || 2026,
        publisher: (document.getElementById('wb-book-publisher') as HTMLInputElement)?.value.trim(),
        isbn: (document.getElementById('wb-book-isbn') as HTMLInputElement)?.value.trim(),
        pages: Number((document.getElementById('wb-book-pages') as HTMLInputElement)?.value) || 200,
        coverImage: (document.getElementById('wb-book-cover') as HTMLInputElement)?.value.trim(),
        synopsis: (document.getElementById('wb-book-synopsis') as HTMLTextAreaElement)?.value.trim() || '',
        chapters,
      };
    } else if (type === 'classes') {
      const title = (document.getElementById('wb-class-title') as HTMLInputElement)?.value.trim();
      const code = (document.getElementById('wb-class-code') as HTMLInputElement)?.value.trim();
      if (!title || !code) {
        (window as any).notify?.('Course code and seminar title are required.', 'warn');
        return;
      }

      const weekRows = document.querySelectorAll<HTMLElement>('#wb-weeks-container .week-row');
      const weeks: Array<{ weekNumber: string; topic: string; readings: string[] }> = [];
      weekRows.forEach((row) => {
        const wkNum = (row.querySelector('.wk-num') as HTMLInputElement)?.value.trim() || 'WK 01';
        const topic = (row.querySelector('.wk-topic') as HTMLInputElement)?.value.trim() || '';
        const readings = (row.querySelector('.wk-readings') as HTMLTextAreaElement)?.value.split('\n').map((r) => r.trim()).filter(Boolean) || [];
        if (topic) weeks.push({ weekNumber: wkNum, topic, readings });
      });

      payload = {
        action: 'create-class',
        existingId,
        code,
        title,
        term: (document.getElementById('wb-class-term') as HTMLInputElement)?.value.trim(),
        academicYear: (document.getElementById('wb-class-year') as HTMLInputElement)?.value.trim(),
        level: (document.getElementById('wb-class-level') as HTMLSelectElement)?.value || 'Seminar',
        location: (document.getElementById('wb-class-location') as HTMLInputElement)?.value.trim(),
        syllabusPdf: (document.getElementById('wb-class-pdf') as HTMLInputElement)?.value.trim(),
        description: (document.getElementById('wb-class-desc') as HTMLTextAreaElement)?.value.trim(),
        weeks,
      };
    }

    if (saveBtn) saveBtn.disabled = true;
    (window as any).notify?.('Committing record to sovereign repository…', 'info');

    try {
      const res = await (window as any).postAdmin?.('/api/admin/content', payload);
      if (saveBtn) saveBtn.disabled = false;

      if (res?.ok) {
        setDirty(false);
        const savedId = res.slug || existingId;
        if (savedId) {
          ATELIER_RECORD_CACHE.set(`${type}:${savedId}`, {
            data: res.item?.data || payload,
            body: res.item?.body || '',
            timestamp: Date.now(),
          });
          if ((window as any).__DRC_CATALOG?.[type]) {
            const list = (window as any).__DRC_CATALOG[type];
            const idx = list.findIndex((it: any) => it.id === savedId);
            if (idx >= 0) {
              list[idx] = { id: savedId, data: res.item?.data || payload };
            } else {
              list.unshift({ id: savedId, data: res.item?.data || payload });
            }
          }
        }

        (window as any).notify?.(res.message || 'Record committed successfully!', 'success');

        window.dispatchEvent(
          new CustomEvent('drc:content-updated', {
            detail: {
              type,
              action: isEdit ? 'update' : 'create',
              id: res.slug || existingId,
              item: res.item,
            },
          })
        );

        if (ATELIER_STATE.savedCallback) {
          ATELIER_STATE.savedCallback({ type, id: res.slug || existingId, item: res.item });
        }

        closeStudio();
      } else {
        (window as any).notify?.(res?.error || 'Failed to commit record.', 'error');
      }
    } catch (err: any) {
      if (saveBtn) saveBtn.disabled = false;
      (window as any).notify?.(`Network error: ${err.message}`, 'error');
    }
  });

