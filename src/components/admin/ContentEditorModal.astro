  // ==========================================
  // NATIVE FILE DRAG-AND-DROP UPLOAD PIPELINE
  // ==========================================

  function setupFileUploader(
    dropzoneEl: HTMLElement | null,
    fileInputEl: HTMLInputElement | null,
    onFileReady: (file: File) => Promise<void>
  ) {
    if (!dropzoneEl) return;

    dropzoneEl.addEventListener('click', () => fileInputEl?.click());

    fileInputEl?.addEventListener('change', async () => {
      const file = fileInputEl.files?.[0];
      if (file) await onFileReady(file);
    });

    ['dragenter', 'dragover'].forEach((eventName) => {
      dropzoneEl.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzoneEl.classList.add('is-drag-over');
      });
    });

    ['dragleave', 'drop'].forEach((eventName) => {
      dropzoneEl.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzoneEl.classList.remove('is-drag-over');
      });
    });

    dropzoneEl.addEventListener('drop', async (e: DragEvent) => {
      const file = e.dataTransfer?.files?.[0];
      if (file) await onFileReady(file);
    });
  }

  // Publication Dropzone
  setupFileUploader(
    document.getElementById('dropzone-pub'),
    document.getElementById('file-input-pub') as HTMLInputElement,
    async (file: File) => {
      if (file.name.endsWith('.bib')) {
        const text = await file.text();
        const res = await (window as any).postAdmin?.('/api/admin/content', {
          action: 'parse-bibtex',
          bibtex: text,
        });
        if (res?.ok && res?.metadata) {
          const m = res.metadata;
          (document.getElementById('wb-pub-title') as HTMLInputElement).value = m.title || '';
          (document.getElementById('wb-pub-year') as HTMLInputElement).value = String(m.year || 2026);
          (document.getElementById('wb-pub-venue') as HTMLInputElement).value = m.venue || '';
          (document.getElementById('wb-pub-volume') as HTMLInputElement).value = m.volumeIssue || '';
          (document.getElementById('wb-pub-doi') as HTMLInputElement).value = m.doi || '';
          (document.getElementById('wb-pub-authors') as HTMLInputElement).value = (m.coAuthors || []).join(', ');
          (document.getElementById('wb-pub-abstract') as HTMLTextAreaElement).value = m.abstract || '';
          (document.getElementById('wb-pub-bibtex') as HTMLTextAreaElement).value = m.citationBibtex || text;
          setDirty(true);
          updateTargetSlugDisplay();
          updateLiveMirror();
          setViewMode('split');
          (window as any).notify?.('Populated fields from dropped BibTeX file!', 'success');
        }
        return;
      }

      // PDF Upload
      (window as any).notify?.(`Uploading manuscript "${file.name}"…`, 'info');
      const reader = new FileReader();
      reader.onload = async () => {
        const dataUrl = reader.result as string;
        const res = await (window as any).postAdmin?.('/api/admin/content', {
          action: 'upload-document',
          type: 'publications',
          fileName: file.name,
          dataUrl,
        });

        if (res?.ok && res?.fileUrl) {
          (document.getElementById('wb-pub-pdf') as HTMLInputElement).value = res.fileUrl;
          const inferredTitle = file.name.replace(/\.[^/.]+$/, '').replace(/[-_]+/g, ' ');
          const titleInput = document.getElementById('wb-pub-title') as HTMLInputElement;
          if (!titleInput.value) titleInput.value = inferredTitle;

          setDirty(true);
          updateTargetSlugDisplay();
          updateLiveMirror();
          setViewMode('split');
          (window as any).notify?.(`Manuscript attached: ${res.fileUrl}`, 'success');
        } else {
          (window as any).notify?.(res?.error || 'Document upload failed.', 'error');
        }
      };
      reader.readAsDataURL(file);
    }
  );

  // Inline Publication PDF Drop
  setupFileUploader(
    document.getElementById('drop-inline-pub-pdf'),
    document.getElementById('inline-file-pub') as HTMLInputElement,
    async (file: File) => {
      (window as any).notify?.(`Uploading replacement PDF "${file.name}"…`, 'info');
      const reader = new FileReader();
      reader.onload = async () => {
        const res = await (window as any).postAdmin?.('/api/admin/content', {
          action: 'upload-document',
          type: 'publications',
          fileName: file.name,
          dataUrl: reader.result as string,
        });
        if (res?.ok && res?.fileUrl) {
          (document.getElementById('wb-pub-pdf') as HTMLInputElement).value = res.fileUrl;
          setDirty(true);
          (window as any).notify?.(`Updated manuscript file route: ${res.fileUrl}`, 'success');
        }
