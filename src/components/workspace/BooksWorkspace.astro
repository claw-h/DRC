---
interface Props {
  books: any[];
}

const { books } = Astro.props;
const sortedBooks = [...books].sort((a, b) => b.data.year - a.data.year);
---

<section
  id="view-books"
  class="spa-view workspace-split inactive"
  data-view-idx="1"
  tabindex="-1"
  aria-label="Books and Monographs"
>
  <!-- LEFT PANE: Subgrid Cover Catalog (with Close Index button inside the index pane) -->
  <aside class="workspace-pane-left">
    <div class="pane-inner-scroll" data-scrollable-pane>
      <header class="pane-toolbar">
        <div class="pane-toolbar-title">
          <span class="section-fleuron" aria-hidden="true">§</span>
          <h2 class="pane-heading">
            Monographs <span class="count-badge tabular">[{String(sortedBooks.length).padStart(2, '0')}]</span>
          </h2>
        </div>
        <button
          type="button"
          class="pane-close-index-btn tabular"
          data-collapse-index
          aria-label="Close Index Pane"
          title="Close left index pane"
        >
          ◁ Close Index
        </button>
      </header>

      <ul class="book-catalog-grid" role="list">
        {sortedBooks.map((book, idx) => (
          <li class="book-card-item">
            <button
              type="button"
              class="book-card"
              aria-current={idx === 0 ? 'true' : 'false'}
              data-book-select={book.data.id}
            >
              <div class="book-cover-frame">
                <img
                  src={book.data.coverImage}
                  alt={`Cover of ${book.data.title}`}
                  width="200"
                  height="300"
                  loading="lazy"
                  class="book-cover-thumb"
                />
                <span class="book-slot-tag tabular">VOL.{String(idx + 1).padStart(2, '0')}</span>
              </div>
              <span style="font-size: 0.85rem; font-weight: 500; line-height: 1.3; color: var(--text-primary); font-family: var(--font-serif);">
                {book.data.title}
              </span>
              <span class="tabular" style="font-size: 0.7rem; color: var(--text-muted);">
                {book.data.publisher} · {book.data.year}
              </span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </aside>

  <!-- RIGHT PANE: Size-Aware Monograph Dossier -->
  <div class="workspace-pane-right">
    <button
      type="button"
      class="pane-reopen-index-btn tabular"
      data-expand-index
      aria-label="Open Index Pane"
      title="Re-open left index pane"
    >
      ▷ Open Index
    </button>

    <div class="pane-inner-scroll book-dossier-container" data-scrollable-pane data-primary-reader>
      <div class="mobile-back-bar">
        <button type="button" class="btn-mobile-back tabular" data-stack-back>
          ◄ Back to Monographs
        </button>
        <span class="tabular" style="font-size: 0.7rem; color: var(--text-muted);">MONOGRAPH DOSSIER</span>
      </div>

      <!-- Top Return Horizon Cue: Books -> Publications -->
      <div class="scroll-horizon-top-cue" data-jump-view="view-publications">
        <span class="scholarly-caps">↑ Advance scroll upwards to return to I · PUBLICATIONS</span>
      </div>

      {sortedBooks.map((book, idx) => {
        const b = book.data;
        return (
          <article
            class:list={['book-dossier-entry', { 'entry-hidden': idx !== 0 }]}
            data-book-entry={b.id}
          >
            <header class="dossier-hero">
              <div class="dossier-cover-showcase" data-open-book-tome={b.id} role="button" tabindex="0" title="Inspect Monograph Colophon & Chapters" style="cursor: pointer;">
                <img
                  src={b.coverImage}
                  alt={`Cover of ${b.title}`}
                  width="240"
                  height="360"
                  style="border-radius: 6px; border: 1px solid var(--border-subtle); box-shadow: 0 22px 44px -12px oklch(0% 0 0 / 0.65); aspect-ratio: 2 / 3; object-fit: cover; transition: transform 0.2s ease, box-shadow 0.2s ease;"
                />
              </div>

              <div class="dossier-meta-lockup">
                <div class="reader-eyebrow-row">
                  <span class="fascicle-tag tabular">
                    FOLIO {b.id.toUpperCase()} · {b.year}
                  </span>
                  <span class="colophon-stamp scholarly-caps">PUBLISHED MONOGRAPH</span>
                </div>
                <h3 class="reader-main-title" data-scramble-title>
                  {b.title}
                </h3>
                {b.subtitle && (
                  <p style="font-family: var(--font-serif); font-style: italic; font-size: 1.15rem; color: var(--text-secondary); margin-block-end: 1rem;">
                    {b.subtitle}
                  </p>
                )}

                <dl class="tabular colophon-specs-grid">
                  <div>
                    <dt>PUBLISHER</dt>
                    <dd>{b.publisher}</dd>
                  </div>
                  <div>
                    <dt>ISBN-13</dt>
                    <dd><code>{b.isbn}</code></dd>
                  </div>
                  <div>
                    <dt>EXTENT</dt>
                    <dd>{b.pages} Pages</dd>
                  </div>
                </dl>

                <div style="display: flex; flex-wrap: wrap; gap: 0.6rem;">
                  {b.purchaseLinks.map((link: any) => (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="pill"
                      style="text-decoration: none; color: var(--text-primary); padding: 0.45rem 0.85rem;"
                    >
                      {link.label} ↗
                    </a>
                  ))}
                  <button
                    type="button"
                    class="pill btn-open-book-tome"
                    data-open-book-tome={b.id}
                    style="color: var(--accent); border-color: color-mix(in oklab, var(--accent) 45%, var(--border-subtle)); padding: 0.45rem 0.85rem;"
                  >
                    📖 Monograph Colophon &amp; Chapters
                  </button>
                </div>
              </div>
            </header>

            <section class="manuscript-abstract-vellum bookplate-frame" style="margin-block-end: 2rem;">
              <div class="bookplate-corner bookplate-corner--tl" aria-hidden="true">❦</div>
              <div class="bookplate-corner bookplate-corner--tr" aria-hidden="true">❦</div>
              <div class="bookplate-corner bookplate-corner--bl" aria-hidden="true">❦</div>
              <div class="bookplate-corner bookplate-corner--br" aria-hidden="true">❦</div>
              <h4 class="scholarly-caps" style="font-size: 0.74rem; letter-spacing: 0.14em; color: var(--accent); margin-block-end: 0.5rem;">
                SYNOPSIS · EDITORIAL DOSSIER
              </h4>
              <p style="font-size: 0.98rem; color: var(--text-primary); line-height: 1.68; font-family: var(--font-serif);">
                {b.synopsis}
              </p>
            </section>

            {b.endorsements.length > 0 && (
              <section style="margin-block-end: 2rem;">
                <h4 class="tabular" style="font-size: 0.74rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-block-end: 0.65rem;">
                  Critical Reception
                </h4>
                <div style="display: flex; flex-direction: column; gap: 0.85rem;">
                  {b.endorsements.map((end: any) => (
                    <figure style="padding: 1rem 1.25rem; border-inline-start: 2px solid var(--accent); background: var(--bg-elevated); border-radius: 0 6px 6px 0;">
                      <blockquote cite={end.citeUrl || ''}>
                        <p style="font-family: var(--font-serif); font-style: italic; font-size: 1.08rem; margin-block-end: 0.35rem;">
                          “{end.quote}”
                        </p>
                      </blockquote>
                      <figcaption class="tabular" style="font-size: 0.74rem; color: var(--text-muted);">
                        — <cite>{end.sourceTitle}</cite>
                      </figcaption>
                    </figure>
                  ))}
                </div>
              </section>
            )}

            {b.chapters.length > 0 && (
              <section>
                <h4 class="tabular" style="font-size: 0.74rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-block-end: 0.65rem;">
                  Table of Contents
                </h4>
                <div>
                  {b.chapters.map((ch: any) => (
                    <details class="academic-accordion" open>
                      <summary>
                        <span class="tabular" style="color: var(--accent); font-size: 0.8rem;">CH {ch.number}</span>
                        <span>{ch.title}</span>
                      </summary>
                      <div class="accordion-body">
                        <p>{ch.summary}</p>
                      </div>
                    </details>
                  ))}
                </div>
              </section>
            )}
          </article>
        );
      })}

      <!-- Folio Turn Progression: Books -> Classes -->
      <div class="folio-turn-bridge" data-jump-view="view-classes">
        <div class="horizon-bridge-meta">
          <span class="horizon-kicker scholarly-caps">FOLIO TURN · ADVANCE TO NEXT FASCICLE</span>
          <strong class="horizon-title">III · CLASSES →</strong>
        </div>
        <div class="horizon-charge-track">
          <div class="horizon-charge-fill" data-scroll-charge-fill></div>
        </div>
        <span class="horizon-hint scholarly-caps">Advance scroll to turn folio into Classes</span>
      </div>
    </div>
  </div>
</section>


<style>
  .entry-hidden {
    display: none;
  }
  .btn-mobile-back {
    font-size: 0.75rem;
    padding: 0.35rem 0.7rem;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
    background: var(--bg-elevated);
    color: var(--accent);
    cursor: pointer;
  }
</style>
