---
interface Props {
  books: any[];
}

const { books } = Astro.props;
const sortedBooks = [...books].sort((a, b) => b.data.year - a.data.year);
---

<section
  id="view-books"
  class="spa-view workspace-split inactive"
  tabindex="-1"
  aria-label="Books and Monographs"
>
  <!-- LEFT PANE: Subgrid Cover Catalog -->
  <aside class="workspace-pane-left">
    <div class="pane-inner-scroll">
      <header class="pane-toolbar">
        <h2 class="pane-heading">
          Monographs <span class="count-badge tabular">[{String(sortedBooks.length).padStart(2, '0')}]</span>
        </h2>
      </header>

      <ul class="book-catalog-grid" role="list">
        {sortedBooks.map((book, idx) => (
          <li class="book-card-item">
            <button
              type="button"
              class="book-card"
              aria-current={idx === 0 ? 'true' : 'false'}
              data-book-select={book.data.id}
            >
              <img
                src={book.data.coverImage}
                alt={`Cover of ${book.data.title}`}
                width="200"
                height="300"
                loading="lazy"
                class="book-cover-thumb"
              />
              <span style="font-size: 0.85rem; font-weight: 500; line-height: 1.3; color: var(--text-primary);">
                {book.data.title}
              </span>
              <span class="tabular" style="font-size: 0.7rem; color: var(--text-muted);">
                {book.data.publisher} · {book.data.year}
              </span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </aside>

  <!-- RIGHT PANE: Size-Aware Monograph Dossier -->
  <div class="workspace-pane-right">
    <div class="pane-inner-scroll book-dossier-container">
      <div class="mobile-back-bar">
        <button type="button" class="btn-mobile-back tabular" data-stack-back>
          ◄ Back to Monographs
        </button>
        <span class="tabular" style="font-size: 0.7rem; color: var(--text-muted);">MONOGRAPH DOSSIER</span>
      </div>

      {sortedBooks.map((book, idx) => {
        const b = book.data;
        return (
          <article
            class:list={['book-dossier-entry', { 'entry-hidden': idx !== 0 }]}
            data-book-entry={b.id}
            style="padding: clamp(1.25rem, 3vw, 2.75rem); max-inline-size: 86ch;"
          >
            <header class="dossier-hero">
              <img
                src={b.coverImage}
                alt={`Cover of ${b.title}`}
                width="240"
                height="360"
                style="border-radius: 6px; border: 1px solid var(--border-subtle); box-shadow: 0 18px 36px -12px oklch(0% 0 0 / 0.45); aspect-ratio: 2 / 3; object-fit: cover;"
              />

              <div class="dossier-meta-lockup">
                <p class="tabular" style="font-size: 0.72rem; letter-spacing: 0.15em; color: var(--accent); margin-block-end: 0.35rem;">
                  MONOGRAPH // {b.year}
                </p>
                <h3 style="font-size: clamp(1.4rem, 2.5vw, 2.1rem); margin-block-end: 0.3rem;">
                  {b.title}
                </h3>
                {b.subtitle && (
                  <p style="font-family: var(--font-serif); font-style: italic; font-size: 1.15rem; color: var(--text-secondary); margin-block-end: 1rem;">
                    {b.subtitle}
                  </p>
                )}

                <dl class="tabular" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.75rem; padding: 0.85rem; border-radius: 6px; background: var(--bg-elevated); border: 1px solid var(--border-subtle); font-size: 0.78rem; margin-block-end: 1.1rem;">
                  <div>
                    <dt style="font-size: 0.65rem; color: var(--text-muted);">PUBLISHER</dt>
                    <dd style="font-weight: 500;">{b.publisher}</dd>
                  </div>
                  <div>
                    <dt style="font-size: 0.65rem; color: var(--text-muted);">ISBN-13</dt>
                    <dd><code>{b.isbn}</code></dd>
                  </div>
                  <div>
                    <dt style="font-size: 0.65rem; color: var(--text-muted);">EXTENT</dt>
                    <dd>{b.pages} Pages</dd>
                  </div>
                </dl>

                <div style="display: flex; flex-wrap: wrap; gap: 0.6rem;">
                  {b.purchaseLinks.map((link: any) => (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="pill"
                      style="text-decoration: none; color: var(--text-primary); padding: 0.45rem 0.85rem;"
                    >
                      {link.label} ↗
                    </a>
                  ))}
                </div>
              </div>
            </header>

            <section style="margin-block-end: 2rem;">
              <h4 class="tabular" style="font-size: 0.74rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-block-end: 0.5rem;">
                Synopsis
              </h4>
              <p style="font-size: 0.96rem; color: var(--text-secondary); line-height: 1.65;">
                {b.synopsis}
              </p>
            </section>

            {b.endorsements.length > 0 && (
              <section style="margin-block-end: 2rem;">
                <h4 class="tabular" style="font-size: 0.74rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-block-end: 0.65rem;">
                  Critical Reception
                </h4>
                <div style="display: flex; flex-direction: column; gap: 0.85rem;">
                  {b.endorsements.map((end: any) => (
                    <figure style="padding: 1rem 1.25rem; border-inline-start: 2px solid var(--accent); background: var(--bg-elevated); border-radius: 0 6px 6px 0;">
                      <blockquote cite={end.citeUrl || ''}>
                        <p style="font-family: var(--font-serif); font-style: italic; font-size: 1.08rem; margin-block-end: 0.35rem;">
                          “{end.quote}”
                        </p>
                      </blockquote>
                      <figcaption class="tabular" style="font-size: 0.74rem; color: var(--text-muted);">
                        — <cite>{end.sourceTitle}</cite>
                      </figcaption>
                    </figure>
                  ))}
                </div>
              </section>
            )}

            {b.chapters.length > 0 && (
              <section>
                <h4 class="tabular" style="font-size: 0.74rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-block-end: 0.65rem;">
                  Table of Contents
                </h4>
                <div>
                  {b.chapters.map((ch: any, cIdx: number) => (
                    <details class="academic-accordion" name={`chapters-${b.id}`} open={cIdx === 0}>
                      <summary>
                        <span class="tabular" style="color: var(--accent); font-size: 0.8rem;">CH {ch.number}</span>
                        <span>{ch.title}</span>
                      </summary>
                      <div class="accordion-body">
                        <p>{ch.summary}</p>
                      </div>
                    </details>
                  ))}
                </div>
              </section>
            )}
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .entry-hidden {
    display: none;
  }
  .btn-mobile-back {
    font-size: 0.75rem;
    padding: 0.35rem 0.7rem;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
    background: var(--bg-elevated);
    color: var(--accent);
    cursor: pointer;
  }
</style>
