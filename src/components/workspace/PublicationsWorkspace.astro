---
interface Props {
  publications: any[];
}

const { publications } = Astro.props;
const sortedPubs = [...publications].sort((a, b) => b.data.year - a.data.year);
---

<section
  id="view-publications"
  class="spa-view workspace-split"
  data-view-idx="0"
  tabindex="-1"
  aria-label="Publications Archive and Reader"
>
  <!-- LEFT PANE: Collapsible Publications Index (with Close button inside the index pane) -->
  <aside class="workspace-pane-left">
    <div class="pane-inner-scroll" data-scrollable-pane>
      <header class="pane-toolbar">
        <div class="pane-toolbar-title">
          <span class="led-socket is-on" aria-hidden="true"></span>
          <h2 class="pane-heading">
            Publications <span class="count-badge tabular">[{String(sortedPubs.length).padStart(2, '0')}]</span>
          </h2>
        </div>
        <button
          type="button"
          class="pane-close-index-btn tabular"
          data-collapse-index
          aria-label="Close Index Pane"
          title="Close left index pane"
        >
          ◁ Close Index
        </button>
      </header>

      <search class="pane-search-box" style="padding: 0.75rem 1.25rem; border-block-end: 1px solid var(--border-subtle);">
        <label for="pub-filter-input" class="sr-only">Filter publications</label>
        <input
          type="search"
          id="pub-filter-input"
          placeholder="Search title, journal, or year..."
          spellcheck="false"
          autocomplete="off"
          class="telemetry-input"
        />
      </search>

      <ul class="pub-list" id="pub-index-list" role="list">
        {sortedPubs.map((pub, idx) => (
          <li data-search-text={`${pub.data.title} ${pub.data.subtitle ?? ''} ${pub.data.venue} ${pub.data.year}`.toLowerCase()}>
            <button
              type="button"
              class="pub-item-btn"
              aria-current={idx === 0 ? 'true' : 'false'}
              data-pub-select={pub.data.id}
            >
              <div class="pub-item-top-row">
                <span class="index-slot-num tabular">{String(idx + 1).padStart(2, '0')}</span>
                <span class="pub-item-meta tabular">
                  {pub.data.year} · {pub.data.id.toUpperCase()}
                </span>
              </div>
              <span class="pub-item-title">{pub.data.title}</span>
              <span class="pub-item-venue">{pub.data.venue}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </aside>

  <!-- RIGHT PANE: Open Publication Reader -->
  <div class="workspace-pane-right">
    <!-- Re-Open Index Tab (visible when index pane is closed) -->
    <button
      type="button"
      class="pane-reopen-index-btn tabular"
      data-expand-index
      aria-label="Open Index Pane"
      title="Re-open left index pane"
    >
      ▷ Open Index
    </button>

    <div class="pane-inner-scroll" id="pub-reader-scroll" data-scrollable-pane data-primary-reader>
      <div class="mobile-back-bar">
        <button type="button" class="btn-mobile-back tabular" data-stack-back>
          ◄ Back to Index
        </button>
        <span class="tabular" style="font-size: 0.7rem; color: var(--text-muted);">READER VIEW</span>
      </div>

      {sortedPubs.map((pub, idx) => {
        const p = pub.data;
        return (
          <div
            class:list={['pub-reader-entry', { 'entry-hidden': idx !== 0 }]}
            data-pub-entry={p.id}
          >
            <div class="reader-layout">
              <article class="reader-article">
                <header class="reader-header" style="border-block-end: 1px solid var(--border-subtle); padding-block-end: 1.5rem; margin-block-end: 1.75rem;">
                  <div class="reader-eyebrow-row">
                    <span class="cathode-tag tabular" data-scramble-eyebrow>
                      CATALOG ID // {p.id.toUpperCase()} · {p.year}
                    </span>
                    <span class="telemetry-stamp tabular">PEER-REVIEWED MONOGRAPH</span>
                  </div>
                  <h3 class="reader-main-title" data-scramble-title>
                    {p.title}
                  </h3>
                  {p.subtitle && (
                    <p style="font-family: var(--font-serif); font-style: italic; font-size: 1.15rem; color: var(--text-secondary); margin-block-end: 0.85rem;">
                      {p.subtitle}
                    </p>
                  )}
                  <p style="font-size: 0.86rem; color: var(--text-secondary); margin-block-end: 0.25rem;">
                    <strong>Authors:</strong> Duncan R. Cordry{p.coAuthors.length > 0 ? `, ${p.coAuthors.join(', ')}` : ''}
                  </p>
                  <p class="tabular" style="font-size: 0.8rem; color: var(--text-muted); margin-block-end: 1.1rem;">
                    <em>{p.venue}</em> {p.volumeIssue ? `· ${p.volumeIssue}` : ''}
                  </p>

                  <div style="display: flex; flex-wrap: wrap; gap: 0.55rem;">
                    <a
                      href={`/publications/${p.id}`}
                      class="pill"
                      style="text-decoration: none; color: var(--text-primary);"
                    >
                      ⌖ Standalone Permalink ↗
                    </a>
                    {p.doi && (
                      <a
                        href={p.doi}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="pill"
                        style="text-decoration: none; color: var(--text-primary);"
                      >
                        DOI Record ↗
                      </a>
                    )}
                    <button
                      type="button"
                      class="pill btn-copy-bibtex"
                      data-bibtex={p.citationBibtex}
                    >
                      ⎘ Copy BibTeX
                    </button>
                  </div>
                </header>

                <section id={`${p.id}-abstract`} class="recessed-abstract-box">
                  <div class="chassis-bolt chassis-bolt--tl"></div>
                  <div class="chassis-bolt chassis-bolt--tr"></div>
                  <div class="chassis-bolt chassis-bolt--bl"></div>
                  <div class="chassis-bolt chassis-bolt--br"></div>
                  <h4 class="tabular" style="font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-block-end: 0.5rem;">
                    Abstract // Archival Synopsis
                  </h4>
                  <p style="font-size: 0.96rem; color: var(--text-primary); font-family: var(--font-serif); line-height: 1.68;">
                    {p.abstract}
                  </p>
                </section>

                {p.sections.map((sec: any, sIdx: number) => {
                  const refNum = (sIdx % Math.max(1, p.references.length)) + 1;
                  const refObj = p.references.find((r: any) => r.num === refNum);
                  const hoverId = `cite-hover-${p.id}-${sIdx}`;
                  return (
                    <section id={`${p.id}-${sec.id}`} class="reader-section" style="margin-block-end: 2rem;">
                      <h4 style="font-size: 1.15rem; margin-block-end: 0.65rem; font-family: var(--font-serif);">
                        {sec.heading}
                      </h4>
                      <p style="font-size: 1rem; color: var(--text-secondary); line-height: 1.72; font-family: var(--font-serif);">
                        {sec.body.replace(/\[\d+\]/g, '')}
                        {refObj && (
                          <>
                            {' '}
                            <a
                              href={`#ref-${p.id}-${refObj.num}`}
                              interestfor={hoverId}
                              class="cite-trigger tabular"
                            >
                              [{refObj.num}]
                            </a>
                            <div id={hoverId} popover="hint" class="cite-hovercard">
                              <p class="tabular" style="font-size: 0.68rem; color: var(--accent); margin-block-end: 0.25rem;">
                                REFERENCE [{refObj.num}]
                              </p>
                              <p style="margin-block-end: 0.35rem; color: var(--text-primary);">
                                {refObj.citation}
                              </p>
                              {refObj.note && (
                                <p style="font-size: 0.76rem; color: var(--text-secondary);">
                                  {refObj.note}
                                </p>
                              )}
                            </div>
                          </>
                        )}
                      </p>
                    </section>
                  );
                })}

                {p.references.length > 0 && (
                  <footer id={`${p.id}-references`} style="border-block-start: 1px solid var(--border-subtle); padding-block-start: 1.5rem; margin-block-start: 2.5rem;">
                    <h4 class="tabular" style="font-size: 0.76rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); margin-block-end: 0.85rem;">
                      References &amp; Archival Notes
                    </h4>
                    <ol style="padding-inline-start: 1.25rem; display: flex; flex-direction: column; gap: 0.65rem; font-size: 0.86rem; color: var(--text-secondary);">
                      {p.references.map((r: any) => (
                        <li id={`ref-${p.id}-${r.num}`}>
                          <span>{r.citation}</span>
                          {r.note && (
                            <span style="display: block; font-size: 0.78rem; color: var(--text-muted); margin-block-start: 0.15rem;">
                              Note: {r.note}
                            </span>
                          )}
                        </li>
                      ))}
                    </ol>
                  </footer>
                )}
              </article>

              <!-- Right Outline Scrollspy (scroll-target-group: auto) -->
              <nav class="reader-toc-nav" aria-label="Article Sections">
                <span class="tabular" style="font-size: 0.66rem; letter-spacing: 0.14em; color: var(--text-muted); text-transform: uppercase; margin-block-end: 0.25rem;">
                  On This Page
                </span>
                <a href={`#${p.id}-abstract`}>Abstract</a>
                {p.sections.map((sec: any) => (
                  <a href={`#${p.id}-${sec.id}`}>{sec.heading}</a>
                ))}
                {p.references.length > 0 && (
                  <a href={`#${p.id}-references`}>References</a>
                )}
              </nav>
            </div>
          </div>
        );
      })}

      <!-- Seamless Scroll Horizon Cue: Publications -> Books -->
      <div class="scroll-horizon-bridge" data-jump-view="view-books">
        <div class="horizon-bridge-meta">
          <span class="horizon-kicker tabular">CONTINUOUS SCROLL HORIZON // NEXT CHANNEL</span>
          <strong class="horizon-title">02 · BOOKS &amp; MONOGRAPHS →</strong>
        </div>
        <div class="horizon-charge-track">
          <div class="horizon-charge-fill" data-scroll-charge-fill></div>
        </div>
        <span class="horizon-hint tabular">Keep scrolling down to transition seamlessly into Books</span>
      </div>
    </div>
  </div>
</section>

<style>
  .entry-hidden {
    display: none;
  }
  .btn-mobile-back {
    font-size: 0.75rem;
    padding: 0.35rem 0.7rem;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
    background: var(--bg-elevated);
    color: var(--accent);
    cursor: pointer;
  }
</style>
