---
import PublicationsWorkspace from './PublicationsWorkspace.astro';
import BooksWorkspace from './BooksWorkspace.astro';
import ClassesWorkspace from './ClassesWorkspace.astro';

interface Props {
  publications: any[];
  books: any[];
  classes: any[];
}

const { publications, books, classes } = Astro.props;
const sortedPubs = [...publications].sort((a, b) => b.data.year - a.data.year);
const sortedBooks = [...books].sort((a, b) => b.data.year - a.data.year);
---

<drc-workspace class="academic-shell">
  <div class="workspace-light-spill" aria-hidden="true"></div>
  <PublicationsWorkspace publications={publications} />
  <BooksWorkspace books={books} />
  <ClassesWorkspace classes={classes} />

  <!-- 1. ARCHIVAL CITATION & BIBTEX CODEX MODAL -->
  <dialog id="publication-codex-dialog" class="artefact-modal codex-dialog" closedby="any" aria-labelledby="codex-dialog-title">
    <div class="artefact-slab-shell" id="codex-slab-shell">
      <div class="bookplate-corner bookplate-corner--tl" aria-hidden="true">❦</div>
      <div class="bookplate-corner bookplate-corner--tr" aria-hidden="true">❦</div>
      <div class="bookplate-corner bookplate-corner--bl" aria-hidden="true">❦</div>
      <div class="bookplate-corner bookplate-corner--br" aria-hidden="true">❦</div>

      <header class="artefact-modal-header">
        <div class="artefact-modal-header-tag">
          <span class="seal-mark" aria-hidden="true">❧</span>
          <span id="codex-folio-tag">FOLIO ARCHIVE · SCHOLARLY CITATION CODEX</span>
        </div>
        <button type="button" class="artefact-close-btn" id="btn-close-codex" aria-label="Close Archival Dossier">✕</button>
      </header>

      <div class="artefact-modal-body">
        <p class="codex-eyebrow tabular" id="codex-dialog-venue">VENUE · YEAR</p>
        <h3 id="codex-dialog-title" class="codex-title">Publication Title</h3>
        <p id="codex-dialog-subtitle" style="font-family: var(--font-serif); font-style: italic; color: var(--text-secondary); margin-block-end: 0.85rem; display: none;"></p>
        
        <dl class="codex-meta-specs tabular">
          <div>
            <dt>AUTHORS</dt>
            <dd id="codex-dialog-authors">Duncan R. Cordry</dd>
          </div>
          <div>
            <dt>JOURNAL / VOLUME</dt>
            <dd id="codex-dialog-vol">Volume &amp; Issue</dd>
          </div>
          <div>
            <dt>SCHOLARLY REGISTRATION</dt>
            <dd id="codex-dialog-id">ID</dd>
          </div>
        </dl>

        <section class="codex-cartouche">
          <div class="cartouche-header">
            <span class="cartouche-title">BIBTEX ARCHIVAL RECORD</span>
            <button type="button" class="pill" id="btn-codex-copy-bibtex" style="font-size: 0.7rem; padding: 0.25rem 0.65rem;">
              ⎘ Copy BibTeX
            </button>
          </div>
          <pre><code id="codex-dialog-bibtex" class="codex-bibtex-block"></code></pre>
        </section>

        <section style="margin-block-end: 1.5rem;">
          <div class="cartouche-header" style="margin-block-end: 0.45rem;">
            <span class="cartouche-title">FORMATTED SCHOLARLY CITATION (APA)</span>
            <button type="button" class="pill" id="btn-codex-copy-apa" style="font-size: 0.7rem; padding: 0.25rem 0.65rem;">
              ⎘ Copy Citation
            </button>
          </div>
          <p id="codex-dialog-apa" class="codex-apa-box"></p>
        </section>

        <div class="codex-actions-row">
          <a id="codex-link-permalink" href="#" class="pill" style="text-decoration: none; color: var(--text-primary);">
            ⌖ Standalone Folio Permalink ↗
          </a>
          <a id="codex-link-doi" href="#" target="_blank" rel="noopener noreferrer" class="pill" style="text-decoration: none; color: var(--text-primary); display: none;">
            DOI Record ↗
          </a>
        </div>
      </div>
    </div>
  </dialog>

  <!-- 2. MONOGRAPH COLOPHON & CHAPTER DOSSIER TOME MODAL -->
  <dialog id="book-tome-dialog" class="artefact-modal tome-dialog" closedby="any" aria-labelledby="tome-dialog-title">
    <div class="artefact-slab-shell" id="tome-slab-shell">
      <div class="bookplate-corner bookplate-corner--tl" aria-hidden="true">❦</div>
      <div class="bookplate-corner bookplate-corner--tr" aria-hidden="true">❦</div>
      <div class="bookplate-corner bookplate-corner--bl" aria-hidden="true">❦</div>
      <div class="bookplate-corner bookplate-corner--br" aria-hidden="true">❦</div>

      <header class="artefact-modal-header">
        <div class="artefact-modal-header-tag">
          <span class="seal-mark" aria-hidden="true">❧</span>
          <span id="tome-folio-tag">MONOGRAPH DOSSIER · EDITORIAL COLOPHON &amp; PROSPECTUS</span>
        </div>
        <button type="button" class="artefact-close-btn" id="btn-close-tome" aria-label="Close Monograph Dossier">✕</button>
      </header>

      <div class="artefact-modal-body">
        <div class="tome-spread-grid">
          <!-- VERSO: Cover & Ex Libris Colophon -->
          <aside class="tome-verso-colophon">
            <div class="tome-cover-wrap">
              <img
                id="tome-dialog-cover"
                src=""
                alt="Monograph Cover"
                width="190"
                height="285"
                class="tome-cover-img"
              />
            </div>

            <div class="tome-ex-libris-plate">
              <div class="ex-libris-header">EX LIBRIS · DUNCAN R. CORDRY</div>
              <dl class="colophon-specs-grid tabular" style="margin-block-end: 0; background: transparent; border: none; box-shadow: none; padding: 0;">
                <div>
                  <dt>PUBLISHER</dt>
                  <dd id="tome-dialog-publisher"></dd>
                </div>
                <div>
                  <dt>ISBN-13</dt>
                  <dd><code id="tome-dialog-isbn"></code></dd>
                </div>
                <div>
                  <dt>EXTENT</dt>
                  <dd id="tome-dialog-pages"></dd>
                </div>
                <div>
                  <dt>YEAR</dt>
                  <dd id="tome-dialog-year"></dd>
                </div>
              </dl>
            </div>

            <div id="tome-purchase-links" style="display: flex; flex-direction: column; gap: 0.45rem;"></div>
          </aside>

          <!-- RECTO: Prospectus, Table of Contents & Critical Reception -->
          <div class="tome-recto-content">
            <div>
              <span class="fascicle-tag tabular" id="tome-dialog-eyebrow">FOLIO RECORD</span>
              <h3 id="tome-dialog-title" class="tome-heading">Book Title</h3>
              <p id="tome-dialog-subtitle" class="tome-subtitle" style="display: none;"></p>
            </div>

            <section class="manuscript-abstract-vellum bookplate-frame" style="margin-block-end: 0;">
              <div class="bookplate-corner bookplate-corner--tl" aria-hidden="true">❦</div>
              <div class="bookplate-corner bookplate-corner--tr" aria-hidden="true">❦</div>
              <h4 class="scholarly-caps" style="font-size: 0.72rem; letter-spacing: 0.14em; color: var(--accent); margin-block-end: 0.5rem;">
                EDITORIAL SYNOPSIS
              </h4>
              <p id="tome-dialog-synopsis" style="font-size: 0.94rem; color: var(--text-primary); line-height: 1.65; font-family: var(--font-serif);"></p>
            </section>

            <section>
              <h4 class="scholarly-caps" style="font-size: 0.72rem; letter-spacing: 0.14em; color: var(--accent); margin-block-end: 0.65rem;">
                TABLE OF CONTENTS &amp; CHAPTER SUMMARIES
              </h4>
              <div id="tome-chapters-list" class="tome-chapter-list"></div>
            </section>

            <section id="tome-endorsements-wrap">
              <h4 class="scholarly-caps" style="font-size: 0.72rem; letter-spacing: 0.14em; color: var(--accent); margin-block-end: 0.65rem;">
                CRITICAL RECEPTION &amp; SCHOLARLY ENDORSEMENTS
              </h4>
              <div id="tome-endorsements-list" style="display: flex; flex-direction: column; gap: 0.75rem;"></div>
            </section>
          </div>
        </div>
      </div>
    </div>
  </dialog>

  <!-- 3. SEMINAR LEDGER & EVALUATION CODEX MODAL -->
  <dialog id="class-ledger-dialog" class="artefact-modal ledger-dialog" closedby="any" aria-labelledby="ledger-dialog-title">
    <div class="artefact-slab-shell" id="ledger-slab-shell">
      <div class="ledger-brass-bar"></div>
      <div class="bookplate-corner bookplate-corner--tl" aria-hidden="true">❦</div>
      <div class="bookplate-corner bookplate-corner--tr" aria-hidden="true">❦</div>
      <div class="bookplate-corner bookplate-corner--bl" aria-hidden="true">❦</div>
      <div class="bookplate-corner bookplate-corner--br" aria-hidden="true">❦</div>

      <header class="artefact-modal-header">
        <div class="artefact-modal-header-tag">
          <span class="seal-mark" aria-hidden="true">❧</span>
          <span id="ledger-folio-tag">ACADEMIC LEDGER · COURSE SYLLABUS &amp; EVALUATION CODEX</span>
        </div>
        <button type="button" class="artefact-close-btn" id="btn-close-ledger" aria-label="Close Seminar Ledger">✕</button>
      </header>

      <div class="artefact-modal-body">
        <div style="margin-block-end: 1.25rem;">
          <span class="fascicle-tag tabular" id="ledger-dialog-eyebrow">CURRICULUM</span>
          <h3 id="ledger-dialog-title" class="tome-heading" style="margin-block-end: 0.5rem;">Course Title</h3>
          <dl class="colophon-specs-grid tabular" style="margin-block-end: 0;">
            <div>
              <dt>COURSE CODE</dt>
              <dd id="ledger-dialog-code"></dd>
            </div>
            <div>
              <dt>TERM &amp; YEAR</dt>
              <dd id="ledger-dialog-term"></dd>
            </div>
            <div>
              <dt>LEVEL</dt>
              <dd id="ledger-dialog-level"></dd>
            </div>
            <div>
              <dt>MEETING &amp; LOCATION</dt>
              <dd id="ledger-dialog-sched"></dd>
            </div>
          </dl>
        </div>

        <!-- Dual Ledger Tabs: Evaluation vs Curriculum -->
        <div class="ledger-tabs-row" role="tablist">
          <button type="button" class="ledger-tab-btn" id="btn-ledger-tab-eval" role="tab" aria-selected="true" aria-controls="panel-ledger-eval">
            ✍ Record Seminar Evaluation
          </button>
          <button type="button" class="ledger-tab-btn" id="btn-ledger-tab-curr" role="tab" aria-selected="false" aria-controls="panel-ledger-curr">
            📜 14-Week Curriculum &amp; Required Readings
          </button>
        </div>

        <!-- Tab Panel 1: Record Seminar Evaluation -->
        <div id="panel-ledger-eval" role="tabpanel" aria-labelledby="btn-ledger-tab-eval">
          <p id="ledger-review-status" role="status" aria-live="polite" style="font-size:0.82rem; color:var(--text-muted);">Your review will be visible after instructor approval.</p>
          <form id="ledger-review-form" class="ledger-form">
            <input type="hidden" id="ledger-form-course-id" name="courseId" value="" />
            <input type="hidden" id="ledger-form-rating" name="rating" value="5.0 / 5.0" />

            <div class="ledger-form-grid">
              <div class="ledger-field-wrap">
                <label class="ledger-label" for="ledger-input-author">NAME / SCHOLAR INITIALS</label>
                <input type="text" id="ledger-input-author" name="author" maxlength="80" required placeholder="e.g. Ananya S." class="ledger-feint-input" />
              </div>
              <div class="ledger-field-wrap">
                <label class="ledger-label" for="ledger-input-role">PROGRAMME / COHORT</label>
                <input type="text" id="ledger-input-role" name="role" maxlength="120" required placeholder="e.g. BA (Hons.) Philosophy · ASP" class="ledger-feint-input" />
              </div>
              <div class="ledger-field-wrap">
                <label class="ledger-label" for="ledger-input-term">SEMESTER</label>
                <input type="text" id="ledger-input-term" name="term" maxlength="80" required class="ledger-feint-input" />
              </div>
            </div>

            <div class="ledger-field-wrap">
              <label class="ledger-label" for="ledger-input-highlight">SEMINAR HIGHLIGHT / TAKEAWAY</label>
              <input type="text" id="ledger-input-highlight" name="highlight" maxlength="180" placeholder="Brief headline summary of your seminar experience..." class="ledger-feint-input" />
            </div>

            <div class="ledger-field-wrap">
              <label class="ledger-label" for="ledger-input-quote">SCHOLARLY EVALUATION &amp; REFLECTION</label>
              <textarea id="ledger-input-quote" name="quote" maxlength="3000" rows="3" required placeholder="Share your reflection on the readings, seminar discussions, and intellectual arc..." class="ledger-feint-textarea"></textarea>
            </div>

            <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-block-start: 0.5rem;">
              <div class="ledger-rating-row">
                <span class="ledger-label" style="margin: 0;">SEMINAR RATING:</span>
                <div class="rating-stars-group" id="ledger-stars-group" role="group" aria-label="Seminar Rating">
                  <button type="button" class="star-select-btn active" data-val="1">★</button>
                  <button type="button" class="star-select-btn active" data-val="2">★</button>
                  <button type="button" class="star-select-btn active" data-val="3">★</button>
                  <button type="button" class="star-select-btn active" data-val="4">★</button>
                  <button type="button" class="star-select-btn active" data-val="5">★</button>
                </div>
                <span class="tabular" id="ledger-rating-readout" style="font-size: 0.72rem; color: var(--accent); font-weight: 600;">5.0 / 5.0</span>
              </div>

              <button type="submit" class="ledger-submit-btn tabular" id="btn-ledger-submit">
                ✓ Record into Seminar Ledger
              </button>
            </div>
          </form>
        </div>

        <!-- Tab Panel 2: Curriculum & Required Readings -->
        <div id="panel-ledger-curr" role="tabpanel" aria-labelledby="btn-ledger-tab-curr" style="display: none;">
          <div id="ledger-weeks-container" style="display: flex; flex-direction: column; gap: 0.65rem;"></div>
        </div>
      </div>
      <div class="ledger-brass-bar"></div>
    </div>
  </dialog>

  <!-- UNIFIED MANIFEST FOR CLIENT SCRIPT -->
  <div
    id="drc-artefact-manifest"
    data-publications={JSON.stringify(sortedPubs.map(p => ({
      id: p.data.id,
      title: p.data.title,
      subtitle: p.data.subtitle || '',
      year: p.data.year,
      venue: p.data.venue,
      volumeIssue: p.data.volumeIssue || '',
      coAuthors: p.data.coAuthors || [],
      doi: p.data.doi || '',
      bibtex: p.data.citationBibtex || ''
    })))}
    data-books={JSON.stringify(sortedBooks.map(b => ({
      id: b.data.id,
      title: b.data.title,
      subtitle: b.data.subtitle || '',
      year: b.data.year,
      publisher: b.data.publisher,
      isbn: b.data.isbn,
      pages: b.data.pages,
      coverImage: b.data.coverImage,
      synopsis: b.data.synopsis,
      purchaseLinks: b.data.purchaseLinks || [],
      chapters: b.data.chapters || [],
      endorsements: b.data.endorsements || []
    })))}
    data-classes={JSON.stringify(classes.map(cls => ({
      id: cls.data.id,
      courseCode: cls.data.courseCode,
      title: cls.data.title,
      academicYear: cls.data.academicYear,
      term: cls.data.term,
      level: cls.data.level,
      acceptingReviews: Boolean(cls.data.acceptingReviews),
      schedule: cls.data.schedule,
      summary: cls.data.summary,
      weeks: cls.data.weeks || []
    })))}
    hidden
  ></div>
</drc-workspace>

<script>
  const VIEW_ORDER = ['view-publications', 'view-books', 'view-classes'] as const;
  const FASCICLE_LABELS = [
    'FASCICLE I · PUBLICATIONS',
    'FASCICLE II · BOOKS',
    'FASCICLE III · CLASSES',
  ];

  function applyInkTransition(el: HTMLElement | null) {
    if (!el) return;
    el.classList.remove('ink-transition-active');
    void el.offsetWidth;
    el.classList.add('ink-transition-active');
    window.setTimeout(() => {
      el.classList.remove('ink-transition-active');
    }, 650);
  }

  function updateManuscriptLabel(el: HTMLElement | null, target: string) {
    if (!el || el.textContent === target) return;
    el.style.opacity = '0.35';
    el.style.filter = 'blur(2px)';
    el.style.transition = 'opacity 0.16s ease, filter 0.16s ease';
    window.setTimeout(() => {
      el.textContent = target;
      el.style.opacity = '1';
      el.style.filter = 'none';
      applyInkTransition(el);
    }, 160);
  }

  class DrcWorkspace extends HTMLElement {
    private activeViewIndex = 0;
    private scrollCharge = 0;
    private isTransitionLocked = false;
    private chargeDecayTimer: number | null = null;
    private lastContentScrollTime = 0;

    connectedCallback() {
      this.initViewTabsAndJumpBridges();
      this.initSeamlessSectionScroll();
      this.initScriptoriumHotkeys();
      this.initScrubberBridge();
      this.initSidebarCollapseInsidePane();
      this.initItemSelectors();
      this.initSearchAndFilters();
      this.initMobileStackDrillDown();
      this.initScrollspyFallback();
      this.initAmbientLightSpill();
      this.initArtefactModals();
    }

    // Switch active workspace view (0 = Publications, 1 = Books, 2 = Classes)
    private switchToViewIndex(nextIndex: number, direction: 'down' | 'up' | 'jump' = 'jump') {
      if (nextIndex < 0 || nextIndex >= VIEW_ORDER.length) return;
      if (nextIndex === this.activeViewIndex && direction !== 'jump') return;

      this.activeViewIndex = nextIndex;
      this.scrollCharge = 0;
      this.lastContentScrollTime = performance.now();
      this.updateChargeMeters(0);

      const targetId = VIEW_ORDER[nextIndex];
      const navButtons = document.querySelectorAll<HTMLButtonElement>('.nav-strip-btn[data-target-view]');
      const views = this.querySelectorAll<HTMLElement>('.spa-view');

      navButtons.forEach((b) => {
        b.setAttribute('aria-current', b.dataset.targetView === targetId ? 'page' : 'false');
      });

      // Keep NavStrip track stable without artificial negative offsets that clip collapsed numerals
      const navTrack = document.getElementById('nav-strip-track');
      if (navTrack) {
        navTrack.style.setProperty('--nav-scrub-offset', '0px');
      }

      const targetPct = ((nextIndex + 1) / VIEW_ORDER.length) * 100;
      const flowFill = document.getElementById('nav-scroll-flow-fill');
      const thumb = document.getElementById('folio-ribbon-thumb');
      const scrubber = document.getElementById('folio-ribbon-meter');
      if (flowFill) {
        flowFill.style.width = `${targetPct}%`;
      }
      if (thumb) {
        thumb.style.left = `${targetPct}%`;
      }
      if (scrubber) {
        scrubber.setAttribute('aria-valuenow', Math.round(targetPct).toString());
      }

      const locatorEl = document.getElementById('nav-cathode-status');
      updateManuscriptLabel(locatorEl, FASCICLE_LABELS[nextIndex]);

      views.forEach((view) => {
        const isTarget = view.id === targetId;
        view.classList.toggle('inactive', !isTarget);
        view.setAttribute('aria-hidden', isTarget ? 'false' : 'true');

        if (isTarget) {
          view.dataset.enterDir = direction;
          const primaryReader = view.querySelector<HTMLElement>('[data-primary-reader]');
          if (primaryReader) {
            primaryReader.scrollTop = 0;
          }
        }
      });
    }

    // 1. NavStrip buttons & in-pane horizon jump bridges
    private initViewTabsAndJumpBridges() {
      const navButtons = document.querySelectorAll<HTMLButtonElement>('.nav-strip-btn[data-target-view]');
      navButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetId = btn.dataset.targetView;
          const idx = VIEW_ORDER.indexOf(targetId as any);
          if (idx !== -1) {
            this.switchToViewIndex(idx, 'jump');
          }
          if (document.body.dataset.stage !== 'stage-3') {
            (window as any).__drcSnapToStage?.(3);
          }
        });
      });

      this.querySelectorAll<HTMLElement>('[data-jump-view]').forEach((bridge) => {
        bridge.addEventListener('click', () => {
          const targetId = bridge.dataset.jumpView;
          const idx = VIEW_ORDER.indexOf(targetId as any);
          if (idx !== -1) {
            this.switchToViewIndex(idx, idx > this.activeViewIndex ? 'down' : 'up');
          }
        });
      });

      window.addEventListener('drc:stage-snap', () => {
        this.scrollCharge = 0;
        this.updateChargeMeters(0);
      });
    }

    private updateChargeMeters(ratio: number) {
      const pct = `${Math.min(100, Math.max(0, ratio * 100)).toFixed(1)}%`;
      this.querySelectorAll<HTMLElement>('[data-scroll-charge-fill]').forEach((el) => {
        el.style.width = pct;
      });
    }

    // 2. Scriptorium Hotkeys: 1, 2, 3, [, ], ArrowLeft, ArrowRight
    private initScriptoriumHotkeys() {
      window.addEventListener('keydown', (e: KeyboardEvent) => {
        // Guard 1: Ignore modified keys (Cmd, Ctrl, Alt)
        if (e.metaKey || e.ctrlKey || e.altKey) return;

        // Guard 2: Ignore typing inside inputs, textareas, or contenteditables
        const target = e.target as HTMLElement | null;
        if (
          target &&
          (target.tagName === 'INPUT' ||
            target.tagName === 'TEXTAREA' ||
            target.tagName === 'SELECT' ||
            target.isContentEditable)
        ) {
          return;
        }

        // Guard 3: Ignore if any modal dialog is open
        if (document.querySelector('dialog[open]')) {
          return;
        }

        let targetIdx = -1;
        if (e.key === '1') targetIdx = 0;
        else if (e.key === '2') targetIdx = 1;
        else if (e.key === '3') targetIdx = 2;
        else if (e.key === '[' || e.key === 'ArrowLeft') {
          targetIdx = Math.max(0, this.activeViewIndex - 1);
        } else if (e.key === ']' || e.key === 'ArrowRight') {
          targetIdx = Math.min(VIEW_ORDER.length - 1, this.activeViewIndex + 1);
        }

        if (targetIdx !== -1 && targetIdx !== this.activeViewIndex) {
          e.preventDefault();
          this.switchToViewIndex(targetIdx, targetIdx > this.activeViewIndex ? 'down' : 'up');
          if (document.body.dataset.stage !== 'stage-3') {
            (window as any).__drcSnapToStage?.(3);
          }
        }
      });
    }

    // 3. Interactive Ribbon Scrubber Bridge (Click & Continuous Drag)
    private initScrubberBridge() {
      (window as any).__drcScrubToProgress = (ratio: number) => {
        const clampedRatio = Math.max(0, Math.min(1, ratio));
        const numSections = VIEW_ORDER.length;
        const targetIndex = Math.min(numSections - 1, Math.floor(clampedRatio * numSections));
        const localRatio = (clampedRatio * numSections) - targetIndex;

        if (this.activeViewIndex !== targetIndex) {
          this.switchToViewIndex(targetIndex, targetIndex > this.activeViewIndex ? 'down' : 'up');
        }

        if (document.body.dataset.stage !== 'stage-3') {
          (window as any).__drcSnapToStage?.(3);
        }

        const activeView = this.querySelector<HTMLElement>(`#${VIEW_ORDER[targetIndex]}`);
        if (activeView) {
          const primaryReader = activeView.querySelector<HTMLElement>('[data-primary-reader]');
          if (primaryReader) {
            const maxScroll = Math.max(0, primaryReader.scrollHeight - primaryReader.clientHeight);
            primaryReader.scrollTop = Math.round(localRatio * maxScroll);
          }
        }

        // Keep flow fill, thumb, and aria attribute locked to the scrub ratio
        const totalPct = clampedRatio * 100;
        const flowFill = document.getElementById('nav-scroll-flow-fill');
        const thumb = document.getElementById('folio-ribbon-thumb');
        const scrubber = document.getElementById('folio-ribbon-meter');
        if (flowFill) flowFill.style.width = `${totalPct.toFixed(1)}%`;
        if (thumb) thumb.style.left = `${totalPct.toFixed(1)}%`;
        if (scrubber) scrubber.setAttribute('aria-valuenow', Math.round(totalPct).toString());
      };
    }

    // 4. Seamless Scroll Progression (bound to window + live elementFromPoint so stationary cursor never stalls)
    private initSeamlessSectionScroll() {
      const THRESHOLD = 120;
      const REST_GATE_MS = 180;

      window.addEventListener(
        'wheel',
        (e: WheelEvent) => {
          if (document.body.dataset.stage !== 'stage-3') {
            return;
          }

          // Ignore if modal dialog is open
          if (document.querySelector('dialog[open]')) {
            return;
          }

          if (this.isTransitionLocked) {
            e.preventDefault();
            return;
          }

          const activeView = this.querySelector<HTMLElement>(`#${VIEW_ORDER[this.activeViewIndex]}`);
          if (!activeView) return;

          const primaryReader = activeView.querySelector<HTMLElement>('[data-primary-reader]');
          if (!primaryReader) return;

          // Resolve live element under cursor (even if cursor is stationary and e.target is cached from an earlier stage/view)
          const hitEl =
            (typeof e.clientX === 'number' && (e.clientX !== 0 || e.clientY !== 0)
              ? (document.elementFromPoint(e.clientX, e.clientY) as HTMLElement | null)
              : null) || (e.target as HTMLElement | null);

          // Neutral Area (Title Bar): Scrolling up over the title bar always snaps directly back up top
          if (hitEl?.closest('.persistent-chrome') && e.deltaY < 0) {
            e.preventDefault();
            this.scrollCharge = Math.min(0, this.scrollCharge) + e.deltaY;
            if (this.chargeDecayTimer) clearTimeout(this.chargeDecayTimer);
            this.chargeDecayTimer = window.setTimeout(() => {
              this.scrollCharge = 0;
            }, 300);
            if (Math.abs(this.scrollCharge) >= 40) {
              this.scrollCharge = 0;
              (window as any).__drcSnapToStage?.(2);
            }
            return;
          }

          const leftPane = hitEl?.closest<HTMLElement>('.workspace-pane-left');
          const leftScroll =
            leftPane && activeView.contains(leftPane)
              ? leftPane.querySelector<HTMLElement>('[data-scrollable-pane]')
              : null;

          if (leftScroll) {
            const leftCanScrollDown =
              e.deltaY > 0 && leftScroll.scrollTop + leftScroll.clientHeight < leftScroll.scrollHeight - 2;
            const leftCanScrollUp = e.deltaY < 0 && leftScroll.scrollTop > 2;

            if (leftCanScrollDown || leftCanScrollUp) {
              e.preventDefault();
              leftScroll.scrollTop += e.deltaY;
              return;
            }
          }

          const { scrollTop, scrollHeight, clientHeight } = primaryReader;
          const maxScroll = Math.max(0, scrollHeight - clientHeight);
          const atBottom = scrollTop >= maxScroll - 4;
          const atTop = scrollTop <= 4;

          const canScrollReaderDown = e.deltaY > 0 && !atBottom;
          const canScrollReaderUp = e.deltaY < 0 && !atTop;

          if (canScrollReaderDown || canScrollReaderUp) {
            e.preventDefault();
            primaryReader.scrollTop += e.deltaY;

            this.lastContentScrollTime = performance.now();
            if (this.scrollCharge !== 0) {
              this.scrollCharge = 0;
              this.updateChargeMeters(0);
            }

            // Update continuous progress bar & scrubber inside NavStrip based on current scroll + view index
            const nextScrollTop = Math.min(maxScroll, Math.max(0, primaryReader.scrollTop));
            const localProgress = maxScroll > 0 ? nextScrollTop / maxScroll : 0;
            const totalProgress = ((this.activeViewIndex + localProgress) / VIEW_ORDER.length) * 100;
            const flowFill = document.getElementById('nav-scroll-flow-fill');
            const thumb = document.getElementById('folio-ribbon-thumb');
            const scrubber = document.getElementById('folio-ribbon-meter');
            if (flowFill) {
              flowFill.style.width = `${Math.max(6, totalProgress).toFixed(1)}%`;
            }
            if (thumb) {
              thumb.style.left = `${Math.max(0, Math.min(100, totalProgress)).toFixed(1)}%`;
            }
            if (scrubber) {
              scrubber.setAttribute('aria-valuenow', Math.round(totalProgress).toString());
            }
            return;
          }

          // Bounded 180ms grace window right after touching top/bottom boundary (never extended at boundary!)
          const now = performance.now();
          if (now - this.lastContentScrollTime < REST_GATE_MS) {
            e.preventDefault();
            this.scrollCharge = 0;
            this.updateChargeMeters(0);
            return;
          }

          // Case A: Scrolling down at bottom boundary -> Snap into next section (Publications -> Books -> Classes)
          if (e.deltaY > 0 && atBottom && this.activeViewIndex < VIEW_ORDER.length - 1) {
            e.preventDefault();
            this.scrollCharge = Math.max(0, this.scrollCharge) + e.deltaY;
            this.updateChargeMeters(this.scrollCharge / THRESHOLD);

            if (this.chargeDecayTimer) clearTimeout(this.chargeDecayTimer);
            this.chargeDecayTimer = window.setTimeout(() => {
              this.scrollCharge = 0;
              this.updateChargeMeters(0);
            }, 380);

            if (this.scrollCharge >= THRESHOLD) {
              this.isTransitionLocked = true;
              this.switchToViewIndex(this.activeViewIndex + 1, 'down');
              setTimeout(() => {
                this.isTransitionLocked = false;
              }, 380);
            }
            return;
          }

          // Case B: Scrolling up at top boundary of Books or Classes -> Snap back to previous section
          if (e.deltaY < 0 && atTop && this.activeViewIndex > 0) {
            e.preventDefault();
            this.scrollCharge = Math.min(0, this.scrollCharge) + e.deltaY;
            this.updateChargeMeters(Math.abs(this.scrollCharge) / THRESHOLD);

            if (this.chargeDecayTimer) clearTimeout(this.chargeDecayTimer);
            this.chargeDecayTimer = window.setTimeout(() => {
              this.scrollCharge = 0;
              this.updateChargeMeters(0);
            }, 380);

            if (Math.abs(this.scrollCharge) >= THRESHOLD) {
              this.isTransitionLocked = true;
              this.switchToViewIndex(this.activeViewIndex - 1, 'up');
              setTimeout(() => {
                this.isTransitionLocked = false;
              }, 380);
            }
            return;
          }

          // Case C: Scrolling up at top boundary of 01 // PUBLICATIONS -> Snap cleanly back to Stage 2 (Info Card)
          if (e.deltaY < 0 && atTop && this.activeViewIndex === 0) {
            e.preventDefault();
            this.scrollCharge = Math.min(0, this.scrollCharge) + e.deltaY;

            if (this.chargeDecayTimer) clearTimeout(this.chargeDecayTimer);
            this.chargeDecayTimer = window.setTimeout(() => {
              this.scrollCharge = 0;
            }, 320);

            if (Math.abs(this.scrollCharge) >= 55) {
              this.scrollCharge = 0;
              (window as any).__drcSnapToStage?.(2);
            }
            return;
          }

          // Otherwise reset boundary charge
          if (this.scrollCharge !== 0) {
            this.scrollCharge = 0;
            this.updateChargeMeters(0);
          }
        },
        { passive: false }
      );
    }

    // 3. In-Pane Collapse & Re-Open Index Controls
    private initSidebarCollapseInsidePane() {
      const setCollapsed = (collapsed: boolean) => {
        this.querySelectorAll<HTMLElement>('.workspace-split').forEach((split) => {
          split.dataset.sidebarCollapsed = String(collapsed);
          const leftPane = split.querySelector<HTMLElement>('.workspace-pane-left');
          leftPane?.toggleAttribute('inert', collapsed);
        });
      };

      this.querySelectorAll<HTMLButtonElement>('[data-collapse-index]').forEach((btn) => {
        btn.addEventListener('click', () => setCollapsed(true));
      });

      this.querySelectorAll<HTMLButtonElement>('[data-expand-index]').forEach((btn) => {
        btn.addEventListener('click', () => setCollapsed(false));
      });
    }

    // 4. Master-detail item selection + Title Scramble + Scroll reset + Mobile horizontal drill-down scroll
    private initItemSelectors() {
      const resetReaderScroll = (splitContainer: HTMLElement | null) => {
        const reader = splitContainer?.querySelector<HTMLElement>('[data-primary-reader]');
        if (reader) {
          reader.scrollTop = 0;
        }
        this.scrollCharge = 0;
        this.lastContentScrollTime = performance.now();
        this.updateChargeMeters(0);
      };

      const drillToRightPane = (splitContainer: HTMLElement | null) => {
        resetReaderScroll(splitContainer);
        if (!splitContainer) return;
        if (window.matchMedia('(max-width: 767px)').matches) {
          if (!history.state?.drcMobileDetail) {
            history.pushState({ ...(history.state || {}), drcMobileDetail: true }, '', location.href);
          }
          splitContainer.scrollBy({ left: splitContainer.clientWidth, behavior: 'auto' });
        }
      };

      // Publications
      this.querySelectorAll<HTMLButtonElement>('[data-pub-select]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.pubSelect;
          this.querySelectorAll('[data-pub-select]').forEach((b) =>
            b.setAttribute('aria-current', b === btn ? 'true' : 'false')
          );
          this.querySelectorAll<HTMLElement>('[data-pub-entry]').forEach((entry) => {
            const isMatch = entry.dataset.pubEntry === id;
            entry.classList.toggle('entry-hidden', !isMatch);
            if (isMatch) {
              applyInkTransition(entry);
            }
          });
          drillToRightPane(btn.closest('.workspace-split'));
        });
      });

      // Books
      this.querySelectorAll<HTMLButtonElement>('[data-book-select]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.bookSelect;
          this.querySelectorAll('[data-book-select]').forEach((b) =>
            b.setAttribute('aria-current', b === btn ? 'true' : 'false')
          );
          this.querySelectorAll<HTMLElement>('[data-book-entry]').forEach((entry) => {
            const isMatch = entry.dataset.bookEntry === id;
            entry.classList.toggle('entry-hidden', !isMatch);
            if (isMatch) {
              applyInkTransition(entry);
            }
          });
          drillToRightPane(btn.closest('.workspace-split'));
        });
      });

      // Classes
      this.querySelectorAll<HTMLButtonElement>('[data-class-select]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.classSelect;
          this.querySelectorAll('[data-class-select]').forEach((b) =>
            b.setAttribute('aria-current', b === btn ? 'true' : 'false')
          );
          this.querySelectorAll<HTMLElement>('[data-class-entry]').forEach((entry) => {
            const isMatch = entry.dataset.classEntry === id;
            entry.classList.toggle('entry-hidden', !isMatch);
            if (isMatch) {
              applyInkTransition(entry);
            }
          });
          drillToRightPane(btn.closest('.workspace-split'));
        });
      });

      // Copy BibTeX buttons
      this.querySelectorAll<HTMLButtonElement>('.btn-copy-bibtex').forEach((btn) => {
        btn.addEventListener('click', () => {
          const bib = btn.dataset.bibtex || '';
          navigator.clipboard?.writeText(bib);
          const orig = btn.textContent;
          btn.textContent = '✓ BibTeX Copied';
          setTimeout(() => (btn.textContent = orig), 1600);
        });
      });
    }

    // 5. Live search & course level filter pills
    private initSearchAndFilters() {
      const pubInput = document.getElementById('pub-filter-input') as HTMLInputElement | null;
      pubInput?.addEventListener('input', () => {
        const q = pubInput.value.trim().toLowerCase();
        document.querySelectorAll<HTMLElement>('#pub-index-list > li').forEach((li) => {
          const text = li.dataset.searchText || '';
          li.style.display = !q || text.includes(q) ? '' : 'none';
        });
      });

      const courseInput = document.getElementById('course-search-input') as HTMLInputElement | null;
      let activeLevel = 'all';

      const applyCourseFilter = () => {
        const q = (courseInput?.value || '').trim().toLowerCase();
        document.querySelectorAll<HTMLElement>('#course-index-list > li').forEach((li) => {
          const text = li.dataset.searchText || '';
          const level = li.dataset.courseLevel || '';
          const matchLevel = activeLevel === 'all' || level === activeLevel;
          const matchQuery = !q || text.includes(q);
          li.style.display = matchLevel && matchQuery ? '' : 'none';
        });
      };

      courseInput?.addEventListener('input', applyCourseFilter);

      this.querySelectorAll<HTMLButtonElement>('[data-level-filter]').forEach((pill) => {
        pill.addEventListener('click', () => {
          activeLevel = pill.dataset.levelFilter || 'all';
          this.querySelectorAll('[data-level-filter]').forEach((p) =>
            p.setAttribute('aria-pressed', p === pill ? 'true' : 'false')
          );
          applyCourseFilter();
        });
      });
    }

    // 6. Mobile Stack Drill-Down Back Button & scrollsnapchange inert sync
    private initMobileStackDrillDown() {
      this.querySelectorAll<HTMLButtonElement>('[data-stack-back]').forEach((backBtn) => {
        backBtn.addEventListener('click', () => {
          const split = backBtn.closest<HTMLElement>('.workspace-split');
          if (history.state?.drcMobileDetail) history.back();
          else split?.scrollTo({ left: 0, behavior: 'auto' });
        });
      });

      const isMobile = () => window.matchMedia('(max-width: 767px)').matches;

      this.querySelectorAll<HTMLElement>('.workspace-split').forEach((stack) => {
        stack.addEventListener('scrollend', () => {
          if (isMobile() && stack.scrollLeft < stack.clientWidth * 0.25 && history.state?.drcMobileDetail) {
            history.back();
          }
        });
        const syncMobileInert = (activePane: Element | null) => {
          if (!isMobile() || !activePane) {
            stack.querySelectorAll('.workspace-pane-left, .workspace-pane-right').forEach((p) =>
              p.removeAttribute('inert')
            );
            return;
          }
          stack.querySelectorAll('.workspace-pane-left, .workspace-pane-right').forEach((pane) => {
            pane.toggleAttribute('inert', pane !== activePane);
          });
        };

        if ('onscrollsnapchange' in HTMLElement.prototype) {
          stack.addEventListener('scrollsnapchange', (e: any) => {
            syncMobileInert(e.snapTargetInline);
          });
        } else {
          const obs = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.intersectionRatio >= 0.95) {
                  syncMobileInert(entry.target);
                }
              }
            },
            { root: stack, threshold: 0.95 }
          );
          stack.querySelectorAll('.workspace-pane-left, .workspace-pane-right').forEach((p) => obs.observe(p));
        }
      });

      window.addEventListener('popstate', () => {
        if (history.state?.drcMobileDetail) return;
        this.querySelectorAll<HTMLElement>('.workspace-split').forEach((stack) => {
          if (isMobile()) stack.scrollTo({ left: 0, behavior: 'auto' });
        });
      });
    }

    // 7. Scrollspy fallback for browsers without CSS scroll-target-group: auto
    private initScrollspyFallback() {
      const readerScroll = document.getElementById('pub-reader-scroll');
      if (!readerScroll) return;

      if (CSS.supports('scroll-target-group: auto')) {
        const syncAria = () => {
          this.querySelectorAll('.reader-toc-nav').forEach((nav) => {
            const current = nav.querySelector('a:target-current');
            nav.querySelectorAll('a').forEach((a) => {
              a.setAttribute('aria-current', a === current ? 'true' : 'false');
            });
          });
        };
        readerScroll.addEventListener('scrollend', syncAria, { passive: true });
      } else {
        const sections = readerScroll.querySelectorAll<HTMLElement>('section[id], footer[id]');
        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const id = entry.target.getAttribute('id');
                this.querySelectorAll<HTMLAnchorElement>('.reader-toc-nav a').forEach((link) => {
                  const active = link.getAttribute('href') === `#${id}`;
                  link.classList.toggle(':target-current', active);
                  link.setAttribute('aria-current', String(active));
                });
              }
            });
          },
          { root: readerScroll, rootMargin: '-25% 0px -60% 0px', threshold: 0 }
        );
        sections.forEach((sec) => obs.observe(sec));
      }
    }

    // 8. Cursor-Tracked Ambient Light Spill (from portyxb InstrumentPanel.ts updateLightPosition)
    private initAmbientLightSpill() {
      this.addEventListener(
        'pointermove',
        (e: PointerEvent) => {
          const rect = this.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          this.style.setProperty('--light-x', `${x}px`);
          this.style.setProperty('--light-y', `${y}px`);
        },
        { passive: true }
      );
    }

    // 9. Tactile 3D Artefact Modals Controller (Codex, Tome, Ledger)
    private initArtefactModals() {
      // 1. Parse unified manifest catalogs
      const manifest = document.getElementById('drc-artefact-manifest');
      const parseJsonDataset = (raw: string | null | undefined): any[] => {
        if (!raw) return [];
        try {
          return JSON.parse(raw);
        } catch {
          try {
            const decoded = raw
              .replace(/&#34;/g, '"')
              .replace(/&#38;/g, '&')
              .replace(/&#39;/g, "'")
              .replace(/&quot;/g, '"')
              .replace(/&amp;/g, '&');
            return JSON.parse(decoded);
          } catch (e) {
            console.error('[DRC Artefacts] Failed to parse JSON dataset', e);
            return [];
          }
        }
      };

      const pubList = parseJsonDataset(manifest?.dataset?.publications || manifest?.getAttribute('data-publications'));
      const bookList = parseJsonDataset(manifest?.dataset?.books || manifest?.getAttribute('data-books'));
      const classList = parseJsonDataset(manifest?.dataset?.classes || manifest?.getAttribute('data-classes'));

      const pubMap = new Map(pubList.map((p) => [p.id, p]));
      const bookMap = new Map(bookList.map((b) => [b.id, b]));
      const classMap = new Map(classList.map((c) => [c.id, c]));

      // 2. Helper to construct archival review cards
      const createReviewCardElement = (rev: {
        author: string;
        role: string;
        term: string;
        rating?: string | number;
        highlight?: string;
        quote: string;
        num: number;
      }) => {
        const card = document.createElement('article');
        card.className = 'review-card bookplate-card';

        const cornerTl = document.createElement('div');
        cornerTl.className = 'bookplate-corner bookplate-corner--tl';
        cornerTl.setAttribute('aria-hidden', 'true');
        cornerTl.textContent = '❦';

        const cornerTr = document.createElement('div');
        cornerTr.className = 'bookplate-corner bookplate-corner--tr';
        cornerTr.setAttribute('aria-hidden', 'true');
        cornerTr.textContent = '❦';

        const top = document.createElement('div');
        top.className = 'review-card-top';

        const left = document.createElement('div');
        const strong = document.createElement('strong');
        strong.className = 'review-author';
        strong.textContent = rev.author;
        const roleSpan = document.createElement('span');
        roleSpan.className = 'review-role';
        roleSpan.textContent = rev.role;
        left.append(strong, roleSpan);

        const badges = document.createElement('div');
        badges.className = 'review-badges tabular';
        const termTag = document.createElement('span');
        termTag.className = 'review-term-tag';
        termTag.textContent = rev.term;
        const ratingTag = document.createElement('span');
        ratingTag.className = 'review-rating-tag';
        ratingTag.textContent = `★ ${typeof rev.rating === 'number' ? `${rev.rating.toFixed(1)} / 5.0` : (rev.rating || '5.0 / 5.0')}`;
        badges.append(termTag, ratingTag);

        top.append(left, badges);
        card.append(cornerTl, cornerTr, top);

        if (rev.highlight) {
          const hl = document.createElement('p');
          hl.className = 'review-highlight';
          hl.textContent = `“${rev.highlight}”`;
          card.appendChild(hl);
        }

        const bq = document.createElement('blockquote');
        bq.className = 'review-quote';
        const p = document.createElement('p');
        p.textContent = rev.quote;
        bq.appendChild(p);
        card.appendChild(bq);

        const foot = document.createElement('footer');
        foot.className = 'review-card-foot tabular';
        const s1 = document.createElement('span');
        s1.textContent = `EVALUATION RECORD #${String(rev.num).padStart(2, '0')}`;
        const s2 = document.createElement('span');
        s2.textContent = 'VERIFIED SEMINAR PARTICIPANT';
        foot.append(s1, s2);
        card.appendChild(foot);

        return card;
      };

      // Load approved public reviews from the backend. Legacy frontmatter reviews
      // are included by the endpoint so older classes remain visible.
      classList.forEach(async (cls) => {
        const listEl = this.querySelector<HTMLElement>(`[data-reviews-list="${cls.id}"]`);
        if (!listEl) return;
        try {
          const response = await fetch(`/api/public/reviews?classId=${encodeURIComponent(cls.id)}`);
          if (!response.ok) return;
          const payload = await response.json();
          if (!Array.isArray(payload.reviews)) return;
          listEl.replaceChildren();
          payload.reviews.forEach((item: any, idx: number) => listEl.appendChild(createReviewCardElement({ ...item, num: idx + 1 })));
          const ratings = payload.reviews.map((item: any) => Number.parseFloat(String(item.rating || '').replace(/[^0-9.]/g, ''))).filter((rating: number) => Number.isFinite(rating) && rating > 0);
          const score = this.querySelector<HTMLElement>(`[data-review-score="${cls.id}"]`);
          if (score && ratings.length) {
            const average = (ratings.reduce((sum: number, rating: number) => sum + rating, 0) / ratings.length).toFixed(1);
            score.textContent = `★ ${average} / 5.0 · COHORT AVERAGE`;
            score.hidden = false;
          } else if (score) score.hidden = true;
        } catch { /* Keep server-rendered legacy reviews visible if offline. */ }
      });

      // 4. Modal references
      const codexDialog = document.getElementById('publication-codex-dialog') as HTMLDialogElement | null;
      const tomeDialog = document.getElementById('book-tome-dialog') as HTMLDialogElement | null;
      const ledgerDialog = document.getElementById('class-ledger-dialog') as HTMLDialogElement | null;

      const codexSlab = document.getElementById('codex-slab-shell');
      const tomeSlab = document.getElementById('tome-slab-shell');
      const ledgerSlab = document.getElementById('ledger-slab-shell');

      // Setup 3D tilt tracking helper
      const setup3DTilt = (dialog: HTMLDialogElement | null, slab: HTMLElement | null) => {
        if (!dialog || !slab) return;
        const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (isReducedMotion || !window.matchMedia('(min-width: 768px)').matches) return;

        let tiltRaf: number | null = null;
        dialog.addEventListener('pointermove', (event) => {
          if (tiltRaf) cancelAnimationFrame(tiltRaf);
          tiltRaf = requestAnimationFrame(() => {
            const rect = slab.getBoundingClientRect();
            const px = (event.clientX - rect.left) / rect.width;
            const py = (event.clientY - rect.top) / rect.height;
            if (px >= 0 && px <= 1 && py >= 0 && py <= 1) {
              const tiltX = (py - 0.5) * -7;
              const tiltY = (px - 0.5) * 7;
              slab.style.setProperty('--modal-tilt-x', `${tiltX.toFixed(2)}deg`);
              slab.style.setProperty('--modal-tilt-y', `${tiltY.toFixed(2)}deg`);
              slab.style.setProperty('--modal-light-x', `${(px * 100).toFixed(1)}%`);
              slab.style.setProperty('--modal-light-y', `${(py * 100).toFixed(1)}%`);
            }
          });
        });

        dialog.addEventListener('pointerleave', () => {
          if (tiltRaf) cancelAnimationFrame(tiltRaf);
          slab.style.setProperty('--modal-tilt-x', '0deg');
          slab.style.setProperty('--modal-tilt-y', '0deg');
          slab.style.setProperty('--modal-light-x', '75%');
          slab.style.setProperty('--modal-light-y', '15%');
        });
      };

      setup3DTilt(codexDialog, codexSlab);
      setup3DTilt(tomeDialog, tomeSlab);
      setup3DTilt(ledgerDialog, ledgerSlab);

      // Smooth Ink-Blotting Close Helper
      const smoothCloseModal = async (dialog: HTMLDialogElement | null) => {
        if (!dialog || !dialog.open || dialog.hasAttribute('data-closing')) return;
        dialog.setAttribute('data-closing', '');

        const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (isReducedMotion) {
          dialog.removeAttribute('data-closing');
          dialog.close();
          return;
        }

        const animations = dialog.getAnimations({ subtree: true });
        if (animations.length > 0) {
          await Promise.race([
            Promise.allSettled(animations.map((a) => a.finished)),
            new Promise((r) => setTimeout(r, 380)),
          ]);
        } else {
          await new Promise((r) => setTimeout(r, 340));
        }

        if (dialog.hasAttribute('data-closing')) {
          dialog.removeAttribute('data-closing');
          dialog.close();
        }
      };

      // Intercept native Escape key on all 3 dialogs so the ink-blot exit plays
      [codexDialog, tomeDialog, ledgerDialog].forEach((dlg) => {
        dlg?.addEventListener('cancel', (e) => {
          e.preventDefault();
          smoothCloseModal(dlg);
        });
      });

      // Setup click-outside-to-dismiss helper
      const setupClickOutside = (dialog: HTMLDialogElement | null) => {
        if (!dialog) return;
        dialog.addEventListener('click', (event) => {
          if (event.target !== dialog) return;
          const rect = dialog.getBoundingClientRect();
          const isInside =
            rect.top <= event.clientY &&
            event.clientY <= rect.top + rect.height &&
            rect.left <= event.clientX &&
            event.clientX <= rect.left + rect.width;
          if (!isInside) smoothCloseModal(dialog);
        });
      };

      setupClickOutside(codexDialog);
      setupClickOutside(tomeDialog);
      setupClickOutside(ledgerDialog);

      // Close buttons
      document.getElementById('btn-close-codex')?.addEventListener('click', () => smoothCloseModal(codexDialog));
      document.getElementById('btn-close-tome')?.addEventListener('click', () => smoothCloseModal(tomeDialog));
      document.getElementById('btn-close-ledger')?.addEventListener('click', () => smoothCloseModal(ledgerDialog));

      // 5. Open Codex Modal
      const openCodex = (id: string) => {
        const pub = pubMap.get(id);
        if (!pub || !codexDialog) return;

        const folioTag = document.getElementById('codex-folio-tag');
        const venueEl = document.getElementById('codex-dialog-venue');
        const titleEl = document.getElementById('codex-dialog-title');
        const subEl = document.getElementById('codex-dialog-subtitle');
        const authEl = document.getElementById('codex-dialog-authors');
        const volEl = document.getElementById('codex-dialog-vol');
        const idEl = document.getElementById('codex-dialog-id');
        const bibEl = document.getElementById('codex-dialog-bibtex');
        const apaEl = document.getElementById('codex-dialog-apa');
        const permalinkEl = document.getElementById('codex-link-permalink') as HTMLAnchorElement | null;
        const doiEl = document.getElementById('codex-link-doi') as HTMLAnchorElement | null;

        if (folioTag) folioTag.textContent = `FOLIO ${pub.id.toUpperCase()} · CITATION ARCHIVE`;
        if (venueEl) venueEl.textContent = `${pub.venue.toUpperCase()} · ${pub.year}`;
        if (titleEl) titleEl.textContent = pub.title;

        if (subEl) {
          if (pub.subtitle) {
            subEl.textContent = pub.subtitle;
            subEl.style.display = 'block';
          } else {
            subEl.style.display = 'none';
          }
        }

        const allAuthors = ['Duncan R. Cordry', ...(pub.coAuthors || [])].join(', ');
        if (authEl) authEl.textContent = allAuthors;
        if (volEl) volEl.textContent = pub.volumeIssue || 'Archival Monograph / Record';
        if (idEl) idEl.textContent = pub.id.toUpperCase();
        if (bibEl) bibEl.textContent = pub.bibtex;

        const apaText = `${allAuthors} (${pub.year}). ${pub.title}. ${pub.venue}${pub.volumeIssue ? ', ' + pub.volumeIssue : ''}.${pub.doi ? ' ' + pub.doi : ''}`;
        if (apaEl) apaEl.textContent = apaText;

        if (permalinkEl) permalinkEl.href = `/publications/${pub.id}`;
        if (doiEl) {
          if (pub.doi) {
            doiEl.href = pub.doi;
            doiEl.style.display = 'inline-flex';
          } else {
            doiEl.style.display = 'none';
          }
        }

        codexDialog.removeAttribute('data-closing');
        codexDialog.showModal();
        applyInkTransition(codexDialog.querySelector('.artefact-modal-body'));
      };

      // Codex Copy buttons
      const copyBibBtn = document.getElementById('btn-codex-copy-bibtex');
      copyBibBtn?.addEventListener('click', () => {
        const text = document.getElementById('codex-dialog-bibtex')?.textContent || '';
        navigator.clipboard?.writeText(text);
        const orig = copyBibBtn.textContent;
        copyBibBtn.textContent = '✓ BibTeX Copied';
        setTimeout(() => (copyBibBtn.textContent = orig), 1600);
      });

      const copyApaBtn = document.getElementById('btn-codex-copy-apa');
      copyApaBtn?.addEventListener('click', () => {
        const text = document.getElementById('codex-dialog-apa')?.textContent || '';
        navigator.clipboard?.writeText(text);
        const orig = copyApaBtn.textContent;
        copyApaBtn.textContent = '✓ Citation Copied';
        setTimeout(() => (copyApaBtn.textContent = orig), 1600);
      });

      // 6. Open Tome Modal
      const openTome = (id: string) => {
        const book = bookMap.get(id);
        if (!book || !tomeDialog) return;

        const folioTag = document.getElementById('tome-folio-tag');
        const coverEl = document.getElementById('tome-dialog-cover') as HTMLImageElement | null;
        const pubEl = document.getElementById('tome-dialog-publisher');
        const isbnEl = document.getElementById('tome-dialog-isbn');
        const pagesEl = document.getElementById('tome-dialog-pages');
        const yearEl = document.getElementById('tome-dialog-year');
        const eyebrowEl = document.getElementById('tome-dialog-eyebrow');
        const titleEl = document.getElementById('tome-dialog-title');
        const subEl = document.getElementById('tome-dialog-subtitle');
        const synEl = document.getElementById('tome-dialog-synopsis');
        const buyWrap = document.getElementById('tome-purchase-links');
        const chList = document.getElementById('tome-chapters-list');
        const endWrap = document.getElementById('tome-endorsements-wrap');
        const endList = document.getElementById('tome-endorsements-list');

        if (folioTag) folioTag.textContent = `FOLIO ${book.id.toUpperCase()} · MONOGRAPH DOSSIER`;
        if (coverEl) {
          coverEl.src = book.coverImage;
          coverEl.alt = `Cover of ${book.title}`;
        }
        if (pubEl) pubEl.textContent = book.publisher;
        if (isbnEl) isbnEl.textContent = book.isbn;
        if (pagesEl) pagesEl.textContent = `${book.pages} Pages (Cloth Bound)`;
        if (yearEl) yearEl.textContent = String(book.year);

        if (eyebrowEl) eyebrowEl.textContent = `FOLIO ${book.id.toUpperCase()} · ${book.year}`;
        if (titleEl) titleEl.textContent = book.title;

        if (subEl) {
          if (book.subtitle) {
            subEl.textContent = book.subtitle;
            subEl.style.display = 'block';
          } else {
            subEl.style.display = 'none';
          }
        }

        if (synEl) synEl.textContent = book.synopsis;

        if (buyWrap) {
          buyWrap.innerHTML = '';
          (book.purchaseLinks || []).forEach((link: any) => {
            const a = document.createElement('a');
            a.href = link.url;
            a.target = '_blank';
            a.rel = 'noopener noreferrer';
            a.className = 'pill';
            a.style.cssText = 'text-decoration: none; color: var(--text-primary); padding: 0.4rem 0.75rem; text-align: center;';
            a.textContent = `${link.label} ↗`;
            buyWrap.appendChild(a);
          });
        }

        if (chList) {
          chList.innerHTML = '';
          (book.chapters || []).forEach((ch: any) => {
            const det = document.createElement('details');
            det.className = 'academic-accordion';
            det.open = true;

            const sum = document.createElement('summary');
            sum.innerHTML = `<span class="tabular" style="color: var(--accent); font-size: 0.8rem;">CH ${ch.number}</span> <span>${ch.title}</span>`;

            const body = document.createElement('div');
            body.className = 'accordion-body';
            body.innerHTML = `<p>${ch.summary}</p>`;

            det.append(sum, body);
            chList.appendChild(det);
          });
        }

        if (endWrap && endList) {
          if (book.endorsements && book.endorsements.length > 0) {
            endWrap.style.display = 'block';
            endList.innerHTML = '';
            book.endorsements.forEach((end: any) => {
              const fig = document.createElement('figure');
              fig.style.cssText = 'padding: 0.85rem 1.15rem; border-inline-start: 2px solid var(--accent); background: var(--bg-surface); border-radius: 0 4px 4px 0;';
              fig.innerHTML = `
                <blockquote><p style="font-family: var(--font-serif); font-style: italic; font-size: 0.98rem; margin-block-end: 0.25rem;">“${end.quote}”</p></blockquote>
                <figcaption class="tabular" style="font-size: 0.72rem; color: var(--text-muted);">— ${end.sourceTitle}</figcaption>
              `;
              endList.appendChild(fig);
            });
          } else {
            endWrap.style.display = 'none';
          }
        }

        tomeDialog.removeAttribute('data-closing');
        tomeDialog.showModal();
        applyInkTransition(tomeDialog.querySelector('.artefact-modal-body'));
      };

      // 7. Open Ledger Modal
      const tabEval = document.getElementById('btn-ledger-tab-eval');
      const tabCurr = document.getElementById('btn-ledger-tab-curr');
      const panelEval = document.getElementById('panel-ledger-eval');
      const panelCurr = document.getElementById('panel-ledger-curr');
      const ledgerForm = document.getElementById('ledger-review-form') as HTMLFormElement | null;
      const starsGroup = document.getElementById('ledger-stars-group');
      const ratingReadout = document.getElementById('ledger-rating-readout');
      const ratingInput = document.getElementById('ledger-form-rating') as HTMLInputElement | null;
      const submitBtn = document.getElementById('btn-ledger-submit');
      const reviewStatus = document.getElementById('ledger-review-status');

      const switchLedgerTab = (target: 'eval' | 'curr') => {
        if (target === 'eval') {
          tabEval?.setAttribute('aria-selected', 'true');
          tabCurr?.setAttribute('aria-selected', 'false');
          if (panelEval) panelEval.style.display = 'block';
          if (panelCurr) panelCurr.style.display = 'none';
        } else {
          tabEval?.setAttribute('aria-selected', 'false');
          tabCurr?.setAttribute('aria-selected', 'true');
          if (panelEval) panelEval.style.display = 'none';
          if (panelCurr) panelCurr.style.display = 'block';
        }
      };

      tabEval?.addEventListener('click', () => switchLedgerTab('eval'));
      tabCurr?.addEventListener('click', () => switchLedgerTab('curr'));

      starsGroup?.querySelectorAll<HTMLButtonElement>('.star-select-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const val = parseInt(btn.dataset.val || '5', 10);
          if (ratingInput) ratingInput.value = `${val}.0 / 5.0`;
          if (ratingReadout) ratingReadout.textContent = `${val}.0 / 5.0`;

          starsGroup.querySelectorAll<HTMLButtonElement>('.star-select-btn').forEach((s) => {
            const sVal = parseInt(s.dataset.val || '0', 10);
            s.classList.toggle('active', sVal <= val);
          });
        });
      });

      const openLedger = (courseId: string, initialTab: 'eval' | 'curr' = 'eval') => {
        const cls = classMap.get(courseId);
        if (!cls || !ledgerDialog) return;
        const reviewsEnabled = Boolean(cls.acceptingReviews);
        if (tabEval) tabEval.hidden = !reviewsEnabled;
        if (!reviewsEnabled && initialTab === 'eval') initialTab = 'curr';

        const folioTag = document.getElementById('ledger-folio-tag');
        const eyebrow = document.getElementById('ledger-dialog-eyebrow');
        const title = document.getElementById('ledger-dialog-title');
        const code = document.getElementById('ledger-dialog-code');
        const term = document.getElementById('ledger-dialog-term');
        const level = document.getElementById('ledger-dialog-level');
        const sched = document.getElementById('ledger-dialog-sched');
        const courseIdInput = document.getElementById('ledger-form-course-id') as HTMLInputElement | null;
        const termInput = document.getElementById('ledger-input-term') as HTMLInputElement | null;
        const weeksContainer = document.getElementById('ledger-weeks-container');

        if (folioTag) folioTag.textContent = `ACADEMIC LEDGER · ${cls.courseCode} · ${cls.term.toUpperCase()} ${cls.academicYear}`;
        if (eyebrow) eyebrow.textContent = `CURRICULUM ARCHIVE · ${cls.courseCode}`;
        if (title) title.textContent = cls.title;
        if (code) code.textContent = cls.courseCode;
        if (term) term.textContent = `${cls.term} (${cls.academicYear})`;
        if (level) level.textContent = cls.level;
        if (sched) sched.textContent = cls.schedule;

        if (courseIdInput) courseIdInput.value = cls.id;
        if (termInput) termInput.value = `${cls.term} ${cls.academicYear}`;
        if (reviewStatus) reviewStatus.textContent = 'Your review will be visible after instructor approval.';

        if (weeksContainer) {
          weeksContainer.innerHTML = '';
          (cls.weeks || []).forEach((wk: any) => {
            const card = document.createElement('div');
            card.style.cssText = 'padding: 0.85rem 1.15rem; border-radius: 4px; border: 1px solid var(--border-subtle); background: var(--bg-surface);';

            let readingsHtml = '';
            if (Array.isArray(wk.readings)) {
              readingsHtml = `<ul style="margin: 0.45rem 0 0; padding-inline-start: 1.15rem; font-size: 0.86rem; color: var(--text-secondary); display: flex; flex-direction: column; gap: 0.25rem;">${wk.readings.map((r: string) => `<li>${r}</li>`).join('')}</ul>`;
            }

            card.innerHTML = `
              <div style="display: flex; align-items: baseline; gap: 0.65rem;">
                <span class="tabular" style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--accent); font-weight: 600;">${wk.weekNumber}</span>
                <strong style="font-family: var(--font-serif); font-size: 1rem; color: var(--text-primary);">${wk.topic}</strong>
              </div>
              ${readingsHtml}
            `;
            weeksContainer.appendChild(card);
          });
        }

        switchLedgerTab(initialTab);
        ledgerDialog.removeAttribute('data-closing');
        ledgerDialog.showModal();
        applyInkTransition(ledgerDialog.querySelector('.artefact-modal-body'));
      };

      ledgerForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(ledgerForm);
        const courseId = String(fd.get('courseId') || '');
        const newReview = {
          classId: courseId,
          author: String(fd.get('author') || 'Seminar Participant').trim(),
          role: String(fd.get('role') || 'Ashoka University').trim(),
          term: String(fd.get('term') || '2025–2026').trim(),
          rating: Number.parseInt(String(fd.get('rating') || '5'), 10),
          highlight: String(fd.get('highlight') || '').trim(),
          quote: String(fd.get('quote') || '').trim(),
        };
        if (!newReview.quote || !courseId) return;
        const submit = submitBtn as HTMLButtonElement | null;
        if (submit) { submit.disabled = true; submit.textContent = 'Sending review…'; }
        try {
          const response = await fetch('/api/public/reviews', {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(newReview),
          });
          const result = await response.json();
          if (!response.ok) throw new Error(result.error || 'Could not send review.');
          if (reviewStatus) reviewStatus.textContent = result.message || 'Your review was received and is awaiting approval.';
          if (submit) { submit.textContent = '✓ Received · Awaiting Approval'; submit.classList.add('ink-record-active'); }
          setTimeout(() => {
            ledgerForm.reset();
            if (submit) { submit.disabled = false; submit.textContent = '✓ Record into Seminar Ledger'; submit.classList.remove('ink-record-active'); }
            smoothCloseModal(ledgerDialog);
          }, 1100);
        } catch (error: any) {
          if (submit) { submit.disabled = false; submit.textContent = '✓ Record into Seminar Ledger'; }
          if (reviewStatus) reviewStatus.textContent = error?.message || 'Could not send review. Please try again.';
        }
      });

      // 8. Delegated click triggers for all 3 buttons!
      this.addEventListener('click', (event) => {
        const target = event.target as HTMLElement | null;
        if (!target) return;

        const showInlineOnMobile = (kind: 'pub' | 'book' | 'class', id: string) => {
          if (!window.matchMedia('(max-width: 767px)').matches) return false;
          const selector = kind === 'pub' ? `[data-pub-select="${CSS.escape(id)}"]`
            : kind === 'book' ? `[data-book-select="${CSS.escape(id)}"]`
              : `[data-class-select="${CSS.escape(id)}"]`;
          const selectButton = this.querySelector<HTMLButtonElement>(selector);
          selectButton?.click();
          return true;
        };

        // Button 2: Publications Codex
        const pubBtn = target.closest<HTMLElement>('[data-open-pub-codex]');
        if (pubBtn) {
          event.preventDefault();
          const id = pubBtn.dataset.openPubCodex;
          if (id && !showInlineOnMobile('pub', id)) openCodex(id);
          return;
        }

        // Button 3: Books Tome
        const bookBtn = target.closest<HTMLElement>('[data-open-book-tome]');
        if (bookBtn) {
          event.preventDefault();
          const id = bookBtn.dataset.openBookTome;
          if (id && !showInlineOnMobile('book', id)) openTome(id);
          return;
        }

        // Button 4a: Classes Ledger (Curriculum)
        const classBtn = target.closest<HTMLElement>('[data-open-class-ledger]');
        if (classBtn) {
          event.preventDefault();
          const id = classBtn.dataset.openClassLedger;
          if (id && !showInlineOnMobile('class', id)) openLedger(id, 'curr');
          return;
        }

        // Button 4b: Classes Add Review (Evaluation)
        const reviewBtn = target.closest<HTMLElement>('[data-toggle-review-form]');
        if (reviewBtn) {
          event.preventDefault();
          const id = reviewBtn.dataset.toggleReviewForm;
          if (id && !showInlineOnMobile('class', id)) openLedger(id, 'eval');
          return;
        }
      });

      // Expose to window for external/dev usage
      (window as any).__drcOpenPubCodex = openCodex;
      (window as any).__drcOpenBookTome = openTome;
      (window as any).__drcOpenClassLedger = openLedger;
    }
  }

  if (!customElements.get('drc-workspace')) {
    customElements.define('drc-workspace', DrcWorkspace);
  }
</script>
