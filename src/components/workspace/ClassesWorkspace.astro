---
interface Props {
  classes: any[];
}

const { classes } = Astro.props;
---

<section
  id="view-classes"
  class="spa-view workspace-split inactive"
  data-view-idx="2"
  tabindex="-1"
  aria-label="Classes and Syllabi"
>
  <!-- LEFT PANE: Semester Ledger & Level Filter (with Close Index button inside the index pane) -->
  <aside class="workspace-pane-left">
    <div class="pane-inner-scroll" data-scrollable-pane>
      <header class="pane-toolbar">
        <div class="pane-toolbar-title">
          <span class="section-fleuron" aria-hidden="true">§</span>
          <h2 class="pane-heading">
            Course Archive <span class="count-badge tabular">[{String(classes.length).padStart(2, '0')}]</span>
          </h2>
        </div>
        <button
          type="button"
          class="pane-close-index-btn tabular"
          data-collapse-index
          aria-label="Close Index Pane"
          title="Close left index pane"
        >
          ◁ Close Index
        </button>
      </header>

      <search class="course-filter-bar" aria-label="Filter courses" style="padding: 0.85rem 1.25rem; border-block-end: 1px solid var(--border-subtle);">
        <label for="course-search-input" class="sr-only">Search courses by code or title</label>
        <input
          type="search"
          id="course-search-input"
          placeholder="Filter by course code or topic..."
          spellcheck="false"
          autocomplete="off"
          class="manuscript-search-input"
        />
        <div class="level-pill-group" role="group" aria-label="Filter by course level">
          <button type="button" class="pill" data-level-filter="all" aria-pressed="true">All</button>
          <button type="button" class="pill" data-level-filter="Undergraduate" aria-pressed="false">Undergraduate</button>
          <button type="button" class="pill" data-level-filter="Graduate" aria-pressed="false">Graduate</button>
          <button type="button" class="pill" data-level-filter="Seminar" aria-pressed="false">Seminar</button>
        </div>
      </search>

      <ul class="pub-list" id="course-index-list" role="list">
        {classes.map((cls, idx) => (
          <li
            data-course-level={cls.data.level}
            data-search-text={`${cls.data.courseCode} ${cls.data.title} ${cls.data.term}`.toLowerCase()}
          >
            <button
              type="button"
              class="pub-item-btn"
              aria-current={idx === 0 ? 'true' : 'false'}
              data-class-select={cls.data.id}
            >
              <div class="pub-item-top-row">
                <span class="index-slot-num tabular">{String(idx + 1).padStart(2, '0')}</span>
                <span class="pub-item-meta tabular">
                  {cls.data.courseCode} · {cls.data.term.toUpperCase()}
                </span>
              </div>
              <span class="pub-item-title">{cls.data.title}</span>
              <span class="pub-item-venue tabular">{cls.data.level} · {cls.data.academicYear}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </aside>

  <!-- RIGHT PANE: Syllabus, Weekly Schedule & Seminar Reviews -->
  <div class="workspace-pane-right">
    <button
      type="button"
      class="pane-reopen-index-btn tabular"
      data-expand-index
      aria-label="Open Index Pane"
      title="Re-open left index pane"
    >
      ▷ Open Index
    </button>

    <div class="pane-inner-scroll" data-scrollable-pane data-primary-reader>
      <div class="mobile-back-bar">
        <button type="button" class="btn-mobile-back tabular" data-stack-back>
          ◄ Back to Course Ledger
        </button>
        <span class="tabular" style="font-size: 0.7rem; color: var(--text-muted);">SYLLABUS BRIEFING</span>
      </div>

      <!-- Top Return Horizon Cue: Classes -> Books -->
      <div class="scroll-horizon-top-cue" data-jump-view="view-books">
        <span class="scholarly-caps">↑ Advance scroll upwards to return to II · BOOKS</span>
      </div>

      {classes.map((cls, idx) => {
        const c = cls.data;
        const reviews = c.reviews || [];
        const ratedReviews = reviews.map((review: any) => Number.parseFloat(String(review.rating || '').replace(/[^0-9.]/g, ''))).filter((rating: number) => Number.isFinite(rating) && rating > 0);
        const averageRating = ratedReviews.length ? (ratedReviews.reduce((sum: number, rating: number) => sum + rating, 0) / ratedReviews.length).toFixed(1) : '';
        return (
          <article
            class:list={['class-syllabus-entry', { 'entry-hidden': idx !== 0 }]}
            data-class-entry={c.id}
          >
            <header style="border-block-end: 1px solid var(--border-subtle); padding-block-end: 1.5rem; margin-block-end: 1.75rem;">
              <div class="reader-eyebrow-row">
                <span class="fascicle-tag tabular">
                  CURRICULUM · {c.courseCode}
                </span>
                <span class="colophon-stamp scholarly-caps">{c.level.toUpperCase()} SEMINAR</span>
              </div>
              <h3 class="reader-main-title" data-scramble-title>
                {c.title}
              </h3>

              <dl class="tabular colophon-specs-grid">
                <div>
                  <dt>TERM</dt>
                  <dd>{c.term} ({c.academicYear})</dd>
                </div>
                <div>
                  <dt>LEVEL</dt>
                  <dd>{c.level}</dd>
                </div>
                <div>
                  <dt>MEETING &amp; LOCATION</dt>
                  <dd>{c.schedule}</dd>
                </div>
                <div>
                  <dt>PRINTABLE SYLLABUS</dt>
                  <dd><a href={c.syllabusPdf || '/cv'} style="color: var(--accent);">Open Syllabus / CV ↗</a></dd>
                </div>
              </dl>
            </header>

            <section class="manuscript-abstract-vellum bookplate-frame" style="margin-block-end: 2rem;">
              <div class="bookplate-corner bookplate-corner--tl" aria-hidden="true">❦</div>
              <div class="bookplate-corner bookplate-corner--tr" aria-hidden="true">❦</div>
              <div class="bookplate-corner bookplate-corner--bl" aria-hidden="true">❦</div>
              <div class="bookplate-corner bookplate-corner--br" aria-hidden="true">❦</div>
              <h4 class="scholarly-caps" style="font-size: 0.74rem; letter-spacing: 0.14em; color: var(--accent); margin-block-end: 0.5rem;">
                SYNOPSIS · SEMINAR PROSPECTUS
              </h4>
              <p style="font-size: 0.98rem; color: var(--text-primary); line-height: 1.68; font-family: var(--font-serif);">
                {c.summary}
              </p>
            </section>

            {c.weeks.length > 0 && (
              <section style="margin-block-end: 2.5rem;">
                <h4 class="tabular" style="font-size: 0.74rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-block-end: 0.65rem;">
                  Weekly Schedule &amp; Required Readings
                </h4>
                <div>
                  {c.weeks.map((wk: any) => (
                    <details class="academic-accordion" open>
                      <summary>
                        <span class="tabular" style="color: var(--accent); font-size: 0.8rem;">{wk.weekNumber}</span>
                        <span>{wk.topic}</span>
                      </summary>
                      <div class="accordion-body">
                        <ul style="padding-inline-start: 1.15rem; display: flex; flex-direction: column; gap: 0.35rem;">
                          {wk.readings.map((reading: string) => (
                            <li>{reading}</li>
                          ))}
                        </ul>
                      </div>
                    </details>
                  ))}
                </div>
              </section>
            )}

            <!-- Seminar Reviews & Student Evaluations Section -->
            <section class="course-reviews-section" data-course-reviews={c.id}>
              <div class="reviews-header-row">
                <div>
                  <span class="fascicle-tag tabular" style="display: block; margin-block-end: 0.2rem;">
                    SEMINAR EVALUATION LEDGER · {c.courseCode}
                  </span>
                  <h4 class="reviews-section-title">
                    Student &amp; Peer Seminar Reviews
                  </h4>
                </div>
                <div class="reviews-header-actions">
                  <span class="review-score-pill tabular" data-review-score={c.id} hidden={!averageRating}>
                    {averageRating ? `★ ${averageRating} / 5.0 · COHORT AVERAGE` : ''}
                  </span>
                  {c.acceptingReviews && <button
                    type="button"
                    class="pill btn-toggle-review-form tabular"
                    data-toggle-review-form={c.id}
                  >
                    + Write a Review
                  </button>}
                  <button
                    type="button"
                    class="pill btn-open-class-ledger tabular"
                    data-open-class-ledger={c.id}
                    style="color: var(--accent); border-color: color-mix(in oklab, var(--accent) 45%, var(--border-subtle));"
                  >
                    📜 Curriculum &amp; Evaluation Ledger
                  </button>
                </div>
              </div>


              <div class="course-reviews-list" data-reviews-list={c.id}>
                {reviews.map((rev: any, rIdx: number) => (
                  <article class="review-card bookplate-card">
                    <div class="bookplate-corner bookplate-corner--tl" aria-hidden="true">❦</div>
                    <div class="bookplate-corner bookplate-corner--tr" aria-hidden="true">❦</div>
                    <div class="review-card-top">
                      <div>
                        <strong class="review-author">{rev.author}</strong>
                        <span class="review-role">{rev.role}</span>
                      </div>
                      <div class="review-badges tabular">
                        <span class="review-term-tag">{rev.term}</span>
                        <span class="review-rating-tag">★ {rev.rating || '5.0 / 5.0'}</span>
                      </div>
                    </div>
                    {rev.highlight && (
                      <p class="review-highlight">“{rev.highlight}”</p>
                    )}
                    <blockquote class="review-quote">
                      <p>{rev.quote}</p>
                    </blockquote>
                    <footer class="review-card-foot tabular">
                      <span>EVALUATION RECORD #{String(rIdx + 1).padStart(2, '0')}</span>
                      <span>VERIFIED SEMINAR PARTICIPANT</span>
                    </footer>
                  </article>
                ))}
              </div>
            </section>
          </article>
        );
      })}

      <!-- Bottom Return-to-Sky / CV Cue -->
      <div class="scroll-horizon-bridge" data-jump-view="view-publications">
        <div class="horizon-bridge-meta">
          <span class="horizon-kicker tabular">END OF ARCHIVE // FULL CYCLE</span>
          <strong class="horizon-title">↺ RETURN TO 01 · PUBLICATIONS OR /CV</strong>
        </div>
        <span class="horizon-hint tabular">Click to cycle back to Publications or scroll up to Books</span>
      </div>
    </div>
  </div>
</section>


<style>
  .entry-hidden {
    display: none;
  }
  .btn-mobile-back {
    font-size: 0.75rem;
    padding: 0.35rem 0.7rem;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
    background: var(--bg-elevated);
    color: var(--accent);
    cursor: pointer;
  }
</style>
