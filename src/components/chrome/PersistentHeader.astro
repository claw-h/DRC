---
import ThemeToggle from './ThemeToggle.astro';
import ContactIdCard from './ContactIdCard.astro';
import NavStrip from './NavStrip.astro';
import type { FacultyProfile } from '../../lib/system-state';

interface Props {
  profile: FacultyProfile;
  pubCount: number;
  bookCount: number;
  classCount: number;
}

const { profile, pubCount, bookCount, classCount } = Astro.props;
---

<div class="persistent-chrome">
  <header class="persistent-header">
    <!-- Left-docking / Center-origin Brand Lockup: DRC (Dead-Center) -> Glides Left -> Duncan R. Cordry (Serif) -->
    <a
      href="#stage-1"
      class="brand-lockup"
      id="header-brand-lockup"
      aria-label={`${profile.name} — Return to Constellation Sky`}
    >
      <span class="brand-text-stage">
        <span class="header-title-drc">{profile.monogram}</span>
        <span class="header-title-full" aria-hidden="true">{profile.name}</span>
      </span>
    </a>

    <!-- Right-Docked Persistent Hardware Controls -->
    <div class="header-actions">
      <div class="header-telemetry-pill" aria-hidden="true">
        <span class="led-socket is-on"></span>
        <span class="telemetry-pill-text tabular" id="header-epoch-readout">OBS // J2000.0</span>
      </div>

      <!-- Vintage Telephone Trigger -> Expands into Faculty ID Card -->
      <button
        type="button"
        id="contact-trigger-btn"
        class="chrome-icon-btn"
        commandfor="contact-id-card"
        command="show-modal"
        aria-label="Open Faculty Contact ID Card"
        title="Faculty Contact & Credentials Card"
      >
        <svg
          aria-hidden="true"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
        >
          <path
            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
          ></path>
        </svg>
      </button>

      <!-- Day / Night Observatory Mode Toggle -->
      <ThemeToggle />
    </div>
  </header>

  <NavStrip pubCount={pubCount} bookCount={bookCount} classCount={classCount} />
</div>

<ContactIdCard profile={profile} />
