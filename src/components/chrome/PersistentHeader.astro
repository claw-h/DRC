---
import ThemeToggle from './ThemeToggle.astro';
import AccessibilityToggle from './AccessibilityToggle.astro';
import ContactIdCard from './ContactIdCard.astro';
import NavStrip from './NavStrip.astro';
import SiteIntroGuide from './SiteIntroGuide.astro';
import type { FacultyProfile } from '../../lib/system-state';

interface Props {
  profile: FacultyProfile;
  pubCount: number;
  bookCount: number;
  classCount: number;
}

const { profile, pubCount, bookCount, classCount } = Astro.props;
---

<div class="persistent-chrome">
  <header class="persistent-header" id="persistent-header">
    <!-- Dual Fixed Stations (Option B):
         1. Center Station: Monogram (Stage 1 Constellation Sky)
         2. Left Station: Full Classical Serif Name (Stage 2 & 3 Pullup & Folio)
    -->
    <a
      href="#stage-1"
      class="brand-lockup brand-station-center"
      id="header-brand-center"
      aria-label={`${profile.name} — Return to Constellation Sky`}
    >
      <span class="header-title-drc">{profile.monogram}</span>
    </a>

    <a
      href="#stage-1"
      class="brand-lockup brand-station-left"
      id="header-brand-left"
      aria-label={`${profile.name} — Return to Constellation Sky`}
      tabindex="-1"
      aria-hidden="true"
    >
      <span class="header-title-full">{profile.name}</span>
    </a>

    <!-- Right-Docked Study Controls -->
    <div class="header-actions">
      <!-- Tiny Metallic Minecraft Block with Inscribed PCB Orthodox Cross Emblem -->
      <div
        class="mc-metallic-block-bar mc-emblem-block"
        id="mc-metallic-bar"
        role="banner"
        aria-label="PCB Orthodox Cross Emblem"
        title="PCB Orthodox Cross Emblem"
      >
        <!-- 4 Corner Pixel Rivets (Tiny Minecraft Iron Block) -->
        <span class="mc-pixel-rivet mc-pixel-rivet--tl" aria-hidden="true"></span>
        <span class="mc-pixel-rivet mc-pixel-rivet--tr" aria-hidden="true"></span>
        <span class="mc-pixel-rivet mc-pixel-rivet--bl" aria-hidden="true"></span>
        <span class="mc-pixel-rivet mc-pixel-rivet--br" aria-hidden="true"></span>

        <!-- Inscribed Circuit Cross Emblem -->
        <div class="mc-emblem-wrapper" aria-hidden="true">
          <img
            src="/images/pcb-orthodox-cross.webp"
            alt="PCB Orthodox Cross Emblem"
            class="mc-emblem-img"
            width="625"
            height="975"
            loading="eager"
            decoding="async"
          />
          <!-- Gold Transistor Circuit Sheen Overlay on Idle -->
          <div class="mc-circuit-sheen" aria-hidden="true"></div>
        </div>
      </div>

      <!-- Scholarly Visiting Card Trigger -> Expands into Faculty Credentials Card -->
      <button
        type="button"
        id="contact-trigger-btn"
        class="chrome-icon-btn"
        commandfor="contact-id-card"
        command="show-modal"
        aria-label="Open Faculty Credentials Card"
        title="Faculty Visiting & Credentials Card"
      >
        <svg
          aria-hidden="true"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
        >
          <path
            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
          ></path>
        </svg>
      </button>

      <!-- Accessibility High-Contrast & Font Mode Toggle -->
      <AccessibilityToggle />

      <!-- Day / Night Study Mode Toggle -->
      <ThemeToggle />
    </div>

    <!-- First-visit Top Bar Controls Tour -->
    <SiteIntroGuide />
  </header>

  <NavStrip pubCount={pubCount} bookCount={bookCount} classCount={classCount} />
</div>

<ContactIdCard profile={profile} />

<script>
  const centerStation = document.getElementById('header-brand-center');
  const leftStation = document.getElementById('header-brand-left');
  const metallicBlock = document.getElementById('mc-metallic-bar');

  const updateStationA11y = (stage?: string) => {
    const isStage1 = !stage || stage === 'stage-1';
    if (centerStation) {
      centerStation.setAttribute('aria-hidden', String(!isStage1));
      centerStation.setAttribute('tabindex', isStage1 ? '0' : '-1');
    }
    if (leftStation) {
      leftStation.setAttribute('aria-hidden', String(isStage1));
      leftStation.setAttribute('tabindex', isStage1 ? '-1' : '0');
    }
  };

  const updateBlockScrollFlip = () => {
    const isScrolled = window.scrollY > 20 || (document.body.dataset.stage && document.body.dataset.stage !== 'stage-1');
    if (metallicBlock) {
      metallicBlock.classList.toggle('is-scrolled-flipped', Boolean(isScrolled));
    }
  };

  window.addEventListener('scroll', updateBlockScrollFlip, { passive: true });

  const observer = new MutationObserver((mutations) => {
    for (const m of mutations) {
      if (m.type === 'attributes' && m.attributeName === 'data-stage') {
        updateStationA11y(document.body.dataset.stage);
        updateBlockScrollFlip();
      }
    }
  });

  observer.observe(document.body, { attributes: true, attributeFilter: ['data-stage'] });
  updateStationA11y(document.body.dataset.stage);
  updateBlockScrollFlip();
</script>
