---
import ThemeToggle from './ThemeToggle.astro';
import ContactIdCard from './ContactIdCard.astro';
import NavStrip from './NavStrip.astro';
import type { FacultyProfile } from '../../lib/system-state';

interface Props {
  profile: FacultyProfile;
  pubCount: number;
  bookCount: number;
  classCount: number;
}

const { profile, pubCount, bookCount, classCount } = Astro.props;
---

<div class="persistent-chrome">
  <header class="persistent-header is-load-expanding" id="persistent-header">
    <!-- Neutral Area Load-Time Calibration Cue: Two-Way Pointed Arrows Drawing In & Out -->
    <div class="header-neutral-cue" aria-hidden="true">
      <!-- Left Horizontal + Vertical Two-Way Pointed Arrow -->
      <svg class="neutral-arrow-svg neutral-arrow-svg--left" viewBox="0 0 180 44" fill="none">
        <!-- Horizontal two-way shaft drawing outward from center -->
        <line x1="90" y1="22" x2="14" y2="22" pathLength="100" class="neutral-draw-line" />
        <line x1="90" y1="22" x2="166" y2="22" pathLength="100" class="neutral-draw-line" />
        <!-- Left & Right Pointed Arrowheads -->
        <polyline points="22,16 12,22 22,28" pathLength="100" class="neutral-draw-head" />
        <polyline points="158,16 168,22 158,28" pathLength="100" class="neutral-draw-head" />
        <!-- Vertical two-way pointed arrow showing height expansion -->
        <line x1="90" y1="22" x2="90" y2="5" pathLength="100" class="neutral-draw-line" />
        <line x1="90" y1="22" x2="90" y2="39" pathLength="100" class="neutral-draw-line" />
        <polyline points="85,10 90,4 95,10" pathLength="100" class="neutral-draw-head" />
        <polyline points="85,34 90,40 95,34" pathLength="100" class="neutral-draw-head" />
      </svg>

      <span class="neutral-zone-label tabular">↕ NEUTRAL CURSOR ZONE ↕</span>

      <!-- Right Horizontal + Vertical Two-Way Pointed Arrow -->
      <svg class="neutral-arrow-svg neutral-arrow-svg--right" viewBox="0 0 180 44" fill="none">
        <line x1="90" y1="22" x2="14" y2="22" pathLength="100" class="neutral-draw-line" />
        <line x1="90" y1="22" x2="166" y2="22" pathLength="100" class="neutral-draw-line" />
        <polyline points="22,16 12,22 22,28" pathLength="100" class="neutral-draw-head" />
        <polyline points="158,16 168,22 158,28" pathLength="100" class="neutral-draw-head" />
        <line x1="90" y1="22" x2="90" y2="5" pathLength="100" class="neutral-draw-line" />
        <line x1="90" y1="22" x2="90" y2="39" pathLength="100" class="neutral-draw-line" />
        <polyline points="85,10 90,4 95,10" pathLength="100" class="neutral-draw-head" />
        <polyline points="85,34 90,40 95,34" pathLength="100" class="neutral-draw-head" />
      </svg>
    </div>

    <!-- Left-docking / Center-origin Brand Lockup: DRC (Dead-Center) -> Glides Left -> Duncan R. Cordry (Serif) -->
    <a
      href="#stage-1"
      class="brand-lockup"
      id="header-brand-lockup"
      aria-label={`${profile.name} — Return to Constellation Sky`}
    >
      <span class="brand-text-stage">
        <span class="header-title-drc">{profile.monogram}</span>
        <span class="header-title-full" aria-hidden="true">{profile.name}</span>
      </span>
    </a>

    <!-- Right-Docked Persistent Hardware Controls -->
    <div class="header-actions">
      <div class="header-telemetry-pill" aria-hidden="true">
        <span class="led-socket is-on"></span>
        <span class="telemetry-pill-text tabular" id="header-epoch-readout">OBS // J2000.0</span>
      </div>

      <!-- Vintage Telephone Trigger -> Expands into Faculty ID Card -->
      <button
        type="button"
        id="contact-trigger-btn"
        class="chrome-icon-btn"
        commandfor="contact-id-card"
        command="show-modal"
        aria-label="Open Faculty Contact ID Card"
        title="Faculty Contact & Credentials Card"
      >
        <svg
          aria-hidden="true"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
        >
          <path
            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
          ></path>
        </svg>
      </button>

      <!-- Day / Night Observatory Mode Toggle -->
      <ThemeToggle />
    </div>
  </header>

  <NavStrip pubCount={pubCount} bookCount={bookCount} classCount={classCount} />
</div>

<ContactIdCard profile={profile} />

<script>
  const replayNeutralHeaderIntro = () => {
    const header = document.getElementById('persistent-header');
    if (!header) return;
    header.classList.remove('is-load-expanding');
    // Force reflow so the height expansion + two-way arrow draw-in/out plays on every page load
    void header.offsetWidth;
    header.classList.add('is-load-expanding');
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', replayNeutralHeaderIntro, { once: true });
  } else {
    replayNeutralHeaderIntro();
  }
  window.addEventListener('pageshow', replayNeutralHeaderIntro);
</script>
