---
import type { FacultyProfile } from '../../lib/system-state';

interface Props {
  profile: FacultyProfile;
}

const { profile } = Astro.props;
---

<dialog id="contact-id-card" class="id-card-dialog bookplate-card" closedby="any" aria-labelledby="id-card-name">
  <div class="id-card-surface">
    <div class="bookplate-corner bookplate-corner--tl" aria-hidden="true">❦</div>
    <div class="bookplate-corner bookplate-corner--tr" aria-hidden="true">❦</div>
    <div class="bookplate-corner bookplate-corner--bl" aria-hidden="true">❦</div>
    <div class="bookplate-corner bookplate-corner--br" aria-hidden="true">❦</div>

    <header class="id-card-strip">
      <span style="display: inline-flex; align-items: center; gap: 0.45rem;">
        <span class="seal-mark" aria-hidden="true">❧</span>
        <span class="scholarly-caps">{profile.institution}</span>
      </span>
      <div style="display: inline-flex; align-items: center; gap: 0.65rem;">
        <span class="scholarly-caps">FOLIO · {profile.credentialId}</span>
        <button type="button" id="id-card-close-btn" class="id-card-close-btn" aria-label="Close visiting card">✕</button>
      </div>
    </header>

    <div class="id-card-body">
      <div class="id-card-photo-frame">
        <img
          src={profile.portraitUrl}
          alt={`Portrait of ${profile.name}`}
          width="96"
          height="120"
          class="id-card-photo"
          onerror="this.onerror=null;this.src='/images/duncan-cordry-portrait.svg';"
        />
      </div>
      <div class="id-card-identity">
        <span class="id-card-clearance scholarly-caps">FACULTY CARTE DE VISITE</span>
        <h2 id="id-card-name" class="id-card-name" style="font-family: var(--font-serif);">{profile.name}</h2>
        <p class="id-card-title">{profile.title}</p>
        <p class="id-card-dept">
          {profile.department} · {profile.education || 'Ph.D., Purdue University'}
        </p>
      </div>
    </div>

    <dl class="id-card-telemetry id-card-credentials">
      <div>
        <dt class="scholarly-caps">SCHOLARLY INQUIRY</dt>
        <dd><a href={`mailto:${profile.email}`} style="color: inherit;">{profile.email}</a></dd>
      </div>
      <div>
        <dt class="scholarly-caps">OFFICE &amp; CONSULTATION</dt>
        <dd>{profile.officeHours}</dd>
      </div>
    </dl>

    <footer class="id-card-actions">
      <a
        href={`mailto:${profile.email}?subject=Academic%20Inquiry%20for%20Prof.%20Duncan%20Cordry`}
        class="id-card-email-btn"
      >
        ✉ Email {profile.name} ↗
      </a>
      <div class="id-card-secondary-row">
        <button type="button" class="id-card-sub-btn" id="btn-copy-faculty-email" data-email={profile.email}>
          ⎘ Copy Email
        </button>
        {profile.philPeopleUrl && (
          <a href={profile.philPeopleUrl} target="_blank" rel="noopener noreferrer" class="id-card-sub-btn">
            PhilPeople ↗
          </a>
        )}
        {profile.ashokaProfileUrl && (
          <a href={profile.ashokaProfileUrl} target="_blank" rel="noopener noreferrer" class="id-card-sub-btn">
            Ashoka ↗
          </a>
        )}
        <a href="/cv" class="id-card-sub-btn">
          ↓ CV
        </a>
      </div>
    </footer>
  </div>
</dialog>

<style>
  .id-card-photo-frame {
    position: relative;
    display: inline-block;
    border-radius: 6px;
    overflow: hidden;
  }

  .id-card-photo {
    object-fit: cover;
    object-position: center top;
  }

  .bookplate-card {
    position: relative;
  }

  .bookplate-corner {
    position: absolute;
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: color-mix(in oklab, var(--accent) 60%, transparent);
    user-select: none;
    line-height: 1;
    pointer-events: none;
    z-index: 2;
  }

  .bookplate-corner--tl { inset-block-start: 0.55rem; inset-inline-start: 0.65rem; }
  .bookplate-corner--tr { inset-block-start: 0.55rem; inset-inline-end: 0.65rem; }
  .bookplate-corner--bl { inset-block-end: 0.55rem; inset-inline-start: 0.65rem; }
  .bookplate-corner--br { inset-block-end: 0.55rem; inset-inline-end: 0.65rem; }

  .id-card-clearance {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    color: var(--accent);
    margin-block-end: 0.15rem;
    display: block;
  }

  .seal-mark {
    font-family: var(--font-serif);
    font-size: 0.85rem;
    color: var(--accent);
    line-height: 1;
    user-select: none;
  }

  .id-card-close-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 0.82rem;
    cursor: pointer;
    line-height: 1;
    padding: 0.2rem 0.35rem;
    border-radius: 4px;
    transition: color 0.15s, background 0.15s;
  }

  .id-card-close-btn:hover {
    color: var(--accent);
    background: var(--bg-elevated);
  }
</style>

<script>
  const triggerBtn = document.getElementById('contact-trigger-btn');
  const dialog = document.getElementById('contact-id-card') as HTMLDialogElement | null;
  const copyBtn = document.getElementById('btn-copy-faculty-email') as HTMLButtonElement | null;
  const closeBtn = document.getElementById('id-card-close-btn');

  let supportsDisplayTransition: boolean | undefined;
  function canTransitionDisplay(): boolean {
    if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
    if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
      return false;
    }
    const probe = document.createElement('div');
    probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
    document.body.appendChild(probe);
    getComputedStyle(probe).display;
    probe.style.display = 'none';
    supportsDisplayTransition = getComputedStyle(probe).display === 'block';
    probe.remove();
    return supportsDisplayTransition;
  }

  function supportsTopLayerExit(): boolean {
    return Boolean(window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay());
  }

  async function closeIdCard() {
    if (!dialog) return;
    if (!supportsTopLayerExit()) {
      dialog.setAttribute('data-closing', '');
      const animations = dialog.getAnimations({ subtree: true });
      if (animations.length > 0) {
        await Promise.race([
          Promise.allSettled(animations.map((a) => a.finished)),
          new Promise((r) => setTimeout(r, 400)),
        ]);
      }
      if (!dialog.hasAttribute('data-closing')) return;
      dialog.removeAttribute('data-closing');
    }
    dialog.close();
  }

  closeBtn?.addEventListener('click', () => {
    closeIdCard();
  });

  triggerBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    if (!dialog) return;
    if (dialog.open) {
      closeIdCard();
    } else {
      dialog.showModal();
    }
  });

  dialog?.addEventListener('cancel', (event) => {
    event.preventDefault();
    closeIdCard();
  });

  dialog?.addEventListener('click', (event) => {
    if (event.target !== dialog) return;
    const rect = dialog.getBoundingClientRect();
    const isInside =
      rect.top <= event.clientY &&
      event.clientY <= rect.top + rect.height &&
      rect.left <= event.clientX &&
      event.clientX <= rect.left + rect.width;

    if (!isInside) {
      closeIdCard();
    }
  });

  copyBtn?.addEventListener('click', () => {
    const email = copyBtn.dataset.email || '';
    navigator.clipboard?.writeText(email);
    const orig = copyBtn.textContent;
    copyBtn.textContent = '✓ Copied';
    setTimeout(() => (copyBtn.textContent = orig), 1600);
  });

  // 3D Pointer-Tracking Tilt and Specular Highlight for Visiting Card
  const surface = dialog?.querySelector('.id-card-surface') as HTMLElement | null;
  const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (dialog && surface && !isReducedMotion && window.matchMedia('(min-width: 768px)').matches) {
    let tiltRaf: number | null = null;

    dialog.addEventListener('pointermove', (event) => {
      if (tiltRaf) cancelAnimationFrame(tiltRaf);
      tiltRaf = requestAnimationFrame(() => {
        const rect = surface.getBoundingClientRect();
        const px = (event.clientX - rect.left) / rect.width;
        const py = (event.clientY - rect.top) / rect.height;

        if (px >= 0 && px <= 1 && py >= 0 && py <= 1) {
          const tiltX = (py - 0.5) * -12;
          const tiltY = (px - 0.5) * 12;
          surface.style.setProperty('--card-tilt-x', `${tiltX.toFixed(2)}deg`);
          surface.style.setProperty('--card-tilt-y', `${tiltY.toFixed(2)}deg`);
          surface.style.setProperty('--card-light-x', `${(px * 100).toFixed(1)}%`);
          surface.style.setProperty('--card-light-y', `${(py * 100).toFixed(1)}%`);
        }
      });
    });

    dialog.addEventListener('pointerleave', () => {
      if (tiltRaf) cancelAnimationFrame(tiltRaf);
      surface.style.setProperty('--card-tilt-x', '0deg');
      surface.style.setProperty('--card-tilt-y', '0deg');
      surface.style.setProperty('--card-light-x', '85%');
      surface.style.setProperty('--card-light-y', '15%');
    });
  }
</script>
