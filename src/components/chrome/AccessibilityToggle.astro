<drc-accessibility-toggle>
  <button
    type="button"
    class="chrome-icon-btn"
    id="accessibility-toggle-btn"
    aria-label="Toggle high-contrast black-and-white and enlarged bold font"
    aria-pressed="false"
    title="Toggle Accessibility Mode: High Contrast & Large Bold Text"
  >
    <!-- Aa Typography & Legibility Symbol -->
    <svg
      class="icon-a11y"
      aria-hidden="true"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M3.5 19L8 6l4.5 13"></path>
      <path d="M5 14.5h6"></path>
      <circle cx="17.5" cy="15" r="3.2"></circle>
      <path d="M20.7 12v7"></path>
    </svg>
  </button>
</drc-accessibility-toggle>

<script>
  class DrcAccessibilityToggle extends HTMLElement {
    connectedCallback() {
      const btn = this.querySelector('button');
      if (!btn) return;

      const syncState = () => {
        const isEnabled = document.documentElement.getAttribute('data-a11y-mode') === 'true';
        btn.setAttribute('aria-pressed', String(isEnabled));
      };

      syncState();

      btn.addEventListener('click', () => {
        const isCurrentlyEnabled = document.documentElement.getAttribute('data-a11y-mode') === 'true';
        const targetState = !isCurrentlyEnabled;

        if (targetState) {
          document.documentElement.setAttribute('data-a11y-mode', 'true');
          try {
            localStorage.setItem('drc-a11y-mode', 'true');
          } catch {}
        } else {
          document.documentElement.removeAttribute('data-a11y-mode');
          try {
            localStorage.removeItem('drc-a11y-mode');
          } catch {}
        }

        btn.setAttribute('aria-pressed', String(targetState));
        window.dispatchEvent(
          new CustomEvent('drc-accessibility-changed', {
            detail: { enabled: targetState },
          })
        );
      });
    }
  }

  if (!customElements.get('drc-accessibility-toggle')) {
    customElements.define('drc-accessibility-toggle', DrcAccessibilityToggle);
  }
</script>
