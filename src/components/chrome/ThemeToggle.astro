<drc-theme-toggle>
  <button
    type="button"
    class="chrome-icon-btn"
    id="theme-toggle-btn"
    aria-label="Toggle day and night observatory mode"
    title="Toggle Day (Vellum Atlas) / Night (Observatory) Scheme"
  >
    <!-- Sun / Astrolabe Day Icon -->
    <svg class="icon-sun" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
      <circle cx="12" cy="12" r="4.5"></circle>
      <path d="M12 2v2.5M12 19.5V22M4.93 4.93l1.77 1.77M17.3 17.3l1.77 1.77M2 12h2.5M19.5 12H22M4.93 19.07l1.77-1.77M17.3 6.7l1.77-1.77"></path>
    </svg>
  </button>
</drc-theme-toggle>

<script>
  class DrcThemeToggle extends HTMLElement {
    connectedCallback() {
      const btn = this.querySelector('button');
      const meta = document.querySelector('meta[name="color-scheme"]') as HTMLMetaElement | null;
      if (!btn || !meta) return;

      btn.addEventListener('click', () => {
        const stored = localStorage.getItem('color-scheme');
        const sysDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const currentScheme =
          stored === 'dark' || stored === 'light' ? stored : sysDark ? 'dark' : 'light';
        const targetScheme = currentScheme === 'dark' ? 'light' : 'dark';
        const currentSysScheme = sysDark ? 'dark' : 'light';

        // Per modern-web-guidance dark-mode-toggle:
        // If target matches current system preference, remove stored value rather than pinning
        if (targetScheme === currentSysScheme) {
          try {
            localStorage.removeItem('color-scheme');
          } catch {}
          meta.content = 'light dark';
        } else {
          try {
            localStorage.setItem('color-scheme', targetScheme);
          } catch {}
          meta.content = targetScheme;
        }

        window.dispatchEvent(new CustomEvent('drc-theme-changed', { detail: { scheme: targetScheme } }));
      });
    }
  }

  if (!customElements.get('drc-theme-toggle')) {
    customElements.define('drc-theme-toggle', DrcThemeToggle);
  }
</script>
