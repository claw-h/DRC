---
import type { FacultyProfile } from '../../lib/system-state';

interface Props {
  profile: FacultyProfile;
  isDialog?: boolean;
  editablePortrait?: boolean;
  variant?: 'auto' | 'desktop' | 'mobile';
}

const { profile, isDialog = false, editablePortrait = false, variant = 'auto' } = Astro.props;
const id = isDialog ? 'public' : 'admin';
const firstName = profile.name.split(' ')[0] || profile.name;
const specialization = profile.aos?.[2] || profile.aos?.[0] || 'Philosophy of Technics & Organology';
---

<div
  class:list={['id-card-surface', { 'id-card-surface--standalone': !isDialog, 'id-card-surface--editable': editablePortrait }]}
  data-card-variant={variant}
  id={!isDialog ? 'admin-id-card-surface' : undefined}
>
  <div class="id-card-material" aria-hidden="true"></div>
  <div class="id-card-watermark" aria-hidden="true">✣</div>
  <div class="bookplate-corner bookplate-corner--tl" aria-hidden="true"><svg viewBox="-16 -16 32 32"><use href={`#ch-clover-rivet-${id}`} /></svg></div>
  <div class="bookplate-corner bookplate-corner--tr" aria-hidden="true"><svg viewBox="-16 -16 32 32"><use href={`#ch-clover-rivet-${id}`} /></svg></div>
  <div class="bookplate-corner bookplate-corner--bl" aria-hidden="true"><svg viewBox="-16 -16 32 32"><use href={`#ch-clover-rivet-${id}`} /></svg></div>
  <div class="bookplate-corner bookplate-corner--br" aria-hidden="true"><svg viewBox="-16 -16 32 32"><use href={`#ch-clover-rivet-${id}`} /></svg></div>

  <svg class="rivet-definitions" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id={`rivet-flange-${id}`} cx="35%" cy="30%" r="70%"><stop offset="0%" stop-color="#f1f5f9"/><stop offset="25%" stop-color="#cbd5e1"/><stop offset="65%" stop-color="#64748b"/><stop offset="100%" stop-color="#1e293b"/></radialGradient>
      <linearGradient id={`rivet-petal-${id}`} x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#fff"/><stop offset="20%" stop-color="#f1f5f9"/><stop offset="55%" stop-color="#94a3b8"/><stop offset="85%" stop-color="#475569"/><stop offset="100%" stop-color="#1e293b"/></linearGradient>
      <radialGradient id={`rivet-boss-${id}`} cx="30%" cy="30%" r="65%"><stop offset="0%" stop-color="#fff"/><stop offset="35%" stop-color="#e2e8f0"/><stop offset="75%" stop-color="#475569"/><stop offset="100%" stop-color="#0f172a"/></radialGradient>
      <g id={`ch-clover-rivet-${id}`}>
        <circle r="14.5" fill={`url(#rivet-flange-${id})`} stroke="#1e293b" stroke-width=".8"/><circle r="13" fill="none" stroke="#fff" stroke-opacity=".45" stroke-width=".5"/><circle r="11.5" fill="none" stroke="#0f172a" stroke-width=".5" stroke-dasharray="1.2 1.2"/><circle r="10" fill="#070a12"/>
        <path d="M-2.2-2C-4.2-4.8-6.5-7.5-3.8-10.2-1.5-11.2 1.5-11.2 3.8-10.2 6.5-7.5 4.2-4.8 2.2-2ZM-2.2 2C-4.2 4.8-6.5 7.5-3.8 10.2-1.5 11.2 1.5 11.2 3.8 10.2 6.5 7.5 4.2 4.8 2.2 2ZM-2-2.2C-4.8-4.2-7.5-6.5-10.2-3.8-11.2-1.5-11.2 1.5-10.2 3.8-7.5 6.5-4.8 4.2-2 2.2ZM2-2.2C4.8-4.2 7.5-6.5 10.2-3.8 11.2-1.5 11.2 1.5 10.2 3.8 7.5 6.5 4.8 4.2 2 2.2Z" fill={`url(#rivet-petal-${id})`} stroke="#cbd5e1" stroke-width=".4"/>
        <g fill="#cbd5e1" stroke="#334155" stroke-width=".3"><rect x="-5.2" y="-5.2" width="2" height="2" transform="rotate(45 -4.2 -4.2)"/><rect x="3.2" y="-5.2" width="2" height="2" transform="rotate(45 4.2 -4.2)"/><rect x="-5.2" y="3.2" width="2" height="2" transform="rotate(45 -4.2 4.2)"/><rect x="3.2" y="3.2" width="2" height="2" transform="rotate(45 4.2 4.2)"/></g>
        <circle r="3.6" fill={`url(#rivet-boss-${id})`} stroke="#1e293b" stroke-width=".5"/><circle cx="-.8" cy="-.8" r=".8" fill="#fff"/><path d="M-1.8 0h3.6M0-1.8v3.6" stroke="#050811" stroke-width=".7"/>
      </g>
    </defs>
  </svg>

  <header class="id-card-strip">
    <div class="id-card-institution"><span class="pcb-seal" aria-hidden="true"><i></i></span><span class="scholarly-caps" data-id-field="institution">{profile.institution}</span></div>
    <div class="id-card-folio"><span class="scholarly-caps">FOLIO · <span data-id-field="credentialId">{profile.credentialId}</span></span>{isDialog && <button type="button" id="id-card-close-btn" class="id-card-close-btn" aria-label="Close visiting card">×</button>}</div>
  </header>

  <div class="id-card-body">
    <div class:list={['id-card-photo-frame', { 'id-card-photo-frame--editable': editablePortrait }]} id={editablePortrait ? 'card-photo-trigger-zone' : undefined}>
      <img src={profile.portraitUrl} alt={`Portrait of ${profile.name}`} width="96" height="120" class="id-card-photo" data-id-field="portrait" onerror="this.onerror=null;this.src='/images/duncan-cordry-portrait.svg';" />
      <span class="photo-bracket photo-bracket--tl"></span><span class="photo-bracket photo-bracket--br"></span>
      {editablePortrait && <div class="photo-edit-overlay" aria-hidden="true"><span class="photo-edit-badge">✎ Edit Photo</span></div>}
    </div>
    <div class="id-card-identity">
      <span class="id-card-clearance scholarly-caps">FACULTY CARTE DE VISITE</span>
      <h2 id={isDialog ? 'id-card-name' : undefined} class="id-card-name" data-id-field="name">{profile.name}</h2>
      <p class="id-card-title" data-id-field="title">{profile.title}</p>
      <p class="id-card-dept"><span data-id-field="dept">{profile.department}</span><span class="id-card-separator"> · </span><span data-id-field="education">{profile.education || 'Ph.D., Purdue University'}</span></p>
      <span class="id-card-status"><i></i> ACTIVE · IN RESIDENCE</span>
    </div>
  </div>

  <dl class="id-card-telemetry">
    <div><dt>01 · OFFICE</dt><dd data-id-field="office">{profile.office}</dd></div>
    <div><dt>02 · CONSULTATION</dt><dd data-id-field="officeHours">{profile.officeHours}</dd></div>
    <div><dt>03 · SPECIALIZATION</dt><dd data-id-field="specialization">{specialization}</dd></div>
    <div><dt>04 · DISPATCH</dt><dd><a href={`mailto:${profile.email}`} data-id-field="email">{profile.email}</a></dd></div>
  </dl>

  <footer class="id-card-actions">
    <a href={`mailto:${profile.email}?subject=Academic%20Inquiry%20for%20Prof.%20Duncan%20Cordry`} class="id-card-email-btn" data-id-field="emailBtn">✉ Transmit Academic Inquiry <span aria-hidden="true">↗</span></a>
    <div class="id-card-secondary-row">
      <button type="button" class="id-card-sub-btn" data-email={profile.email}>⎘ Copy Dispatch</button>
      {profile.philPeopleUrl && <a href={profile.philPeopleUrl} target="_blank" rel="noopener noreferrer" class="id-card-sub-btn">PhilPeople ↗</a>}
      {profile.ashokaProfileUrl && <a href={profile.ashokaProfileUrl} target="_blank" rel="noopener noreferrer" class="id-card-sub-btn">Ashoka ↗</a>}
      <a href="/cv" class="id-card-sub-btn">↓ Full CV</a>
    </div>
  </footer>
  <div class="id-card-serial"><span>ASHOKA-PHIL-DRC // 2026-F</span><svg viewBox="0 0 14 14" role="img" aria-label="Credential matrix code"><path fill="currentColor" d="M0 0h14v1H1v12h12V1h1v13H0zm2 2h2v2H2zm4 0h1v2H6zm3 0h2v2H9zM2 6h1v1H2zm3 0h2v2H5zm4 1h1v1H9zm2-1h1v2h-1zM2 9h2v2H2zm4 0h1v1H6zm3 2h2v1H9zm-4 1h2v1H5z"/></svg></div>
</div>
