---
interface Props {
  pubCount: number;
  bookCount: number;
  classCount: number;
}

const { pubCount, bookCount, classCount } = Astro.props;
---

<nav class="nav-strip-wrapper" aria-label="Academic Sections">
  <ul class="nav-strip-track" id="nav-strip-track">
    <li>
      <button
        type="button"
        class="nav-strip-btn"
        data-target-view="view-publications"
        data-view-index="0"
        aria-current="page"
      >
        <span class="nav-strip-idx tabular">01</span>
        <span class="nav-strip-label">PUBLICATIONS</span>
        <span class="nav-strip-count tabular">[{String(pubCount).padStart(2, '0')}]</span>
      </button>
    </li>
    <li class="nav-strip-connector" aria-hidden="true">───</li>
    <li>
      <button
        type="button"
        class="nav-strip-btn"
        data-target-view="view-books"
        data-view-index="1"
        aria-current="false"
      >
        <span class="nav-strip-idx tabular">02</span>
        <span class="nav-strip-label">BOOKS</span>
        <span class="nav-strip-count tabular">[{String(bookCount).padStart(2, '0')}]</span>
      </button>
    </li>
    <li class="nav-strip-connector" aria-hidden="true">───</li>
    <li>
      <button
        type="button"
        class="nav-strip-btn"
        data-target-view="view-classes"
        data-view-index="2"
        aria-current="false"
      >
        <span class="nav-strip-idx tabular">03</span>
        <span class="nav-strip-label">CLASSES</span>
        <span class="nav-strip-count tabular">[{String(classCount).padStart(2, '0')}]</span>
      </button>
    </li>
  </ul>

  <div class="nav-strip-right">
    <div class="cathode-readout" aria-live="polite">
      <span class="cathode-label">CHANNEL</span>
      <span class="cathode-value tabular" id="nav-cathode-status">01 // PUBLICATIONS</span>
    </div>
    <div class="scroll-flow-meter" title="Continuous scroll progression across sections">
      <div class="scroll-flow-fill" id="nav-scroll-flow-fill" style="width: 33.3%;"></div>
    </div>
  </div>
</nav>

<style>
  .nav-strip-wrapper {
    justify-content: space-between;
    gap: 1rem;
  }

  .nav-strip-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.3rem;
    background: none;
    border: none;
    border-block-end: 2px solid transparent;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.16em;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.22s ease, border-color 0.22s ease, text-shadow 0.22s ease;
  }

  .nav-strip-btn:hover {
    color: var(--text-primary);
  }

  .nav-strip-btn[aria-current="page"] {
    color: var(--text-primary);
    border-block-end-color: var(--accent);
    font-weight: 600;
    text-shadow: 0 0 12px color-mix(in oklab, var(--accent) 45%, transparent);
  }

  .nav-strip-connector {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--border-subtle);
    user-select: none;
  }

  .nav-strip-idx {
    font-size: 0.66rem;
    color: var(--accent);
  }

  .nav-strip-count {
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .nav-strip-right {
    display: none;
    align-items: center;
    gap: 0.75rem;
  }

  /* Recessed Cathode Readout Badge (from portyxb InstrumentPanel.css) */
  .cathode-readout {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.22rem 0.6rem;
    border-radius: 3px;
    background: #020806;
    border: 1px solid rgba(94, 255, 164, 0.2);
    box-shadow:
      inset 0 3px 8px rgba(0, 0, 0, 0.92),
      0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .cathode-label {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.4);
  }

  .cathode-value {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: #5effa4;
    text-shadow:
      -1px 0 1px rgba(255, 0, 0, 0.45),
      1px 0 1px rgba(0, 80, 255, 0.45),
      0 0 6px rgba(94, 255, 164, 0.5);
  }

  .scroll-flow-meter {
    width: 72px;
    height: 4px;
    border-radius: 99px;
    background: var(--border-subtle);
    overflow: hidden;
  }

  .scroll-flow-fill {
    height: 100%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    transition: width 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (min-width: 768px) {
    .nav-strip-right {
      display: inline-flex;
    }
  }
</style>
