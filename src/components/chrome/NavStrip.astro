---
interface Props {
  pubCount: number;
  bookCount: number;
  classCount: number;
}

const { pubCount, bookCount, classCount } = Astro.props;
---

<nav class="nav-strip-wrapper" aria-label="Academic Sections">
  <ul class="nav-strip-track" id="nav-strip-track">
    <li>
      <button
        type="button"
        class="nav-strip-btn"
        data-target-view="view-publications"
        data-view-index="0"
        aria-current="page"
      >
        <span class="nav-strip-idx tabular">I</span>
        <span class="nav-strip-label">PUBLICATIONS</span>
        <span class="nav-strip-count tabular">[{String(pubCount).padStart(2, '0')}]</span>
      </button>
    </li>
    <li class="nav-strip-connector" aria-hidden="true">───</li>
    <li>
      <button
        type="button"
        class="nav-strip-btn"
        data-target-view="view-books"
        data-view-index="1"
        aria-current="false"
      >
        <span class="nav-strip-idx tabular">II</span>
        <span class="nav-strip-label">BOOKS</span>
        <span class="nav-strip-count tabular">[{String(bookCount).padStart(2, '0')}]</span>
      </button>
    </li>
    <li class="nav-strip-connector" aria-hidden="true">───</li>
    <li>
      <button
        type="button"
        class="nav-strip-btn"
        data-target-view="view-classes"
        data-view-index="2"
        aria-current="false"
      >
        <span class="nav-strip-idx tabular">III</span>
        <span class="nav-strip-label">CLASSES</span>
        <span class="nav-strip-count tabular">[{String(classCount).padStart(2, '0')}]</span>
      </button>
    </li>
  </ul>

  <div class="nav-strip-right">
    <div class="fascicle-locator" aria-live="polite">
      <span class="locator-icon">§</span>
      <span class="locator-value scholarly-caps" id="nav-cathode-status">FASCICLE I · PUBLICATIONS</span>
    </div>
    <div class="folio-ribbon-meter" title="Folio fascicle progression">
      <div class="folio-ribbon-fill" id="nav-scroll-flow-fill" style="width: 33.3%;"></div>
    </div>
  </div>
</nav>

<style>
  .nav-strip-wrapper {
    justify-content: space-between;
    gap: 1rem;
  }

  .nav-strip-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.3rem;
    background: none;
    border: none;
    border-block-end: 2px solid transparent;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.16em;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.22s ease, border-color 0.22s ease, text-shadow 0.22s ease;
  }

  .nav-strip-btn:hover {
    color: var(--text-primary);
  }

  .nav-strip-btn[aria-current="page"] {
    color: var(--text-primary);
    border-block-end-color: var(--accent);
    font-weight: 600;
    text-shadow: 0 0 12px color-mix(in oklab, var(--accent) 45%, transparent);
  }

  .nav-strip-connector {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--border-subtle);
    user-select: none;
  }

  .nav-strip-idx {
    font-size: 0.66rem;
    color: var(--accent);
  }

  .nav-strip-count {
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .nav-strip-right {
    display: none;
    align-items: center;
    gap: 0.75rem;
  }

  /* Scriptorium Fascicle Locator & Silk Ribbon Bookmark Progression */
  .fascicle-locator {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.22rem 0.55rem;
    border-radius: 2px;
    background: color-mix(in oklab, var(--bg-surface) 92%, var(--paper-vellum, #f4efe6) 8%);
    border: 1px solid var(--border-subtle);
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  .locator-icon {
    font-family: var(--font-serif);
    font-size: 0.75rem;
    color: var(--accent);
    user-select: none;
    line-height: 1;
  }

  .locator-value {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--text-primary);
  }

  .folio-ribbon-meter {
    width: 68px;
    height: 4px;
    border-radius: 1px;
    background: var(--border-subtle);
    overflow: hidden;
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.15);
  }

  .folio-ribbon-fill {
    height: 100%;
    background: var(--ribbon-silk, oklch(48% 0.17 28));
    transition: width 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (min-width: 768px) {
    .nav-strip-right {
      display: inline-flex;
    }
  }
</style>
