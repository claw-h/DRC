---
interface Props {
  featuredConstellationId?: string | null;
}

const { featuredConstellationId = null } = Astro.props;
---

<div class="sky-backdrop">
  <drc-constellation-canvas
    data-featured-id={featuredConstellationId ?? ''}
    style="display: block; inline-size: 100%; block-size: 100%; position: relative;"
  >
    <canvas
      id="sky-artefact-layer"
      class="sky-interactive-canvas"
      style="position: absolute; inset: 0; inline-size: 100%; block-size: 100%;"
    ></canvas>
  </drc-constellation-canvas>
</div>

<!-- Stage 1 Foreground: Academic Star-Atlas Folio Plate Cartouche & Margin Notes -->
<section id="stage-1" class="snap-stage stage-sky-hud" aria-label="Celestial Atlas & Cartography">
  <!-- Scholarly Margin Note: Star Astrometric Inset -->
  <div id="star-inset-popup" class="star-inset-popup" hidden>
    <svg class="inset-connector" viewBox="0 0 28 12" aria-hidden="true">
      <line x1="0" y1="6" x2="24" y2="6" stroke="currentColor" stroke-width="1" stroke-dasharray="2 3" opacity="0.6" />
      <circle cx="0" cy="6" r="2.5" fill="currentColor" opacity="0.8" />
    </svg>
    <div class="inset-card">
      <div class="inset-card-header">
        <div class="inset-header-left">
          <span class="inset-wet-indicator" id="inset-wet-indicator"></span>
          <span class="inset-kicker scholarly-caps" id="inset-star-designation">ASTROMETRIC FOLIO · α</span>
        </div>
        <div class="inset-header-right">
          <span class="inset-mag tabular" id="inset-star-mag">0.45 MAG</span>
          <button type="button" id="inset-close-btn" class="inset-close-btn" aria-label="Close star annotation">✕</button>
        </div>
      </div>

      <div class="inset-visual-box">
        <div class="inset-star-preview" id="inset-star-preview"></div>
        <div class="inset-visual-caption">
          <h3 class="inset-caption-title" id="inset-star-title">Betelgeuse</h3>
          <span class="inset-caption-sub" id="inset-star-catalog">α Ori · HIP 27989 · HD 39801</span>
        </div>
      </div>

      <div class="inset-card-body">
        <div class="inset-telemetry-row">
          <span class="inset-telemetry-label">SPECTRAL CLASS:</span>
          <span class="inset-telemetry-val" id="inset-star-spectral">M1-2 Ia-ab · 3,330 K</span>
        </div>
        <div class="inset-telemetry-row">
          <span class="inset-telemetry-label">DISTANCE FROM EARTH:</span>
          <span class="inset-telemetry-val" id="inset-star-dist">~548 LIGHT-YEARS</span>
        </div>
        <div class="inset-telemetry-row">
          <span class="inset-telemetry-label">CELESTIAL COORDINATES:</span>
          <span class="inset-telemetry-val tabular" id="inset-star-coords">RA 05h 55m · DEC +07° 24'</span>
        </div>
      </div>

      <div class="inset-card-footer">
        <span class="inset-ink-status" id="inset-ink-status">Ink re-wetted to spectral tint</span>
      </div>
    </div>
  </div>

  <div class="sky-hud-bottom-row">
    <!-- Left: Engraved Atlas Cartouche (Collapses to name-only, expands on hover) -->
    <div class="sky-hud-bottom-left">
      <div
        class="atlas-cartouche"
        id="sky-cartouche"
        tabindex="0"
        role="region"
        aria-label="Constellation Astrometric Cartouche"
      >
        <!-- Primary Compact Header Bar: Always visible, displaying constellation name -->
        <div class="cartouche-compact-bar" id="sky-title-cluster">
          <h1 class="sky-hud-name" id="hud-constellation-name">Orion</h1>
          <span class="cartouche-cue" aria-hidden="true" title="Hover or tap to reveal astrometry">✦</span>
        </div>

        <!-- Expanded Astrometric Folio: Reveals on hover/focus/tap -->
        <div class="cartouche-expanded-wrap">
          <div class="cartouche-expanded-inner" id="hud-cartouche-expanded-inner">
            <div class="cartouche-header">
              <span class="cartouche-plate-badge scholarly-caps" id="hud-plate-kicker">PLATE LX</span>
              <span class="cartouche-sep">·</span>
              <span class="cartouche-iau-code tabular" id="hud-constellation-id">IAU · ORI</span>
              <span class="cartouche-sep">·</span>
              <span class="cartouche-epoch tabular">EPOCH J2000.0</span>
            </div>

            <p class="sky-hud-meaning" id="hud-constellation-meaning"><em>Orionis</em> · The Celestial Hunter</p>

            <div class="cartouche-astrometry">
              <span class="cartouche-coords tabular" id="hud-constellation-coords">
                RA 05h 35m 17s · DEC +09° 56' 02"
              </span>
              <span class="cartouche-bullet" id="hud-deepsky-bullet">·</span>
              <span class="cartouche-deepsky" id="hud-nebula-designation">
                M42 · Great Orion Nebula
              </span>
            </div>

            <div class="cartouche-footer-hint">
              <span class="cartouche-hint-text">
                Engraved star plate · Click any star node to inspect astrometry · Scroll to enter archive
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: Folio Navigation & Export Actions -->
    <div class="sky-hud-bottom-right">
      <button
        type="button"
        class="sky-hud-btn scholarly-caps"
        id="btn-new-constellation"
        title="Turn to another engraved plate from the 88 IAU constellations"
      >
        ↻ Next Plate
      </button>
      <button
        type="button"
        class="sky-hud-btn scholarly-caps"
        id="btn-copy-sky-link"
        title="Copy permalink to this exact celestial plate"
      >
        ⌖ Plate Link
      </button>
      <button
        type="button"
        class="sky-hud-btn scholarly-caps"
        id="btn-export-chart"
        title="Export archival 4K engraved star chart plate (PNG)"
      >
        ↓ Export Plate
      </button>
      <a href="#stage-2" class="sky-scroll-cue scholarly-caps" aria-label="Scroll down to academic archive">
        SCROLL TO ENTER FOLIO ↓
      </a>
    </div>
  </div>
</section>

<style>
  .sky-interactive-canvas {
    cursor: default;
    background: transparent;
  }

  .stage-sky-hud {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1.5rem, 4vw, 3rem);
    pointer-events: none;
    position: relative;
    z-index: 10;
  }

  /* Classical Atlas Cartouche Box: Collapsible to name-only */
  .sky-hud-bottom-left {
    align-self: flex-end;
    max-inline-size: 100%;
  }

  .atlas-cartouche {
    pointer-events: auto;
    position: relative;
    background: color-mix(in oklch, var(--bg-surface) 92%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    padding: 0.55rem 1.15rem;
    box-shadow:
      0 10px 28px -6px rgba(0, 0, 0, 0.35),
      inset 0 0 0 1px color-mix(in oklch, var(--border-subtle) 40%, transparent);
    inline-size: fit-content;
    max-inline-size: fit-content;
    border-radius: 2px;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    transition:
      padding 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s ease,
      background-color 0.3s ease,
      box-shadow 0.35s ease;
  }

  .atlas-cartouche:hover,
  .atlas-cartouche:focus-within,
  .atlas-cartouche.is-expanded {
    padding: 1.15rem 1.55rem 1.1rem;
    border-color: var(--accent);
    background: color-mix(in oklch, var(--bg-surface) 96%, transparent);
    box-shadow:
      0 16px 40px -8px rgba(0, 0, 0, 0.45),
      inset 0 0 0 1px color-mix(in oklch, var(--accent) 30%, transparent);
    user-select: text;
    -webkit-user-select: text;
  }

  .cartouche-compact-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
  }

  .sky-hud-name {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.6vw, 2.75rem);
    font-weight: 400;
    line-height: 1.05;
    color: var(--text-primary);
    margin: 0;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  .cartouche-cue {
    font-size: 0.8rem;
    color: var(--accent);
    opacity: 0.65;
    line-height: 1;
    transform: rotate(0deg);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease, color 0.3s ease;
    flex-shrink: 0;
  }

  .atlas-cartouche:hover .cartouche-cue,
  .atlas-cartouche:focus-within .cartouche-cue,
  .atlas-cartouche.is-expanded .cartouche-cue {
    transform: rotate(45deg) scale(1.15);
    opacity: 1;
  }

  /* Smooth 60 FPS Accordion Reveal */
  .cartouche-expanded-wrap {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    pointer-events: none;
    max-inline-size: 0;
    overflow: hidden;
    margin-block-start: 0;
    transition:
      grid-template-rows 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      max-inline-size 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.28s ease,
      margin-block-start 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .atlas-cartouche:hover .cartouche-expanded-wrap,
  .atlas-cartouche:focus-within .cartouche-expanded-wrap,
  .atlas-cartouche.is-expanded .cartouche-expanded-wrap {
    grid-template-rows: 1fr;
    opacity: 1;
    pointer-events: auto;
    max-inline-size: min(34rem, calc(100vw - 4rem));
    margin-block-start: 0.85rem;
  }

  .cartouche-expanded-inner {
    overflow: hidden;
    min-height: 0;
    min-width: 0;
    width: max-content;
    max-width: min(34rem, calc(100vw - 4rem));
    display: flex;
    flex-direction: column;
    padding-block-start: 0.65rem;
    border-block-start: 1px solid color-mix(in oklch, var(--border-subtle) 60%, transparent);
  }

  .cartouche-header {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-block-end: 0.35rem;
  }

  .cartouche-plate-badge {
    font-weight: 600;
  }

  .cartouche-sep {
    opacity: 0.4;
  }

  .cartouche-epoch {
    color: var(--text-muted);
    font-size: 0.68rem;
  }

  .sky-hud-meaning {
    font-family: var(--font-serif);
    font-style: normal;
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    color: var(--text-secondary);
    margin-block-end: 0.5rem;
  }

  .sky-hud-meaning em {
    font-style: italic;
    color: var(--text-primary);
  }

  .cartouche-astrometry {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .cartouche-bullet {
    opacity: 0.5;
  }

  .cartouche-deepsky {
    color: var(--accent);
    font-family: var(--font-serif);
    font-style: italic;
  }

  .cartouche-footer-hint {
    margin-block-start: 0.65rem;
    padding-block-start: 0.5rem;
    border-block-start: 1px dashed color-mix(in oklch, var(--border-subtle) 65%, transparent);
    font-size: 0.7rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  /* Bottom Row Layout */
  .sky-hud-bottom-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    inline-size: 100%;
  }

  .sky-hud-bottom-right {
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.65rem;
  }

  .sky-hud-btn {
    appearance: none;
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklch, var(--bg-surface) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--text-primary);
    padding: 0.55rem 1.1rem;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s, color 0.2s, transform 0.15s;
  }

  .sky-hud-btn:hover {
    background: var(--bg-elevated);
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-1px);
  }

  .sky-scroll-cue {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    text-decoration: none;
    padding-block: 0.35rem;
    transition: color 0.2s, transform 0.2s;
  }

  .sky-scroll-cue:hover {
    color: var(--accent);
    transform: translateY(2px);
  }

  /* Scholarly Margin Note: Star Inset Popup */
  .star-inset-popup {
    position: absolute;
    pointer-events: auto;
    z-index: 40;
    width: 20rem;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .inset-connector {
    position: absolute;
    width: 28px;
    height: 12px;
    left: -24px;
    top: 24px;
    color: var(--accent);
    pointer-events: none;
  }

  .inset-card {
    background: color-mix(in oklch, var(--bg-surface) 96%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border-subtle);
    box-shadow: 0 16px 40px -10px rgba(0, 0, 0, 0.45);
    padding: 1rem 1.15rem;
  }

  .inset-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-block-end: 0.65rem;
    padding-block-end: 0.45rem;
    border-block-end: 1px solid var(--border-subtle);
  }

  .inset-header-left {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .inset-wet-indicator {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px var(--accent);
  }

  .inset-kicker {
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .inset-mag {
    font-size: 0.72rem;
    color: var(--accent);
    font-weight: 600;
  }

  .inset-close-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 0.85rem;
    cursor: pointer;
    padding: 0 0.25rem;
    margin-inline-start: 0.35rem;
  }

  .inset-close-btn:hover {
    color: var(--text-primary);
  }

  .inset-visual-box {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-block-end: 0.75rem;
  }

  .inset-star-preview {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--border-subtle);
    flex-shrink: 0;
    transition: background 0.3s, box-shadow 0.3s;
  }

  .inset-caption-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 400;
    color: var(--text-primary);
    line-height: 1.15;
  }

  .inset-caption-sub {
    font-size: 0.76rem;
    color: var(--text-secondary);
    font-family: var(--font-serif);
    font-style: italic;
  }

  .inset-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.74rem;
    margin-block-end: 0.65rem;
  }

  .inset-telemetry-row {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .inset-telemetry-label {
    color: var(--text-muted);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
  }

  .inset-telemetry-val {
    color: var(--text-primary);
    font-weight: 500;
  }

  .inset-card-footer {
    border-block-start: 1px dashed var(--border-subtle);
    padding-block-start: 0.45rem;
    font-size: 0.66rem;
    color: var(--accent);
    font-style: italic;
  }

  @media (max-width: 768px) {
    .stage-sky-hud {
      padding: 1rem;
    }
    .sky-hud-bottom-row {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
    }
    .sky-hud-bottom-left {
      align-self: flex-start;
      max-inline-size: 100%;
    }
    .atlas-cartouche {
      align-self: flex-start;
      inline-size: fit-content;
      max-inline-size: fit-content;
    }
    .atlas-cartouche:hover,
    .atlas-cartouche:focus-within,
    .atlas-cartouche.is-expanded {
      max-inline-size: 100%;
    }
    .sky-hud-bottom-right {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>

<script>
  // Academic Ink Star-Atlas & Celestial Slew Engine
  class DrcConstellationCanvas extends HTMLElement {
    private canvas!: HTMLCanvasElement;
    private ctx!: CanvasRenderingContext2D;
    private rafId: number = 0;
    private isVisible: boolean = true;
    private observer: IntersectionObserver | null = null;
    private lastTime: number = 0;

    // Authoritative astronomical datasets
    private constellations: any[] = [];
    private stars: any[] = [];
    private starsMap: Map<number, any> = new Map();
    private currentConstellation: any = null;
    private previousConstellation: any = null;

    // Celestial camera & slewing state
    private camera = {
      ra: 0,
      dec: 0,
      targetRa: 0,
      targetDec: 0,
      startRa: 0,
      startDec: 0,
      dRa: 0,
      slewStartTime: 0,
      slewDuration: 1300, // ms
      isSlewing: false
    };

    // Diurnal sidereal drift (degrees)
    private siderealAngle: number = 0;

    // Inking & drying animation state
    private drawStartTime: number = 0;
    private readonly INK_DRAW_DURATION = 1800; // ms for line drawing
    private readonly DRYING_DURATION = 2400;   // ms for spectral tint to fade to monochrome ink

    // Interactive state & multi-plane parallax physics
    private hoveredStar: any = null;
    private selectedStar: any = null;
    private isInteracting: boolean = false;
    private mousePos = { x: -1000, y: -1000 };
    private parallax = { x: 0, y: 0, targetX: 0, targetY: 0 };

    // Dense Diamond Dust Background Stars
    private denseFieldStars: any[] = [];

    // Precomputed per-catalogue-star [noiseSeed, rBase, alphaBase]
    private starDerived: Float32Array = new Float32Array(0);

    // Atmospheric scintillation state
    private seeing: number = 1;                 // sky-wide turbulence (calm ↔ restless spells)
    private reducedMotion: boolean = false;     // prefers-reduced-motion: freeze twinkle
    private staticScintillation: boolean = false; // export: render at mean brightness

    // Deep-Sky Galaxy Morphology Cache (deterministic per celestial object)
    private galaxyGenomes: Map<string, GalaxyMorphology> = new Map();

    // Universal Cosmological Background Deep Field Galaxies (20–45 distant micro-galaxies)
    private universalFieldGalaxies: any[] = [];

    // Cosmic Transients Engine (Sporadic Meteor Bolides & Ionized Wakes)
    private meteorState = {
      active: false,
      startX: 0,
      startY: 0,
      endX: 0,
      endY: 0,
      startTime: 0,
      duration: 650,
      nextTrigger: 0,
      trail: [] as Array<{ x: number, y: number, time: number }>
    };

    async connectedCallback() {
      this.canvas = this.querySelector('#sky-artefact-layer') as HTMLCanvasElement;
      this.ctx = this.canvas.getContext('2d', { alpha: true })!;
      this.meteorState.nextTrigger = performance.now() + 7000;

      // Accessibility: freeze stellar twinkle for users who prefer reduced motion
      const motionQuery = window.matchMedia?.('(prefers-reduced-motion: reduce)');
      if (motionQuery) {
        this.reducedMotion = motionQuery.matches;
        motionQuery.addEventListener?.('change', (e) => { this.reducedMotion = e.matches; });
      }

      this.resizeCanvas();
      window.addEventListener('resize', () => this.resizeCanvas(), { passive: true });

      // Setup IntersectionObserver on #stage-1 for Zero-GPU-Melt protection
      this.setupVisibilityObserver();

      // Setup document visibility listener
      document.addEventListener('visibilitychange', () => this.handleVisibilityChange());

      await this.loadCatalogs();
      this.initSelectedConstellation();
      this.bindEvents();
      this.startRenderLoop();
    }

    // -----------------------------------------------------------------------
    // Atmospheric Scintillation Model
    //
    // Real twinkling is caused by turbulent air cells focusing / defocusing
    // starlight. Its intensity statistics are log-normal (mostly steady with
    // brief sharp flares and dips), its power sits roughly at 1–20 Hz, it is
    // far stronger at high airmass (near the horizon), it is more noticeable
    // on bright stars, and the whole sky cycles through calmer / more
    // turbulent spells. Planets aside, every star flickers independently.
    // -----------------------------------------------------------------------

    private isScintillationFrozen(): boolean {
      return this.reducedMotion || this.staticScintillation;
    }

    /** Sky-wide seeing level 0.65 (calm) .. 1.2 (restless), varying over ~15–30 s. */
    private updateSeeing(now: number) {
      this.seeing = this.isScintillationFrozen()
        ? 1
        : 0.65 + 0.55 * (0.5 + 0.5 * valueNoise1D(now * 0.00006, 3));
    }

    /** Screen-space airmass proxy: the lower edge of the viewport stands in for the horizon. */
    private airmassAt(y: number, h: number): number {
      const t = clamp(0, y / h, 1);
      return 0.65 + 0.85 * t * t;
    }

    /**
     * Log-normal scintillation multiplier (mean ≈ 1).
     * Fast band: two octaves of value noise at ~3–6 lattice points/s plus a 2.37× octave,
     * giving perceptible flicker of roughly 2–8 Hz. Slow band: a gentle ~4 s seeing swell.
     */
    private scintillation(seed: number, now: number, mag: number, airmass: number, isDark: boolean): number {
      if (this.isScintillationFrozen()) return 1;
      const rate = 0.0045 * (0.7 + seed * 0.7);
      const ch = Math.floor(seed * 9973);
      const n = (valueNoise1D(now * rate, ch) + 0.5 * valueNoise1D(now * rate * 2.37, ch + 17)) * 1.6;
      const magFactor = clamp(0.35, (6.8 - mag) / 6.3, 1.15);
      let sigma = 0.34 * magFactor * airmass * this.seeing;
      if (!isDark) sigma *= 0.25; // ink on paper barely shimmers
      const fast = Math.exp(sigma * n - 0.3 * sigma * sigma);
      const swell = 1 + 0.1 * valueNoise1D(now * 0.00025, ch + 101);
      return fast * swell;
    }

    /** Draws a pre-rendered PSF sprite whose visual core radius is `coreR` px. */
    private drawStarSprite(x: number, y: number, coreR: number, bv: number, saturation: number, alpha: number) {
      if (alpha <= 0.004) return;
      const d = coreR * 2 * STAR_SPRITE_EXTENT;
      const sprite = getStarSprite(bv, saturation, d);
      this.ctx.globalAlpha = Math.min(1, alpha);
      this.ctx.drawImage(sprite, x - d / 2, y - d / 2, d, d);
    }

    /**
     * Chromatic scintillation for the very brightest stars (mag < 1, dark sky).
     * Atmospheric dispersion separates colours into slightly different ray paths, so red
     * and blue light twinkle out of step – the flashing "Sirius effect". Red sits a hair
     * lower and blue higher, as refraction lifts shorter wavelengths more.
     * Caller must have additive compositing active; globalAlpha is used as a multiplier.
     */
    private drawChromaticScintillation(
      x: number, y: number, coreR: number, seed: number, now: number, mag: number, airmass: number
    ) {
      if (mag > 1.0 || this.isScintillationFrozen()) return;
      const strength = clamp(0, (1.2 - mag) / 2.7, 1) * airmass * this.seeing;
      const rate = 0.0065 * (0.8 + seed * 0.5);
      const ch = Math.floor(seed * 7919) + 503;
      const nR = valueNoise1D(now * rate, ch);
      const nB = valueNoise1D(now * rate, ch + 61);
      const d = coreR * 2 * STAR_SPRITE_EXTENT * 1.15;
      const shift = 0.35 * airmass;
      const base = this.ctx.globalAlpha;

      const redA = Math.max(0, nR - 0.1) * 0.75 * strength;
      if (redA > 0.01) {
        this.ctx.globalAlpha = base * Math.min(1, redA);
        this.ctx.drawImage(getStarSprite(1.9, 1, d), x - d / 2, y - d / 2 + shift, d, d);
      }
      const blueA = Math.max(0, nB - 0.1) * 0.75 * strength;
      if (blueA > 0.01) {
        this.ctx.globalAlpha = base * Math.min(1, blueA);
        this.ctx.drawImage(getStarSprite(-0.35, 1, d), x - d / 2, y - d / 2 - shift, d, d);
      }
      this.ctx.globalAlpha = base;
    }

    disconnectedCallback() {
      if (this.rafId) {
        cancelAnimationFrame(this.rafId);
        this.rafId = 0;
      }
      if (this.observer) {
        this.observer.disconnect();
        this.observer = null;
      }
    }

    private setupVisibilityObserver() {
      const stageEl = document.getElementById('stage-1');
      if (!stageEl || !('IntersectionObserver' in window)) return;

      this.observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          this.isVisible = entry.isIntersecting;
          if (this.isVisible) {
            if (!this.rafId) {
              this.lastTime = performance.now();
              this.startRenderLoop();
            }
          } else {
            if (this.rafId) {
              cancelAnimationFrame(this.rafId);
              this.rafId = 0;
            }
          }
        }
      }, { threshold: 0.05 });

      this.observer.observe(stageEl);
    }

    private handleVisibilityChange() {
      if (document.hidden) {
        if (this.rafId) {
          cancelAnimationFrame(this.rafId);
          this.rafId = 0;
        }
      } else if (this.isVisible && !this.rafId) {
        this.lastTime = performance.now();
        this.startRenderLoop();
      }
    }

    private resizeCanvas() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = window.innerWidth;
      const h = window.innerHeight;

      this.canvas.width = Math.floor(w * dpr);
      this.canvas.height = Math.floor(h * dpr);
      this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      this.renderSingleFrame(performance.now());
    }

    private async loadCatalogs() {
      try {
        const [constRes, starsRes] = await Promise.all([
          fetch('/data/sky/constellations.json'),
          fetch('/data/sky/stars.json')
        ]);
        this.constellations = await constRes.json();
        this.stars = await starsRes.json();

        // Populate fast lookup map for all Hipparcos stars
        this.starsMap.clear();
        for (const s of this.stars) {
          this.starsMap.set(s[0], s);
        }

        // Precompute [noiseSeed, rBase, alphaBase] per star.
        // Brightness follows Pogson's law (×2.512 per magnitude) relative to mag 6.0.
        this.starDerived = new Float32Array(this.stars.length * 3);
        for (let i = 0; i < this.stars.length; i++) {
          const [hip, , , mag] = this.stars[i];
          const relFlux = Math.pow(10, -0.4 * (mag - 6.0));
          this.starDerived[i * 3] = hash01(hip);
          this.starDerived[i * 3 + 1] = 0.75 + 0.62 * Math.pow(relFlux, 0.25);
          this.starDerived[i * 3 + 2] = 0.55 * Math.pow(relFlux, 0.3);
        }
      } catch (err) {
        console.error('[DRC Atlas] Failed to load catalog assets:', err);
      }
    }

    private initSelectedConstellation() {
      if (!this.constellations || this.constellations.length === 0) return;

      const urlParams = new URLSearchParams(window.location.search);
      const skyParam = urlParams.get('sky');
      const featuredId = this.dataset.featuredId;

      let chosen = null;
      if (skyParam) {
        chosen = this.constellations.find(
          c => c.id.toLowerCase() === skyParam.toLowerCase() ||
               c.name.toLowerCase() === skyParam.toLowerCase()
        );
        // Fallback for legacy DRC-0001 aliases
        if (!chosen && skyParam.startsWith('DRC-')) {
          const num = parseInt(skyParam.replace('DRC-', ''), 10);
          if (!Number.isNaN(num)) {
            chosen = this.constellations[(num - 1) % this.constellations.length];
          }
        }
      }

      if (!chosen && featuredId) {
        chosen = this.constellations.find(c => c.id === featuredId);
      }

      if (!chosen) {
        // Default to Orion (Ori), Ursa Major (UMa), or Cassiopeia (Cas)
        chosen = this.constellations.find(c => c.id === 'Ori') || this.constellations[0];
      }

      this.currentConstellation = chosen;
      this.galaxyGenomes.clear();
      this.generateDenseFieldStars(chosen);
      this.generateUniversalFieldGalaxies(chosen);
      this.camera.ra = chosen.barycenterRaDeg ?? 83.8;
      this.camera.dec = chosen.barycenterDecDeg ?? 9.9;
      this.camera.targetRa = this.camera.ra;
      this.camera.targetDec = this.camera.dec;
      this.camera.isSlewing = false;

      this.updateCartouche(chosen);
      this.drawStartTime = performance.now();
    }

    private slewToConstellation(target: any) {
      if (!target || target === this.currentConstellation) {
        this.drawStartTime = performance.now();
        return;
      }

      this.previousConstellation = this.currentConstellation;
      this.currentConstellation = target;
      this.galaxyGenomes.clear();
      this.generateDenseFieldStars(target);
      this.generateUniversalFieldGalaxies(target);
      this.updateCartouche(target);

      this.camera.startRa = this.camera.ra;
      this.camera.startDec = this.camera.dec;
      this.camera.targetRa = target.barycenterRaDeg ?? 0;
      this.camera.targetDec = target.barycenterDecDeg ?? 0;

      // Calculate shortest angular path across Right Ascension (0..360 meridian wrap)
      let dRa = this.camera.targetRa - this.camera.startRa;
      while (dRa > 180) dRa -= 360;
      while (dRa < -180) dRa += 360;
      this.camera.dRa = dRa;

      this.camera.slewStartTime = performance.now();
      this.camera.isSlewing = true;
      this.drawStartTime = performance.now() + 350; // New inking begins as camera arrives

      this.selectedStar = null;
      document.getElementById('star-inset-popup')?.setAttribute('hidden', '');
    }

    private isDarkTheme(): boolean {
      const dataTheme = document.documentElement.getAttribute('data-theme');
      if (dataTheme === 'light') return false;
      if (dataTheme === 'dark') return true;

      const metaScheme = document.querySelector('meta[name="color-scheme"]')?.getAttribute('content');
      if (metaScheme === 'light') return false;
      if (metaScheme === 'dark') return true;

      try {
        const saved = localStorage.getItem('color-scheme');
        if (saved === 'light') return false;
        if (saved === 'dark') return true;
      } catch {}

      return window.matchMedia?.('(prefers-color-scheme: dark)').matches ?? true;
    }

    private updateCartouche(c: any) {
      const plateEl = document.getElementById('hud-plate-kicker');
      const iauEl = document.getElementById('hud-constellation-id');
      const nameEl = document.getElementById('hud-constellation-name');
      const meaningEl = document.getElementById('hud-constellation-meaning');
      const coordsEl = document.getElementById('hud-constellation-coords');
      const deepSkyEl = document.getElementById('hud-nebula-designation');
      const bulletEl = document.getElementById('hud-deepsky-bullet');
      const titleCluster = document.getElementById('sky-title-cluster');

      if (plateEl) plateEl.textContent = c.plate;
      if (iauEl) iauEl.textContent = `IAU · ${c.id.toUpperCase()}`;
      if (nameEl) nameEl.textContent = c.name;
      if (meaningEl) meaningEl.innerHTML = `<em>${c.genitive}</em> · ${c.english}`;
      if (coordsEl) coordsEl.textContent = `RA ${c.ra} · DEC ${c.dec}`;
      if (deepSkyEl && bulletEl) {
        if (c.deepSkySummary) {
          deepSkyEl.textContent = c.deepSkySummary;
          deepSkyEl.style.display = 'inline';
          bulletEl.style.display = 'inline';
        } else {
          deepSkyEl.style.display = 'none';
          bulletEl.style.display = 'none';
        }
      }

      if (titleCluster) {
        applyInkTransition(titleCluster);
      }
      const expandedInner = document.getElementById('hud-cartouche-expanded-inner');
      if (expandedInner) {
        applyInkTransition(expandedInner);
      }
    }

    private startRenderLoop() {
      if (this.rafId) return;
      this.lastTime = performance.now();

      const step = (time: number) => {
        const dt = Math.min(48, Math.max(8, time - (this.lastTime || time)));
        this.lastTime = time;

        // 1. Continuous Sidereal Diurnal Drift (gentle rotation of celestial sphere)
        this.siderealAngle = (this.siderealAngle + 0.000045 * dt) % 360;

        // 2. Smooth parallax damping with subtle inertia
        this.parallax.x += (this.parallax.targetX - this.parallax.x) * 0.08;
        this.parallax.y += (this.parallax.targetY - this.parallax.y) * 0.08;

        // 3. Smooth Astrometric Camera Slewing across RA / Dec
        if (this.camera.isSlewing) {
          const slewElapsed = time - this.camera.slewStartTime;
          const t = Math.min(1, slewElapsed / this.camera.slewDuration);
          // High-precision quintic ease-in-out
          const ease = t < 0.5 ? 16 * t * t * t * t * t : 1 - Math.pow(-2 * t + 2, 5) / 2;

          this.camera.ra = (this.camera.startRa + this.camera.dRa * ease + 360) % 360;
          this.camera.dec = this.camera.startDec + (this.camera.targetDec - this.camera.startDec) * ease;

          if (t >= 1) {
            this.camera.isSlewing = false;
            this.previousConstellation = null;
            this.camera.ra = this.camera.targetRa;
            this.camera.dec = this.camera.targetDec;
          }
        }

        this.renderSingleFrame(time);

        // Keep running continuously while visible (zero freezing, living celestial sphere)
        if (this.isVisible && !document.hidden) {
          this.rafId = requestAnimationFrame(step);
        } else {
          this.rafId = 0;
        }
      };

      this.rafId = requestAnimationFrame(step);
    }

    private renderSingleFrame(now: number) {
      if (!this.ctx || !this.currentConstellation) return;

      const w = window.innerWidth;
      const h = window.innerHeight;
      this.ctx.clearRect(0, 0, w, h);

      // Determine active theme colors via authoritative isDarkTheme()
      const isDark = this.isDarkTheme();

      // Theme-specific academic ink palette
      const inkPrimary = isDark ? 'rgba(232, 226, 214, 0.92)' : 'rgba(38, 34, 30, 0.92)';
      const inkSecondary = isDark ? 'rgba(210, 204, 192, 0.55)' : 'rgba(60, 54, 48, 0.65)';
      const inkSubtle = isDark ? 'rgba(180, 175, 165, 0.22)' : 'rgba(120, 114, 108, 0.28)';
      const inkLine = isDark ? 'rgba(235, 230, 220, 0.65)' : 'rgba(45, 40, 36, 0.72)';
      const inkLineShadow = isDark ? 'rgba(255, 255, 255, 0.12)' : 'rgba(0, 0, 0, 0.08)';

      const elapsed = Math.max(0, now - this.drawStartTime);
      const lineProgress = Math.min(1, elapsed / this.INK_DRAW_DURATION);

      // Spectral Tint Drying Calculation:
      // While lines ink in (0..1.8s): wetFactor = 1.0 (spectral colors vivid)
      // Between 1.8s..4.2s: wetFactor smoothly decays from 1.0 to 0.0 (monochrome ink)
      let wetFactor = 1.0;
      if (elapsed > this.INK_DRAW_DURATION) {
        const dryProgress = (elapsed - this.INK_DRAW_DURATION) / this.DRYING_DURATION;
        wetFactor = Math.max(0, 1.0 - Math.min(1.0, dryProgress));
      }

      // Slew crossfade transition weights
      let oldConstellationAlpha = 0;
      let newConstellationAlpha = 1;
      if (this.camera.isSlewing) {
        const slewT = (now - this.camera.slewStartTime) / this.camera.slewDuration;
        oldConstellationAlpha = Math.max(0, 1.0 - slewT * 3.2);
        newConstellationAlpha = Math.min(1, Math.max(0, (slewT - 0.22) * 1.35));
      }

      this.ctx.save();

      // Sky-wide atmospheric seeing for this frame (shared by every star layer)
      this.updateSeeing(now);

      // 1. Refractor Lens Dome Vignette on outer margin
      this.drawDomeVignette(w, h, isDark);

      // 2. Volumetric Floating Colors & Interstellar Dust Veils
      this.drawNebularVeils(w, h, isDark, now, newConstellationAlpha);

      // 3. Archival Graticule Frame & Vernier Ruler (z = 0, sits fixed on the paper aperture)
      this.drawGraticule(w, h, inkSubtle);

      // 4. Golden Ecliptic (Via Solis) & Galactic Equator (Via Lactea) Arcs
      this.drawCelestialArcs(w, h, isDark, now, newConstellationAlpha);

      // 5. Dense 3D Diamond Dust Background Starfield (1,600–2,400 additive PSF micro-stars, log-normal twinkle)
      this.drawDenseFieldStars(w, h, isDark, now);

      // 5b. Cosmological Background Deep Field Galaxies (20–45 distant micro-galaxies across wide celestial sphere)
      this.drawUniversalFieldGalaxies(w, h, isDark, newConstellationAlpha);

      // 6. Volumetric Deep-Sky Nebulae & Multi-Object Galaxies (M31, M42, M13, field galaxies)
      this.drawDeepSkyBlooms(w, h, isDark, now, newConstellationAlpha);

      // 7. 3D Background Starfield (Hipparcos catalog, Pogson-scaled PSF glow, log-normal + chromatic scintillation, true tangent projection)
      this.drawBackgroundStars(w, h, isDark, inkSecondary, now);

      // 8. Mythologized Geometry & "Distant Dreams" Figurative Echoes (2-5% opacity)
      this.drawMythicAura(w, h, isDark, now, newConstellationAlpha);

      // 9. Constellation Chords & Polylines (lines flex in true 3D perspective between star depths)
      if (this.previousConstellation && oldConstellationAlpha > 0.01) {
        this.drawConstellationEdges(w, h, 1.0, isDark, inkLine, inkLineShadow, this.previousConstellation, oldConstellationAlpha);
      }
      this.drawConstellationEdges(w, h, lineProgress, isDark, inkLine, inkLineShadow, this.currentConstellation, newConstellationAlpha);

      // 10. Constellation Stars, Overdriven Core Halos & Bayer Greek Glyphs
      if (this.previousConstellation && oldConstellationAlpha > 0.01) {
        this.drawConstellationStars(w, h, 0, isDark, inkPrimary, now, this.previousConstellation, oldConstellationAlpha);
      }
      this.drawConstellationStars(w, h, wetFactor, isDark, inkPrimary, now, this.currentConstellation, newConstellationAlpha);

      // 11. Cosmic Transients (Sporadic Meteor Bolides & Lingering Ionized Wake Trails)
      this.drawCosmicTransients(w, h, isDark, now);

      this.ctx.restore();
    }

    private drawDomeVignette(w: number, h: number, isDark: boolean) {
      const cx = w * 0.5;
      const cy = h * 0.5;
      const maxR = Math.hypot(w, h) * 0.52;
      const innerR = Math.min(w, h) * 0.42;

      const grad = this.ctx.createRadialGradient(cx, cy, innerR, cx, cy, maxR);
      if (isDark) {
        grad.addColorStop(0, 'rgba(8, 10, 16, 0)');
        grad.addColorStop(0.7, 'rgba(8, 10, 16, 0.22)');
        grad.addColorStop(1, 'rgba(6, 8, 14, 0.68)');
      } else {
        grad.addColorStop(0, 'rgba(245, 242, 234, 0)');
        grad.addColorStop(0.7, 'rgba(215, 206, 190, 0.18)');
        grad.addColorStop(1, 'rgba(195, 184, 166, 0.52)');
      }

      this.ctx.fillStyle = grad;
      this.ctx.fillRect(0, 0, w, h);
    }

    private drawNebularVeils(
      w: number,
      h: number,
      isDark: boolean,
      now: number,
      alphaMultiplier: number
    ) {
      if (alphaMultiplier <= 0.01) return;

      const cx = w * 0.5;
      const cy = h * 0.5;
      const minDim = Math.min(w, h);
      const isMilkyWay = this.currentConstellation?.inMilkyWay;
      const intensity = (isMilkyWay ? 1.35 : 1.0) * alphaMultiplier;

      // 6 Distinct volumetric nebular cloud centers with slow sidereal undulation
      const clouds = [
        // 1. Hydrogen-Alpha Wine/Rose cloud
        {
          relX: -0.22, relY: -0.15, rad: minDim * 0.65,
          freqX: 0.00005, freqY: 0.00007, phase: 1.2,
          darkRgb: [225, 90, 145], darkAlpha: 0.075 * intensity,
          lightRgb: [165, 50, 80], lightAlpha: 0.045 * intensity
        },
        // 2. Oxygen-III Celestial Cyan/Teal pocket
        {
          relX: 0.25, relY: 0.18, rad: minDim * 0.55,
          freqX: 0.00007, freqY: 0.00004, phase: 3.4,
          darkRgb: [60, 215, 205], darkAlpha: 0.065 * intensity,
          lightRgb: [35, 115, 120], lightAlpha: 0.040 * intensity
        },
        // 3. Stardust & Cosmic Dust Lane (Warm Amber/Ochre)
        {
          relX: 0.08, relY: -0.26, rad: minDim * 0.70,
          freqX: 0.00004, freqY: 0.00006, phase: 5.1,
          darkRgb: [235, 175, 95], darkAlpha: 0.055 * intensity,
          lightRgb: [175, 115, 30], lightAlpha: 0.050 * intensity
        },
        // 4. Lapis Lazuli Deep Sky Reflection Veil
        {
          relX: -0.18, relY: 0.24, rad: minDim * 0.60,
          freqX: 0.00006, freqY: 0.00005, phase: 2.8,
          darkRgb: [85, 135, 240], darkAlpha: 0.060 * intensity,
          lightRgb: [35, 75, 155], lightAlpha: 0.050 * intensity
        },
        // 5. Diffuse Ionized Outflow (Pale Rose)
        {
          relX: 0.32, relY: -0.12, rad: minDim * 0.48,
          freqX: 0.00005, freqY: 0.00008, phase: 0.9,
          darkRgb: [215, 80, 120], darkAlpha: 0.050 * intensity,
          lightRgb: [145, 45, 70], lightAlpha: 0.035 * intensity
        },
        // 6. Background Cosmic Veil (Pale Violet / Sepia)
        {
          relX: 0.0, relY: 0.05, rad: minDim * 0.85,
          freqX: 0.00003, freqY: 0.00003, phase: 4.2,
          darkRgb: [160, 120, 210], darkAlpha: 0.040 * intensity,
          lightRgb: [70, 85, 60], lightAlpha: 0.035 * intensity
        }
      ];

      for (const cl of clouds) {
        const driftX = Math.sin(now * cl.freqX + cl.phase) * (minDim * 0.06);
        const driftY = Math.cos(now * cl.freqY + cl.phase) * (minDim * 0.05);
        const px = cx + cl.relX * minDim + driftX + this.parallax.x * 0.10;
        const py = cy + cl.relY * minDim + driftY + this.parallax.y * 0.10;

        const [r, g, b] = isDark ? cl.darkRgb : cl.lightRgb;
        const a = isDark ? cl.darkAlpha : cl.lightAlpha;

        const grad = this.ctx.createRadialGradient(px, py, cl.rad * 0.08, px, py, cl.rad);
        grad.addColorStop(0, `rgba(${r}, ${g}, ${b}, ${a})`);
        grad.addColorStop(0.45, `rgba(${r}, ${g}, ${b}, ${a * 0.45})`);
        grad.addColorStop(1, `rgba(${r}, ${g}, ${b}, 0)`);

        this.ctx.fillStyle = grad;
        this.ctx.beginPath();
        this.ctx.arc(px, py, cl.rad, 0, Math.PI * 2);
        this.ctx.fill();
      }
    }

    private drawCelestialArcs(
      w: number,
      h: number,
      isDark: boolean,
      now: number,
      alphaMultiplier: number
    ) {
      if (!this.currentConstellation || alphaMultiplier <= 0.01) return;

      const cy = h * 0.5;
      const z = 0.25;

      // Golden Zodiacal Ecliptic Arc (Via Solis)
      if (this.currentConstellation.isZodiac) {
        this.ctx.save();
        this.ctx.strokeStyle = isDark
          ? `rgba(235, 195, 95, ${0.14 * alphaMultiplier})`
          : `rgba(165, 115, 30, ${0.16 * alphaMultiplier})`;
        this.ctx.lineWidth = 0.75;
        this.ctx.setLineDash([4, 6]);

        // Ecliptic chord across chart
        const yEcl = cy + this.parallax.y * z;
        this.ctx.beginPath();
        this.ctx.moveTo(30, yEcl - 40);
        this.ctx.bezierCurveTo(w * 0.33, yEcl - 10, w * 0.66, yEcl + 20, w - 30, yEcl + 50);
        this.ctx.stroke();

        this.ctx.fillStyle = isDark
          ? `rgba(235, 195, 95, ${0.28 * alphaMultiplier})`
          : `rgba(165, 115, 30, ${0.32 * alphaMultiplier})`;
        this.ctx.font = 'italic 10px Newsreader, serif';
        this.ctx.fillText('VIA SOLIS · ECLIPTICA', w - 165, yEcl + 42);
        this.ctx.setLineDash([]);
        this.ctx.restore();
      }

      // Galactic Equator Arc (Via Lactea)
      if (this.currentConstellation.inMilkyWay) {
        this.ctx.save();
        this.ctx.strokeStyle = isDark
          ? `rgba(190, 215, 255, ${0.12 * alphaMultiplier})`
          : `rgba(50, 75, 120, ${0.14 * alphaMultiplier})`;
        this.ctx.lineWidth = 0.75;
        this.ctx.setLineDash([2, 5]);

        const galY = cy + this.parallax.y * z;
        this.ctx.beginPath();
        this.ctx.moveTo(30, galY + 60);
        this.ctx.bezierCurveTo(w * 0.35, galY + 25, w * 0.65, galY - 25, w - 30, galY - 60);
        this.ctx.stroke();

        this.ctx.fillStyle = isDark
          ? `rgba(190, 215, 255, ${0.24 * alphaMultiplier})`
          : `rgba(50, 75, 120, ${0.28 * alphaMultiplier})`;
        this.ctx.font = 'italic 10px Newsreader, serif';
        this.ctx.fillText('VIA LACTEA · AEQUATOR GALACTICOS', 35, galY + 52);
        this.ctx.setLineDash([]);
        this.ctx.restore();
      }
    }

    private drawGraticule(w: number, h: number, tickColor: string) {
      const margin = clamp(24, w * 0.025, 48);
      this.ctx.strokeStyle = tickColor;
      this.ctx.lineWidth = 0.75;

      // Outer border frame (fixed aperture on the page, unshifted by parallax)
      this.ctx.strokeRect(margin, margin, w - margin * 2, h - margin * 2);

      // Vernier ticks along top and bottom edges
      const step = 40;
      this.ctx.beginPath();
      for (let x = margin + step; x < w - margin; x += step) {
        this.ctx.moveTo(x, margin);
        this.ctx.lineTo(x, margin + 4);
        this.ctx.moveTo(x, h - margin);
        this.ctx.lineTo(x, h - margin - 4);
      }
      for (let y = margin + step; y < h - margin; y += step) {
        this.ctx.moveTo(margin, y);
        this.ctx.lineTo(margin + 4, y);
        this.ctx.moveTo(w - margin, y);
        this.ctx.lineTo(w - margin - 4, y);
      }
      this.ctx.stroke();
    }

    private getGalaxyGenome(dIdx: number, d: any): GalaxyMorphology {
      const key = `${this.currentConstellation?.id || 'sky'}_${dIdx}_${d[6] || ''}`;
      let genome = this.galaxyGenomes.get(key);
      if (!genome) {
        const [rawX, rawY, , , , rawType, label] = d;
        const hash = Math.abs(Math.sin(rawX * 12.9898 + rawY * 78.233)) * 43758.5453;
        genome = deriveGalaxyGenome(hash, rawType, label);
        this.galaxyGenomes.set(key, genome);
      }
      return genome;
    }

    private drawDeepSkyBlooms(
      w: number,
      h: number,
      isDark: boolean,
      now: number,
      alphaMultiplier: number
    ) {
      if (!this.currentConstellation.deepFieldObjects || alphaMultiplier <= 0.01) return;

      const cx = w * 0.5;
      const cy = h * 0.5;
      const scale = Math.min(w, h) / 10000;
      let prevLabelPos: { x: number, y: number } | null = null;

      for (let dIdx = 0; dIdx < this.currentConstellation.deepFieldObjects.length; dIdx++) {
        const d = this.currentConstellation.deepFieldObjects[dIdx];
        const [rawX, rawY, rad, , , rawType, label] = d;
        const type = (rawType || '').toUpperCase();
        const baseX = cx + (rawX - 5000) * scale;
        const baseY = cy + (rawY - 5000) * scale;

        // Astrometric depth for deep-sky objects: anchored deep in celestial sphere
        const z = 0.22;
        const px = baseX + this.parallax.x * z;
        const py = baseY + this.parallax.y * z;

        // Bounded within view frame with margin
        if (px < 40 || px > w - 40 || py < 40 || py > h - 40) continue;

        // Derive deterministic orientation angle and aspect from label/coords hash
        const hash = Math.abs(Math.sin(rawX * 12.9898 + rawY * 78.233)) * 43758.5453;
        const baseAngle = ((hash % 180) * Math.PI) / 180;

        const isGalaxy = type === 'S' || type === 'I' || type === 'E';
        const genome = isGalaxy ? this.getGalaxyGenome(dIdx, d) : null;

        this.ctx.save();
        this.ctx.translate(px, py);

        // 1. SPIRAL & DIVERSE GALAXY MORPHOLOGIES (Grand Design, Barred, Edge-on, Flocculent, Irregular)
        if (genome && (type === 'S' || type === 'I' || genome.hubbleType !== 'elliptical')) {
          const pa = genome.pa;
          this.ctx.rotate(pa);

          const majR = Math.max(22, Math.min(48, rad * scale * 1.6));
          const cosI = genome.cosI;
          // Hubble (1926) oblate spheroid intrinsic thickness: prevents flat 2D wafer collapse
          const q0 = 0.15;
          const sinI = Math.sqrt(Math.max(0, 1 - cosI * cosI));
          const effectiveCosI = Math.sqrt(cosI * cosI + q0 * q0 * sinI * sinI);
          const minR = majR * effectiveCosI;
          const isEdgeOn = genome.hubbleType === 'edge_on' || cosI < 0.22;

          const discRgb = isDark ? genome.discRgbDark : genome.discRgbLight;
          const coreRgb = isDark ? genome.coreRgbDark : genome.coreRgbLight;

          // (a) Volumetric Multi-Layer Exponential Stellar Disc
          // Layer 1: Diffuse Outer Gaseous Corona / Stellar Halo (extends to 1.35x majR)
          const haloR = majR * 1.35;
          const haloGrad = this.ctx.createRadialGradient(0, 0, majR * 0.2, 0, 0, haloR);
          if (isDark) {
            haloGrad.addColorStop(0, `rgba(${discRgb[0]}, ${discRgb[1]}, ${discRgb[2]}, ${0.16 * alphaMultiplier})`);
            haloGrad.addColorStop(0.55, `rgba(${discRgb[0] * 0.85 | 0}, ${discRgb[1] * 0.9 | 0}, ${discRgb[2]}, ${0.05 * alphaMultiplier})`);
            haloGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
          } else {
            haloGrad.addColorStop(0, `rgba(${discRgb[0]}, ${discRgb[1]}, ${discRgb[2]}, ${0.09 * alphaMultiplier})`);
            haloGrad.addColorStop(0.60, `rgba(${discRgb[0]}, ${discRgb[1]}, ${discRgb[2]}, ${0.03 * alphaMultiplier})`);
            haloGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
          }
          this.ctx.save();
          this.ctx.scale(1.0, effectiveCosI);
          this.ctx.fillStyle = haloGrad;
          this.ctx.beginPath();
          this.ctx.arc(0, 0, haloR, 0, Math.PI * 2);
          this.ctx.fill();
          this.ctx.restore();

          // Layer 2: Main Exponential Stellar Disc (I(R) = I0 * exp(-R/Rd))
          const discGrad = this.ctx.createRadialGradient(0, 0, 1.5, 0, 0, majR);
          if (isDark) {
            discGrad.addColorStop(0, `rgba(${coreRgb[0]}, ${coreRgb[1]}, ${coreRgb[2]}, ${0.48 * alphaMultiplier})`);
            discGrad.addColorStop(0.32, `rgba(${discRgb[0]}, ${discRgb[1]}, ${discRgb[2]}, ${0.24 * alphaMultiplier})`);
            discGrad.addColorStop(0.70, `rgba(${discRgb[0] * 0.9 | 0}, ${discRgb[1] * 0.95 | 0}, ${discRgb[2]}, ${0.08 * alphaMultiplier})`);
            discGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
          } else {
            discGrad.addColorStop(0, `rgba(${coreRgb[0]}, ${coreRgb[1]}, ${coreRgb[2]}, ${0.35 * alphaMultiplier})`);
            discGrad.addColorStop(0.38, `rgba(${discRgb[0]}, ${discRgb[1]}, ${discRgb[2]}, ${0.16 * alphaMultiplier})`);
            discGrad.addColorStop(0.75, `rgba(${discRgb[0]}, ${discRgb[1]}, ${discRgb[2]}, ${0.04 * alphaMultiplier})`);
            discGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
          }
          this.ctx.save();
          this.ctx.scale(1.0, effectiveCosI);
          this.ctx.fillStyle = discGrad;
          this.ctx.beginPath();
          this.ctx.arc(0, 0, majR, 0, Math.PI * 2);
          this.ctx.fill();
          this.ctx.restore();

          // (b) Central Stellar Bar (for Barred Spirals e.g. SBb, SBc)
          if (genome.hubbleType === 'barred_spiral' && !isEdgeOn) {
            const barHalf = majR * genome.barLength;
            const barW = barHalf * 0.36;
            this.ctx.save();
            this.ctx.rotate(genome.barAngle);
            this.ctx.scale(1.0, effectiveCosI);
            const barGrad = this.ctx.createRadialGradient(0, 0, 0, 0, 0, barHalf);
            if (isDark) {
              barGrad.addColorStop(0, `rgba(255, 248, 230, ${0.60 * alphaMultiplier})`);
              barGrad.addColorStop(0.55, `rgba(${coreRgb[0]}, ${coreRgb[1]}, ${coreRgb[2]}, ${0.28 * alphaMultiplier})`);
              barGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
            } else {
              barGrad.addColorStop(0, `rgba(45, 36, 30, ${0.48 * alphaMultiplier})`);
              barGrad.addColorStop(0.55, `rgba(95, 75, 55, ${0.20 * alphaMultiplier})`);
              barGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
            }
            this.ctx.fillStyle = barGrad;
            this.ctx.beginPath();
            this.ctx.ellipse(0, 0, barHalf, barW, 0, 0, Math.PI * 2);
            this.ctx.fill();
            this.ctx.restore();
          }

          // (c) Spiral Density Wave Ribbons (Flaring volumetric polygons replacing line strokes)
          if (!isEdgeOn && genome.hubbleType !== 'lenticular') {
            const armSteps = 24;
            const armCount = genome.armCount;
            const winding = genome.winding;
            const pitch = genome.pitch;
            const startR = genome.hubbleType === 'barred_spiral' ? (majR * genome.barLength * 0.88) : 4.5;
            const nearSide = genome.dustAsymmetry; // +1 or -1 near-side orientation

            for (let arm = 0; arm < armCount; arm++) {
              const armBasePhase = (arm * 2 * Math.PI) / armCount;
              const outerPts: Array<{ x: number, y: number }> = [];
              const innerPts: Array<{ x: number, y: number }> = [];
              const spinePts: Array<{ x: number, y: number, r: number, yc: number }> = [];

              for (let i = 0; i <= armSteps; i++) {
                const t = i / armSteps;
                const r = startR + t * (majR - startR - 3.0);
                const theta = armBasePhase + winding * Math.log(Math.max(0.01, r / startR)) / Math.tan(pitch);
                const xc = r * Math.cos(theta);
                const yc = r * Math.sin(theta);

                // Flaring ribbon normal vector: expands from 1.2px at root to 5.2px at outer rim
                const normAngle = theta + winding * (Math.PI * 0.5 - pitch * 0.5);
                const halfW = 1.1 + 3.8 * Math.pow(t, 1.2);
                const nx = Math.cos(normAngle) * halfW;
                const ny = Math.sin(normAngle) * halfW;

                outerPts.push({ x: xc + nx, y: (yc + ny) * effectiveCosI });
                innerPts.push({ x: xc - nx, y: (yc - ny) * effectiveCosI });
                spinePts.push({ x: xc, y: yc * effectiveCosI, r, yc });
              }

              // 1. Broad Volumetric Density Ribbon Fill (smooth stellar density compression)
              this.ctx.beginPath();
              for (let i = 0; i < outerPts.length; i++) {
                if (i === 0) this.ctx.moveTo(outerPts[i].x, outerPts[i].y);
                else this.ctx.lineTo(outerPts[i].x, outerPts[i].y);
              }
              for (let i = innerPts.length - 1; i >= 0; i--) {
                this.ctx.lineTo(innerPts[i].x, innerPts[i].y);
              }
              this.ctx.closePath();
              this.ctx.fillStyle = isDark
                ? `rgba(${discRgb[0]}, ${discRgb[1]}, ${discRgb[2]}, ${0.18 * alphaMultiplier})`
                : `rgba(${discRgb[0]}, ${discRgb[1]}, ${discRgb[2]}, ${0.12 * alphaMultiplier})`;
              this.ctx.fill();

              // 2. Luminous Spine (crest of the density wave)
              this.ctx.beginPath();
              for (let i = 0; i < spinePts.length; i++) {
                if (i === 0) this.ctx.moveTo(spinePts[i].x, spinePts[i].y);
                else this.ctx.lineTo(spinePts[i].x, spinePts[i].y);
              }
              this.ctx.strokeStyle = isDark
                ? `rgba(${discRgb[0]}, ${discRgb[1]}, ${discRgb[2]}, ${0.35 * alphaMultiplier})`
                : `rgba(${discRgb[0]}, ${discRgb[1]}, ${discRgb[2]}, ${0.28 * alphaMultiplier})`;
              this.ctx.lineWidth = 1.35;
              this.ctx.stroke();

              // 3. Tilted Near-Side Dust Silhouette Ribbon (asymmetric absorption)
              // Only renders along the inner concave edge on the near-side hemisphere
              this.ctx.beginPath();
              let dustStarted = false;
              for (let i = 1; i < innerPts.length - 2; i++) {
                const sp = spinePts[i];
                // Check if this segment lies on the near-side tilted hemisphere
                const isNearSide = (sp.yc * nearSide) > -majR * 0.15;
                if (isNearSide) {
                  if (!dustStarted) {
                    this.ctx.moveTo(innerPts[i].x, innerPts[i].y);
                    dustStarted = true;
                  } else {
                    this.ctx.lineTo(innerPts[i].x, innerPts[i].y);
                  }
                }
              }
              if (dustStarted) {
                this.ctx.strokeStyle = isDark
                  ? `rgba(7, 9, 14, ${genome.dustOpacity * 0.95 * alphaMultiplier})`
                  : `rgba(248, 245, 238, ${genome.dustOpacity * 1.15 * alphaMultiplier})`;
                this.ctx.lineWidth = 1.6;
                this.ctx.stroke();
              }
            }

            // Starburst Knots: Volumetric H II Ionized Pink Nodules & Azure OB Stellar Clusters
            if (isDark && genome.knots && genome.knots.length > 0) {
              for (let kIdx = 0; kIdx < genome.knots.length; kIdx++) {
                const knot = genome.knots[kIdx];
                const kR = (startR + knot.rNorm * (majR - startR));
                const kX = kR * Math.cos(knot.theta);
                const kY = kR * Math.sin(knot.theta) * effectiveCosI;
                const kAlpha = (0.42 + knot.size * 0.18) * alphaMultiplier;
                const kRadius = Math.max(1.0, knot.size * 0.95);

                const knotGrad = this.ctx.createRadialGradient(kX, kY, 0, kX, kY, kRadius * 1.8);
                if (knot.isH2) {
                  // H-alpha ruby/magenta emission
                  knotGrad.addColorStop(0, `rgba(255, 185, 215, ${kAlpha})`);
                  knotGrad.addColorStop(0.45, `rgba(240, 95, 150, ${kAlpha * 0.75})`);
                  knotGrad.addColorStop(1, 'rgba(240, 95, 150, 0)');
                } else {
                  // Young OB stellar cluster azure/cyan
                  knotGrad.addColorStop(0, `rgba(225, 245, 255, ${kAlpha})`);
                  knotGrad.addColorStop(0.45, `rgba(125, 205, 255, ${kAlpha * 0.75})`);
                  knotGrad.addColorStop(1, 'rgba(125, 205, 255, 0)');
                }
                this.ctx.fillStyle = knotGrad;
                this.ctx.beginPath();
                this.ctx.arc(kX, kY, kRadius * 1.8, 0, Math.PI * 2);
                this.ctx.fill();
              }
            }
          }

          // (d) Edge-on Galaxies (Volumetric spindle discs & tilted near-side dust silhouettes)
          if (isEdgeOn) {
            // Spheroidal Bulge (Sombrero profile) popping out above and below the thin equatorial plane
            const bulgeR = majR * genome.bulgeRatio;
            const bGrad = this.ctx.createRadialGradient(0, 0, 0, 0, 0, bulgeR);
            if (isDark) {
              bGrad.addColorStop(0, `rgba(255, 255, 255, ${0.92 * alphaMultiplier})`);
              bGrad.addColorStop(0.35, `rgba(255, 235, 198, ${0.60 * alphaMultiplier})`);
              bGrad.addColorStop(0.75, `rgba(${coreRgb[0]}, ${coreRgb[1]}, ${coreRgb[2]}, ${0.25 * alphaMultiplier})`);
              bGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
            } else {
              bGrad.addColorStop(0, `rgba(25, 20, 16, ${0.88 * alphaMultiplier})`);
              bGrad.addColorStop(0.40, `rgba(90, 65, 45, ${0.45 * alphaMultiplier})`);
              bGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
            }
            this.ctx.save();
            this.ctx.scale(0.85, 1.45); // Vertically pronounced spheroidal bulge
            this.ctx.fillStyle = bGrad;
            this.ctx.beginPath();
            this.ctx.arc(0, 0, bulgeR, 0, Math.PI * 2);
            this.ctx.fill();
            this.ctx.restore();

            // Tilted Near-Side Equatorial Dust Silhouette (Volumetric absorbing belt)
            const dustLen = majR * 0.96;
            const nearOffset = 0.85 * genome.dustAsymmetry; // Asymmetric near-side offset

            // Pass 1: Broad semi-opaque absorption veil
            this.ctx.strokeStyle = isDark
              ? `rgba(8, 10, 14, ${0.65 * alphaMultiplier})`
              : `rgba(248, 245, 238, ${0.75 * alphaMultiplier})`;
            this.ctx.lineWidth = 3.2;
            this.ctx.beginPath();
            this.ctx.moveTo(-dustLen * 0.85, nearOffset);
            this.ctx.lineTo(dustLen * 0.85, nearOffset);
            this.ctx.stroke();

            // Pass 2: Dense central opaque absorption rift cutting across the bulge
            this.ctx.strokeStyle = isDark
              ? `rgba(5, 7, 10, ${0.92 * alphaMultiplier})`
              : `rgba(252, 250, 244, ${0.95 * alphaMultiplier})`;
            this.ctx.lineWidth = 1.45;
            this.ctx.beginPath();
            this.ctx.moveTo(-dustLen, nearOffset);
            this.ctx.lineTo(dustLen, nearOffset);
            this.ctx.stroke();
          } else {
            // (e) Standard Galactic Spheroidal Bulge & Nucleus
            const coreRadius = Math.max(3.5, minR * genome.bulgeRatio);
            const coreGrad = this.ctx.createRadialGradient(0, 0, 0, 0, 0, coreRadius);
            if (isDark) {
              coreGrad.addColorStop(0, `rgba(255, 255, 255, ${0.90 * alphaMultiplier})`);
              coreGrad.addColorStop(0.35, `rgba(${coreRgb[0]}, ${coreRgb[1]}, ${coreRgb[2]}, ${0.52 * alphaMultiplier})`);
              coreGrad.addColorStop(1, `rgba(${coreRgb[0]}, ${coreRgb[1]}, ${coreRgb[2]}, 0)`);
            } else {
              coreGrad.addColorStop(0, `rgba(28, 22, 18, ${0.88 * alphaMultiplier})`);
              coreGrad.addColorStop(0.40, `rgba(${coreRgb[0]}, ${coreRgb[1]}, ${coreRgb[2]}, ${0.42 * alphaMultiplier})`);
              coreGrad.addColorStop(1, `rgba(${coreRgb[0]}, ${coreRgb[1]}, ${coreRgb[2]}, 0)`);
            }
            this.ctx.fillStyle = coreGrad;
            this.ctx.beginPath();
            this.ctx.arc(0, 0, coreRadius, 0, Math.PI * 2);
            this.ctx.fill();

            // Starlike central supermassive black hole stellar cusp
            this.ctx.fillStyle = isDark ? '#ffffff' : '#221d19';
            this.ctx.beginPath();
            this.ctx.arc(0, 0, 1.25, 0, Math.PI * 2);
            this.ctx.fill();
          }
        }

        // 2. ELLIPTICAL GALAXIES ('E', 'L') - e.g. M32, M87, M110, DFG spheroids
        else if (type === 'E' || (genome && genome.hubbleType === 'elliptical')) {
          const pa = genome ? genome.pa : baseAngle;
          this.ctx.rotate(pa);
          const rEll = Math.max(14, Math.min(32, rad * scale * 1.1));
          const cosI = genome ? genome.cosI : 0.72;

          const ellGrad = this.ctx.createRadialGradient(0, 0, 0, 0, 0, rEll);
          if (isDark) {
            ellGrad.addColorStop(0, `rgba(255, 255, 255, ${0.82 * alphaMultiplier})`);
            ellGrad.addColorStop(0.25, `rgba(255, 238, 205, ${0.45 * alphaMultiplier})`);
            ellGrad.addColorStop(0.65, `rgba(215, 225, 245, ${0.12 * alphaMultiplier})`);
            ellGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
          } else {
            ellGrad.addColorStop(0, `rgba(28, 24, 20, ${0.80 * alphaMultiplier})`);
            ellGrad.addColorStop(0.30, `rgba(115, 80, 50, ${0.35 * alphaMultiplier})`);
            ellGrad.addColorStop(0.70, `rgba(150, 120, 90, ${0.08 * alphaMultiplier})`);
            ellGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
          }
          this.ctx.save();
          this.ctx.scale(1.0, cosI);
          this.ctx.fillStyle = ellGrad;
          this.ctx.beginPath();
          this.ctx.arc(0, 0, rEll, 0, Math.PI * 2);
          this.ctx.fill();

          // Classical concentric astrometric contour ring in light mode
          if (!isDark) {
            this.ctx.strokeStyle = `rgba(60, 50, 42, ${0.30 * alphaMultiplier})`;
            this.ctx.lineWidth = 0.65;
            this.ctx.setLineDash([2, 3]);
            this.ctx.beginPath();
            this.ctx.arc(0, 0, rEll * 0.75, 0, Math.PI * 2);
            this.ctx.stroke();
            this.ctx.setLineDash([]);
          }
          this.ctx.restore();
        }

        // 3. GLOBULAR CLUSTERS ('GC') - e.g. M13 Hercules, M22, Omega Centauri
        else if (type === 'GC') {
          const rCluster = Math.max(14, Math.min(30, rad * scale * 1.0));

          // Soft central unresolved star core
          const coreGrad = this.ctx.createRadialGradient(0, 0, 0, 0, 0, rCluster * 0.65);
          if (isDark) {
            coreGrad.addColorStop(0, `rgba(255, 250, 240, ${0.65 * alphaMultiplier})`);
            coreGrad.addColorStop(0.4, `rgba(220, 235, 255, ${0.25 * alphaMultiplier})`);
            coreGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
          } else {
            coreGrad.addColorStop(0, `rgba(40, 34, 30, ${0.55 * alphaMultiplier})`);
            coreGrad.addColorStop(0.4, `rgba(100, 85, 75, ${0.18 * alphaMultiplier})`);
            coreGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
          }
          this.ctx.fillStyle = coreGrad;
          this.ctx.beginPath();
          this.ctx.arc(0, 0, rCluster * 0.65, 0, Math.PI * 2);
          this.ctx.fill();

          // Swarm of resolved micro-stars with isotropic King profile radial distribution
          const starCount = 45;
          for (let sIdx = 0; sIdx < starCount; sIdx++) {
            let sH = ((sIdx + 1) ^ (hash * 1000 | 0)) * 0x45d9f3b;
            sH = ((sH >>> 16) ^ sH) * 0x45d9f3b;
            sH = (sH >>> 16) ^ sH;
            const u1 = (sH & 0xffff) / 65535.0;
            const u2 = ((sH >>> 16) & 0xffff) / 65535.0;

            const theta = u1 * Math.PI * 2;
            const distNorm = Math.pow(u2, 2.2);
            const dist = distNorm * rCluster;
            const starX = Math.cos(theta) * dist;
            const starY = Math.sin(theta) * dist;
            const starR = Math.max(0.65, (1.0 - distNorm * 0.45) * 1.15);
            const starAlpha = (0.35 + (1.0 - distNorm) * 0.60) * alphaMultiplier;

            this.ctx.fillStyle = isDark
              ? `rgba(240, 245, 255, ${starAlpha})`
              : `rgba(45, 40, 35, ${starAlpha * 0.9})`;
            this.ctx.beginPath();
            this.ctx.arc(starX, starY, starR, 0, Math.PI * 2);
            this.ctx.fill();
          }

          // Cartographic cluster circle mark in light mode
          if (!isDark) {
            this.ctx.strokeStyle = `rgba(50, 44, 38, ${0.35 * alphaMultiplier})`;
            this.ctx.lineWidth = 0.65;
            this.ctx.setLineDash([1, 2]);
            this.ctx.beginPath();
            this.ctx.arc(0, 0, rCluster, 0, Math.PI * 2);
            this.ctx.stroke();
            this.ctx.setLineDash([]);
          }
        }

        // 4. PLANETARY NEBULAE ('PN') - e.g. M57 Ring Nebula, M27 Dumbbell
        else if (type === 'PN') {
          const rPn = Math.max(12, Math.min(24, rad * scale * 0.95));
          this.ctx.rotate(baseAngle);

          // Outer H-alpha / [N II] ruby shell
          this.ctx.strokeStyle = isDark
            ? `rgba(225, 90, 160, ${0.45 * alphaMultiplier})`
            : `rgba(165, 50, 95, ${0.38 * alphaMultiplier})`;
          this.ctx.lineWidth = 2.0;
          this.ctx.beginPath();
          this.ctx.ellipse(0, 0, rPn, rPn * 0.72, 0, 0, Math.PI * 2);
          this.ctx.stroke();

          // Inner [O III] cyan/teal torus
          this.ctx.strokeStyle = isDark
            ? `rgba(60, 240, 215, ${0.60 * alphaMultiplier})`
            : `rgba(30, 115, 120, ${0.50 * alphaMultiplier})`;
          this.ctx.lineWidth = 1.3;
          this.ctx.beginPath();
          this.ctx.ellipse(0, 0, rPn * 0.75, rPn * 0.54, 0, 0, Math.PI * 2);
          this.ctx.stroke();

          // Faint interior hollow
          const innerGrad = this.ctx.createRadialGradient(0, 0, 0, 0, 0, rPn * 0.5);
          if (isDark) {
            innerGrad.addColorStop(0, `rgba(40, 180, 170, ${0.18 * alphaMultiplier})`);
            innerGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
          } else {
            innerGrad.addColorStop(0, `rgba(40, 100, 100, ${0.12 * alphaMultiplier})`);
            innerGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
          }
          this.ctx.fillStyle = innerGrad;
          this.ctx.beginPath();
          this.ctx.ellipse(0, 0, rPn * 0.5, rPn * 0.36, 0, 0, Math.PI * 2);
          this.ctx.fill();

          // Central 15th-mag white dwarf star
          this.ctx.fillStyle = isDark ? '#ffffff' : '#1a1614';
          this.ctx.beginPath();
          this.ctx.arc(0, 0, 0.9, 0, Math.PI * 2);
          this.ctx.fill();
        }

        // 5. EMISSION NEBULAE / STAR FORMING REGIONS / SUPERNOVA REMNANTS ('SFR', 'RN', 'SNR')
        // e.g. M42 Great Orion Nebula, Carina, Crab M1
        else if (type === 'SFR' || type === 'RN' || type === 'SNR') {
          const rNeb = Math.max(20, Math.min(45, rad * scale * 1.35));
          this.ctx.rotate(baseAngle);

          // Asymmetric multi-lobed ionized cloud
          // Lobe A: Hydrogen-Alpha Ruby/Rose wing
          const lobeAGrad = this.ctx.createRadialGradient(-rNeb * 0.25, -rNeb * 0.15, 2, -rNeb * 0.25, -rNeb * 0.15, rNeb * 0.85);
          if (isDark) {
            lobeAGrad.addColorStop(0, `rgba(235, 105, 155, ${0.28 * alphaMultiplier})`);
            lobeAGrad.addColorStop(0.55, `rgba(200, 80, 130, ${0.10 * alphaMultiplier})`);
            lobeAGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
          } else {
            lobeAGrad.addColorStop(0, `rgba(165, 55, 85, ${0.18 * alphaMultiplier})`);
            lobeAGrad.addColorStop(0.55, `rgba(140, 45, 70, ${0.06 * alphaMultiplier})`);
            lobeAGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
          }
          this.ctx.fillStyle = lobeAGrad;
          this.ctx.beginPath();
          this.ctx.ellipse(-rNeb * 0.25, -rNeb * 0.15, rNeb * 0.85, rNeb * 0.55, 0.4, 0, Math.PI * 2);
          this.ctx.fill();

          // Lobe B: Oxygen-III Teal/Cyan pocket
          const lobeBGrad = this.ctx.createRadialGradient(rNeb * 0.2, rNeb * 0.25, 1, rNeb * 0.2, rNeb * 0.25, rNeb * 0.70);
          if (isDark) {
            lobeBGrad.addColorStop(0, `rgba(80, 220, 215, ${0.24 * alphaMultiplier})`);
            lobeBGrad.addColorStop(0.55, `rgba(60, 175, 180, ${0.08 * alphaMultiplier})`);
            lobeBGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
          } else {
            lobeBGrad.addColorStop(0, `rgba(45, 120, 115, ${0.14 * alphaMultiplier})`);
            lobeBGrad.addColorStop(0.55, `rgba(35, 95, 95, ${0.05 * alphaMultiplier})`);
            lobeBGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
          }
          this.ctx.fillStyle = lobeBGrad;
          this.ctx.beginPath();
          this.ctx.ellipse(rNeb * 0.2, rNeb * 0.25, rNeb * 0.70, rNeb * 0.45, -0.35, 0, Math.PI * 2);
          this.ctx.fill();

          // Embedded ionization cluster (e.g. Trapezium cluster)
          const trapCoords = [
            [-2.5, -1.5],
            [2.0, -2.0],
            [-1.0, 2.5],
            [2.5, 1.8]
          ];
          for (const [tx, ty] of trapCoords) {
            this.ctx.fillStyle = isDark ? '#ffffff' : '#1a1614';
            this.ctx.beginPath();
            this.ctx.arc(tx, ty, 0.95, 0, Math.PI * 2);
            this.ctx.fill();
          }
        }

        // 6. ELLIPTICAL & LENTICULAR GALAXIES ('E', 'L') - e.g. M87, M49, M105, DFG field galaxies
        else if (type === 'E') {
          const rE = Math.max(12, Math.min(28, rad * scale * 1.0));
          this.ctx.rotate(baseAngle);

          const eGrad = this.ctx.createRadialGradient(0, 0, 0, 0, 0, rE);
          if (isDark) {
            eGrad.addColorStop(0, `rgba(255, 245, 225, ${0.72 * alphaMultiplier})`);
            eGrad.addColorStop(0.35, `rgba(225, 215, 195, ${0.28 * alphaMultiplier})`);
            eGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
          } else {
            eGrad.addColorStop(0, `rgba(45, 38, 32, ${0.60 * alphaMultiplier})`);
            eGrad.addColorStop(0.35, `rgba(95, 82, 70, ${0.20 * alphaMultiplier})`);
            eGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
          }
          this.ctx.fillStyle = eGrad;
          this.ctx.beginPath();
          this.ctx.ellipse(0, 0, rE, rE * 0.72, 0, 0, Math.PI * 2);
          this.ctx.fill();

          // Central stellar core
          this.ctx.fillStyle = isDark ? '#ffffff' : '#1a1614';
          this.ctx.beginPath();
          this.ctx.arc(0, 0, 1.1, 0, Math.PI * 2);
          this.ctx.fill();
        }

        // 7. OPEN CLUSTERS & ASTERISMS ('OC', 'POS') - e.g. Pleiades M45, Praesepe M44
        else {
          const rOc = Math.max(14, Math.min(28, rad * scale * 1.0));
          const starCount = 16;
          for (let sIdx = 0; sIdx < starCount; sIdx++) {
            const seed = ((sIdx * 197.3 + hash) % 1000) / 1000;
            const theta = seed * Math.PI * 2;
            const dist = (0.2 + 0.8 * Math.sqrt(seed)) * rOc;
            const starX = Math.cos(theta) * dist;
            const starY = Math.sin(theta) * dist;
            const starR = Math.max(0.75, 1.25 - (dist / rOc) * 0.5);

            this.ctx.fillStyle = isDark ? 'rgba(235, 245, 255, 0.90)' : 'rgba(38, 34, 30, 0.88)';
            this.ctx.beginPath();
            this.ctx.arc(starX, starY, starR, 0, Math.PI * 2);
            this.ctx.fill();
          }

          // In Light mode, dashed cartographic bounding circle
          if (!isDark) {
            this.ctx.strokeStyle = `rgba(55, 48, 42, ${0.30 * alphaMultiplier})`;
            this.ctx.lineWidth = 0.65;
            this.ctx.setLineDash([2, 3]);
            this.ctx.beginPath();
            this.ctx.arc(0, 0, rOc, 0, Math.PI * 2);
            this.ctx.stroke();
            this.ctx.setLineDash([]);
          }
        }

        this.ctx.restore();

        // Delicate italic cartographic label for showpieces (top 2 features)
        if (dIdx < 2) {
          this.ctx.fillStyle = isDark
            ? `rgba(225, 218, 205, ${0.72 * alphaMultiplier})`
            : `rgba(65, 56, 48, ${0.75 * alphaMultiplier})`;
          this.ctx.font = 'italic 11px Newsreader, serif';
          let displayLabel = label.split('·')[0].trim();
          const parenMatch = label.match(/\((M\d+)\)/);
          if (parenMatch) {
            displayLabel = parenMatch[1];
          }
          if (genome) {
            displayLabel = `${displayLabel} · ${genome.hubbleNotation}`;
          }

          let labelX = px + 22;
          let labelY = py + 4;
          if (prevLabelPos && Math.hypot(labelX - prevLabelPos.x, labelY - prevLabelPos.y) < 65) {
            labelY = py - 14;
          }
          prevLabelPos = { x: labelX, y: labelY };

          this.ctx.fillText(displayLabel, labelX, labelY);
        }
      }
    }

    private drawBackgroundStars(
      w: number,
      h: number,
      isDark: boolean,
      inkColor: string,
      now: number
    ) {
      if (!this.stars || this.stars.length === 0) return;

      const cx = w * 0.5;
      const cy = h * 0.5;
      const deg2rad = Math.PI / 180;

      // Angular scale matching the active constellation tangent chart
      const chartScale = this.currentConstellation.chartScale || 7500;
      // On desktop, widen FOV to cover wider aspect ratios (16:9, 21:9) and show dense sky
      const isDesktop = w >= 1024;
      const fovMultiplier = isDesktop ? 1.45 : 1.05;
      const fovScale = (chartScale / 5000) * (Math.min(w, h) * 0.5) * fovMultiplier;

      // Celestial camera position with continuous sidereal diurnal drift
      const camRaDeg = (this.camera.ra - this.siderealAngle + 360) % 360;
      const camDecDeg = this.camera.dec;

      const camRaRad = camRaDeg * deg2rad;
      const camDecRad = camDecDeg * deg2rad;
      const sinCamDec = Math.sin(camDecRad);
      const cosCamDec = Math.cos(camDecRad);

      const margin = 16;

      this.ctx.save();
      // Additive light accumulation on the night sky
      if (isDark) this.ctx.globalCompositeOperation = 'lighter';

      for (let i = 0; i < this.stars.length; i++) {
        const s = this.stars[i];
        const [hip, ra, dec, mag, bv] = s;

        // Skip constellation stars to avoid redundant double rendering
        if (this.isConstellationStar(hip)) continue;

        // True Tangent Gnomonic Projection
        const dra = (ra * deg2rad) - camRaRad;
        const dRad = dec * deg2rad;
        const sinDec = Math.sin(dRad);
        const cosDec = Math.cos(dRad);

        const cosC = sinCamDec * sinDec + cosCamDec * cosDec * Math.cos(dra);
        if (cosC <= 0.04) continue; // Show wide celestial hemisphere

        const xi = -(cosDec * Math.sin(dra)) / cosC;
        const eta = (cosCamDec * sinDec - sinCamDec * cosDec * Math.cos(dra)) / cosC;

        // 3D Astrometric Parallax: distant stars have minimal parallax shift
        const z = Math.max(0.24, 0.72 - mag * 0.07);
        const x = cx + xi * fovScale + this.parallax.x * z;
        const y = cy - eta * fovScale + this.parallax.y * z;

        if (x < margin || x > w - margin || y < margin || y > h - margin) continue;

        // Precomputed per-star seed + Pogson-scaled radius / opacity (see loadCatalogs)
        const seed = this.starDerived[i * 3];
        const rBase = this.starDerived[i * 3 + 1];
        const alphaBase = this.starDerived[i * 3 + 2];

        // Log-normal scintillation: mostly steady, with brief sharp flares and dips
        const airmass = this.airmassAt(y, h);
        const twinkle = this.scintillation(seed, now, mag, airmass, isDark);

        let alpha = alphaBase * twinkle;
        let r = rBase * (0.9 + 0.1 * Math.min(twinkle, 2));
        // Flux beyond full opacity spills into a wider bloom (eye reads brightness as size)
        if (alpha > 1) {
          r *= Math.pow(alpha, 0.35);
          alpha = 1;
        }

        if (isDark) {
          const starBv = bv ?? 0.6;
          this.drawStarSprite(x, y, r, starBv, perceivedSaturation(mag), alpha);
          this.ctx.globalAlpha = 1;
          this.drawChromaticScintillation(x, y, r, seed, now, mag, airmass);
        } else {
          // In Light mode: crisp archival pigments on cream rag paper
          const a = Math.min(1, alpha) * 0.88;
          if (bv !== undefined && bv < 0.2) {
            this.ctx.fillStyle = `rgba(35, 75, 145, ${a})`;
          } else if (bv !== undefined && bv > 1.0) {
            this.ctx.fillStyle = `rgba(160, 85, 30, ${a})`;
          } else {
            this.ctx.fillStyle = `rgba(45, 40, 36, ${a})`;
          }
          this.ctx.beginPath();
          this.ctx.arc(x, y, Math.min(r, 3.4), 0, Math.PI * 2);
          this.ctx.fill();
        }
      }

      this.ctx.restore();
    }

    private isConstellationStar(hip: number): boolean {
      if (!this.currentConstellation || !this.currentConstellation.stars) return false;
      return this.currentConstellation.stars.some((s: any) => s[4] === hip);
    }

    private generateDenseFieldStars(con: any) {
      if (!con) return;
      const count = con.inMilkyWay ? 2400 : 1600;
      this.denseFieldStars = [];

      // Deterministic PRNG seeded by constellation celestial barycenter
      let seed = Math.abs(Math.sin(con.barycenterRaDeg * 19.3 + con.barycenterDecDeg * 41.7)) * 100000;
      const nextRnd = () => {
        seed = (seed * 9301 + 49297) % 233280;
        return seed / 233280;
      };

      for (let i = 0; i < count; i++) {
        const u1 = nextRnd();
        const u2 = nextRnd();
        // Radial distribution across wide hemisphere
        const rRad = Math.sqrt(-2.0 * Math.log(Math.max(0.0001, u1))) * 0.45;
        const theta = u2 * Math.PI * 2;
        const xi = Math.cos(theta) * rRad;
        const eta = Math.sin(theta) * rRad;

        // Magnitude distribution: exponential faint star scaling (6.5 to 11.2)
        const magRand = nextRnd();
        const mag = 6.5 + Math.pow(magRand, 0.75) * 4.7;

        // Spectral class slot (1=O/B, 2=A, 3=F, 4=G, 5=K, 6=M)
        const specRand = nextRnd();
        const specSlot = specRand < 0.25 ? 1 : specRand < 0.45 ? 2 : specRand < 0.65 ? 3 : specRand < 0.82 ? 4 : specRand < 0.94 ? 5 : 6;

        // Deep 3D parallax depth factor (distant background: z in [0.12, 0.42])
        const z = 0.12 + nextRnd() * 0.30;
        const phaseSeed = nextRnd() * 1000;

        // Continuous colour index (slot centre ± small jitter derived from phaseSeed so the
        // PRNG sequence – and therefore star placement – is unchanged).
        const bv = specSlotToBv(specSlot) + (((phaseSeed * 7.31) % 1) - 0.5) * 0.2;

        // Pogson flux relative to the mag 6.5 naked-eye limit → perceptual radius & opacity
        const relFlux = Math.pow(10, -0.4 * (mag - 6.5));
        const alphaBase = 0.8 * Math.pow(relFlux, 0.4);
        const rBase = 0.5 + 0.55 * Math.pow(relFlux, 0.25);
        const noiseSeed = phaseSeed / 1000;

        this.denseFieldStars.push([xi, eta, mag, specSlot, z, phaseSeed, bv, alphaBase, rBase, noiseSeed]);
      }
    }

    private drawDenseFieldStars(
      w: number,
      h: number,
      isDark: boolean,
      now: number
    ) {
      if (!this.denseFieldStars || this.denseFieldStars.length === 0) return;

      const cx = w * 0.5;
      const cy = h * 0.5;
      const chartScale = this.currentConstellation?.chartScale || 7500;
      const isDesktop = w >= 1024;
      const fovMultiplier = isDesktop ? 1.45 : 1.05;
      const fovScale = (chartScale / 5000) * (Math.min(w, h) * 0.5) * fovMultiplier;
      const margin = 12;

      this.ctx.save();
      // Additive light accumulation on the night sky; overlapping halos brighten naturally
      if (isDark) this.ctx.globalCompositeOperation = 'lighter';

      for (let i = 0; i < this.denseFieldStars.length; i++) {
        const [xi, eta, mag, specSlot, z, , bv, alphaBase, rBase, noiseSeed] = this.denseFieldStars[i];

        const px = cx + xi * fovScale + this.parallax.x * z;
        const py = cy - eta * fovScale + this.parallax.y * z;

        if (px < margin || px > w - margin || py < margin || py > h - margin) continue;

        // Independent per-star log-normal scintillation (stronger toward the "horizon")
        const twinkle = this.scintillation(noiseSeed, now, mag, this.airmassAt(py, h), isDark);
        let alpha = alphaBase * twinkle;
        let r = rBase;
        // Flux that would exceed full opacity spills into a larger bloom instead of clipping
        if (alpha > 1) {
          r *= Math.pow(alpha, 0.35);
          alpha = 1;
        }

        if (isDark) {
          this.drawStarSprite(px, py, r, bv, perceivedSaturation(mag), alpha);
        } else {
          // Light Mode: archival manuscript pigment pinpricks
          const a = alpha * 0.45;
          if (specSlot === 1) {
            this.ctx.fillStyle = `rgba(30, 65, 140, ${a})`;
          } else if (specSlot === 5 || specSlot === 6) {
            this.ctx.fillStyle = `rgba(150, 75, 25, ${a})`;
          } else {
            this.ctx.fillStyle = `rgba(45, 40, 36, ${a})`;
          }
          this.ctx.beginPath();
          this.ctx.arc(px, py, Math.min(1.05, r), 0, Math.PI * 2);
          this.ctx.fill();
        }
      }

      this.ctx.restore();
    }

    private generateUniversalFieldGalaxies(con: any) {
      if (!con) return;
      this.universalFieldGalaxies = [];

      // Zone of Avoidance: Milky Way dust obscures distant background galaxies at low galactic latitudes
      const bDeg = Math.abs(con.galacticLatDeg ?? 30);
      const zoneOfAvoidanceFactor = clamp(0.35, Math.sin((bDeg * Math.PI) / 180), 1.0);
      const count = Math.round(20 + (con.inMilkyWay ? 8 : 22) * zoneOfAvoidanceFactor);

      // Deterministic PRNG seeded by constellation coordinates
      let seed = Math.abs(Math.sin(con.barycenterRaDeg * 31.7 + con.barycenterDecDeg * 67.3)) * 100000;
      const nextRnd = () => {
        seed = (seed * 9301 + 49297) % 233280;
        return seed / 233280;
      };

      for (let i = 0; i < count; i++) {
        const u1 = nextRnd();
        const u2 = nextRnd();
        // Radial distribution across wide hemisphere
        const rRad = Math.sqrt(-2.0 * Math.log(Math.max(0.0001, u1))) * 0.44;
        const theta = u2 * Math.PI * 2;
        const xi = Math.cos(theta) * rRad;
        const eta = Math.sin(theta) * rRad;

        // Distant galaxy angular radius: miniature cosmic sizes (6.5px to 17px)
        const majR = 6.5 + Math.pow(nextRnd(), 1.2) * 10.5;

        // Generate synthetic DFG catalog designation
        const dfgNum = Math.floor(1000 + nextRnd() * 8999);
        const label = `DFG-${dfgNum}`;

        // Cosmological parallax depth factor: distant background (z in [0.04, 0.09])
        const z = 0.04 + nextRnd() * 0.05;

        // Base opacity: subtle, non-distracting ethereal smudge (0.28 to 0.55)
        const baseAlpha = 0.28 + nextRnd() * 0.27;

        // Derive unique morphology genome for this background galaxy
        const gSeed = Math.abs(Math.sin(xi * 83.1 + eta * 47.9 + dfgNum)) * 100000;
        const genome = deriveGalaxyGenome(gSeed, 'S', label);

        this.universalFieldGalaxies.push([xi, eta, majR, genome, z, baseAlpha, label]);
      }
    }

    private drawUniversalFieldGalaxies(
      w: number,
      h: number,
      isDark: boolean,
      alphaMultiplier: number
    ) {
      if (!this.universalFieldGalaxies || this.universalFieldGalaxies.length === 0 || alphaMultiplier <= 0.01) return;

      const cx = w * 0.5;
      const cy = h * 0.5;
      const chartScale = this.currentConstellation?.chartScale || 7500;
      const isDesktop = w >= 1024;
      const fovMultiplier = isDesktop ? 1.45 : 1.05;
      const fovScale = (chartScale / 5000) * (Math.min(w, h) * 0.5) * fovMultiplier;
      const margin = 20;

      this.ctx.save();
      if (isDark) {
        this.ctx.globalCompositeOperation = 'lighter';
      }

      for (let i = 0; i < this.universalFieldGalaxies.length; i++) {
        const [xi, eta, majR, genome, z, baseAlpha, label] = this.universalFieldGalaxies[i];

        const px = cx + xi * fovScale + this.parallax.x * z;
        const py = cy - eta * fovScale + this.parallax.y * z;

        if (px < margin || px > w - margin || py < margin || py > h - margin) continue;

        const effectiveAlpha = baseAlpha * alphaMultiplier;
        const cosI = genome.cosI;
        // Hubble (1926) intrinsic thickness: prevents distant wafer collapse
        const q0 = 0.15;
        const sinI = Math.sqrt(Math.max(0, 1 - cosI * cosI));
        const effectiveCosI = Math.sqrt(cosI * cosI + q0 * q0 * sinI * sinI);
        const minR = Math.max(1.8, majR * effectiveCosI);
        const isEdgeOn = genome.hubbleType === 'edge_on' || cosI < 0.22;

        const discRgb = isDark ? genome.discRgbDark : genome.discRgbLight;
        const coreRgb = isDark ? genome.coreRgbDark : genome.coreRgbLight;

        this.ctx.save();
        this.ctx.translate(px, py);
        this.ctx.rotate(genome.pa);

        // 1. Distant Ellipticals / Spheroids (de Vaucouleurs profile)
        if (genome.hubbleType === 'elliptical') {
          const ellGrad = this.ctx.createRadialGradient(0, 0, 0, 0, 0, majR);
          if (isDark) {
            ellGrad.addColorStop(0, `rgba(255, 248, 230, ${0.72 * effectiveAlpha})`);
            ellGrad.addColorStop(0.35, `rgba(${coreRgb[0]}, ${coreRgb[1]}, ${coreRgb[2]}, ${0.38 * effectiveAlpha})`);
            ellGrad.addColorStop(0.75, `rgba(${discRgb[0]}, ${discRgb[1]}, ${discRgb[2]}, ${0.10 * effectiveAlpha})`);
            ellGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
          } else {
            ellGrad.addColorStop(0, `rgba(35, 28, 22, ${0.70 * effectiveAlpha})`);
            ellGrad.addColorStop(0.35, `rgba(${coreRgb[0]}, ${coreRgb[1]}, ${coreRgb[2]}, ${0.32 * effectiveAlpha})`);
            ellGrad.addColorStop(0.75, `rgba(${discRgb[0]}, ${discRgb[1]}, ${discRgb[2]}, ${0.08 * effectiveAlpha})`);
            ellGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
          }
          this.ctx.scale(1.0, effectiveCosI);
          this.ctx.fillStyle = ellGrad;
          this.ctx.beginPath();
          this.ctx.arc(0, 0, majR, 0, Math.PI * 2);
          this.ctx.fill();
        }

        // 2. Distant Edge-on Spindles & Needles (Thin disc + prominent central bulge + dust cut)
        else if (isEdgeOn) {
          // Disc envelope
          const edgeGrad = this.ctx.createRadialGradient(0, 0, 0, 0, 0, majR);
          if (isDark) {
            edgeGrad.addColorStop(0, `rgba(255, 250, 240, ${0.65 * effectiveAlpha})`);
            edgeGrad.addColorStop(0.35, `rgba(${discRgb[0]}, ${discRgb[1]}, ${discRgb[2]}, ${0.32 * effectiveAlpha})`);
            edgeGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
          } else {
            edgeGrad.addColorStop(0, `rgba(35, 28, 22, ${0.65 * effectiveAlpha})`);
            edgeGrad.addColorStop(0.40, `rgba(${discRgb[0]}, ${discRgb[1]}, ${discRgb[2]}, ${0.22 * effectiveAlpha})`);
            edgeGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
          }
          this.ctx.save();
          this.ctx.scale(1.0, effectiveCosI);
          this.ctx.fillStyle = edgeGrad;
          this.ctx.beginPath();
          this.ctx.arc(0, 0, majR, 0, Math.PI * 2);
          this.ctx.fill();
          this.ctx.restore();

          // Spheroidal bulge
          const bulgeR = majR * 0.36;
          const bGrad = this.ctx.createRadialGradient(0, 0, 0, 0, 0, bulgeR);
          if (isDark) {
            bGrad.addColorStop(0, `rgba(255, 255, 255, ${0.80 * effectiveAlpha})`);
            bGrad.addColorStop(0.5, `rgba(255, 230, 195, ${0.38 * effectiveAlpha})`);
            bGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
          } else {
            bGrad.addColorStop(0, `rgba(25, 20, 15, ${0.80 * effectiveAlpha})`);
            bGrad.addColorStop(0.5, `rgba(80, 60, 42, ${0.35 * effectiveAlpha})`);
            bGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
          }
          this.ctx.save();
          this.ctx.scale(0.85, 1.3);
          this.ctx.fillStyle = bGrad;
          this.ctx.beginPath();
          this.ctx.arc(0, 0, bulgeR, 0, Math.PI * 2);
          this.ctx.fill();
          this.ctx.restore();

          // Hairline dust cut
          this.ctx.strokeStyle = isDark
            ? `rgba(8, 10, 14, ${0.72 * effectiveAlpha})`
            : `rgba(245, 242, 234, ${0.82 * effectiveAlpha})`;
          this.ctx.lineWidth = 0.85;
          this.ctx.beginPath();
          this.ctx.moveTo(-majR * 0.85, 0);
          this.ctx.lineTo(majR * 0.85, 0);
          this.ctx.stroke();
        }

        // 3. Distant Spirals (Barred, Grand Design, Flocculent)
        else {
          // Disc exponential glow
          const discGrad = this.ctx.createRadialGradient(0, 0, 1, 0, 0, majR);
          if (isDark) {
            discGrad.addColorStop(0, `rgba(${coreRgb[0]}, ${coreRgb[1]}, ${coreRgb[2]}, ${0.45 * effectiveAlpha})`);
            discGrad.addColorStop(0.35, `rgba(${discRgb[0]}, ${discRgb[1]}, ${discRgb[2]}, ${0.20 * effectiveAlpha})`);
            discGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
          } else {
            discGrad.addColorStop(0, `rgba(${coreRgb[0]}, ${coreRgb[1]}, ${coreRgb[2]}, ${0.35 * effectiveAlpha})`);
            discGrad.addColorStop(0.40, `rgba(${discRgb[0]}, ${discRgb[1]}, ${discRgb[2]}, ${0.14 * effectiveAlpha})`);
            discGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
          }
          this.ctx.save();
          this.ctx.scale(1.0, effectiveCosI);
          this.ctx.fillStyle = discGrad;
          this.ctx.beginPath();
          this.ctx.arc(0, 0, majR, 0, Math.PI * 2);
          this.ctx.fill();
          this.ctx.restore();

          // Delicate spiral arm whorls
          const armSteps = 16;
          const armCount = genome.armCount;
          const winding = genome.winding;
          const pitch = genome.pitch;
          const startR = majR * (genome.hubbleType === 'barred_spiral' ? 0.35 : 0.18);

          this.ctx.strokeStyle = isDark
            ? `rgba(${discRgb[0]}, ${discRgb[1]}, ${discRgb[2]}, ${0.32 * effectiveAlpha})`
            : `rgba(${discRgb[0]}, ${discRgb[1]}, ${discRgb[2]}, ${0.22 * effectiveAlpha})`;
          this.ctx.lineWidth = 0.65;

          for (let arm = 0; arm < armCount; arm++) {
            const armBasePhase = (arm * 2 * Math.PI) / armCount;
            this.ctx.beginPath();
            for (let s = 0; s <= armSteps; s++) {
              const t = s / armSteps;
              const r = startR + t * (majR - startR - 1.5);
              const theta = armBasePhase + winding * Math.log(Math.max(0.01, r / startR)) / Math.tan(pitch);
              const xArm = r * Math.cos(theta);
              const yArm = r * Math.sin(theta) * effectiveCosI;
              if (s === 0) this.ctx.moveTo(xArm, yArm);
              else this.ctx.lineTo(xArm, yArm);
            }
            this.ctx.stroke();
          }

          // Micro Bar if barred spiral
          if (genome.hubbleType === 'barred_spiral') {
            const barHalf = majR * genome.barLength * 0.8;
            this.ctx.save();
            this.ctx.rotate(genome.barAngle);
            this.ctx.scale(1.0, effectiveCosI);
            this.ctx.fillStyle = isDark
              ? `rgba(255, 245, 225, ${0.45 * effectiveAlpha})`
              : `rgba(45, 36, 30, ${0.35 * effectiveAlpha})`;
            this.ctx.beginPath();
            this.ctx.ellipse(0, 0, barHalf, barHalf * 0.35, 0, 0, Math.PI * 2);
            this.ctx.fill();
            this.ctx.restore();
          }

          // Micro Starlike Nucleus
          const nucR = Math.max(1.1, minR * 0.32);
          this.ctx.fillStyle = isDark
            ? `rgba(255, 255, 255, ${0.80 * effectiveAlpha})`
            : `rgba(25, 20, 16, ${0.75 * effectiveAlpha})`;
          this.ctx.beginPath();
          this.ctx.arc(0, 0, nucR, 0, Math.PI * 2);
          this.ctx.fill();
        }

        this.ctx.restore();
      }

      this.ctx.restore();
    }

    private drawMythicAura(
      w: number,
      h: number,
      isDark: boolean,
      now: number,
      alphaMultiplier: number
    ) {
      if (!this.currentConstellation || alphaMultiplier <= 0.01) return;

      const cx = w * 0.5;
      const cy = h * 0.5;
      const scale = Math.min(w, h) / 10000;
      const z = 0.75; // Sits at constellation plane

      // Hypnotic 14-second breathing wave: opacity strictly 0.015 .. 0.040 ("distant dreams overlaid on top")
      const breath = 0.024 + 0.016 * Math.sin(now * 0.00045);
      const dreamOpacity = breath * alphaMultiplier;

      const figures = this.currentConstellation.mythicFigures;
      if (figures && figures.length > 0) {
        this.ctx.save();
        this.ctx.strokeStyle = isDark
          ? `rgba(235, 220, 195, ${dreamOpacity})`
          : `rgba(45, 40, 36, ${dreamOpacity * 1.25})`;
        this.ctx.lineWidth = 0.65;
        this.ctx.setLineDash([1.5, 4.0]); // Delicate archival stipple
        this.ctx.lineCap = 'round';
        this.ctx.lineJoin = 'round';

        for (const path of figures) {
          if (!path || path.length < 2) continue;
          this.ctx.beginPath();
          for (let pIdx = 0; pIdx < path.length; pIdx++) {
            const [rawX, rawY] = path[pIdx];
            const px = cx + (rawX - 5000) * scale + this.parallax.x * z;
            const py = cy + (rawY - 5000) * scale + this.parallax.y * z;
            if (pIdx === 0) {
              this.ctx.moveTo(px, py);
            } else {
              this.ctx.lineTo(px, py);
            }
          }
          this.ctx.stroke();
        }
        this.ctx.setLineDash([]);
        this.ctx.restore();
      }
    }

    private drawCosmicTransients(
      w: number,
      h: number,
      isDark: boolean,
      now: number
    ) {
      // Trigger new meteor bolide every 18-28 seconds
      if (!this.meteorState.active && now > this.meteorState.nextTrigger) {
        this.spawnMeteor(w, h, now);
      }

      if (this.meteorState.active) {
        const elapsed = now - this.meteorState.startTime;
        const t = elapsed / this.meteorState.duration;

        if (t >= 1.0) {
          this.meteorState.active = false;
        } else {
          // Decelerating atmospheric entry trajectory
          const easeT = 1.0 - Math.pow(1.0 - t, 2.2);
          const curX = this.meteorState.startX + (this.meteorState.endX - this.meteorState.startX) * easeT;
          const curY = this.meteorState.startY + (this.meteorState.endY - this.meteorState.startY) * easeT;

          // Push wake point
          this.meteorState.trail.push({ x: curX, y: curY, time: now });

          // Head brightness curve
          const headAlpha = Math.sin(t * Math.PI);
          const headR = 1.6 + headAlpha * 1.1;

          this.ctx.save();
          this.ctx.fillStyle = isDark
            ? `rgba(255, 250, 240, ${headAlpha * 0.92})`
            : `rgba(40, 35, 30, ${headAlpha * 0.82})`;
          this.ctx.beginPath();
          this.ctx.arc(curX, curY, headR, 0, Math.PI * 2);
          this.ctx.fill();

          // Soft bluish ion halo in dark mode
          if (isDark) {
            const headGlow = this.ctx.createRadialGradient(curX, curY, 0, curX, curY, headR * 3.5);
            headGlow.addColorStop(0, `rgba(180, 220, 255, ${headAlpha * 0.55})`);
            headGlow.addColorStop(1, 'rgba(180, 220, 255, 0)');
            this.ctx.fillStyle = headGlow;
            this.ctx.beginPath();
            this.ctx.arc(curX, curY, headR * 3.5, 0, Math.PI * 2);
            this.ctx.fill();
          }
          this.ctx.restore();
        }
      }

      // Render decaying ionized persistence wake
      if (this.meteorState.trail.length > 0) {
        this.ctx.save();
        const maxAge = 2400; // ms
        this.meteorState.trail = this.meteorState.trail.filter(pt => (now - pt.time) < maxAge);

        for (let i = 1; i < this.meteorState.trail.length; i++) {
          const ptA = this.meteorState.trail[i - 1];
          const ptB = this.meteorState.trail[i];
          const age = now - ptB.time;
          const wakeAlpha = Math.max(0, 1.0 - age / maxAge) * 0.30;

          this.ctx.strokeStyle = isDark
            ? `rgba(200, 225, 255, ${wakeAlpha})`
            : `rgba(60, 50, 45, ${wakeAlpha * 0.75})`;
          this.ctx.lineWidth = Math.max(0.4, (1.0 - age / maxAge) * 1.4);
          this.ctx.beginPath();
          this.ctx.moveTo(ptA.x, ptA.y);
          this.ctx.lineTo(ptB.x, ptB.y);
          this.ctx.stroke();
        }
        this.ctx.restore();
      }
    }

    private spawnMeteor(w: number, h: number, now: number) {
      const startX = w * (0.15 + Math.random() * 0.70);
      const startY = h * (0.08 + Math.random() * 0.35);
      const angle = (25 + Math.random() * 45) * Math.PI / 180;
      const dist = 140 + Math.random() * 160;

      this.meteorState.active = true;
      this.meteorState.startX = startX;
      this.meteorState.startY = startY;
      this.meteorState.endX = startX + Math.cos(angle) * dist;
      this.meteorState.endY = startY + Math.sin(angle) * dist;
      this.meteorState.startTime = now;
      this.meteorState.duration = 550 + Math.random() * 250;
      this.meteorState.nextTrigger = now + 18000 + Math.random() * 12000;
    }

    private drawConstellationEdges(
      w: number,
      h: number,
      progress: number,
      isDark: boolean,
      inkColor: string,
      shadowColor: string,
      constellation: any,
      alphaMultiplier: number
    ) {
      if (!constellation.edges || !constellation.stars || alphaMultiplier <= 0.01) return;

      const cx = w * 0.5;
      const cy = h * 0.5;
      const scale = Math.min(w, h) / 10000;
      const stars = constellation.stars;

      const totalEdges = constellation.edges.length;
      const edgeCutoff = Math.floor(totalEdges * progress);
      const edgePartial = (totalEdges * progress) - edgeCutoff;

      this.ctx.lineCap = 'round';

      for (let i = 0; i <= edgeCutoff && i < totalEdges; i++) {
        const [aIdx, bIdx] = constellation.edges[i];
        const starA = stars[aIdx];
        const starB = stars[bIdx];
        if (!starA || !starB) continue;

        // 3D Parallax Depth for Star A and Star B:
        // Fore-stars lean further towards pointer, causing edge lines to flex in 3D perspective!
        const zA = calculateStarDepth(starA[2], starA[7]);
        const zB = calculateStarDepth(starB[2], starB[7]);

        const ax = cx + (starA[0] - 5000) * scale + this.parallax.x * zA;
        const ay = cy + (starA[1] - 5000) * scale + this.parallax.y * zA;
        const bx = cx + (starB[0] - 5000) * scale + this.parallax.x * zB;
        const by = cy + (starB[1] - 5000) * scale + this.parallax.y * zB;

        const dx = bx - ax;
        const dy = by - ay;
        const len = Math.hypot(dx, dy);
        if (len < 16) continue; // Skip degenerate segments

        // 9px Breathing Halo: pen stroke stops 9px short of star centers
        const uX = dx / len;
        const uY = dy / len;
        const gap = 9;

        const startX = ax + uX * gap;
        const startY = ay + uY * gap;
        let endX = bx - uX * gap;
        let endY = by - uY * gap;

        // Partial stroke for progressive inking
        if (i === edgeCutoff) {
          endX = startX + (endX - startX) * edgePartial;
          endY = startY + (endY - startY) * edgePartial;
        }

        // 3D Depth-modulated intaglio shadow
        const avgZ = (zA + zB) * 0.5;
        const shadowOffset = 1.0 * avgZ;
        this.ctx.strokeStyle = shadowColor;
        this.ctx.lineWidth = 0.9;
        this.ctx.beginPath();
        this.ctx.moveTo(startX + shadowOffset, startY + shadowOffset);
        this.ctx.lineTo(endX + shadowOffset, endY + shadowOffset);
        this.ctx.stroke();

        // 3D Tapered Pen Stroke via Linear Gradient
        const edgeGrad = this.ctx.createLinearGradient(startX, startY, endX, endY);
        const opA = Math.min(1.0, 0.48 + (zA - 0.7) * 0.32) * alphaMultiplier;
        const opB = Math.min(1.0, 0.48 + (zB - 0.7) * 0.32) * alphaMultiplier;

        if (isDark) {
          edgeGrad.addColorStop(0, `rgba(235, 230, 220, ${opA})`);
          edgeGrad.addColorStop(1, `rgba(235, 230, 220, ${opB})`);
        } else {
          edgeGrad.addColorStop(0, `rgba(45, 40, 36, ${opA * 0.95})`);
          edgeGrad.addColorStop(1, `rgba(45, 40, 36, ${opB * 0.95})`);
        }

        this.ctx.strokeStyle = edgeGrad;
        this.ctx.lineWidth = 1.05;
        this.ctx.beginPath();
        this.ctx.moveTo(startX, startY);
        this.ctx.lineTo(endX, endY);
        this.ctx.stroke();
      }
    }

    private drawConstellationStars(
      w: number,
      h: number,
      wetFactor: number,
      isDark: boolean,
      monochromeInk: string,
      now: number,
      constellation: any,
      alphaMultiplier: number
    ) {
      if (!constellation.stars || alphaMultiplier <= 0.01) return;

      const cx = w * 0.5;
      const cy = h * 0.5;
      const scale = Math.min(w, h) / 10000;
      const stars = constellation.stars;

      for (let i = 0; i < stars.length; i++) {
        const star = stars[i];
        const [rawX, rawY, mag, specSlot, hip, properName, bayer, distLy] = star;

        // True 5-Tier Logarithmic Astrometric Distance Layering
        const z = calculateStarDepth(mag, distLy);

        // Per-star hash seed for uncorrelated turbulence phasing
        let hVal = (hip ^ 0x9e3779b9);
        hVal = Math.imul(hVal ^ (hVal >>> 16), 0x85ebca6b);
        hVal = Math.imul(hVal ^ (hVal >>> 13), 0xc2b2ae35);
        const seed = ((hVal ^ (hVal >>> 16)) >>> 0) / 4294967295;

        // Atmospheric Seeing Micro-Wander (centroid shift 0.12 - 0.55px)
        const frozen = this.isScintillationFrozen();
        const wanderAmp = frozen ? 0 : Math.max(0.12, Math.min(0.55, (4.8 - mag) * 0.12));
        const wanderX = wanderAmp * Math.sin(now * 0.00085 + seed * 45.1);
        const wanderY = wanderAmp * Math.cos(now * 0.00062 + seed * 23.7);

        const px = cx + (rawX - 5000) * scale + this.parallax.x * z + wanderX;
        const py = cy + (rawY - 5000) * scale + this.parallax.y * z + wanderY;

        // Log-normal scintillation intensity (mean ≈ 1) and a signed [-1, 1] proxy
        // that drives the size of rings, spikes and halos below.
        const airmass = this.airmassAt(py, h);
        const twinkle = this.scintillation(seed, now, mag, airmass, isDark);
        const scint = clamp(-1, Math.log(twinkle) / 0.45, 1);

        // Radius scaled by visual magnitude + atmospheric shimmer breathing
        const rBase = Math.max(1.8, Math.min(5.5, (4.8 - mag) * 1.15));
        const r = rBase * (0.92 + 0.16 * Math.max(0, (scint + 0.8) / 1.8));

        // Check if this star is hovered or selected
        const isHovered = this.hoveredStar && this.hoveredStar[4] === hip;
        const isSelected = this.selectedStar && this.selectedStar[4] === hip;

        // Re-wet tint: hovered or selected stars instantly re-wet to full spectral color!
        const effectiveWet = (isHovered || isSelected) ? 1.0 : wetFactor;

        // Spectral color tint
        const spectralRgb = specSlotToRgb(specSlot, isDark);
        const starFill = effectiveWet > 0.02
          ? blendRgbWithMonochrome(spectralRgb, isDark, effectiveWet)
          : monochromeInk;

        // Scattered-light PSF glow (dark sky only): keeps a faint spectral tint even once
        // the ink has dried, and blooms outward when the star flares.
        if (isDark) {
          this.ctx.save();
          this.ctx.globalCompositeOperation = 'lighter';
          const glowSat = perceivedSaturation(mag) * (0.55 + 0.45 * effectiveWet);
          const glowR = rBase * 0.9 * Math.pow(twinkle, 0.35);
          const glowAlpha = clamp(0, 0.5 * twinkle, 1) * alphaMultiplier;
          this.drawStarSprite(px, py, glowR, specSlotToBv(specSlot), glowSat, glowAlpha);
          this.ctx.globalAlpha = alphaMultiplier;
          this.drawChromaticScintillation(px, py, rBase * 0.8, seed, now, mag, airmass);
          this.ctx.restore();
        }

        // Ink core dims slightly in scintillation troughs (dark sky only)
        this.ctx.globalAlpha = isDark
          ? alphaMultiplier * clamp(0.5, 0.35 + 0.65 * twinkle, 1)
          : alphaMultiplier;

        // Radial Chromatic Dispersion during wet phase
        if (effectiveWet > 0.10 && mag <= 2.8) {
          const vX = (px - cx) / (Math.hypot(px - cx, py - cy) || 1);
          const vY = (py - cy) / (Math.hypot(px - cx, py - cy) || 1);
          const chromaticDist = 0.85 * effectiveWet * (1.0 + scint * 0.15);

          // Red-fringe component
          this.ctx.fillStyle = isDark
            ? `rgba(255, 120, 100, ${0.35 * effectiveWet})`
            : `rgba(200, 50, 40, ${0.25 * effectiveWet})`;
          this.ctx.beginPath();
          this.ctx.arc(px + vX * chromaticDist, py + vY * chromaticDist, r * 1.25, 0, Math.PI * 2);
          this.ctx.fill();

          // Cyan-fringe component
          this.ctx.fillStyle = isDark
            ? `rgba(100, 200, 255, ${0.35 * effectiveWet})`
            : `rgba(40, 120, 180, ${0.25 * effectiveWet})`;
          this.ctx.beginPath();
          this.ctx.arc(px - vX * chromaticDist, py - vY * chromaticDist, r * 1.25, 0, Math.PI * 2);
          this.ctx.fill();
        }

        // Astrolabe Reticle for α star, hovered star, or selected star
        if (i === 0 || isHovered || isSelected) {
          this.ctx.strokeStyle = isDark ? 'rgba(235, 226, 210, 0.45)' : 'rgba(50, 44, 38, 0.45)';
          this.ctx.lineWidth = 0.8;
          this.ctx.beginPath();
          this.ctx.arc(px, py, r + 5, 0, Math.PI * 2);
          this.ctx.stroke();

          // 4 Cardinal tick marks
          this.ctx.beginPath();
          this.ctx.moveTo(px - r - 8, py);
          this.ctx.lineTo(px - r - 3, py);
          this.ctx.moveTo(px + r + 3, py);
          this.ctx.lineTo(px + r + 8, py);
          this.ctx.moveTo(px, py - r - 8);
          this.ctx.lineTo(px, py - r - 3);
          this.ctx.moveTo(px, py + r + 3);
          this.ctx.lineTo(px, py + r + 8);
          this.ctx.stroke();
        }

        // Delicate Airy Diffraction Ring for First-Magnitude Stars (mag <= 1.8)
        if (mag <= 1.8) {
          const airyR = r * 2.35 * (1.0 + scint * 0.06);
          const airyAlpha = (0.16 + 0.08 * ((scint + 1) * 0.5)) * alphaMultiplier;
          this.ctx.strokeStyle = isDark
            ? `rgba(220, 230, 255, ${airyAlpha})`
            : `rgba(60, 52, 45, ${airyAlpha * 0.85})`;
          this.ctx.lineWidth = 0.55;
          this.ctx.beginPath();
          this.ctx.arc(px, py, airyR, 0, Math.PI * 2);
          this.ctx.stroke();
        }

        // Classical 4-ray engraved spider cross spikes for bright stars (mag <= 1.8)
        if (mag <= 1.8) {
          const spikeLenBase = (2.2 - mag) * 8.5;
          const spikeLen = spikeLenBase * (1.0 + scint * 0.14);
          this.ctx.strokeStyle = starFill;
          this.ctx.lineWidth = 0.65;
          this.ctx.beginPath();
          this.ctx.moveTo(px - spikeLen, py);
          this.ctx.lineTo(px + spikeLen, py);
          this.ctx.moveTo(px, py - spikeLen);
          this.ctx.lineTo(px, py + spikeLen);
          this.ctx.stroke();
        }

        // Optical Point-Spread Function (PSF) Lorentzian Core Falloff & Core Blowing
        if (mag <= 2.4) {
          const haloR = r * (2.1 + scint * 0.12);
          const psfGrad = this.ctx.createRadialGradient(px, py, r * 0.3, px, py, haloR);
          if (isDark) {
            psfGrad.addColorStop(0, '#ffffff');
            psfGrad.addColorStop(0.35, starFill);
            psfGrad.addColorStop(0.70, `rgba(${spectralRgb[0]}, ${spectralRgb[1]}, ${spectralRgb[2]}, 0.22)`);
            psfGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
          } else {
            psfGrad.addColorStop(0, '#1a1614');
            psfGrad.addColorStop(0.35, starFill);
            psfGrad.addColorStop(0.70, `rgba(${spectralRgb[0]}, ${spectralRgb[1]}, ${spectralRgb[2]}, 0.18)`);
            psfGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
          }
          this.ctx.fillStyle = psfGrad;
          this.ctx.beginPath();
          this.ctx.arc(px, py, haloR, 0, Math.PI * 2);
          this.ctx.fill();

          // Overdriven High-Density Center
          this.ctx.fillStyle = isDark ? '#ffffff' : '#1a1614';
          this.ctx.beginPath();
          this.ctx.arc(px, py, r * 0.65, 0, Math.PI * 2);
          this.ctx.fill();
        } else {
          // Standard Inked Star Core
          this.ctx.fillStyle = starFill;
          this.ctx.beginPath();
          this.ctx.arc(px, py, r, 0, Math.PI * 2);
          this.ctx.fill();
        }

        // Bayer Greek designation label (e.g. α, β, γ)
        if (bayer) {
          this.ctx.fillStyle = isDark ? 'rgba(230, 220, 205, 0.82)' : 'rgba(45, 40, 36, 0.85)';
          this.ctx.font = 'italic 12px Newsreader, serif';
          this.ctx.fillText(bayer, px + r + 5, py - r);
        }

        // If named and bright, draw proper name
        if (properName && (mag <= 2.2 || isHovered || isSelected)) {
          this.ctx.fillStyle = isDark ? 'rgba(215, 205, 190, 0.65)' : 'rgba(75, 68, 60, 0.72)';
          this.ctx.font = 'normal 10px Newsreader, serif';
          this.ctx.fillText(properName, px + r + 5, py + r + 10);
        }

        this.ctx.globalAlpha = 1.0;
      }
    }

    private bindEvents() {
      // 1. Next Plate button with smooth celestial camera slewing
      const nextBtn = document.getElementById('btn-new-constellation');
      nextBtn?.addEventListener('click', () => {
        const pool = this.constellations.filter(c => c.id !== this.currentConstellation.id);
        const idx = Math.floor(Math.random() * pool.length);
        const chosen = pool[idx];
        this.slewToConstellation(chosen);
      });

      // 2. Permalink copy button
      const linkBtn = document.getElementById('btn-copy-sky-link');
      linkBtn?.addEventListener('click', () => {
        const url = new URL(window.location.href);
        url.searchParams.set('sky', this.currentConstellation.id);
        navigator.clipboard.writeText(url.toString()).then(() => {
          linkBtn.textContent = '✓ Copied Link';
          setTimeout(() => { linkBtn.textContent = '⌖ Plate Link'; }, 2000);
        });
      });

      // 3. Export Archival 4K Star Chart PNG
      const exportBtn = document.getElementById('btn-export-chart');
      exportBtn?.addEventListener('click', () => this.exportPlatePng());

      // 4. Interactive pointer hover & click on stars
      this.canvas.addEventListener('mousemove', (e) => this.handlePointerMove(e));
      this.canvas.addEventListener('mouseleave', () => {
        this.hoveredStar = null;
        this.parallax.targetX = 0;
        this.parallax.targetY = 0;
        this.isInteracting = false;
      });
      this.canvas.addEventListener('click', (e) => this.handlePointerClick(e));

      // Close popup button
      document.getElementById('inset-close-btn')?.addEventListener('click', () => {
        this.selectedStar = null;
        document.getElementById('star-inset-popup')?.setAttribute('hidden', '');
      });

      // 5. Interactive Cartouche click/touch & keyboard controls
      const cartouche = document.getElementById('sky-cartouche');
      if (cartouche) {
        cartouche.addEventListener('click', (e) => {
          cartouche.classList.toggle('is-expanded');
          e.stopPropagation();
        });
        cartouche.addEventListener('mouseleave', () => {
          cartouche.classList.remove('is-expanded');
        });
        cartouche.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            cartouche.classList.remove('is-expanded');
            cartouche.blur();
          } else if (e.key === 'Enter' || e.key === ' ') {
            cartouche.classList.toggle('is-expanded');
            e.preventDefault();
          }
        });
        document.addEventListener('click', (e) => {
          if (!cartouche.contains(e.target as Node)) {
            cartouche.classList.remove('is-expanded');
          }
        });
      }

      // 6. Instant theme & accessibility transition listeners
      window.addEventListener('drc-theme-changed', () => {
        this.renderSingleFrame(performance.now());
      });
      window.addEventListener('drc-accessibility-changed', () => {
        this.renderSingleFrame(performance.now());
      });
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
        this.renderSingleFrame(performance.now());
      });
      window.addEventListener('drc:sky-rise', () => {
        this.drawStartTime = performance.now();
        this.renderSingleFrame(performance.now());
      });
    }

    private handlePointerMove(e: MouseEvent) {
      const rect = this.canvas.getBoundingClientRect();
      this.mousePos.x = e.clientX - rect.left;
      this.mousePos.y = e.clientY - rect.top;

      // Realistic 3D parallax tilt towards cursor
      const normX = (this.mousePos.x / rect.width) - 0.5;
      const normY = (this.mousePos.y / rect.height) - 0.5;
      this.parallax.targetX = -normX * 14;
      this.parallax.targetY = -normY * 14;

      const star = this.findStarAtPosition(this.mousePos.x, this.mousePos.y);
      if (star !== this.hoveredStar) {
        this.hoveredStar = star;
        this.canvas.style.cursor = star ? 'pointer' : 'default';
        this.isInteracting = true;
      }
    }

    private handlePointerClick(e: MouseEvent) {
      const rect = this.canvas.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      const clickY = e.clientY - rect.top;

      const star = this.findStarAtPosition(clickX, clickY);
      if (star) {
        this.selectedStar = star;
        this.showStarAnnotation(star, clickX, clickY);
      } else {
        this.selectedStar = null;
        document.getElementById('star-inset-popup')?.setAttribute('hidden', '');
      }
    }

    private findStarAtPosition(x: number, y: number) {
      if (!this.currentConstellation || !this.currentConstellation.stars) return null;

      const w = window.innerWidth;
      const h = window.innerHeight;
      const cx = w * 0.5;
      const cy = h * 0.5;
      const scale = Math.min(w, h) / 10000;

      for (const s of this.currentConstellation.stars) {
        const mag = s[2];
        const distLy = s[7];
        const z = calculateStarDepth(mag, distLy);
        const px = cx + (s[0] - 5000) * scale + this.parallax.x * z;
        const py = cy + (s[1] - 5000) * scale + this.parallax.y * z;
        if (Math.hypot(x - px, y - py) < 22) {
          return s;
        }
      }
      return null;
    }

    private showStarAnnotation(s: any, clickX: number, clickY: number) {
      const popup = document.getElementById('star-inset-popup');
      if (!popup) return;

      const [, , mag, specSlot, hip, properName, bayer, distLy] = s;
      const titleEl = document.getElementById('inset-star-title');
      const catEl = document.getElementById('inset-star-catalog');
      const desigEl = document.getElementById('inset-star-designation');
      const magEl = document.getElementById('inset-star-mag');
      const spectralEl = document.getElementById('inset-star-spectral');
      const distEl = document.getElementById('inset-star-dist');
      const coordsEl = document.getElementById('inset-star-coords');
      const previewEl = document.getElementById('inset-star-preview');

      const name = properName || `${bayer || 'Star'} ${this.currentConstellation.genitive}`;
      if (titleEl) titleEl.textContent = name;
      if (catEl) catEl.textContent = `${bayer || '—'} · HIP ${hip} · IAU ${this.currentConstellation.id.toUpperCase()}`;
      if (desigEl) desigEl.textContent = `ASTROMETRIC FOLIO // ${bayer || 'STAR'}`;
      if (magEl) magEl.textContent = `${mag.toFixed(2)} MAG`;

      const isDark = this.isDarkTheme();
      const specRgb = specSlotToRgb(specSlot, isDark);
      if (previewEl) {
        previewEl.style.backgroundColor = `rgb(${specRgb[0]}, ${specRgb[1]}, ${specRgb[2]})`;
        previewEl.style.boxShadow = isDark
          ? `0 0 16px 2px rgba(${specRgb[0]}, ${specRgb[1]}, ${specRgb[2]}, 0.55)`
          : `0 0 10px 1px rgba(${specRgb[0]}, ${specRgb[1]}, ${specRgb[2]}, 0.35)`;
      }

      const tempK = specSlotToTemp(specSlot);
      if (spectralEl) spectralEl.textContent = `CLASS ${specSlotToClass(specSlot)} · ${tempK.toLocaleString()} K`;
      const trueDistLy = distLy || Math.round(Math.max(25, (6.5 - mag) * 120));
      if (distEl) distEl.textContent = trueDistLy < 100
        ? `${trueDistLy.toFixed(1)} LIGHT-YEARS`
        : `~${Math.round(trueDistLy).toLocaleString()} LIGHT-YEARS`;
      if (coordsEl) coordsEl.textContent = `J2000 ASTROMETRY · HIP ${hip}`;

      // Position popup safely within screen bounds
      const popupWidth = 320;
      const left = Math.min(Math.max(20, clickX + 28), window.innerWidth - popupWidth - 20);
      const top = Math.min(Math.max(80, clickY - 60), window.innerHeight - 300);

      popup.style.left = `${left}px`;
      popup.style.top = `${top}px`;
      popup.removeAttribute('hidden');

      const card = popup.querySelector<HTMLElement>('.inset-card');
      if (card) {
        applyInkTransition(card);
      }
    }

    private exportPlatePng() {
      if (!this.currentConstellation) return;

      const offCanvas = document.createElement('canvas');
      offCanvas.width = 3000;
      offCanvas.height = 2000;
      const offCtx = offCanvas.getContext('2d')!;

      const isDark = this.isDarkTheme();

      // Fill Archival Rag Paper Background
      offCtx.fillStyle = isDark ? '#141724' : '#f5f2ea';
      offCtx.fillRect(0, 0, 3000, 2000);

      // Save canvas state and render crisp plate onto offscreen canvas
      const origCtx = this.ctx;
      this.ctx = offCtx;
      this.ctx.setTransform(1, 0, 0, 1, 0, 0);

      // Render static archival plate (scintillation frozen at mean brightness)
      this.staticScintillation = true;
      this.renderSingleFrame(this.drawStartTime + this.INK_DRAW_DURATION + this.DRYING_DURATION);
      this.staticScintillation = false;
      this.ctx = origCtx;

      const link = document.createElement('a');
      link.download = `DRC-Plate-${this.currentConstellation.id}.png`;
      link.href = offCanvas.toDataURL('image/png');
      link.click();
    }
  }

  function calculateStarDepth(mag: number, distLy?: number): number {
    if (distLy && distLy > 0) {
      // 5-Tier Logarithmic Astrometric Distance Layering
      // Sirius is ~8.6 ly; Rigel ~860 ly; Deneb ~1550 ly; Alnilam ~2000 ly; distant field stars up to 3500 ly
      const clampedDist = Math.max(8.0, Math.min(3500.0, distLy));
      const logMin = Math.log10(8.0);
      const logMax = Math.log10(3500.0);
      const t = (Math.log10(clampedDist) - logMin) / (logMax - logMin); // 0.0 (near) .. 1.0 (far)
      // Map to z in [0.70, 2.30]
      const zDist = 2.30 - t * 1.55;
      // Modulate with visual brightness factor
      const zMag = 1.0 + Math.max(0, (3.2 - mag) * 0.35);
      return Math.max(0.65, Math.min(2.40, 0.65 * zDist + 0.35 * zMag));
    }
    return Math.max(0.70, 1.0 + Math.max(0, (3.2 - mag) * 0.35));
  }

  function getGalacticCoords(raDeg: number, decDeg: number) {
    const deg2rad = Math.PI / 180;
    const rad2deg = 180 / Math.PI;

    const raG = 192.85948 * deg2rad;
    const decG = 27.12825 * deg2rad;
    const l0 = 32.93192 * deg2rad;

    const a = raDeg * deg2rad;
    const d = decDeg * deg2rad;

    const sinB = Math.sin(d) * Math.sin(decG) + Math.cos(d) * Math.cos(decG) * Math.cos(a - raG);
    const b = Math.asin(Math.max(-1, Math.min(1, sinB)));

    const y = Math.cos(d) * Math.sin(a - raG);
    const x = Math.cos(decG) * Math.sin(d) - Math.sin(decG) * Math.cos(d) * Math.cos(a - raG);
    const l = (Math.atan2(y, x) + l0 + 2 * Math.PI) % (2 * Math.PI);

    // Position angle thetaG of the galactic equator tangent in local tangent-plane coordinates
    const num = Math.cos(decG) * Math.sin(a - raG);
    const den = Math.cos(d) * Math.sin(decG) - Math.sin(d) * Math.cos(decG) * Math.cos(a - raG);
    const thetaG = Math.atan2(num, den);

    return {
      lDeg: l * rad2deg,
      bDeg: b * rad2deg,
      bRad: b,
      thetaG
    };
  }

  function applyInkTransition(el: HTMLElement | null) {
    if (!el) return;
    el.classList.remove('ink-transition-active');
    void el.offsetWidth;
    el.classList.add('ink-transition-active');
    window.setTimeout(() => {
      el.classList.remove('ink-transition-active');
    }, 650);
  }

  function specSlotToRgb(slot: number, isDark = true): [number, number, number] {
    if (isDark) {
      switch (slot) {
        case 1: return [160, 195, 255]; // O/B Blue-white
        case 2: return [215, 230, 255]; // A Frost-white
        case 3: return [248, 248, 240]; // F Yellow-white
        case 4: return [255, 244, 215]; // G Solar ivory
        case 5: return [255, 210, 150]; // K Amber
        case 6: return [255, 160, 110]; // M Ember
        default: return [235, 225, 210];
      }
    } else {
      // Historical archival manuscript pigments for cream rag paper
      switch (slot) {
        case 1: return [28, 70, 160];   // Lapis Lazuli Deep Blue
        case 2: return [40, 85, 140];   // Prussian Slate Blue
        case 3: return [75, 95, 50];    // Archival Olive Gold
        case 4: return [175, 110, 20];  // Raw Ochre & Sienna
        case 5: return [175, 75, 25];   // Burnt Sienna Terra
        case 6: return [165, 40, 35];   // Carmine & Madder Red
        default: return [42, 36, 32];   // Archival Iron Gall
      }
    }
  }

  function specSlotToClass(slot: number): string {
    switch (slot) {
      case 1: return 'B2 Ia-ab';
      case 2: return 'A0 V';
      case 3: return 'F5 IV';
      case 4: return 'G2 V';
      case 5: return 'K3 III';
      case 6: return 'M2 Iab';
      default: return 'A0';
    }
  }

  function specSlotToTemp(slot: number): number {
    switch (slot) {
      case 1: return 18500;
      case 2: return 9600;
      case 3: return 6800;
      case 4: return 5780;
      case 5: return 4400;
      case 6: return 3350;
      default: return 7500;
    }
  }

  function blendRgbWithMonochrome(rgb: [number, number, number], isDark: boolean, wet: number): string {
    const [sr, sg, sb] = rgb;
    const [dr, dg, db] = isDark ? [235, 230, 220] : [38, 34, 30];
    const r = Math.round(dr + (sr - dr) * wet);
    const g = Math.round(dg + (sg - dg) * wet);
    const b = Math.round(db + (sb - db) * wet);
    return `rgb(${r}, ${g}, ${b})`;
  }

  function clamp(min: number, val: number, max: number) {
    return Math.max(min, Math.min(max, val));
  }

  // ---------------------------------------------------------------------------
  // Stellar Scintillation & Point-Spread-Function Glow Toolkit
  // ---------------------------------------------------------------------------

  /** Integer avalanche hash → [0, 1). */
  function hash01(n: number): number {
    let h = (n | 0) ^ 0x9e3779b9;
    h = Math.imul(h ^ (h >>> 16), 0x85ebca6b);
    h = Math.imul(h ^ (h >>> 13), 0xc2b2ae35);
    return ((h ^ (h >>> 16)) >>> 0) / 4294967296;
  }

  /**
   * Smooth, non-periodic 1D value noise in [-1, 1].
   * `channel` selects an independent noise stream (one per star / colour band).
   */
  function valueNoise1D(x: number, channel: number): number {
    const i = Math.floor(x);
    const f = x - i;
    const c = Math.imul(channel | 0, 668265263);
    const a = hash01(Math.imul(i, 374761393) ^ c);
    const b = hash01(Math.imul(i + 1, 374761393) ^ c);
    const u = f * f * (3 - 2 * f);
    return (a + (b - a) * u) * 2 - 1;
  }

  /** Representative B–V colour index for the coarse spectral slots used by constellation data. */
  function specSlotToBv(slot: number): number {
    switch (slot) {
      case 1: return -0.2;  // O/B
      case 2: return 0.05;  // A
      case 3: return 0.45;  // F
      case 4: return 0.65;  // G
      case 5: return 1.15;  // K
      case 6: return 1.6;   // M
      default: return 0.4;
    }
  }

  /** Ballesteros (2012) B–V → effective temperature. */
  function bvToKelvin(bv: number): number {
    const b = clamp(-0.4, bv, 2.0);
    return 4600 * (1 / (0.92 * b + 1.7) + 1 / (0.92 * b + 0.62));
  }

  /** Blackbody colour temperature → sRGB (Tanner Helland fit), normalised to peak channel 255. */
  function kelvinToRgb(kelvin: number): [number, number, number] {
    const t = clamp(10, kelvin, 40000) / 100;
    const r = t <= 66 ? 255 : 329.698727446 * Math.pow(t - 60, -0.1332047592);
    const g = t <= 66
      ? 99.4708025861 * Math.log(t) - 161.1195681661
      : 288.1221695283 * Math.pow(t - 60, -0.0755148492);
    const b = t >= 66 ? 255 : t <= 19 ? 0 : 138.5177312231 * Math.log(t - 10) - 305.0447927307;
    const cr = clamp(0, r, 255);
    const cg = clamp(0, g, 255);
    const cb = clamp(0, b, 255);
    const peak = Math.max(cr, cg, cb, 1);
    return [cr * 255 / peak, cg * 255 / peak, cb * 255 / peak];
  }

  /**
   * Human colour perception of stars: only bright stars excite enough cone response
   * to look coloured; faint stars read as near-white (scotopic / rod vision).
   */
  function perceivedSaturation(mag: number): number {
    return clamp(0.12, 0.3 + (3.5 - mag) * 0.14, 0.9);
  }

  function starTintRgb(bv: number, saturation: number): [number, number, number] {
    const [r, g, b] = kelvinToRgb(bvToKelvin(bv));
    const n: [number, number, number] = [255, 251, 246]; // neutral "white" star
    return [
      n[0] + (r - n[0]) * saturation,
      n[1] + (g - n[1]) * saturation,
      n[2] + (b - n[2]) * saturation
    ];
  }

  // Pre-rendered PSF sprites (one mip ladder per quantised colour) so every star gets a
  // physically shaped glow without per-frame gradient allocation or sub-pixel aliasing.
  const STAR_SPRITE_SIZES = [8, 16, 32, 64, 128];
  /** Sprite half-size as a multiple of the star's visual core radius. */
  const STAR_SPRITE_EXTENT = 5;
  const starSpriteCache = new Map<number, HTMLCanvasElement>();

  function getStarSprite(bv: number, saturation: number, drawSize: number): HTMLCanvasElement {
    const bvQ = Math.round((clamp(-0.4, bv, 2.0) + 0.4) * 20); // 0..48
    const satQ = Math.round(clamp(0, saturation, 1) * 10);     // 0..10
    let level = 0;
    while (level < STAR_SPRITE_SIZES.length - 1 && STAR_SPRITE_SIZES[level] < drawSize) level++;
    const key = (bvQ * 11 + satQ) * 8 + level;
    let sprite = starSpriteCache.get(key);
    if (!sprite) {
      sprite = renderStarSprite(starTintRgb(bvQ / 20 - 0.4, satQ / 10), STAR_SPRITE_SIZES[level]);
      starSpriteCache.set(key, sprite);
    }
    return sprite;
  }

  /**
   * Gaussian seeing core + Moffat-like scattered-light halo, supersampled 3×3.
   * The centre is pushed toward white (detector / retina saturation) while the halo
   * carries the star's spectral tint.
   */
  function renderStarSprite(rgb: [number, number, number], size: number): HTMLCanvasElement {
    const canvas = document.createElement('canvas');
    canvas.width = size;
    canvas.height = size;
    const g = canvas.getContext('2d')!;
    const img = g.createImageData(size, size);
    const data = img.data;
    const half = size / 2;
    const SS = 3;
    const coreSigma2 = 2 * 0.11 * 0.11;
    const haloW2 = 0.2 * 0.2;

    for (let y = 0; y < size; y++) {
      for (let x = 0; x < size; x++) {
        let core = 0;
        let halo = 0;
        for (let sy = 0; sy < SS; sy++) {
          for (let sx = 0; sx < SS; sx++) {
            const dx = (x + (sx + 0.5) / SS - half) / half;
            const dy = (y + (sy + 0.5) / SS - half) / half;
            const u2 = dx * dx + dy * dy;
            if (u2 >= 1) continue;
            const fade = (1 - u2) * (1 - u2);
            core += Math.exp(-u2 / coreSigma2) * fade;
            halo += 0.3 * Math.pow(1 + u2 / haloW2, -1.3) * fade;
          }
        }
        core /= SS * SS;
        halo /= SS * SS;
        const a = Math.min(1, core + halo);
        const hot = Math.min(1, core * 0.7);
        const idx = (y * size + x) * 4;
        data[idx] = rgb[0] + (255 - rgb[0]) * hot;
        data[idx + 1] = rgb[1] + (255 - rgb[1]) * hot;
        data[idx + 2] = rgb[2] + (255 - rgb[2]) * hot;
        data[idx + 3] = a * 255;
      }
    }
    g.putImageData(img, 0, 0);
    return canvas;
  }

  // ---------------------------------------------------------------------------
  // Deep-Sky Galaxy Morphology Generator & Phenotypic Genome
  // ---------------------------------------------------------------------------

  interface GalaxyKnot {
    theta: number;
    rNorm: number;
    size: number;
    isH2: boolean; // true = H II ionized hydrogen (ruby/rose), false = young OB star cluster (azure/cyan)
  }

  interface GalaxyMorphology {
    hubbleType: 'grand_design' | 'barred_spiral' | 'flocculent' | 'edge_on' | 'elliptical' | 'lenticular' | 'irregular';
    hubbleNotation: string;
    inclinationDeg: number;
    incRad: number;
    cosI: number;
    pa: number;
    winding: number;
    armCount: number;
    pitch: number;
    bulgeRatio: number;
    barLength: number;
    barAngle: number;
    dustOpacity: number;
    dustAsymmetry: number;
    knots: GalaxyKnot[];
    coreRgbDark: [number, number, number];
    discRgbDark: [number, number, number];
    coreRgbLight: [number, number, number];
    discRgbLight: [number, number, number];
  }

  function deriveGalaxyGenome(seedVal: number, rawType = 'S', label = ''): GalaxyMorphology {
    let seed = Math.abs(seedVal);
    const nextRnd = () => {
      seed = (seed * 9301 + 49297) % 233280;
      return seed / 233280;
    };

    const cleanLabel = (label || '').toUpperCase();
    const type = (rawType || 'S').toUpperCase();

    // Iconic astrophysical archetypes
    const isM31 = cleanLabel.includes('M31') || cleanLabel.includes('ANDROMEDA');
    const isM51 = cleanLabel.includes('M51') || cleanLabel.includes('WHIRLPOOL');
    const isM104 = cleanLabel.includes('M104') || cleanLabel.includes('SOMBRERO');
    const isM82 = cleanLabel.includes('M82') || cleanLabel.includes('CIGAR');
    const isM33 = cleanLabel.includes('M33') || cleanLabel.includes('TRIANGULUM');
    const isM101 = cleanLabel.includes('M101') || cleanLabel.includes('PINWHEEL');
    const isM81 = cleanLabel.includes('M81') || cleanLabel.includes('BODE');
    const isM87 = cleanLabel.includes('M87');

    let hubbleType: GalaxyMorphology['hubbleType'] = 'grand_design';
    let hubbleNotation = 'Sc';
    let inclinationDeg = 35;

    if (isM104) {
      hubbleType = 'edge_on';
      hubbleNotation = 'Sa (Edge-on Sombrero)';
      inclinationDeg = 84;
    } else if (isM51 || isM101) {
      hubbleType = 'grand_design';
      hubbleNotation = isM51 ? 'Sc I (Face-on)' : 'Scd (Pinwheel)';
      inclinationDeg = isM51 ? 21 : 18;
    } else if (isM31) {
      hubbleType = 'grand_design';
      hubbleNotation = 'Sb I-II (Andromeda)';
      inclinationDeg = 77;
    } else if (isM81) {
      hubbleType = 'grand_design';
      hubbleNotation = 'Sb (Bode)';
      inclinationDeg = 59;
    } else if (isM82) {
      hubbleType = 'irregular';
      hubbleNotation = 'I0 (Starburst Cigar)';
      inclinationDeg = 80;
    } else if (isM33) {
      hubbleType = 'flocculent';
      hubbleNotation = 'SA(s)cd (Triangulum)';
      inclinationDeg = 54;
    } else if (isM87 || type === 'E') {
      hubbleType = nextRnd() < 0.25 ? 'lenticular' : 'elliptical';
      const ellClass = Math.floor(nextRnd() * 6);
      hubbleNotation = hubbleType === 'lenticular' ? 'S0' : `E${ellClass}`;
      inclinationDeg = 20 + nextRnd() * 55;
    } else if (type === 'I' || type === 'IRR') {
      hubbleType = 'irregular';
      hubbleNotation = 'dIrr / Sm';
      inclinationDeg = 25 + nextRnd() * 55;
    } else {
      // Cosmological morphological distribution for field galaxies:
      // ~35% Barred Spirals (SB), ~30% Grand Design (S), ~15% Flocculent, ~12% Edge-on, ~8% Lenticular
      const roll = nextRnd();
      if (roll < 0.35) {
        hubbleType = 'barred_spiral';
        hubbleNotation = nextRnd() < 0.5 ? 'SBb' : 'SBc';
        inclinationDeg = 25 + nextRnd() * 50;
      } else if (roll < 0.65) {
        hubbleType = 'grand_design';
        hubbleNotation = nextRnd() < 0.5 ? 'Sb' : 'Sc';
        inclinationDeg = 20 + nextRnd() * 55;
      } else if (roll < 0.80) {
        hubbleType = 'flocculent';
        hubbleNotation = 'SAb (Flocculent)';
        inclinationDeg = 25 + nextRnd() * 50;
      } else if (roll < 0.92) {
        hubbleType = 'edge_on';
        hubbleNotation = nextRnd() < 0.5 ? 'Sb (Edge-on)' : 'S0 (Spindle)';
        inclinationDeg = 82 + nextRnd() * 6; // 82 to 88 degrees
      } else {
        hubbleType = 'lenticular';
        hubbleNotation = 'S0/a';
        inclinationDeg = 30 + nextRnd() * 45;
      }
    }

    const incRad = (inclinationDeg * Math.PI) / 180;
    const cosI = Math.max(0.12, Math.cos(incRad));
    const pa = nextRnd() * Math.PI; // Position angle
    const winding = nextRnd() < 0.5 ? 1 : -1;
    const armCount = hubbleType === 'flocculent' ? (nextRnd() < 0.5 ? 3 : 4) : 2;
    const pitch = 0.22 + nextRnd() * 0.14; // Tightness
    const bulgeRatio = (hubbleType === 'edge_on' && isM104) ? 0.48 : (0.20 + nextRnd() * 0.25);
    const barLength = hubbleType === 'barred_spiral' ? 0.32 + nextRnd() * 0.16 : 0;
    const barAngle = (nextRnd() - 0.5) * 1.2;
    const dustOpacity = 0.45 + nextRnd() * 0.4;
    const dustAsymmetry = nextRnd() < 0.5 ? 1 : -1; // near-side tilt

    // Pre-generate starburst H II and OB knots
    const knotCount = (hubbleType === 'elliptical' || hubbleType === 'lenticular')
      ? 0
      : Math.floor(12 + nextRnd() * 16);

    const knots: GalaxyKnot[] = [];
    for (let k = 0; k < knotCount; k++) {
      const t = 0.25 + nextRnd() * 0.70;
      const arm = Math.floor(nextRnd() * armCount);
      const armBasePhase = (arm * 2 * Math.PI) / armCount;
      const thetaArm = armBasePhase + winding * Math.log(t / 0.15) / Math.tan(pitch);
      const thetaJitter = (nextRnd() - 0.5) * 0.22;
      const theta = thetaArm + thetaJitter;
      const rJitter = (nextRnd() - 0.5) * 0.15;
      const rNorm = Math.max(0.18, Math.min(0.98, t + rJitter));
      const size = 0.8 + nextRnd() * 1.4;
      const isH2 = nextRnd() < 0.45;
      knots.push({ theta, rNorm, size, isH2 });
    }

    // Stellar population color gradients
    const coreRgbDark: [number, number, number] = [255, 240, 210]; // warm Pop II
    const discRgbDark: [number, number, number] = (hubbleType === 'elliptical' || hubbleType === 'lenticular')
      ? [245, 230, 205]
      : [180, 212, 255]; // Pop I starlight
    const coreRgbLight: [number, number, number] = [45, 36, 30]; // archival umber
    const discRgbLight: [number, number, number] = [115, 88, 65]; // sepia wash

    return {
      hubbleType,
      hubbleNotation,
      inclinationDeg,
      incRad,
      cosI,
      pa,
      winding,
      armCount,
      pitch,
      bulgeRatio,
      barLength,
      barAngle,
      dustOpacity,
      dustAsymmetry,
      knots,
      coreRgbDark,
      discRgbDark,
      coreRgbLight,
      discRgbLight
    };
  }

  if (!customElements.get('drc-constellation-canvas')) {
    customElements.define('drc-constellation-canvas', DrcConstellationCanvas);
  }
</script>
