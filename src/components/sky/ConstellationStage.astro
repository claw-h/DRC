---
interface Props {
  featuredConstellationId?: string | null;
}

const { featuredConstellationId = null } = Astro.props;
---

<div class="sky-backdrop">
  <!-- Smaller Recessed 99th-Degree CRT Fisheye Observatory Tube -->
  <div class="crt-fisheye-stage-center">
    <div class="crt-tube-chassis">
      <!-- Machined Corner Bolts on the CRT Housing -->
      <span class="crt-bolt crt-bolt--tl" aria-hidden="true"></span>
      <span class="crt-bolt crt-bolt--tr" aria-hidden="true"></span>
      <span class="crt-bolt crt-bolt--bl" aria-hidden="true"></span>
      <span class="crt-bolt crt-bolt--br" aria-hidden="true"></span>

      <!-- Top CRT Bezel Engraving -->
      <div class="crt-bezel-top" aria-hidden="true">
        <span class="crt-bezel-tag tabular">CATHODE_OPTICS // 180° FISHEYE DOME · k₁ = +3.35</span>
        <span class="crt-bezel-tag crt-bezel-tag--warn tabular" id="crt-anomaly-readout">
          POSS-1954 // UNREDACTED PLATE
        </span>
      </div>

      <!-- The Curved 99th-Degree CRT Tube Viewport -->
      <div class="crt-tube-aperture">
        <drc-constellation-canvas
          data-featured-id={featuredConstellationId ?? ''}
          style="display: block; inline-size: 100%; block-size: 100%; position: relative;"
        >
          <canvas
            id="sky-nebula-layer"
            style="position: absolute; inset: 0; inline-size: 100%; block-size: 100%; pointer-events: none;"
          ></canvas>
          <canvas
            id="sky-artefact-layer"
            class="sky-interactive-canvas"
            style="position: absolute; inset: 0; inline-size: 100%; block-size: 100%; will-change: transform;"
          ></canvas>
        </drc-constellation-canvas>

        <!-- Optical CRT Shadow-Mask & Curved Glass Dome Reflections -->
        <div class="crt-glass-dome-overlay" aria-hidden="true"></div>
      </div>

      <!-- Bottom CRT Bezel Vernier Scale -->
      <div class="crt-bezel-bottom" aria-hidden="true">
        <span class="crt-bezel-sub tabular">PALOMAR SCHMIDT 48-IN · AGFA 103a-E EMULSION</span>
        <span class="crt-bezel-sub tabular">ANODE 27.5 kV // SPHERICAL ABERRATION: 99TH DEG</span>
      </div>
    </div>
  </div>
</div>

<!-- Stage 1 Foreground HUD: Vault Telemetry, Constellation Title, Inset Node Popup & Controls -->
<section id="stage-1" class="snap-stage stage-sky-hud" aria-label="Celestial Cartography">
  <!-- Interactive Inset-Map Star Node Popup -->
  <div id="star-inset-popup" class="star-inset-popup" hidden>
    <svg class="inset-connector" viewBox="0 0 28 12" aria-hidden="true">
      <line x1="0" y1="6" x2="24" y2="6" stroke="rgba(232,222,181,0.45)" stroke-width="1" stroke-dasharray="3 3" />
      <circle cx="0" cy="6" r="2.2" fill="rgba(232,222,181,0.75)" />
    </svg>
    <div class="inset-card">
      <div class="inset-card-header">
        <div class="inset-header-left">
          <span class="inset-pulse-dot"></span>
          <span class="inset-kicker" id="inset-star-designation">ASTROMETRIC_LOG // α</span>
        </div>
        <div class="inset-header-right">
          <span class="inset-mag" id="inset-star-mag">MAG 0.62</span>
          <button type="button" id="inset-close-btn" class="inset-close-btn" aria-label="Close star telemetry">✕</button>
        </div>
      </div>

      <div class="inset-visual-box">
        <div class="inset-scanlines"></div>
        <div class="inset-reticle inset-reticle--tl"></div>
        <div class="inset-reticle inset-reticle--tr"></div>
        <div class="inset-reticle inset-reticle--bl"></div>
        <div class="inset-reticle inset-reticle--br"></div>
        <div class="inset-star-preview" id="inset-star-preview"></div>
        <div class="inset-visual-caption">
          <span class="inset-caption-sub" id="inset-star-spectral">SPECTRAL CLASS B2V · 18,500 K</span>
          <h3 class="inset-caption-title" id="inset-star-title">Alpha Vela Minor</h3>
        </div>
      </div>

      <div class="inset-card-footer">
        <span class="inset-coords" id="inset-star-coords">RA 09h 36m · DEC +22° 19'</span>
        <div class="inset-flux-meter">
          <div class="inset-flux-bar">
            <div class="inset-flux-fill" id="inset-flux-fill" style="width: 88%;"></div>
          </div>
          <span class="inset-flux-val" id="inset-flux-val">88% LUM</span>
        </div>
      </div>
    </div>
  </div>

  <div class="sky-hud-bottom-row">
    <!-- Left: Telemetry Block + Mythological Designation -->
    <div class="sky-hud-bottom-left">
      <div class="vault-telemetry-box">
        <div class="telemetry-line">
          <span class="telemetry-key">TELEMETRY_STATUS:</span>
          <span class="telemetry-val telemetry-val--ok" id="hud-telemetry-status">ACTIVE // J2000.0</span>
        </div>
        <div class="telemetry-line">
          <span class="telemetry-key">CATALOG_ARTIFACT:</span>
          <span class="telemetry-val" id="hud-constellation-id">DRC-0001</span>
          <span class="telemetry-sep">|</span>
          <span class="telemetry-key">STARS:</span>
          <span class="telemetry-val" id="hud-node-count">6 NODES</span>
        </div>
        <div class="telemetry-line">
          <span class="telemetry-key">NEBULA_FIELD:</span>
          <span class="telemetry-val" id="hud-nebula-designation">NGC 2244 · H II Balmer Emission Nursery</span>
        </div>
        <div class="telemetry-line">
          <span class="telemetry-key">MODE:</span>
          <span class="telemetry-val" id="hud-orbital-mode">ORBITAL_AUTOPILOT</span>
          <span class="telemetry-sep">|</span>
          <span class="telemetry-key">SPIN:</span>
          <span class="telemetry-val" id="hud-spin-speed">0.008°/f</span>
        </div>
      </div>

      <div class="sky-title-cluster" id="sky-title-cluster">
        <h1 class="sky-hud-name" id="hud-constellation-name">Vela Minor</h1>
        <p class="sky-hud-meaning" id="hud-constellation-meaning">The Celestial Sail of the Lesser Arc</p>
        <p class="sky-hud-coords tabular" id="hud-constellation-coords">
          RA 09h 36m 12.1s · DEC +22° 19' 06"
        </p>
      </div>

      <div class="sky-micro-controls">
        <button type="button" id="btn-auto-rotate" class="vault-pill-btn is-active">
          [ AUTO: ON ]
        </button>
        <button type="button" id="btn-meteor-shower" class="vault-pill-btn" title="Trigger bolide meteor transit">
          [ ☄ METEOR TRANSIT ]
        </button>
        <span class="vault-hint">Drag CRT dome to slew · Click α/β nodes · Scroll to enter archive</span>
      </div>
    </div>

    <!-- Right: Action Controls -->
    <div class="sky-hud-bottom-right">
      <button
        type="button"
        class="sky-hud-btn tabular"
        id="btn-new-constellation"
        title="Draw another constellation from the 1,000-entry catalog"
      >
        ↻ Redraw Sky
      </button>
      <button
        type="button"
        class="sky-hud-btn tabular"
        id="btn-copy-sky-link"
        title="Copy permalink to this exact constellation"
      >
        ⌖ Permalink
      </button>
      <button
        type="button"
        class="sky-hud-btn tabular"
        id="btn-export-chart"
        title="Export high-resolution PNG Star Chart"
      >
        ↓ Export Star Chart
      </button>
      <a href="#stage-2" class="sky-scroll-cue tabular" aria-label="Scroll down to Duncan R. Cordry archive">
        SCROLL TO ENTER ARCHIVE ↓
      </a>
    </div>
  </div>
</section>

<style>
  /* Centered Smaller Constellation CRT Zone inside .sky-backdrop */
  .crt-fisheye-stage-center {
    position: absolute;
    inset-inline: 0;
    inset-block-start: calc(var(--header-height) + 0.75rem);
    inset-block-end: clamp(11.5rem, 25vh, 14.5rem);
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: clamp(1rem, 3vw, 2.5rem);
    pointer-events: none;
  }

  .crt-tube-chassis {
    pointer-events: auto;
    position: relative;
    inline-size: min(74vw, 790px);
    block-size: min(50vh, 435px);
    min-block-size: 270px;
    padding: 0.7rem 0.95rem;
    border-radius: 38px / 32px;
    background:
      radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.05), transparent 60%),
      linear-gradient(180deg, #10141d 0%, #06080d 55%, #090c12 100%);
    border: 1px solid rgba(218, 195, 142, 0.22);
    box-shadow:
      0 28px 80px -12px rgba(0, 0, 0, 0.92),
      0 0 45px rgba(127, 212, 255, 0.04),
      inset 0 2px 3px rgba(255, 255, 255, 0.08),
      inset 0 -6px 18px rgba(0, 0, 0, 0.95);
    display: flex;
    flex-direction: column;
    gap: 0.38rem;
  }

  @media (max-width: 768px) {
    .crt-fisheye-stage-center {
      inset-block-start: calc(var(--header-height) + 0.4rem);
      inset-block-end: 15.5rem;
    }
    .crt-tube-chassis {
      inline-size: min(92vw, 680px);
      block-size: min(42vh, 340px);
      min-block-size: 220px;
      padding: 0.55rem 0.7rem;
      border-radius: 28px / 24px;
    }
  }

  .crt-bolt {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #8493a8, #1d242e 75%, #05070b 100%);
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.35),
      0 1px 2px rgba(0, 0, 0, 0.85);
    pointer-events: none;
  }
  .crt-bolt--tl { top: 12px; left: 14px; }
  .crt-bolt--tr { top: 12px; right: 14px; }
  .crt-bolt--bl { bottom: 12px; left: 14px; }
  .crt-bolt--br { bottom: 12px; right: 14px; }

  .crt-bezel-top,
  .crt-bezel-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-inline: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.16em;
    color: rgba(232, 222, 181, 0.52);
    user-select: none;
  }

  .crt-bezel-tag--warn {
    color: #7fd4ff;
    text-shadow: 0 0 8px rgba(127, 212, 255, 0.35);
  }

  .crt-bezel-sub {
    color: rgba(255, 255, 255, 0.28);
  }

  /* Barrel-Bowed Cathode-Ray Tube Aperture */
  .crt-tube-aperture {
    position: relative;
    flex: 1 1 0%;
    min-block-size: 0;
    inline-size: 100%;
    /* Bowed CRT television/oscilloscope tube silhouette */
    border-radius: 44% / 14%;
    overflow: hidden;
    background: #020307;
    border: 1.5px solid rgba(218, 195, 142, 0.28);
    box-shadow:
      inset 0 0 48px 16px rgba(0, 0, 0, 0.96),
      inset 0 0 14px 2px rgba(127, 212, 255, 0.12),
      0 0 1px 1px rgba(0, 0, 0, 0.95);
    isolation: isolate;
  }

  /* Physical CRT Glass Bulge Specular Highlight & Shadow Mask */
  .crt-glass-dome-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 4;
    border-radius: inherit;
    background:
      /* Upper-left convex glass dome specular reflection */
      radial-gradient(
        65% 42% at 32% 18%,
        rgba(255, 255, 255, 0.065) 0%,
        rgba(195, 228, 255, 0.02) 45%,
        transparent 75%
      ),
      /* CRT RGB Phosphor Triad Aperture Grille */
      repeating-linear-gradient(
        90deg,
        rgba(255, 40, 40, 0.018) 0px,
        rgba(40, 255, 120, 0.018) 1px,
        rgba(60, 140, 255, 0.018) 2px,
        rgba(0, 0, 0, 0.08) 3px
      ),
      /* Deep CRT Rim Curvature Falloff */
      radial-gradient(
        56% 56% at 50% 50%,
        transparent 58%,
        rgba(2, 4, 9, 0.48) 82%,
        rgba(1, 2, 5, 0.92) 100%
      );
    box-shadow:
      inset 0 0 32px rgba(0, 0, 0, 0.92),
      inset 0 1px 2px rgba(255, 255, 255, 0.14);
  }

  .sky-interactive-canvas {
    cursor: crosshair;
  }

  .stage-sky-hud {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1rem, 2.5vw, 2rem) clamp(1.25rem, 3.5vw, 2.75rem);
    padding-block-end: calc(clamp(1rem, 2.5vh, 1.85rem) + env(safe-area-inset-bottom, 0px));
    z-index: 5;
    pointer-events: none;
  }

  .sky-hud-bottom-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem;
    width: 100%;
  }

  .sky-hud-bottom-left {
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    max-inline-size: 36rem;
  }

  .vault-telemetry-box {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    line-height: 1.48;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary);
    background: rgba(5, 7, 12, 0.72);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(232, 222, 181, 0.16);
    box-shadow:
      0 0 20px rgba(232, 222, 181, 0.06),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    padding: 0.5rem 0.8rem;
    border-radius: 0.35rem;
    width: fit-content;
  }

  .telemetry-line {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .telemetry-key {
    color: var(--text-muted);
  }

  .telemetry-val {
    color: #e8deb5;
    font-weight: 600;
  }

  .telemetry-val--ok {
    color: #5effa4;
    text-shadow: 0 0 6px rgba(94, 255, 164, 0.45);
  }

  .telemetry-sep {
    color: rgba(255, 255, 255, 0.18);
  }

  .sky-title-cluster {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    opacity: 1;
    transform: translate3d(0, 0, 0);
    transition:
      opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sky-title-cluster.is-slew-fading {
    opacity: 0;
    transform: translate3d(0, 6px, 0);
  }

  .sky-hud-name {
    font-family: var(--font-serif);
    font-size: clamp(1.65rem, 3.4vw, 2.55rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    margin: 0;
    color: var(--text-primary);
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.85);
  }

  .sky-hud-meaning {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(0.88rem, 1.3vw, 1.05rem);
    color: var(--text-secondary);
    margin: 0;
  }

  .sky-hud-coords {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    margin: 0.1rem 0 0;
  }

  .sky-micro-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
  }

  .vault-pill-btn {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 0.34rem 0.65rem;
    border-radius: 0.25rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(5, 7, 12, 0.55);
    color: var(--text-muted);
    backdrop-filter: blur(8px);
    cursor: pointer;
    transition: all 0.4s ease;
  }

  .vault-pill-btn.is-active,
  .vault-pill-btn:hover {
    border-color: rgba(232, 222, 181, 0.45);
    color: #e8deb5;
    background: rgba(232, 222, 181, 0.08);
    box-shadow: 0 0 12px rgba(232, 222, 181, 0.12);
  }

  .vault-hint {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.32);
  }

  .sky-hud-bottom-right {
    pointer-events: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
  }

  .sky-hud-btn {
    min-block-size: 2.35rem;
    padding-inline: 0.8rem;
    border-radius: 0.35rem;
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklab, var(--bg-surface) 75%, transparent);
    backdrop-filter: blur(10px);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color 0.35s ease, color 0.35s ease, transform 0.35s ease;
  }

  .sky-hud-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-1px);
  }

  .sky-scroll-cue {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.35rem;
    padding-inline: 0.9rem;
    border-radius: 0.35rem;
    border: 1px solid color-mix(in oklab, var(--accent) 50%, transparent);
    background: color-mix(in oklab, var(--accent) 14%, transparent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-decoration: none;
  }

  .star-inset-popup {
    position: fixed;
    z-index: 45;
    width: 310px;
    pointer-events: auto;
    animation: inset-map-open 0.65s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    transform-origin: top left;
  }

  @keyframes inset-map-open {
    0% {
      opacity: 0;
      transform: scale(0.9) translateY(8px);
      clip-path: inset(0% 0% 100% 0% round 10px);
    }
    60% {
      clip-path: inset(0% 0% 0% 0% round 10px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
      clip-path: inset(0% 0% 0% 0% round 10px);
    }
  }

  .inset-connector {
    position: absolute;
    top: 42px;
    left: -24px;
    width: 28px;
    height: 12px;
    overflow: visible;
    pointer-events: none;
  }

  .inset-card {
    border-radius: 0.65rem;
    overflow: hidden;
    border: 1px solid rgba(232, 222, 181, 0.28);
    background: rgba(7, 8, 15, 0.94);
    backdrop-filter: blur(20px);
    box-shadow:
      0 0 0 1px rgba(232, 222, 181, 0.06),
      0 20px 55px rgba(0, 0, 0, 0.88);
  }

  .inset-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(255, 255, 255, 0.025);
  }

  .inset-header-left {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .inset-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #e8deb5;
    box-shadow: 0 0 8px #e8deb5;
  }

  .inset-kicker {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.28em;
    color: #e8deb5;
    text-transform: uppercase;
  }

  .inset-header-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .inset-mag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 0.12em;
  }

  .inset-close-btn {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    border: none;
    background: transparent;
    color: rgba(255, 255, 255, 0.4);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    cursor: pointer;
  }

  .inset-close-btn:hover {
    color: #e8deb5;
    background: rgba(255, 255, 255, 0.08);
  }

  .inset-visual-box {
    position: relative;
    height: 128px;
    background: radial-gradient(circle at 50% 42%, #151b2c 0%, #05070c 100%);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .inset-scanlines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.22;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 1px,
      #000 1px,
      #000 2px
    );
  }

  .inset-reticle {
    position: absolute;
    width: 10px;
    height: 10px;
    border-color: rgba(232, 222, 181, 0.55);
    pointer-events: none;
  }
  .inset-reticle--tl { top: 6px; left: 6px; border-top: 1px solid; border-left: 1px solid; }
  .inset-reticle--tr { top: 6px; right: 6px; border-top: 1px solid; border-right: 1px solid; }
  .inset-reticle--bl { bottom: 6px; left: 6px; border-bottom: 1px solid; border-left: 1px solid; }
  .inset-reticle--br { bottom: 6px; right: 6px; border-bottom: 1px solid; border-right: 1px solid; }

  .inset-star-preview {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 12px 4px #fff,
      0 0 32px 12px rgba(232, 222, 181, 0.75);
    transform: translateY(-10px);
  }

  .inset-visual-caption {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 0.5rem 0.85rem;
    background: linear-gradient(to top, rgba(7, 8, 15, 0.96), transparent);
  }

  .inset-caption-sub {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    color: #7fd4ff;
    margin-bottom: 0.15rem;
  }

  .inset-caption-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 0.98rem;
    font-weight: 500;
    color: #f5f5f0;
  }

  .inset-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 0.85rem;
