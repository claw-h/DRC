---
interface Props {
  featuredConstellationId?: string | null;
}

const { featuredConstellationId = null } = Astro.props;
---

<div class="sky-backdrop">
  <drc-constellation-canvas
    data-featured-id={featuredConstellationId ?? ''}
    style="display: block; inline-size: 100%; block-size: 100%; position: relative;"
  >
    <canvas
      id="sky-nebula-layer"
      style="position: absolute; inset: 0; inline-size: 100%; block-size: 100%; pointer-events: none;"
    ></canvas>
    <canvas
      id="sky-artefact-layer"
      class="sky-interactive-canvas"
      style="position: absolute; inset: 0; inline-size: 100%; block-size: 100%; will-change: transform;"
    ></canvas>
  </drc-constellation-canvas>
</div>

<!-- Stage 1 Foreground HUD: Vault Telemetry, Constellation Title, Inset Node Popup & Controls -->
<section id="stage-1" class="snap-stage stage-sky-hud" aria-label="Celestial Cartography">
  <!-- Interactive Inset-Map Star Node Popup -->
  <div id="star-inset-popup" class="star-inset-popup" hidden>
    <svg class="inset-connector" viewBox="0 0 28 12" aria-hidden="true">
      <line x1="0" y1="6" x2="24" y2="6" stroke="rgba(232,222,181,0.45)" stroke-width="1" stroke-dasharray="3 3" />
      <circle cx="0" cy="6" r="2.2" fill="rgba(232,222,181,0.75)" />
    </svg>
    <div class="inset-card">
      <div class="inset-card-header">
        <div class="inset-header-left">
          <span class="inset-pulse-dot"></span>
          <span class="inset-kicker" id="inset-star-designation">ASTROMETRIC_LOG // α</span>
        </div>
        <div class="inset-header-right">
          <span class="inset-mag" id="inset-star-mag">MAG 0.62</span>
          <button type="button" id="inset-close-btn" class="inset-close-btn" aria-label="Close star telemetry">✕</button>
        </div>
      </div>

      <div class="inset-visual-box">
        <div class="inset-scanlines"></div>
        <div class="inset-reticle inset-reticle--tl"></div>
        <div class="inset-reticle inset-reticle--tr"></div>
        <div class="inset-reticle inset-reticle--bl"></div>
        <div class="inset-reticle inset-reticle--br"></div>
        <div class="inset-star-preview" id="inset-star-preview"></div>
        <div class="inset-visual-caption">
          <span class="inset-caption-sub" id="inset-star-spectral">SPECTRAL CLASS B2V · 18,500 K</span>
          <h3 class="inset-caption-title" id="inset-star-title">Alpha Vela Minor</h3>
        </div>
      </div>

      <div class="inset-card-footer">
        <span class="inset-coords" id="inset-star-coords">RA 09h 36m · DEC +22° 19'</span>
        <div class="inset-flux-meter">
          <div class="inset-flux-bar">
            <div class="inset-flux-fill" id="inset-flux-fill" style="width: 88%;"></div>
          </div>
          <span class="inset-flux-val" id="inset-flux-val">88% LUM</span>
        </div>
      </div>
    </div>
  </div>

  <div class="sky-hud-bottom-row">
    <!-- Left: Telemetry Block + Mythological Designation -->
    <div class="sky-hud-bottom-left">
      <div class="vault-telemetry-box">
        <div class="telemetry-line">
          <span class="telemetry-key">TELEMETRY_STATUS:</span>
          <span class="telemetry-val telemetry-val--ok" id="hud-telemetry-status">ACTIVE // J2000.0</span>
        </div>
        <div class="telemetry-line">
          <span class="telemetry-key">CATALOG_ARTIFACT:</span>
          <span class="telemetry-val" id="hud-constellation-id">DRC-0001</span>
          <span class="telemetry-sep">|</span>
          <span class="telemetry-key">STARS:</span>
          <span class="telemetry-val" id="hud-node-count">6 NODES</span>
        </div>
        <div class="telemetry-line">
          <span class="telemetry-key">NEBULA_FIELD:</span>
          <span class="telemetry-val" id="hud-nebula-designation">NGC 2244 · H II Balmer Emission Nursery</span>
        </div>
        <div class="telemetry-line">
          <span class="telemetry-key">MODE:</span>
          <span class="telemetry-val" id="hud-orbital-mode">ORBITAL_AUTOPILOT</span>
          <span class="telemetry-sep">|</span>
          <span class="telemetry-key">SPIN:</span>
          <span class="telemetry-val" id="hud-spin-speed">0.008°/f</span>
        </div>
      </div>

      <div class="sky-title-cluster" id="sky-title-cluster">
        <h1 class="sky-hud-name" id="hud-constellation-name">Vela Minor</h1>
        <p class="sky-hud-meaning" id="hud-constellation-meaning">The Celestial Sail of the Lesser Arc</p>
        <p class="sky-hud-coords tabular" id="hud-constellation-coords">
          RA 09h 36m 12.1s · DEC +22° 19' 06"
        </p>
      </div>

      <div class="sky-micro-controls">
        <button type="button" id="btn-auto-rotate" class="vault-pill-btn is-active">
          [ AUTO: ON ]
        </button>
        <button type="button" id="btn-meteor-shower" class="vault-pill-btn" title="Trigger bolide meteor transit">
          [ ☄ METEOR TRANSIT ]
        </button>
        <span class="vault-hint">Drag sky to rotate · Click any α/β star node to inspect · Scroll to enter archive</span>
      </div>
    </div>

    <!-- Right: Action Controls -->
    <div class="sky-hud-bottom-right">
      <button
        type="button"
        class="sky-hud-btn tabular"
        id="btn-new-constellation"
        title="Draw another constellation from the 1,000-entry catalog"
      >
        ↻ Redraw Sky
      </button>
      <button
        type="button"
        class="sky-hud-btn tabular"
        id="btn-copy-sky-link"
        title="Copy permalink to this exact constellation"
      >
        ⌖ Permalink
      </button>
      <button
        type="button"
        class="sky-hud-btn tabular"
        id="btn-export-chart"
        title="Export high-resolution PNG Star Chart"
      >
        ↓ Export Star Chart
      </button>
      <a href="#stage-2" class="sky-scroll-cue tabular" aria-label="Scroll down to Duncan R. Cordry archive">
        SCROLL TO ENTER ARCHIVE ↓
      </a>
    </div>
  </div>
</section>

<style>
  .sky-interactive-canvas {
    cursor: crosshair;
  }

  .stage-sky-hud {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1.25rem, 3.5vw, 2.75rem);
    padding-block-end: calc(clamp(1.25rem, 3.5vh, 2.5rem) + env(safe-area-inset-bottom, 0px));
    z-index: 5;
    pointer-events: none;
  }

  .sky-hud-bottom-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
  }

  .sky-hud-bottom-left {
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    max-inline-size: 36rem;
  }

  .vault-telemetry-box {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.55;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary);
    background: rgba(5, 7, 12, 0.68);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(232, 222, 181, 0.16);
    box-shadow:
      0 0 20px rgba(232, 222, 181, 0.06),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    padding: 0.65rem 0.9rem;
    border-radius: 0.35rem;
    width: fit-content;
  }

  .telemetry-line {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .telemetry-key {
    color: var(--text-muted);
  }

  .telemetry-val {
    color: #e8deb5;
    font-weight: 600;
  }

  .telemetry-val--ok {
    color: #5effa4;
    text-shadow: 0 0 6px rgba(94, 255, 164, 0.45);
  }

  .telemetry-sep {
    color: rgba(255, 255, 255, 0.18);
  }

  .sky-title-cluster {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    opacity: 1;
    transform: translate3d(0, 0, 0);
    transition:
      opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sky-title-cluster.is-slew-fading {
    opacity: 0;
    transform: translate3d(0, 6px, 0);
  }

  .sky-hud-name {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4.5vw, 3.35rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    margin: 0;
    color: var(--text-primary);
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.85);
  }

  .sky-hud-meaning {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(0.95rem, 1.5vw, 1.15rem);
    color: var(--text-secondary);
    margin: 0;
  }

  .sky-hud-coords {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    margin: 0.15rem 0 0;
  }

  .sky-micro-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .vault-pill-btn {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 0.38rem 0.7rem;
    border-radius: 0.25rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(5, 7, 12, 0.55);
    color: var(--text-muted);
    backdrop-filter: blur(8px);
    cursor: pointer;
    transition: all 0.4s ease;
  }

  .vault-pill-btn.is-active,
  .vault-pill-btn:hover {
    border-color: rgba(232, 222, 181, 0.45);
    color: #e8deb5;
    background: rgba(232, 222, 181, 0.08);
    box-shadow: 0 0 12px rgba(232, 222, 181, 0.12);
  }

  .vault-hint {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.32);
  }

  .sky-hud-bottom-right {
    pointer-events: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .sky-hud-btn {
    min-block-size: 2.5rem;
    padding-inline: 0.85rem;
    border-radius: 0.35rem;
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklab, var(--bg-surface) 75%, transparent);
    backdrop-filter: blur(10px);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color 0.35s ease, color 0.35s ease, transform 0.35s ease;
  }

  .sky-hud-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-1px);
  }

  .sky-scroll-cue {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.5rem;
    padding-inline: 0.95rem;
    border-radius: 0.35rem;
    border: 1px solid color-mix(in oklab, var(--accent) 50%, transparent);
    background: color-mix(in oklab, var(--accent) 14%, transparent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-decoration: none;
  }

  .star-inset-popup {
    position: fixed;
    z-index: 45;
    width: 310px;
    pointer-events: auto;
    animation: inset-map-open 0.65s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    transform-origin: top left;
  }

  @keyframes inset-map-open {
    0% {
      opacity: 0;
      transform: scale(0.9) translateY(8px);
      clip-path: inset(0% 0% 100% 0% round 10px);
    }
    60% {
      clip-path: inset(0% 0% 0% 0% round 10px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
      clip-path: inset(0% 0% 0% 0% round 10px);
    }
  }

  .inset-connector {
    position: absolute;
    top: 42px;
    left: -24px;
    width: 28px;
    height: 12px;
    overflow: visible;
    pointer-events: none;
  }

  .inset-card {
    border-radius: 0.65rem;
    overflow: hidden;
    border: 1px solid rgba(232, 222, 181, 0.28);
    background: rgba(7, 8, 15, 0.94);
    backdrop-filter: blur(20px);
    box-shadow:
      0 0 0 1px rgba(232, 222, 181, 0.06),
      0 20px 55px rgba(0, 0, 0, 0.88);
  }

  .inset-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(255, 255, 255, 0.025);
  }

  .inset-header-left {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .inset-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #e8deb5;
    box-shadow: 0 0 8px #e8deb5;
  }

  .inset-kicker {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.28em;
    color: #e8deb5;
    text-transform: uppercase;
  }

  .inset-header-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .inset-mag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 0.12em;
  }

  .inset-close-btn {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    border: none;
    background: transparent;
    color: rgba(255, 255, 255, 0.4);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    cursor: pointer;
  }

  .inset-close-btn:hover {
    color: #e8deb5;
    background: rgba(255, 255, 255, 0.08);
  }

  .inset-visual-box {
    position: relative;
    height: 128px;
    background: radial-gradient(circle at 50% 42%, #151b2c 0%, #05070c 100%);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .inset-scanlines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.22;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 1px,
      #000 1px,
      #000 2px
    );
  }

  .inset-reticle {
    position: absolute;
    width: 10px;
    height: 10px;
    border-color: rgba(232, 222, 181, 0.55);
    pointer-events: none;
  }
  .inset-reticle--tl { top: 6px; left: 6px; border-top: 1px solid; border-left: 1px solid; }
  .inset-reticle--tr { top: 6px; right: 6px; border-top: 1px solid; border-right: 1px solid; }
  .inset-reticle--bl { bottom: 6px; left: 6px; border-bottom: 1px solid; border-left: 1px solid; }
  .inset-reticle--br { bottom: 6px; right: 6px; border-bottom: 1px solid; border-right: 1px solid; }

  .inset-star-preview {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 12px 4px #fff,
      0 0 32px 12px rgba(232, 222, 181, 0.75);
    transform: translateY(-10px);
  }

  .inset-visual-caption {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 0.5rem 0.85rem;
    background: linear-gradient(to top, rgba(7, 8, 15, 0.96), transparent);
  }

  .inset-caption-sub {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    color: #7fd4ff;
    margin-bottom: 0.15rem;
  }

  .inset-caption-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 0.98rem;
    font-weight: 500;
    color: #f5f5f0;
  }

  .inset-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 0.85rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .inset-flux-meter {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .inset-flux-bar {
    width: 54px;
    height: 3px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .inset-flux-fill {
    height: 100%;
    background: #e8deb5;
    box-shadow: 0 0 6px #e8deb5;
  }

  .inset-flux-val {
    color: #e8deb5;
  }
</style>

<script>
  const BAYER_GREEK = ['α', 'β', 'γ', 'δ', 'ε', 'ζ', 'η', 'θ', 'ι', 'κ', 'λ', 'μ', 'ν', 'ξ', 'ο', 'π'];
  const BAYER_NAMES = [
    'Alpha', 'Beta', 'Gamma', 'Delta', 'Epsilon', 'Zeta', 'Eta', 'Theta',
    'Iota', 'Kappa', 'Lambda', 'Mu', 'Nu', 'Xi', 'Omicron', 'Pi'
  ];

  // Maps spectral index (0..6 from generate-constellations.mjs) to Planckian RGB
  function specToPlanckianRgb(spec: number): [number, number, number] {
    if (spec <= 1) return [185, 212, 255]; // O/B Blue-White
    if (spec === 2) return [236, 243, 255]; // A White-Blue
    if (spec === 3) return [255, 249, 238]; // F Creamy White
    if (spec === 4) return [255, 235, 192]; // G Solar Gold
    if (spec === 5) return [255, 204, 145]; // K Amber
    return [255, 168, 120]; // M Ember Red
  }

  function specToLabel(spec: number): string {
    if (spec <= 1) return 'CLASS B2V · 18,500 K';
    if (spec === 2) return 'CLASS A1V · 9,400 K';
    if (spec === 3) return 'CLASS F5V · 6,500 K';
    if (spec === 4) return 'CLASS G2V · 5,780 K';
    if (spec === 5) return 'CLASS K3III · 4,300 K';
    return 'CLASS M2Iab · 3,450 K';
  }

  // Quintic smoothstep for zero-jerk transitions
  function quinticSmoothstep(t: number): number {
    const x = Math.max(0, Math.min(1, t));
    return x * x * x * (x * (x * 6 - 15) + 10);
  }

  // Fast deterministic 2D Value-Simplex Noise & Fractional Brownian Motion (fBm) for organic nebula synthesis
  class FractalNebulaNoise {
    private perm = new Uint8Array(512);

    constructor(seed: number) {
      const p = new Uint8Array(256);
      for (let i = 0; i < 256; i++) p[i] = i;
      let s = (seed >>> 0) || 1337;
      for (let i = 255; i > 0; i--) {
        s = (Math.imul(s, 1664525) + 1013904223) >>> 0;
        const j = s % (i + 1);
        const tmp = p[i];
        p[i] = p[j];
        p[j] = tmp;
      }
      for (let i = 0; i < 512; i++) this.perm[i] = p[i & 255];
    }

    public noise2D(x: number, y: number): number {
      const xi = Math.floor(x) & 255;
      const yi = Math.floor(y) & 255;
      const xf = x - Math.floor(x);
      const yf = y - Math.floor(y);

      const u = xf * xf * xf * (xf * (xf * 6 - 15) + 10);
      const v = yf * yf * yf * (yf * (yf * 6 - 15) + 10);

      const aa = this.perm[this.perm[xi] + yi];
      const ab = this.perm[this.perm[xi] + yi + 1];
      const ba = this.perm[this.perm[xi + 1] + yi];
      const bb = this.perm[this.perm[xi + 1] + yi + 1];

      const l1 = aa + u * (ba - aa);
      const l2 = ab + u * (bb - ab);
      return (l1 + v * (l2 - l1)) / 255;
    }

    // 4-octave Fractional Brownian Motion
    public fbm(x: number, y: number): number {
      let value = 0;
      let amp = 0.52;
      let freq = 1;
      for (let i = 0; i < 4; i++) {
        // Rotate octave slightly to eliminate grid alignment artifacts
        const rx = x * freq * 0.866 - y * freq * 0.5;
        const ry = x * freq * 0.5 + y * freq * 0.866;
        value += amp * this.noise2D(rx, ry);
        x += 17.3;
        y += 9.1;
        freq *= 2.07;
        amp *= 0.48;
      }
      return value;
    }

    // Ridged Multifractal for sharp, gossamer cosmic ionization filaments
    public ridged(x: number, y: number): number {
      let value = 0;
      let amp = 0.55;
      let freq = 1;
      let weight = 1;
      for (let i = 0; i < 3; i++) {
        const n = this.noise2D(x * freq, y * freq);
        let signal = 1 - Math.abs(n * 2 - 1);
        signal = signal * signal * weight;
        weight = Math.max(0, Math.min(1, signal * 1.8));
        value += signal * amp;
        freq *= 2.15;
        amp *= 0.45;
      }
      return value;
    }
  }

  type ProjectedStar = {
    idx: number;
    x: number;
    y: number;
    mag: number;
    spec: number;
    rgb: [number, number, number];
  };

  class DrcConstellationCanvas extends HTMLElement {
    private nebulaCanvas!: HTMLCanvasElement;
    private artefactCanvas!: HTMLCanvasElement;
    private aCtx!: CanvasRenderingContext2D;
    private rafId = 0;
    private catalogIndex: any[] = [];

    // Active & Outgoing Constellation States for Seamless Redraw Cross-Dissolve
    private currentConstellation: any = null;
    private outgoingConstellation: any = null;
    private currentNebulaPlanes: HTMLCanvasElement[] = [];
    private outgoingNebulaPlanes: HTMLCanvasElement[] = [];

    private drawProgress = 0;
    private outgoingDrawProgress = 1;
    private transitionBlend = 1; // 1 = stable; 0..1 = cross-dissolving from outgoing -> current
    private slewVX = 0;
    private slewVY = 0;
    private frameCount = 0;

    private backgroundStars: Array<{
      x: number;
      y: number;
      z: number;
      r: number;
      rgb: [number, number, number];
      phase1: number;
      speed1: number;
      phase2: number;
      speed2: number;
      threshold: number; // Controls fading completely in and out of the dark background
      maxAlpha: number;
      isSupernova: boolean;
    }> = [];
    private dustMotes: Array<{
      x: number;
      y: number;
      vx: number;
      vy: number;
      size: number;
      op: number;
      opDir: number;
    }> = [];
    private shootingStars: Array<{
      x: number;
      y: number;
      born: number;
    }> = [];

    // Slow, serene celestial rotation & inertia
    private rotX = 0;
    private rotY = 0;
    private vX = 0.00014;
    private vY = 0.00007;
    private autoRotate = true;
    private isDragging = false;
    private dragStart = { x: 0, y: 0 };
    private lastPointer = { x: -1000, y: -1000 };
    private zoom = 1;

    private hoveredStarIdx: number = -1;
    private selectedStarIdx: number = -1;
    private projectedPrincipalStars: ProjectedStar[] = [];

    async connectedCallback() {
      this.nebulaCanvas = this.querySelector('#sky-nebula-layer') as HTMLCanvasElement;
      this.artefactCanvas = this.querySelector('#sky-artefact-layer') as HTMLCanvasElement;
      if (this.nebulaCanvas) this.nebulaCanvas.style.display = 'none';
      this.aCtx = this.artefactCanvas.getContext('2d')!;

      this.initBackgroundField();
      this.resizeCanvases();
      window.addEventListener('resize', () => this.resizeCanvases(), { passive: true });

      await this.loadCatalogAndSelect(false);
      this.bindControls();
      this.bindInteractivePointer();
      this.startLoop();
    }

    disconnectedCallback() {
      cancelAnimationFrame(this.rafId);
    }

    private initBackgroundField() {
      // 1,700 multi-tier stars that continuously twinkle in and out of the dark sky
      this.backgroundStars = Array.from({ length: 1700 }, (_, i) => {
        const u = Math.random();
        const v = Math.random();
        const theta = 2 * Math.PI * u;
        // Bias 60% of stars toward the forward hemisphere and galactic band so the screen is lush
        const phi = i < 1050
          ? Math.acos((Math.random() - 0.5) * 1.35)
          : Math.acos(2 * v - 1);

        let x = Math.sin(phi) * Math.cos(theta);
        let y = Math.sin(phi) * Math.sin(theta);
        let z = Math.cos(phi);
        if (i < 1050 && z < -0.15) z = -z;

        const isSupernova = Math.random() > 0.945;
        const isTransientTwinkler = Math.random() < 0.76;

        return {
          x,
          y,
          z,
          r: isSupernova
            ? 1.35 + Math.random() * 0.75
            : Math.pow(Math.random(), 2.4) * 1.35 + 0.32,
          rgb: specToPlanckianRgb(Math.floor(Math.random() * 6) + 1),
          phase1: Math.random() * Math.PI * 2,
          speed1: 0.012 + Math.random() * 0.028,
          phase2: Math.random() * Math.PI * 2,
          speed2: 0.005 + Math.random() * 0.014,
          // Transient twinklers dip below threshold to 0 opacity, fading completely in & out!
          threshold: isTransientTwinkler ? 0.34 + Math.random() * 0.28 : 0.05,
          maxAlpha: isSupernova ? 0.95 : 0.45 + Math.random() * 0.5,
          isSupernova,
        };
      });

      this.dustMotes = Array.from({ length: 45 }, () => ({
        x: Math.random(),
        y: Math.random(),
        vx: (Math.random() - 0.5) * 0.00006,
        vy: (Math.random() - 0.5) * 0.00006,
        size: Math.random() * 1.05 + 0.3,
        op: Math.random() * 0.22 + 0.05,
        opDir: Math.random() > 0.5 ? 1 : -1,
      }));
    }

    private resizeCanvases() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = window.innerWidth;
      const h = window.innerHeight;

      this.artefactCanvas.width = Math.floor(w * dpr);
      this.artefactCanvas.height = Math.floor(h * dpr);
      this.aCtx.setTransform(dpr, 0, 0, dpr, 0, 0);

      if (this.currentConstellation) {
        this.currentNebulaPlanes = this.buildNebulaPlanes(this.currentConstellation);
      }
      if (this.outgoingConstellation) {
        this.outgoingNebulaPlanes = this.buildNebulaPlanes(this.outgoingConstellation);
      }
    }

    /**
     * Synthesizes 3 volumetric parallax depth planes using a true per-pixel
     * Domain-Warped fBm + Ridged Multifractal + Beer-Lambert Dark Dust Extinction shader.
     * Zero ellipses or geometric ovals — 100% organic fluid turbulence.
     */
    private buildNebulaPlanes(c: any): HTMLCanvasElement[] {
      const w = 300;
      const h = 190;

      const planes = [0, 1, 2].map(() => {
        const cvs = document.createElement('canvas');
        cvs.width = w;
        cvs.height = h;
        return cvs;
      });

      const neb = c?.nebula;
      const palette: number[][] = neb?.palette || [
        [198, 74, 106],
        [74, 184, 212],
        [236, 212, 162],
      ];
      const spineAngle = typeof neb?.spineAngle === 'number' ? neb.spineAngle : -0.48;
      const cosA = Math.cos(-spineAngle);
      const sinA = Math.sin(-spineAngle);

      const baryX = (neb?.barycenter?.[0] ?? 5000) / 10000;
      const baryY = (neb?.barycenter?.[1] ?? 5000) / 10000;

      // Numeric seed from constellation ID (e.g. DRC-0222 -> 222)
      const idNum = parseInt(String(c?.id || '1').replace(/\D/g, ''), 10) || 1;
      const noiseGen = new FractalNebulaNoise(idNum * 7919 + 104729);

      // Normalized star positions for local H-II stellar illumination pockets
      const starsNorm: Array<[number, number]> = (c?.stars || []).slice(0, 6).map((s: any) => [
        s[0] > 1.5 ? s[0] / 10000 : s[0],
        s[1] > 1.5 ? s[1] / 10000 : s[1],
      ]);

      const ctx0 = planes[0].getContext('2d')!;
      const ctx1 = planes[1].getContext('2d')!;
      const ctx2 = planes[2].getContext('2d')!;

      const img0 = ctx0.createImageData(w, h);
      const img1 = ctx1.createImageData(w, h);
      const img2 = ctx2.createImageData(w, h);

      const d0 = img0.data;
      const d1 = img1.data;
      const d2 = img2.data;

      const [r0, g0, b0] = palette[0];
      const [r1, g1, b1] = palette[1];
      const [r2, g2, b2] = palette[2];

      for (let py = 0; py < h; py++) {
        const ny = py / h;
        const dyBary = ny - baryY;

        for (let px = 0; px < w; px++) {
          const nx = px / w;
          const dxBary = nx - baryX;

          // Rotate coordinates into the constellation's natural spine frame
          const u = dxBary * cosA - dyBary * sinA;
          const v = dxBary * sinA + dyBary * cosA;

          // Elliptical radial envelope + galactic spine envelope (keeps edges fading cleanly into black space)
          const radialDistSq = u * u * 2.2 + v * v * 5.8;
          const envelope = Math.exp(-radialDistSq * 2.1);
          if (envelope < 0.015) continue;

          // Step 1: Domain Warping vectors q = (qx, qy)
          const sx = (u + 0.5) * 3.4;
          const sy = (v + 0.5) * 3.4;
          const qx = noiseGen.fbm(sx, sy);
          const qy = noiseGen.fbm(sx + 5.2, sy + 1.3);

          // Step 2: Second-order warped coordinates
          const wx = sx + 2.6 * (qx - 0.5);
          const wy = sy + 2.6 * (qy - 0.5);
          const gas = noiseGen.fbm(wx, wy);

          // Step 3: Ridged multifractal ionization filaments (wispy tendrils)
          const filamentRidge = noiseGen.ridged(sx * 1.35 + (qx - 0.5) * 1.9, sy * 1.35 + (qy - 0.5) * 1.9);

          // Step 4: Fractal Beer-Lambert Dark Dust Extinction (organic dark crevices, never ovals!)
          const dustField = noiseGen.fbm(wx * 1.45 + 11.7, wy * 1.45 + 4.3);
          const dustCrevice = Math.max(0, dustField - 0.46) * 2.8;
          const extinction = Math.exp(-dustCrevice * dustCrevice * 4.2);

          // Step 5: Proximity to principal constellation stars for localized ionized glow
          let starGlow = 0;
          for (let si = 0; si < starsNorm.length; si++) {
            const sdx = nx - starsNorm[si][0];
            const sdy = ny - starsNorm[si][1];
            const dSq = sdx * sdx + sdy * sdy;
            if (dSq < 0.035) {
              starGlow += Math.exp(-dSq * 95) * (si === 0 ? 0.55 : 0.32);
            }
          }

          const idx = (py * w + px) * 4;

          // --- PLANE 0: Deep Cosmic Emission Envelope (subtle, velvet background) ---
          const density0 = Math.max(0, gas - 0.24) * 1.45 * envelope * extinction;
          if (density0 > 0.005) {
            const mix = Math.min(1, Math.max(0, (qx - 0.25) * 1.8));
            d0[idx] = Math.round(r0 * (1 - mix) + r1 * mix);
            d0[idx + 1] = Math.round(g0 * (1 - mix) + g1 * mix);
            d0[idx + 2] = Math.round(b0 * (1 - mix) + b1 * mix);
            // Keep max alpha tasteful (~0.24) so deep space remains dark and atmospheric
            d0[idx + 3] = Math.min(255, Math.round(density0 * 68));
          }

          // --- PLANE 1: Mid-Field Gossamer Ionization Filaments & Star-Nursery Pockets ---
          const wisp = Math.pow(Math.max(0, filamentRidge - 0.22), 1.8) * envelope * (0.4 + 0.6 * extinction);
          const totalMid = Math.min(1, wisp * 1.15 + starGlow * (0.5 + 0.5 * filamentRidge));
          if (totalMid > 0.005) {
            const coreMix = Math.min(1, starGlow * 1.4 + Math.pow(wisp, 2));
            d1[idx] = Math.round(r1 * (1 - coreMix) + r2 * coreMix);
            d1[idx + 1] = Math.round(g1 * (1 - coreMix) + g2 * coreMix);
            d1[idx + 2] = Math.round(b1 * (1 - coreMix) + b2 * coreMix);
            d1[idx + 3] = Math.min(255, Math.round(totalMid * 78));
          }

          // --- PLANE 2: Foreground Fractal Dark Dust Rifts & Fine Golden Shock Threads ---
          const darkShadow = Math.min(1, Math.pow(Math.max(0, dustField - 0.48) * 2.2, 1.7) * envelope);
          const fineShock = Math.pow(Math.max(0, filamentRidge - 0.52) * 2.1, 2.6) * envelope;
          if (fineShock > 0.01) {
            d2[idx] = r2;
            d2[idx + 1] = g2;
            d2[idx + 2] = b2;
            d2[idx + 3] = Math.min(255, Math.round(fineShock * 62));
          } else if (darkShadow > 0.02) {
            d2[idx] = 5;
            d2[idx + 1] = 7;
            d2[idx + 2] = 12;
            d2[idx + 3] = Math.min(255, Math.round(darkShadow * 135));
          }
        }
      }

      ctx0.putImageData(img0, 0, 0);
      ctx1.putImageData(img1, 0, 0);
      ctx2.putImageData(img2, 0, 0);

      // Apply a single soft optical diffusion pass on each plane to eliminate any 300x190 pixel grid
      return planes.map((rawCanvas, layerIdx) => {
        const blurred = document.createElement('canvas');
        blurred.width = w;
        blurred.height = h;
        const bCtx = blurred.getContext('2d')!;
        const blurPx = layerIdx === 0 ? 10 : layerIdx === 1 ? 4 : 3;
        bCtx.filter = `blur(${blurPx}px)`;
        bCtx.drawImage(rawCanvas, 0, 0);
        bCtx.filter = 'none';
        return blurred;
      });
    }

    private async loadCatalogAndSelect(forceRandom = false) {
      try {
        if (this.catalogIndex.length === 0) {
          const res = await fetch('/data/sky/index.json');
          const data = await res.json();
          this.catalogIndex = data.catalog || [];
        }

        const urlParams = new URLSearchParams(window.location.search);
        const queryId = urlParams.get('sky');
        const featuredId = this.dataset.featuredId;

        let chosenMeta = null;
        if (!forceRandom && queryId) {
          chosenMeta = this.catalogIndex.find((c) => c.id === queryId);
        }
        if (!forceRandom && !chosenMeta && featuredId) {
          chosenMeta = this.catalogIndex.find((c) => c.id === featuredId);
        }
        if (!chosenMeta) {
          // Avoid picking the exact same constellation on redraw
          const pool =
            this.currentConstellation && this.catalogIndex.length > 1
              ? this.catalogIndex.filter((c) => c.id !== this.currentConstellation.id)
              : this.catalogIndex;
          const idx = Math.floor(Math.random() * pool.length);
          chosenMeta = pool[idx];
        }

        const rawShard = String(chosenMeta.shard);
        const shardName = rawShard.endsWith('.json')
          ? rawShard
          : `shard-${rawShard.padStart(2, '0')}.json`;

        const shardRes = await fetch(`/data/sky/shards/${shardName}`);
        const shardList = await shardRes.json();
        const nextConstellation =
          shardList.find((c: any) => c.id === chosenMeta.id) || shardList[0];
        const nextPlanes = this.buildNebulaPlanes(nextConstellation);

        this.selectedStarIdx = -1;
        document.getElementById('star-inset-popup')?.setAttribute('hidden', '');

        if (this.currentConstellation && forceRandom) {
          // Seamless Dual-Constellation Cross-Dissolve + Equatorial Telescope Slew
          this.outgoingConstellation = this.currentConstellation;
          this.outgoingNebulaPlanes = this.currentNebulaPlanes;
          this.outgoingDrawProgress = this.drawProgress;

          this.currentConstellation = nextConstellation;
          this.currentNebulaPlanes = nextPlanes;
          this.drawProgress = 0;
          this.transitionBlend = 0;

          // Gentle telescope slew impulse toward the new sector
          const dirX = Math.random() > 0.5 ? 1 : -1;
          const dirY = (Math.random() - 0.5) * 0.8;
          this.slewVX = dirX * 0.0042;
          this.slewVY = dirY * 0.0022;

          this.crossDissolveHud();
        } else {
          this.currentConstellation = nextConstellation;
          this.currentNebulaPlanes = nextPlanes;
          this.drawProgress = 0;
          this.transitionBlend = 1;
          this.updateHud();
        }
      } catch (err) {
        console.error('[DRC Sky Engine] Failed to load constellation shard:', err);
      }
    }

    private crossDissolveHud() {
      const cluster = document.getElementById('sky-title-cluster');
      const statusEl = document.getElementById('hud-telemetry-status');
      if (statusEl) statusEl.textContent = 'SLEWING // EQUATORIAL';
      cluster?.classList.add('is-slew-fading');

      window.setTimeout(() => {
        this.updateHud();
        cluster?.classList.remove('is-slew-fading');
      }, 420);

      window.setTimeout(() => {
        if (statusEl) statusEl.textContent = 'ACTIVE // J2000.0';
      }, 1450);
    }

    private spawnShootingStar() {
      this.shootingStars.push({
        x: 0.48 + Math.random() * 0.42,
        y: 0.05 + Math.random() * 0.25,
        born: this.frameCount,
      });
    }

    private updateHud() {
      if (!this.currentConstellation) return;
      const c = this.currentConstellation;
      const idEl = document.getElementById('hud-constellation-id');
      const nodeCountEl = document.getElementById('hud-node-count');
      const nebEl = document.getElementById('hud-nebula-designation');
      const nameEl = document.getElementById('hud-constellation-name');
      const meaningEl = document.getElementById('hud-constellation-meaning');
      const coordsEl = document.getElementById('hud-constellation-coords');

      if (idEl) idEl.textContent = c.id;
      if (nodeCountEl) nodeCountEl.textContent = `${c.stars?.length || 0} NODES`;
      if (nebEl) {
        nebEl.textContent = c.nebula?.designation || 'NGC 2244 · H II Emission Field';
      }
      if (nameEl) nameEl.textContent = c.name;
      if (meaningEl) meaningEl.textContent = c.meaning || c.english || '';
      if (coordsEl) coordsEl.textContent = `RA ${c.ra} · DEC ${c.dec}`;
    }

    private bindControls() {
      document.getElementById('btn-new-constellation')?.addEventListener('click', () => {
        this.loadCatalogAndSelect(true);
      });

      document.getElementById('btn-copy-sky-link')?.addEventListener('click', (e) => {
        if (!this.currentConstellation) return;
        const btn = e.currentTarget as HTMLButtonElement;
        const url = new URL(window.location.href);
        url.searchParams.set('sky', this.currentConstellation.id);
        navigator.clipboard?.writeText(url.toString());
        const orig = btn.textContent;
        btn.textContent = '✓ Copied Link';
        setTimeout(() => (btn.textContent = orig), 1800);
      });

      document.getElementById('btn-export-chart')?.addEventListener('click', () => {
        this.exportHighResChart();
      });

      const autoBtn = document.getElementById('btn-auto-rotate');
      const modeEl = document.getElementById('hud-orbital-mode');
      autoBtn?.addEventListener('click', () => {
        this.autoRotate = !this.autoRotate;
        autoBtn.textContent = `[ AUTO: ${this.autoRotate ? 'ON' : 'OFF'} ]`;
        autoBtn.classList.toggle('is-active', this.autoRotate);
        if (modeEl) {
          modeEl.textContent = this.autoRotate ? 'ORBITAL_AUTOPILOT' : 'STATIONARY_LOCK';
        }
        if (this.autoRotate) {
          this.vX = 0.00014;
          this.vY = 0.00007;
        }
      });

      document.getElementById('btn-meteor-shower')?.addEventListener('click', () => {
        this.spawnShootingStar();
      });

      document.getElementById('inset-close-btn')?.addEventListener('click', () => {
        this.selectedStarIdx = -1;
        document.getElementById('star-inset-popup')?.setAttribute('hidden', '');
      });
    }

    private bindInteractivePointer() {
      const canvas = this.artefactCanvas;
      const modeEl = document.getElementById('hud-orbital-mode');

      canvas.addEventListener('pointerdown', (e) => {
        this.isDragging = true;
        this.dragStart = { x: e.clientX, y: e.clientY };
        this.lastPointer = { x: e.clientX, y: e.clientY };
        if (modeEl) modeEl.textContent = 'MANUAL_OVERRIDE';
      });

      window.addEventListener('pointermove', (e) => {
        if (this.isDragging) {
          const dx = e.clientX - this.lastPointer.x;
          const dy = e.clientY - this.lastPointer.y;
          this.vX = dx * 0.0012;
          this.vY = dy * 0.0012;
          this.rotX += this.vX;
          this.rotY = Math.max(-0.45, Math.min(0.45, this.rotY + this.vY));
        }
        this.lastPointer = { x: e.clientX, y: e.clientY };
      }, { passive: true });

      window.addEventListener('pointerup', (e) => {
        if (!this.isDragging) return;
        this.isDragging = false;
        if (modeEl) {
          modeEl.textContent = this.autoRotate ? 'ORBITAL_AUTOPILOT' : 'STATIONARY_LOCK';
        }
        const dist = Math.hypot(e.clientX - this.dragStart.x, e.clientY - this.dragStart.y);
        if (dist < 6 && this.hoveredStarIdx !== -1) {
          this.openStarInsetPopup(this.hoveredStarIdx);
        }
      });
    }

    private openStarInsetPopup(idx: number) {
      this.selectedStarIdx = idx;
      const star = this.projectedPrincipalStars.find((s) => s.idx === idx);
      const popup = document.getElementById('star-inset-popup');
      if (!star || !popup || !this.currentConstellation) return;

      const greek = BAYER_GREEK[idx] || '★';
      const bayerName = BAYER_NAMES[idx] || `Node ${idx + 1}`;
      const c = this.currentConstellation;

      const desigEl = document.getElementById('inset-star-designation');
      const magEl = document.getElementById('inset-star-mag');
      const specEl = document.getElementById('inset-star-spectral');
      const titleEl = document.getElementById('inset-star-title');
      const coordsEl = document.getElementById('inset-star-coords');
      const previewEl = document.getElementById('inset-star-preview');
      const fluxFill = document.getElementById('inset-flux-fill');
      const fluxVal = document.getElementById('inset-flux-val');

      if (desigEl) desigEl.textContent = `ASTROMETRIC_LOG // ${greek} NODE`;
      if (magEl) magEl.textContent = `MAG ${star.mag.toFixed(2)}`;
      if (specEl) specEl.textContent = specToLabel(star.spec);
      if (titleEl) titleEl.textContent = `${bayerName} ${c.name}`;
      if (coordsEl) coordsEl.textContent = `RA ${c.ra} · DEC ${c.dec}`;

      const [r, g, b] = star.rgb;
      if (previewEl) {
        previewEl.style.background = `rgb(${r}, ${g}, ${b})`;
        previewEl.style.boxShadow = `0 0 14px 4px rgb(${r}, ${g}, ${b}), 0 0 34px 12px rgba(${r}, ${g}, ${b}, 0.65)`;
      }

      const lumPct = Math.round(Math.max(22, Math.min(99, (4.0 - star.mag) * 28)));
      if (fluxFill) fluxFill.style.width = `${lumPct}%`;
      if (fluxVal) fluxVal.textContent = `${lumPct}% FLUX`;

      const left = Math.min(Math.max(20, star.x + 24), window.innerWidth - 335);
      const top = Math.min(Math.max(84, star.y - 52), window.innerHeight - 280);
      popup.style.left = `${left}px`;
      popup.style.top = `${top}px`;
      popup.removeAttribute('hidden');
    }

    private startLoop() {
      const step = (time: number) => {
        this.frameCount++;

        // Advance seamless cross-dissolve blend (0 -> 1 over ~2.2 seconds)
        if (this.transitionBlend < 1) {
          this.transitionBlend = Math.min(1, this.transitionBlend + 0.0072);
          if (this.transitionBlend >= 1) {
            this.outgoingConstellation = null;
            this.outgoingNebulaPlanes = [];
          }
        }

        // Slow, dreamlike constellation line tracing (~4.2 seconds across all edges)
        this.drawProgress = Math.min(1, this.drawProgress + 0.0042);

        // Dampen equatorial telescope slew impulse smoothly
        this.slewVX *= 0.955;
        this.slewVY *= 0.955;

        if (!this.isDragging) {
          if (this.autoRotate) {
            this.vX *= 0.97;
            this.vY *= 0.97;
            if (Math.abs(this.vX) < 0.00014) this.vX = (this.vX >= 0 ? 1 : -1) * 0.00014;
            if (Math.abs(this.vY) < 0.00007) this.vY = (this.vY >= 0 ? 1 : -1) * 0.00007;
          } else {
            this.vX *= 0.92;
            this.vY *= 0.92;
          }
          this.rotX += this.vX + this.slewVX;
          this.rotY = Math.max(-0.42, Math.min(0.42, this.rotY + this.vY + this.slewVY));
        }

        if (this.frameCount % 680 === 0 && Math.random() > 0.4) {
          this.spawnShootingStar();
        }

        if (this.frameCount % 30 === 0) {
          const spinEl = document.getElementById('hud-spin-speed');
          if (spinEl) {
            const totalV = Math.hypot(this.vX + this.slewVX, this.vY + this.slewVY);
            const degPerFrame = (totalV * (180 / Math.PI)).toFixed(3);
            spinEl.textContent = `${degPerFrame}°/f`;
          }
        }

        this.renderFrame(time, this.aCtx, window.innerWidth, window.innerHeight);
        this.rafId = requestAnimationFrame(step);
      };
      this.rafId = requestAnimationFrame(step);
    }

    /**
     * Composites the 3 volumetric nebula depth planes with differential 3D parallax
     * and slow organic breathing.
     */
    private drawVolumetricNebulaPlanes(
      ctx: CanvasRenderingContext2D,
      planes: HTMLCanvasElement[],
      w: number,
      h: number,
      rotOffsetX: number,
      rotOffsetY: number,
      masterAlpha: number
    ) {
      if (!planes || planes.length === 0 || masterAlpha <= 0.004) return;
      const parallaxFactors = [0.25, 0.68, 1.18];
      const pad = 48;

      for (let i = 0; i < planes.length; i++) {
        const plane = planes[i];
        if (!plane) continue;
        const pFactor = parallaxFactors[i] ?? 0.65;
        const ox = rotOffsetX * pFactor;
        const oy = rotOffsetY * pFactor;
        const breath = 1 + Math.sin(this.frameCount * 0.0055 + i * 1.7) * 0.014;

        ctx.save();
        ctx.globalAlpha = masterAlpha * (i === 1 ? 0.96 : 0.88);
        if (i === 1) {
          ctx.globalCompositeOperation = 'screen';
        }
        const dw = (w + pad * 2) * breath;
        const dh = (h + pad * 2) * breath;
        const dx = (w - dw) * 0.5 + ox;
        const dy = (h - dh) * 0.5 + oy;
        ctx.drawImage(plane, dx, dy, dw, dh);
        ctx.restore();
      }
    }

    /**
     * Renders a single constellation's stars, ghost chords, silverpoint edges,
     * Airy disks, and Bayer designations at a given `opacityScale` and `progress`.
     * This allows both the outgoing constellation and incoming constellation to
     * cross-dissolve seamlessly during a sky redraw.
     */
    private renderConstellationFigure(
      ctx: CanvasRenderingContext2D,
      c: any,
      w: number,
      h: number,
      vaultRad: number,
      rotOffsetX: number,
      rotOffsetY: number,
      progress: number,
      opacityScale: number,
      isInteractivePrimary: boolean
    ) {
      if (!c || opacityScale <= 0.005) return;

      const padX = Math.max(w * 0.18, (w - vaultRad * 1.9) * 0.5);
      const padY = Math.max(h * 0.14, (h * 0.92 - vaultRad * 1.7) * 0.5);
      const drawW = w - padX * 2;
      const drawH = h * 0.84 - padY * 1.4;

      // Slight radial drift during outgoing dissolve for an ethereal celestial handoff
      const driftScale = isInteractivePrimary ? 1 : 1 - (1 - opacityScale) * 0.035;
      const centerX = w * 0.5;
      const centerY = h * 0.48;

      let nextHovered = -1;
      const projected: ProjectedStar[] = c.stars.map(
        (s: [number, number, number, number], idx: number) => {
          const normX = s[0] > 1.5 ? s[0] / 10000 : s[0];
          const normY = s[1] > 1.5 ? s[1] / 10000 : s[1];

          const parallaxFactor = 0.7 + (idx % 3) * 0.15;
          const rawX = padX + normX * drawW + rotOffsetX * parallaxFactor;
          const rawY = padY + normY * drawH + rotOffsetY * parallaxFactor;
          const px = centerX + (rawX - centerX) * driftScale;
          const py = centerY + (rawY - centerY) * driftScale;
          const rgb = specToPlanckianRgb(s[3]);

          if (
            isInteractivePrimary &&
            !this.isDragging &&
            Math.hypot(px - this.lastPointer.x, py - this.lastPointer.y) < 24
          ) {
            nextHovered = idx;
          }

          return {
            idx,
            x: px,
            y: py,
            mag: s[2],
            spec: s[3],
            rgb,
          };
        }
      );

      if (isInteractivePrimary) {
        this.projectedPrincipalStars = projected;
        this.hoveredStarIdx = nextHovered;
      }

      // 4A. Secondary Ghost Construction Chords (dashed classical geometry lines)
      if (Array.isArray(c.ghostChords) && progress > 0.65) {
        const chordAlpha = Math.min(1, (progress - 0.65) / 0.35) * 0.22 * opacityScale;
        ctx.save();
        ctx.setLineDash([3, 7]);
        ctx.strokeStyle = `rgba(218, 195, 142, ${chordAlpha.toFixed(3)})`;
        ctx.lineWidth = 0.75;
        for (const [u, v] of c.ghostChords) {
          const p1 = projected[u];
          const p2 = projected[v];
          if (!p1 || !p2) continue;
          ctx.beginPath();
          ctx.moveTo(p1.x, p1.y);
          ctx.lineTo(p2.x, p2.y);
          ctx.stroke();
        }
        ctx.restore();
      }

      // 4B. Primary Intaglio Silverpoint Constellation Edges with 9px Breathing Halo Gap
      const totalEdges = c.edges.length;
      const easedProgress = 1 - Math.pow(1 - progress, 2.4);
      const activeEdges = easedProgress * totalEdges;

      c.edges.forEach((edge: [number, number], idx: number) => {
        if (idx > activeEdges) return;
        const p1 = projected[edge[0]];
        const p2 = projected[edge[1]];
        if (!p1 || !p2) return;

        const segProgress = Math.min(1, activeEdges - idx);
        const dx = p2.x - p1.x;
        const dy = p2.y - p1.y;
        const dist = Math.hypot(dx, dy);
        const gap = 9;
        if (dist <= gap * 2.2) return;

        const ux = dx / dist;
        const uy = dy / dist;

        // If outgoing constellation is dissolving out, retract from start vertex toward end vertex!
        const retractStart = isInteractivePrimary ? 0 : Math.pow(1 - opacityScale, 1.3);
        const sx0 = p1.x + ux * gap + (dist - gap * 2) * ux * retractStart;
        const sy0 = p1.y + uy * gap + (dist - gap * 2) * uy * retractStart;
        const fullEx = p2.x - ux * gap;
        const fullEy = p2.y - uy * gap;

        const ex = sx0 + (fullEx - sx0) * segProgress;
        const ey = sy0 + (fullEy - sy0) * segProgress;

        const linePhase = (edge[0] * 2.4 + edge[1] * 1.7) % (Math.PI * 2);
        const glimmer = Math.pow((Math.sin(this.frameCount * 0.012 + linePhase) + 1) * 0.5, 2);

        const grad = ctx.createLinearGradient(sx0, sy0, ex, ey);
        const baseA = ((0.42 + glimmer * 0.14) * opacityScale).toFixed(3);
        const midA = ((0.72 + glimmer * 0.22) * opacityScale).toFixed(3);
        grad.addColorStop(0, `rgba(218, 195, 142, ${baseA})`);
        grad.addColorStop(0.5, `rgba(255, 242, 205, ${midA})`);
        grad.addColorStop(1, `rgba(218, 195, 142, ${baseA})`);

        ctx.save();
        ctx.strokeStyle = `rgba(218, 195, 142, ${(0.14 * opacityScale).toFixed(3)})`;
        ctx.lineWidth = 3.2;
        ctx.beginPath();
        ctx.moveTo(sx0, sy0);
        ctx.lineTo(ex, ey);
        ctx.stroke();

        ctx.strokeStyle = grad;
        ctx.lineWidth = 1.15 + glimmer * 0.35;
        ctx.beginPath();
        ctx.moveTo(sx0, sy0);
        ctx.lineTo(ex, ey);
        ctx.stroke();
        ctx.restore();
      });

      // 5. Render Principal Constellation Stars with 3-Zone Airy Disk + Astrolabe Reticles
      projected.forEach((p, idx) => {
        const [r, g, b] = p.rgb;
        const baseRadius = Math.max(2.1, 4.6 - p.mag * 0.72);
        const isHov = isInteractivePrimary && idx === this.hoveredStarIdx;
        const isSel = isInteractivePrimary && idx === this.selectedStarIdx;
        const radius = baseRadius * (isSel ? 1.5 : isHov ? 1.28 : 1);

        // Zone C: Wide atmospheric halation
        const haloRadius = radius * 8.5;
        const halo = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, haloRadius);
        const coreHaloA = (isSel || isHov ? 0.62 : 0.42) * opacityScale;
        halo.addColorStop(0, `rgba(${r}, ${g}, ${b}, ${coreHaloA.toFixed(3)})`);
        halo.addColorStop(0.38, `rgba(${r}, ${g}, ${b}, ${(0.14 * opacityScale).toFixed(3)})`);
        halo.addColorStop(1, `rgba(${r}, ${g}, ${b}, 0)`);
        ctx.fillStyle = halo;
        ctx.beginPath();
        ctx.arc(p.x, p.y, haloRadius, 0, Math.PI * 2);
        ctx.fill();

        // Zone B: Fraunhofer diffraction spikes for bright alpha/beta/gamma stars
        if (p.mag < 2.2 || isHov || isSel) {
          const spikeLen = radius * (isSel ? 9.5 : 7.2);
          const spikeA = (isSel || isHov ? 0.72 : 0.48) * opacityScale;
          ctx.strokeStyle = `rgba(${r}, ${g}, ${b}, ${spikeA.toFixed(3)})`;
          ctx.lineWidth = 0.7;
          ctx.beginPath();
          ctx.moveTo(p.x - spikeLen, p.y);
          ctx.lineTo(p.x + spikeLen, p.y);
          ctx.moveTo(p.x, p.y - spikeLen);
          ctx.lineTo(p.x, p.y + spikeLen);
          ctx.stroke();
        }

        // Zone A: Pinpoint incandescent core
        ctx.fillStyle = `rgba(255, 255, 255, ${opacityScale.toFixed(3)})`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, radius * 0.78, 0, Math.PI * 2);
        ctx.fill();

        // Rotating 4-Corner Target Reticle on Hovered or Selected Star
        if (isHov || isSel) {
          const tSize = 14;
          const rot = this.frameCount * 0.018;
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate(rot);
          ctx.strokeStyle = `rgba(232, 222, 181, ${(0.92 * opacityScale).toFixed(3)})`;
          ctx.lineWidth = 1.1;
          for (let corner = 0; corner < 4; corner++) {
            ctx.beginPath();
            ctx.moveTo(-tSize, -tSize + tSize * 0.48);
            ctx.lineTo(-tSize, -tSize);
            ctx.lineTo(-tSize + tSize * 0.48, -tSize);
            ctx.stroke();
            ctx.rotate(Math.PI * 0.5);
          }
          ctx.restore();
        } else if (idx === 0 || idx === 1) {
          ctx.strokeStyle = `rgba(218, 195, 142, ${(0.42 * opacityScale).toFixed(3)})`;
          ctx.lineWidth = 0.75;
          ctx.beginPath();
          ctx.arc(p.x, p.y, 7.2, 0, Math.PI * 2);
          ctx.stroke();
        }

        // Bayer Greek letter designation
        if (idx < BAYER_GREEK.length && progress > 0.25) {
          const labelA = (isHov || isSel ? 1 : 0.82) * opacityScale;
          ctx.fillStyle = `rgba(218, 195, 142, ${labelA.toFixed(3)})`;
          ctx.font = '12px Georgia, serif';
          ctx.fillText(BAYER_GREEK[idx], p.x + 11, p.y - 8);
        }
      });
    }

    private renderFrame(
      time: number,
      ctx: CanvasRenderingContext2D,
      w: number,
      h: number
    ) {
      ctx.clearRect(0, 0, w, h);

      const cx = Math.cos(this.rotX);
      const sx = Math.sin(this.rotX);
      const cy = Math.cos(this.rotY);
      const sy = Math.sin(this.rotY);

      const maxEdge = Math.max(w, h);
      const minEdge = Math.min(w, h);
      const uniRad = maxEdge * 0.72;
      const uniFov = maxEdge * 1.35;
      const vaultRad = minEdge * 0.37 * this.zoom;

      const rotOffsetX = Math.sin(this.rotX * 1.2) * (vaultRad * 0.22);
      const rotOffsetY = Math.sin(this.rotY * 1.2) * (vaultRad * 0.22);

      // 0. Draw 3-Layer Volumetric Parallax Nebulae (Seamless cross-dissolve during redraw)
      const smoothBlend = quinticSmoothstep(this.transitionBlend);
      if (this.outgoingNebulaPlanes.length > 0 && smoothBlend < 1) {
        this.drawVolumetricNebulaPlanes(
          ctx,
          this.outgoingNebulaPlanes,
          w,
          h,
          rotOffsetX,
          rotOffsetY,
          1 - smoothBlend
        );
      }
      this.drawVolumetricNebulaPlanes(
        ctx,
        this.currentNebulaPlanes,
        w,
        h,
        rotOffsetX,
        rotOffsetY,
        smoothBlend
      );

      // 1. Background 3D spherical starfield (1,700 stars twinkling in and out of the dark sky)
      for (const s of this.backgroundStars) {
        const x1 = s.x * cx - s.z * sx;
        const z1 = s.z * cx + s.x * sx;
        const y2 = s.y * cy - z1 * sy;
        const z2 = z1 * cy + s.y * sy;
        if (z2 < -0.65) continue;

        const scale = uniFov / (uniFov + z2 * uniRad);
        const sx2D = w * 0.5 + x1 * uniRad * scale;
        const sy2D = h * 0.5 + y2 * uniRad * scale;
        if (sx2D < -10 || sx2D > w + 10 || sy2D < -10 || sy2D > h + 10) continue;

        // Dual-harmonic scintillation wave (0..1)
        const w1 = Math.sin(s.phase1 + this.frameCount * s.speed1);
        const w2 = Math.sin(s.phase2 + this.frameCount * s.speed2);
        const wave = (w1 * 0.62 + w2 * 0.38 + 1) * 0.5;

        // Stars dip below their threshold to 0 opacity, fading completely in & out of the night sky
        if (wave <= s.threshold) continue;
        const normTwinkle = (wave - s.threshold) / (1 - s.threshold);
        const smoothTwinkle = normTwinkle * normTwinkle * (3 - 2 * normTwinkle);
        const alpha = smoothTwinkle * s.maxAlpha * Math.min(1, scale);
        if (alpha < 0.015) continue;

        const [r, g, b] = s.rgb;
        const starRadius = s.r * scale * (0.82 + smoothTwinkle * 0.42);

        // Soft atmospheric micro-halo on brighter twinkling peaks
        if (s.isSupernova || (smoothTwinkle > 0.72 && s.r > 1.0)) {
          ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${(alpha * 0.22).toFixed(3)})`;
          ctx.beginPath();
          ctx.arc(sx2D, sy2D, starRadius * 3.1, 0, Math.PI * 2);
          ctx.fill();
        }

        ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha.toFixed(3)})`;
        ctx.beginPath();
        ctx.arc(sx2D, sy2D, starRadius, 0, Math.PI * 2);
        ctx.fill();

        if (s.isSupernova && smoothTwinkle > 0.65) {
          const flareAlpha = (smoothTwinkle - 0.65) * 2.4 * alpha;
          const flareSize = starRadius * 5.8;
          ctx.strokeStyle = `rgba(${r}, ${g}, ${b}, ${Math.min(0.85, flareAlpha).toFixed(3)})`;
          ctx.lineWidth = 0.55;
          ctx.beginPath();
          ctx.moveTo(sx2D, sy2D - flareSize);
          ctx.lineTo(sx2D, sy2D + flareSize);
          ctx.moveTo(sx2D - flareSize, sy2D);
          ctx.lineTo(sx2D + flareSize, sy2D);
          ctx.stroke();
        }
      }

      // 2. Ambient floating golden dust motes
      for (const d of this.dustMotes) {
        d.x += d.vx;
        d.y += d.vy;
        if (d.x < 0) d.x = 1;
        if (d.x > 1) d.x = 0;
        if (d.y < 0) d.y = 1;
        if (d.y > 1) d.y = 0;
        d.op += 0.00045 * d.opDir;
        if (d.op > 0.3 || d.op < 0.05) d.opDir *= -1;
        ctx.fillStyle = `rgba(232, 222, 181, ${d.op.toFixed(3)})`;
        ctx.beginPath();
        ctx.arc(d.x * w, d.y * h, d.size, 0, Math.PI * 2);
        ctx.fill();
      }

      // 3. Subtle Astrolabe Celestial Vault Rings
      ctx.save();
      ctx.lineWidth = 1;
      ctx.strokeStyle = 'rgba(255, 65, 65, 0.16)';
      ctx.beginPath();
      ctx.arc(w * 0.5 + 1, h * 0.48, vaultRad + 0.5, 0, Math.PI * 2);
      ctx.stroke();

      ctx.strokeStyle = 'rgba(65, 160, 255, 0.16)';
      ctx.beginPath();
      ctx.arc(w * 0.5 - 1, h * 0.48, vaultRad - 0.5, 0, Math.PI * 2);
      ctx.stroke();

      ctx.strokeStyle = 'rgba(232, 222, 181, 0.2)';
      ctx.beginPath();
      ctx.arc(w * 0.5, h * 0.48, vaultRad, 0, Math.PI * 2);
      ctx.stroke();

      ctx.setLineDash([3, 8]);
      ctx.strokeStyle = 'rgba(232, 222, 181, 0.11)';
      ctx.beginPath();
      ctx.arc(w * 0.5, h * 0.48, vaultRad * 0.72, 0, Math.PI * 2);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.restore();

      // 4 & 5. Outgoing Constellation (if mid-transition) + Active Constellation
      if (this.outgoingConstellation && smoothBlend < 1) {
        this.renderConstellationFigure(
          ctx,
          this.outgoingConstellation,
          w,
          h,
          vaultRad,
          rotOffsetX,
          rotOffsetY,
          this.outgoingDrawProgress,
          1 - smoothBlend,
          false
        );
      }

      if (this.currentConstellation) {
        this.renderConstellationFigure(
          ctx,
          this.currentConstellation,
          w,
          h,
          vaultRad,
          rotOffsetX,
          rotOffsetY,
          this.drawProgress,
          smoothBlend,
          true
        );
      }

      // 6. Shooting Stars / Bolide Transits
      this.shootingStars = this.shootingStars.filter((star) => {
        const age = this.frameCount - star.born;
        const dur = 75;
        if (age > dur) return false;
        const prog = age / dur;
        const sx0 = star.x * w;
        const sy0 = star.y * h;
        const travel = prog * w * 0.48;
        const ex = sx0 - travel * 0.76;
        const ey = sy0 + travel * 0.64;
        const op = prog < 0.2 ? prog / 0.2 : prog > 0.75 ? 1 - (prog - 0.75) / 0.25 : 1;
        const tailLen = 175 * Math.min(1, prog * 4);
        const tx = ex + tailLen * 0.76;
        const ty = ey - tailLen * 0.64;

        const grad = ctx.createLinearGradient(tx, ty, ex, ey);
        grad.addColorStop(0, 'transparent');
        grad.addColorStop(0.4, `rgba(232, 222, 181, ${(op * 0.42).toFixed(3)})`);
        grad.addColorStop(1, `rgba(255, 255, 255, ${op.toFixed(3)})`);
        ctx.beginPath();
        ctx.moveTo(tx, ty);
        ctx.lineTo(ex, ey);
        ctx.strokeStyle = grad;
        ctx.lineWidth = 1.65;
        ctx.lineCap = 'round';
        ctx.stroke();

        const hg = ctx.createRadialGradient(ex, ey, 0, ex, ey, 8);
        hg.addColorStop(0, `rgba(255, 255, 255, ${op.toFixed(3)})`);
        hg.addColorStop(0.4, `rgba(232, 222, 181, ${(op * 0.6).toFixed(3)})`);
        hg.addColorStop(1, 'transparent');
        ctx.fillStyle = hg;
        ctx.beginPath();
        ctx.arc(ex, ey, 8, 0, Math.PI * 2);
        ctx.fill();
        return true;
      });
    }

    private exportHighResChart() {
      if (!this.currentConstellation) return;
      const c = this.currentConstellation;
      const off = document.createElement('canvas');
      off.width = 2400;
      off.height = 1500;
      const ctx = off.getContext('2d')!;

      ctx.fillStyle = '#07090e';
      ctx.fillRect(0, 0, off.width, off.height);

      const savedProgress = this.drawProgress;
      const savedBlend = this.transitionBlend;
      this.drawProgress = 1;
      this.transitionBlend = 1;
      this.renderFrame(performance.now(), ctx, off.width, off.height);
      this.drawProgress = savedProgress;
      this.transitionBlend = savedBlend;

      ctx.strokeStyle = 'rgba(218, 195, 142, 0.4)';
      ctx.lineWidth = 2;
      ctx.strokeRect(48, 48, off.width - 96, off.height - 96);

      ctx.fillStyle = '#f2efe9';
      ctx.font = '38px Georgia, serif';
      ctx.fillText(`${c.name} — ${c.meaning || c.english || ''}`, 96, off.height - 130);

      ctx.fillStyle = '#d4af37';
      ctx.font = '22px ui-monospace, monospace';
      ctx.fillText(
        `DUNCAN R. CORDRY OBSERVATORY ARCHIVE · ${c.id} · ${c.nebula?.designation || ''} · RA ${c.ra} · DEC ${c.dec}`,
        96,
        off.height - 88
      );

      off.toBlob((blob) => {
        if (!blob) return;
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${c.id}-${c.name.toLowerCase().replace(/\s+/g, '-')}.png`;
        a.click();
        setTimeout(() => URL.revokeObjectURL(url), 3000);
      }, 'image/png');
    }
  }

  if (!customElements.get('drc-constellation-canvas')) {
    customElements.define('drc-constellation-canvas', DrcConstellationCanvas);
  }
</script>
