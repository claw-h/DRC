<script>
  const BAYER_GREEK = ['α', 'β', 'γ', 'δ', 'ε', 'ζ', 'η', 'θ', 'ι', 'κ', 'λ', 'μ', 'ν', 'ξ', 'ο', 'π'];
  const BAYER_NAMES = [
    'Alpha', 'Beta', 'Gamma', 'Delta', 'Epsilon', 'Zeta', 'Eta', 'Theta',
    'Iota', 'Kappa', 'Lambda', 'Mu', 'Nu', 'Xi', 'Omicron', 'Pi'
  ];

  // Maps spectral index (0..6 from generate-constellations.mjs) to Planckian RGB
  function specToPlanckianRgb(spec: number): [number, number, number] {
    if (spec <= 1) return [185, 212, 255]; // O/B Blue-White
    if (spec === 2) return [236, 243, 255]; // A White-Blue
    if (spec === 3) return [255, 249, 238]; // F Creamy White
    if (spec === 4) return [255, 235, 192]; // G Solar Gold
    if (spec === 5) return [255, 204, 145]; // K Amber
    return [255, 168, 120]; // M Ember Red
  }

  function specToLabel(spec: number): string {
    if (spec <= 1) return 'CLASS B2V · 18,500 K';
    if (spec === 2) return 'CLASS A1V · 9,400 K';
    if (spec === 3) return 'CLASS F5V · 6,500 K';
    if (spec === 4) return 'CLASS G2V · 5,780 K';
    if (spec === 5) return 'CLASS K3III · 4,300 K';
    return 'CLASS M2Iab · 3,450 K';
  }

  // Quintic smoothstep for zero-jerk transitions
  function quinticSmoothstep(t: number): number {
    const x = Math.max(0, Math.min(1, t));
    return x * x * x * (x * (x * 6 - 15) + 10);
  }

  /**
   * 99th-Degree CRT Tube + 180° Hemispherical Fisheye Lens Projection.
   * Bulges the central celestial field outward (~1.72x magnification) and bends
   * peripheral coordinates around the curved cathode-ray glass walls.
   */
  function projectFisheyeCRT(
    rawX: number,
    rawY: number,
    w: number,
    h: number
  ): { x: number; y: number; scale: number; rNorm: number; ux: number; uy: number } {
    const cx = w * 0.5;
    const cy = h * 0.5;
    const rx = Math.max(1, w * 0.5);
    const ry = Math.max(1, h * 0.5);

    const u = (rawX - cx) / rx;
    const v = (rawY - cy) / ry;
    const r = Math.hypot(u, v);

    if (r < 0.0001) {
      return { x: cx, y: cy, scale: 1.72, rNorm: 0, ux: 0, uy: 0 };
    }

    // Extreme 99th-degree fisheye + CRT spherical dome compression
    const K_FISH = 3.45;
    const maxAtan = Math.atan(K_FISH);
    const rFish = Math.atan(K_FISH * r) / maxAtan;

    // 2D CRT barrel cross-axis coupling (bows horizontal & vertical lines into a curved tube)
    const crtBarrelX = 1 - 0.145 * Math.min(1.4, v * v);
    const crtBarrelY = 1 - 0.145 * Math.min(1.4, u * u);

    const ratio = rFish / r;
    const uOut = u * ratio * crtBarrelX * 0.96;
    const vOut = v * ratio * crtBarrelY * 0.96;

    // Local derivative / magnification factor (high in center, compressed at rim)
    const deriv = (K_FISH / (1 + K_FISH * K_FISH * r * r)) / maxAtan;
    const scale = Math.max(0.28, Math.min(1.85, (deriv * 0.65 + ratio * 0.35)));

    return {
      x: cx + uOut * rx,
      y: cy + vOut * ry,
      scale,
      rNorm: Math.min(1.25, r),
      ux: u / r,
      uy: v / r,
    };
  }

  // Fast deterministic 2D Value-Simplex Noise & Fractional Brownian Motion (fBm) for organic nebula synthesis
  class FractalNebulaNoise {
    private perm = new Uint8Array(512);

    constructor(seed: number) {
      const p = new Uint8Array(256);
      for (let i = 0; i < 256; i++) p[i] = i;
      let s = (seed >>> 0) || 1337;
      for (let i = 255; i > 0; i--) {
        s = (Math.imul(s, 1664525) + 1013904223) >>> 0;
        const j = s % (i + 1);
        const tmp = p[i];
        p[i] = p[j];
        p[j] = tmp;
      }
      for (let i = 0; i < 512; i++) this.perm[i] = p[i & 255];
    }

    public noise2D(x: number, y: number): number {
      const xi = Math.floor(x) & 255;
      const yi = Math.floor(y) & 255;
      const xf = x - Math.floor(x);
      const yf = y - Math.floor(y);

      const u = xf * xf * xf * (xf * (xf * 6 - 15) + 10);
      const v = yf * yf * yf * (yf * (yf * 6 - 15) + 10);

      const aa = this.perm[this.perm[xi] + yi];
      const ab = this.perm[this.perm[xi] + yi + 1];
      const ba = this.perm[this.perm[xi + 1] + yi];
      const bb = this.perm[this.perm[xi + 1] + yi + 1];

      const l1 = aa + u * (ba - aa);
      const l2 = ab + u * (bb - ab);
      return (l1 + v * (l2 - l1)) / 255;
    }

    // 4-octave Fractional Brownian Motion
    public fbm(x: number, y: number): number {
      let value = 0;
      let amp = 0.52;
      let freq = 1;
      for (let i = 0; i < 4; i++) {
        const rx = x * freq * 0.866 - y * freq * 0.5;
        const ry = x * freq * 0.5 + y * freq * 0.866;
        value += amp * this.noise2D(rx, ry);
        x += 17.3;
        y += 9.1;
        freq *= 2.07;
        amp *= 0.48;
      }
      return value;
    }

    // Ridged Multifractal for sharp, gossamer cosmic ionization filaments
    public ridged(x: number, y: number): number {
      let value = 0;
      let amp = 0.55;
      let freq = 1;
      let weight = 1;
      for (let i = 0; i < 3; i++) {
        const n = this.noise2D(x * freq, y * freq);
        let signal = 1 - Math.abs(n * 2 - 1);
        signal = signal * signal * weight;
        weight = Math.max(0, Math.min(1, signal * 1.8));
        value += signal * amp;
        freq *= 2.15;
        amp *= 0.45;
      }
      return value;
    }
  }

  type ProjectedStar = {
    idx: number;
    rawX: number;
    rawY: number;
    x: number;
    y: number;
    scale: number;
    rNorm: number;
    ux: number;
    uy: number;
    mag: number;
    spec: number;
    rgb: [number, number, number];
  };

  class DrcConstellationCanvas extends HTMLElement {
    private nebulaCanvas!: HTMLCanvasElement;
    private artefactCanvas!: HTMLCanvasElement;
    private aCtx!: CanvasRenderingContext2D;
    private rafId = 0;
    private catalogIndex: any[] = [];
    private canvasW = 760;
    private canvasH = 420;

    // Active & Outgoing Constellation States for Seamless Redraw Cross-Dissolve
    private currentConstellation: any = null;
    private outgoingConstellation: any = null;
    private currentNebulaPlanes: HTMLCanvasElement[] = [];
    private outgoingNebulaPlanes: HTMLCanvasElement[] = [];

    private drawProgress = 0;
    private outgoingDrawProgress = 1;
    private transitionBlend = 1;
    private slewVX = 0;
    private slewVY = 0;
    private frameCount = 0;

    // Hierarchical Poisson-Thomas Clustered Starfield + Binary Systems
    private backgroundStars: Array<{
      x: number;
      y: number;
      z: number;
      r: number;
      rgb: [number, number, number];
      phase1: number;
      speed1: number;
      phase2: number;
      speed2: number;
      threshold: number;
      maxAlpha: number;
      isSupernova: boolean;
      isBinaryPrimary: boolean;
      companionDx: number;
      companionDy: number;
      companionRgb: [number, number, number];
    }> = [];

    // Silent Keyhole / NOSS Reconnaissance Satellite Triplet Anomaly
    private satelliteTriad: {
      active: boolean;
      progress: number;
      startX: number;
      startY: number;
      endX: number;
      endY: number;
      shadowCutoff: number;
    } = {
      active: true,
      progress: 0.15,
      startX: 0.12,
      startY: 0.78,
      endX: 0.86,
      endY: 0.18,
      shadowCutoff: 0.74,
    };

    private shootingStars: Array<{
      x: number;
      y: number;
      born: number;
    }> = [];

    // Slow, serene celestial rotation & inertia
    private rotX = 0;
    private rotY = 0;
    private vX = 0.00014;
    private vY = 0.00007;
    private autoRotate = true;
    private isDragging = false;
    private dragStart = { x: 0, y: 0 };
    private lastPointer = { x: -1000, y: -1000 };
    private zoom = 1;

    private hoveredStarIdx: number = -1;
    private selectedStarIdx: number = -1;
    private projectedPrincipalStars: ProjectedStar[] = [];

    async connectedCallback() {
      this.nebulaCanvas = this.querySelector('#sky-nebula-layer') as HTMLCanvasElement;
      this.artefactCanvas = this.querySelector('#sky-artefact-layer') as HTMLCanvasElement;
      if (this.nebulaCanvas) this.nebulaCanvas.style.display = 'none';
      this.aCtx = this.artefactCanvas.getContext('2d')!;

      this.initClusteredDeepFieldSky();
      this.resizeCanvases();
      window.addEventListener('resize', () => this.resizeCanvases(), { passive: true });

      await this.loadCatalogAndSelect(false);
      this.bindControls();
      this.bindInteractivePointer();
      this.startLoop();
    }

    disconnectedCallback() {
      cancelAnimationFrame(this.rafId);
    }

    /**
     * Generates a realistic Hierarchical Poisson-Thomas Clustered Starfield
     * with dense Open Star Clusters, Binary/Trinary companions, and Cosmic Voids.
     */
    private initClusteredDeepFieldSky() {
      // 14 Open Cluster Centers along the galactic band
      const clusterCenters = Array.from({ length: 14 }, () => {
        const theta = Math.random() * Math.PI * 2;
        const phi = Math.acos((Math.random() - 0.5) * 1.25);
        return {
          theta,
          phi,
          spread: 0.045 + Math.random() * 0.085,
        };
      });

      this.backgroundStars = Array.from({ length: 1750 }, (_, i) => {
        let theta: number;
        let phi: number;

        // 48% of stars belong to hierarchical open clusters (power-law two-point correlation)
        if (i < 840) {
          const cluster = clusterCenters[i % clusterCenters.length];
          // Box-Muller Gaussian around cluster core
          const u1 = Math.max(0.0001, Math.random());
          const u2 = Math.random();
          const mag = cluster.spread * Math.sqrt(-2 * Math.log(u1));
          theta = cluster.theta + mag * Math.cos(2 * Math.PI * u2);
          phi = Math.max(0.08, Math.min(Math.PI - 0.08, cluster.phi + mag * Math.sin(2 * Math.PI * u2)));
        } else {
          const u = Math.random();
          const v = Math.random();
          theta = 2 * Math.PI * u;
          phi = i < 1300
            ? Math.acos((Math.random() - 0.5) * 1.4)
            : Math.acos(2 * v - 1);
        }

        let x = Math.sin(phi) * Math.cos(theta);
        let y = Math.sin(phi) * Math.sin(theta);
        let z = Math.cos(phi);
        if (i < 1200 && z < -0.15) z = -z;

        const isSupernova = Math.random() > 0.952;
        const isBinaryPrimary = !isSupernova && Math.random() > 0.91;
        const isTransientTwinkler = Math.random() < 0.78;
        const primarySpec = Math.floor(Math.random() * 6) + 1;
        // Contrasting Planckian companion (e.g. blue B-star paired with amber K-giant)
        const companionSpec = primarySpec <= 2 ? 5 : 1;
        const compAngle = Math.random() * Math.PI * 2;
        const compDist = 2.1 + Math.random() * 1.9;

        return {
          x,
          y,
          z,
          r: isSupernova
            ? 1.35 + Math.random() * 0.72
            : Math.pow(Math.random(), 2.3) * 1.32 + 0.3,
          rgb: specToPlanckianRgb(primarySpec),
          phase1: Math.random() * Math.PI * 2,
          speed1: 0.014 + Math.random() * 0.032,
          phase2: Math.random() * Math.PI * 2,
          speed2: 0.006 + Math.random() * 0.016,
          threshold: isTransientTwinkler ? 0.33 + Math.random() * 0.28 : 0.04,
          maxAlpha: isSupernova ? 0.96 : 0.45 + Math.random() * 0.5,
          isSupernova,
          isBinaryPrimary,
          companionDx: Math.cos(compAngle) * compDist,
          companionDy: Math.sin(compAngle) * compDist,
          companionRgb: specToPlanckianRgb(companionSpec),
        };
      });
    }

    private resizeCanvases() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = this.getBoundingClientRect();
      const w = Math.max(300, Math.floor(rect.width || window.innerWidth * 0.72));
      const h = Math.max(220, Math.floor(rect.height || window.innerHeight * 0.48));
      this.canvasW = w;
      this.canvasH = h;

      this.artefactCanvas.width = Math.floor(w * dpr);
      this.artefactCanvas.height = Math.floor(h * dpr);
      this.aCtx.setTransform(dpr, 0, 0, dpr, 0, 0);

      if (this.currentConstellation) {
        this.currentNebulaPlanes = this.buildNebulaPlanes(this.currentConstellation);
      }
      if (this.outgoingConstellation) {
        this.outgoingNebulaPlanes = this.buildNebulaPlanes(this.outgoingConstellation);
      }
    }

    /**
     * Synthesizes 3 volumetric parallax depth planes pre-warped through the
     * 99th-degree CRT Fisheye lens + Silver-Halide Emulsion Grain.
     */
    private buildNebulaPlanes(c: any): HTMLCanvasElement[] {
      const w = 280;
      const h = 175;

      const planes = [0, 1, 2].map(() => {
        const cvs = document.createElement('canvas');
        cvs.width = w;
        cvs.height = h;
        return cvs;
      });

      const neb = c?.nebula;
      const palette: number[][] = neb?.palette || [
        [198, 74, 106],
        [74, 184, 212],
        [236, 212, 162],
      ];
      const spineAngle = typeof neb?.spineAngle === 'number' ? neb.spineAngle : -0.48;
      const cosA = Math.cos(-spineAngle);
      const sinA = Math.sin(-spineAngle);

      const baryX = (neb?.barycenter?.[0] ?? 5000) / 10000;
      const baryY = (neb?.barycenter?.[1] ?? 5000) / 10000;

      const idNum = parseInt(String(c?.id || '1').replace(/\D/g, ''), 10) || 1;
      const noiseGen = new FractalNebulaNoise(idNum * 7919 + 104729);

      const starsNorm: Array<[number, number]> = (c?.stars || []).slice(0, 6).map((s: any) => [
        s[0] > 1.5 ? s[0] / 10000 : s[0],
        s[1] > 1.5 ? s[1] / 10000 : s[1],
      ]);

      const ctx0 = planes[0].getContext('2d')!;
      const ctx1 = planes[1].getContext('2d')!;
      const ctx2 = planes[2].getContext('2d')!;

      const img0 = ctx0.createImageData(w, h);
      const img1 = ctx1.createImageData(w, h);
      const img2 = ctx2.createImageData(w, h);

      const d0 = img0.data;
      const d1 = img1.data;
      const d2 = img2.data;

      const [r0, g0, b0] = palette[0];
      const [r1, g1, b1] = palette[1];
      const [r2, g2, b2] = palette[2];

      for (let py = 0; py < h; py++) {
        const ny = py / h;
        const dyBary = ny - baryY;

        for (let px = 0; px < w; px++) {
          const nx = px / w;
          const dxBary = nx - baryX;

          // Fisheye dome radial falloff so nebula respects the curved CRT tube
          const cxNorm = (nx - 0.5) * 2;
          const cyNorm = (ny - 0.5) * 2;
          const rDomeSq = cxNorm * cxNorm + cyNorm * cyNorm;
          if (rDomeSq > 1.18) continue;

          const u = dxBary * cosA - dyBary * sinA;
          const v = dxBary * sinA + dyBary * cosA;

          const radialDistSq = u * u * 2.1 + v * v * 5.4;
          const envelope = Math.exp(-radialDistSq * 2.05) * Math.exp(-rDomeSq * 0.65);
          if (envelope < 0.015) continue;

          const sx = (u + 0.5) * 3.4;
          const sy = (v + 0.5) * 3.4;
          const qx = noiseGen.fbm(sx, sy);
          const qy = noiseGen.fbm(sx + 5.2, sy + 1.3);

          const wx = sx + 2.6 * (qx - 0.5);
          const wy = sy + 2.6 * (qy - 0.5);
          const gas = noiseGen.fbm(wx, wy);

          const filamentRidge = noiseGen.ridged(sx * 1.35 + (qx - 0.5) * 1.9, sy * 1.35 + (qy - 0.5) * 1.9);

          const dustField = noiseGen.fbm(wx * 1.45 + 11.7, wy * 1.45 + 4.3);
          const dustCrevice = Math.max(0, dustField - 0.46) * 2.8;
          const extinction = Math.exp(-dustCrevice * dustCrevice * 4.2);

          let starGlow = 0;
          for (let si = 0; si < starsNorm.length; si++) {
            const sdx = nx - starsNorm[si][0];
            const sdy = ny - starsNorm[si][1];
            const dSq = sdx * sdx + sdy * sdy;
            if (dSq < 0.035) {
              starGlow += Math.exp(-dSq * 95) * (si === 0 ? 0.55 : 0.32);
            }
          }

          const idx = (py * w + px) * 4;

          // Plane 0: Deep Cosmic Emission Envelope
          const density0 = Math.max(0, gas - 0.24) * 1.45 * envelope * extinction;
          if (density0 > 0.005) {
            const mix = Math.min(1, Math.max(0, (qx - 0.25) * 1.8));
            d0[idx] = Math.round(r0 * (1 - mix) + r1 * mix);
            d0[idx + 1] = Math.round(g0 * (1 - mix) + g1 * mix);
            d0[idx + 2] = Math.round(b0 * (1 - mix) + b1 * mix);
            d0[idx + 3] = Math.min(255, Math.round(density0 * 66));
          }

          // Plane 1: Mid-Field Gossamer Ionization Filaments
          const wisp = Math.pow(Math.max(0, filamentRidge - 0.22), 1.8) * envelope * (0.4 + 0.6 * extinction);
          const totalMid = Math.min(1, wisp * 1.15 + starGlow * (0.5 + 0.5 * filamentRidge));
          if (totalMid > 0.005) {
            const coreMix = Math.min(1, starGlow * 1.4 + Math.pow(wisp, 2));
            d1[idx] = Math.round(r1 * (1 - coreMix) + r2 * coreMix);
            d1[idx + 1] = Math.round(g1 * (1 - coreMix) + g2 * coreMix);
            d1[idx + 2] = Math.round(b1 * (1 - coreMix) + b2 * coreMix);
            d1[idx + 3] = Math.min(255, Math.round(totalMid * 76));
          }

          // Plane 2: Foreground Fractal Dark Dust Rifts & Shock Threads
          const darkShadow = Math.min(1, Math.pow(Math.max(0, dustField - 0.48) * 2.2, 1.7) * envelope);
          const fineShock = Math.pow(Math.max(0, filamentRidge - 0.52) * 2.1, 2.6) * envelope;
          if (fineShock > 0.01) {
            d2[idx] = r2;
            d2[idx + 1] = g2;
            d2[idx + 2] = b2;
            d2[idx + 3] = Math.min(255, Math.round(fineShock * 60));
          } else if (darkShadow > 0.02) {
            d2[idx] = 4;
            d2[idx + 1] = 6;
            d2[idx + 2] = 11;
            d2[idx + 3] = Math.min(255, Math.round(darkShadow * 140));
          }
        }
      }

      ctx0.putImageData(img0, 0, 0);
      ctx1.putImageData(img1, 0, 0);
      ctx2.putImageData(img2, 0, 0);

      return planes.map((rawCanvas, layerIdx) => {
        const blurred = document.createElement('canvas');
        blurred.width = w;
        blurred.height = h;
        const bCtx = blurred.getContext('2d')!;
        const blurPx = layerIdx === 0 ? 9 : layerIdx === 1 ? 4 : 2.5;
        bCtx.filter = `blur(${blurPx}px)`;
        bCtx.drawImage(rawCanvas, 0, 0);
        bCtx.filter = 'none';
        return blurred;
      });
    }

    private async loadCatalogAndSelect(forceRandom = false) {
      try {
        if (this.catalogIndex.length === 0) {
          const res = await fetch('/data/sky/index.json');
          const data = await res.json();
          this.catalogIndex = data.catalog || [];
        }

        const urlParams = new URLSearchParams(window.location.search);
        const queryId = urlParams.get('sky');
        const featuredId = this.dataset.featuredId;

        let chosenMeta = null;
        if (!forceRandom && queryId) {
          chosenMeta = this.catalogIndex.find((c) => c.id === queryId);
        }
        if (!forceRandom && !chosenMeta && featuredId) {
          chosenMeta = this.catalogIndex.find((c) => c.id === featuredId);
        }
        if (!chosenMeta) {
          const pool =
            this.currentConstellation && this.catalogIndex.length > 1
              ? this.catalogIndex.filter((c) => c.id !== this.currentConstellation.id)
              : this.catalogIndex;
          const idx = Math.floor(Math.random() * pool.length);
          chosenMeta = pool[idx];
        }

        const rawShard = String(chosenMeta.shard);
        const shardName = rawShard.endsWith('.json')
          ? rawShard
          : `shard-${rawShard.padStart(2, '0')}.json`;

        const shardRes = await fetch(`/data/sky/shards/${shardName}`);
        const shardList = await shardRes.json();
        const nextConstellation =
          shardList.find((c: any) => c.id === chosenMeta.id) || shardList[0];
        const nextPlanes = this.buildNebulaPlanes(nextConstellation);

        this.selectedStarIdx = -1;
        document.getElementById('star-inset-popup')?.setAttribute('hidden', '');

        if (this.currentConstellation && forceRandom) {
          this.outgoingConstellation = this.currentConstellation;
          this.outgoingNebulaPlanes = this.currentNebulaPlanes;
          this.outgoingDrawProgress = this.drawProgress;

          this.currentConstellation = nextConstellation;
          this.currentNebulaPlanes = nextPlanes;
          this.drawProgress = 0;
          this.transitionBlend = 0;

          const dirX = Math.random() > 0.5 ? 1 : -1;
          const dirY = (Math.random() - 0.5) * 0.8;
          this.slewVX = dirX * 0.0042;
          this.slewVY = dirY * 0.0022;

          this.crossDissolveHud();
        } else {
          this.currentConstellation = nextConstellation;
          this.currentNebulaPlanes = nextPlanes;
          this.drawProgress = 0;
          this.transitionBlend = 1;
          this.updateHud();
        }
      } catch (err) {
        console.error('[DRC Sky Engine] Failed to load constellation shard:', err);
      }
    }

    private crossDissolveHud() {
      const cluster = document.getElementById('sky-title-cluster');
      const statusEl = document.getElementById('hud-telemetry-status');
      if (statusEl) statusEl.textContent = 'SLEWING // FISHEYE DOME';
      cluster?.classList.add('is-slew-fading');

      window.setTimeout(() => {
        this.updateHud();
        cluster?.classList.remove('is-slew-fading');
      }, 420);

      window.setTimeout(() => {
        if (statusEl) statusEl.textContent = 'ACTIVE // J2000.0';
      }, 1450);
    }

    private spawnShootingStar() {
      this.shootingStars.push({
        x: 0.48 + Math.random() * 0.38,
        y: 0.08 + Math.random() * 0.25,
        born: this.frameCount,
      });
    }

    private updateHud() {
      if (!this.currentConstellation) return;
      const c = this.currentConstellation;
      const idEl = document.getElementById('hud-constellation-id');
      const nodeCountEl = document.getElementById('hud-node-count');
      const nebEl = document.getElementById('hud-nebula-designation');
      const nameEl = document.getElementById('hud-constellation-name');
      const meaningEl = document.getElementById('hud-constellation-meaning');
      const coordsEl = document.getElementById('hud-constellation-coords');
      const anomalyEl = document.getElementById('crt-anomaly-readout');

      if (idEl) idEl.textContent = c.id;
      if (nodeCountEl) nodeCountEl.textContent = `${c.stars?.length || 0} NODES`;
      if (nebEl) {
        nebEl.textContent = c.nebula?.designation || 'NGC 2244 · H II Emission Field';
      }
      if (nameEl) nameEl.textContent = c.name;
      if (meaningEl) meaningEl.textContent = c.meaning || c.english || '';
      if (coordsEl) coordsEl.textContent = `RA ${c.ra} · DEC ${c.dec}`;
      if (anomalyEl && c.redactedSector) {
        anomalyEl.textContent = `${c.redactedSector.code} · Δm ${c.redactedSector.extinction}`;
      }
    }

    private bindControls() {
      document.getElementById('btn-new-constellation')?.addEventListener('click', () => {
        this.loadCatalogAndSelect(true);
      });

      document.getElementById('btn-copy-sky-link')?.addEventListener('click', (e) => {
        if (!this.currentConstellation) return;
        const btn = e.currentTarget as HTMLButtonElement;
        const url = new URL(window.location.href);
        url.searchParams.set('sky', this.currentConstellation.id);
        navigator.clipboard?.writeText(url.toString());
        const orig = btn.textContent;
        btn.textContent = '✓ Copied Link';
        setTimeout(() => (btn.textContent = orig), 1800);
      });

      document.getElementById('btn-export-chart')?.addEventListener('click', () => {
        this.exportHighResChart();
      });

      const autoBtn = document.getElementById('btn-auto-rotate');
      const modeEl = document.getElementById('hud-orbital-mode');
      autoBtn?.addEventListener('click', () => {
        this.autoRotate = !this.autoRotate;
        autoBtn.textContent = `[ AUTO: ${this.autoRotate ? 'ON' : 'OFF'} ]`;
        autoBtn.classList.toggle('is-active', this.autoRotate);
        if (modeEl) {
          modeEl.textContent = this.autoRotate ? 'ORBITAL_AUTOPILOT' : 'STATIONARY_LOCK';
        }
        if (this.autoRotate) {
          this.vX = 0.00014;
          this.vY = 0.00007;
        }
      });

      document.getElementById('btn-meteor-shower')?.addEventListener('click', () => {
        this.spawnShootingStar();
      });

      document.getElementById('inset-close-btn')?.addEventListener('click', () => {
        this.selectedStarIdx = -1;
        document.getElementById('star-inset-popup')?.setAttribute('hidden', '');
      });
    }

    private bindInteractivePointer() {
      const canvas = this.artefactCanvas;
      const modeEl = document.getElementById('hud-orbital-mode');

      canvas.addEventListener('pointerdown', (e) => {
        this.isDragging = true;
        const rect = canvas.getBoundingClientRect();
        this.dragStart = { x: e.clientX - rect.left, y: e.clientY - rect.top };
        this.lastPointer = { x: e.clientX - rect.left, y: e.clientY - rect.top };
        if (modeEl) modeEl.textContent = 'MANUAL_OVERRIDE';
      });

      window.addEventListener('pointermove', (e) => {
        const rect = canvas.getBoundingClientRect();
        const localX = e.clientX - rect.left;
        const localY = e.clientY - rect.top;
        if (this.isDragging) {
          const dx = localX - this.lastPointer.x;
          const dy = localY - this.lastPointer.y;
          this.vX = dx * 0.0014;
          this.vY = dy * 0.0014;
          this.rotX += this.vX;
          this.rotY = Math.max(-0.48, Math.min(0.48, this.rotY + this.vY));
        }
        this.lastPointer = { x: localX, y: localY };
      }, { passive: true });

      window.addEventListener('pointerup', (e) => {
        if (!this.isDragging) return;
        this.isDragging = false;
        if (modeEl) {
          modeEl.textContent = this.autoRotate ? 'ORBITAL_AUTOPILOT' : 'STATIONARY_LOCK';
        }
        const rect = canvas.getBoundingClientRect();
        const localX = e.clientX - rect.left;
        const localY = e.clientY - rect.top;
        const dist = Math.hypot(localX - this.dragStart.x, localY - this.dragStart.y);
        if (dist < 6 && this.hoveredStarIdx !== -1) {
          this.openStarInsetPopup(this.hoveredStarIdx);
        }
      });
    }

    private openStarInsetPopup(idx: number) {
      this.selectedStarIdx = idx;
      const star = this.projectedPrincipalStars.find((s) => s.idx === idx);
      const popup = document.getElementById('star-inset-popup');
      if (!star || !popup || !this.currentConstellation) return;

      const greek = BAYER_GREEK[idx] || '★';
      const bayerName = BAYER_NAMES[idx] || `Node ${idx + 1}`;
      const c = this.currentConstellation;

      const desigEl = document.getElementById('inset-star-designation');
      const magEl = document.getElementById('inset-star-mag');
      const specEl = document.getElementById('inset-star-spectral');
      const titleEl = document.getElementById('inset-star-title');
      const coordsEl = document.getElementById('inset-star-coords');
      const previewEl = document.getElementById('inset-star-preview');
      const fluxFill = document.getElementById('inset-flux-fill');
      const fluxVal = document.getElementById('inset-flux-val');

      if (desigEl) desigEl.textContent = `ASTROMETRIC_LOG // ${greek} NODE`;
      if (magEl) magEl.textContent = `MAG ${star.mag.toFixed(2)}`;
      if (specEl) specEl.textContent = specToLabel(star.spec);
      if (titleEl) titleEl.textContent = `${bayerName} ${c.name}`;
      if (coordsEl) coordsEl.textContent = `RA ${c.ra} · DEC ${c.dec}`;

      const [r, g, b] = star.rgb;
      if (previewEl) {
        previewEl.style.background = `rgb(${r}, ${g}, ${b})`;
        previewEl.style.boxShadow = `0 0 14px 4px rgb(${r}, ${g}, ${b}), 0 0 34px 12px rgba(${r}, ${g}, ${b}, 0.65)`;
      }

      const lumPct = Math.round(Math.max(22, Math.min(99, (4.0 - star.mag) * 28)));
      if (fluxFill) fluxFill.style.width = `${lumPct}%`;
      if (fluxVal) fluxVal.textContent = `${lumPct}% FLUX`;

      const rect = this.artefactCanvas.getBoundingClientRect();
      const pageX = rect.left + star.x;
      const pageY = rect.top + star.y;

      const left = Math.min(Math.max(20, pageX + 24), window.innerWidth - 335);
      const top = Math.min(Math.max(84, pageY - 52), window.innerHeight - 280);
      popup.style.left = `${left}px`;
      popup.style.top = `${top}px`;
      popup.removeAttribute('hidden');
    }

    private startLoop() {
      const step = (time: number) => {
        this.frameCount++;

        if (this.transitionBlend < 1) {
          this.transitionBlend = Math.min(1, this.transitionBlend + 0.0075);
          if (this.transitionBlend >= 1) {
            this.outgoingConstellation = null;
            this.outgoingNebulaPlanes = [];
          }
        }

        this.drawProgress = Math.min(1, this.drawProgress + 0.0044);

        this.slewVX *= 0.955;
        this.slewVY *= 0.955;

        if (!this.isDragging) {
          if (this.autoRotate) {
            this.vX *= 0.97;
            this.vY *= 0.97;
            if (Math.abs(this.vX) < 0.00014) this.vX = (this.vX >= 0 ? 1 : -1) * 0.00014;
            if (Math.abs(this.vY) < 0.00007) this.vY = (this.vY >= 0 ? 1 : -1) * 0.00007;
          } else {
            this.vX *= 0.92;
            this.vY *= 0.92;
          }
          this.rotX += this.vX + this.slewVX;
          this.rotY = Math.max(-0.46, Math.min(0.46, this.rotY + this.vY + this.slewVY));
        }

        // Advance NOSS Reconnaissance Satellite Triplet across orbital inclination chord
        this.satelliteTriad.progress += 0.00075;
        if (this.satelliteTriad.progress > 1.25) {
          this.satelliteTriad.progress = -0.15;
          this.satelliteTriad.startX = 0.08 + Math.random() * 0.18;
          this.satelliteTriad.startY = 0.65 + Math.random() * 0.25;
          this.satelliteTriad.endX = 0.75 + Math.random() * 0.18;
          this.satelliteTriad.endY = 0.12 + Math.random() * 0.25;
          this.satelliteTriad.shadowCutoff = 0.62 + Math.random() * 0.22;
        }

        if (this.frameCount % 620 === 0 && Math.random() > 0.35) {
          this.spawnShootingStar();
        }

        if (this.frameCount % 30 === 0) {
          const spinEl = document.getElementById('hud-spin-speed');
          if (spinEl) {
            const totalV = Math.hypot(this.vX + this.slewVX, this.vY + this.slewVY);
            const degPerFrame = (totalV * (180 / Math.PI)).toFixed(3);
            spinEl.textContent = `${degPerFrame}°/f`;
          }
        }

        this.renderFrame(time, this.aCtx, this.canvasW, this.canvasH);
        this.rafId = requestAnimationFrame(step);
      };
      this.rafId = requestAnimationFrame(step);
    }

    /**
     * Helper to trace a straight line in celestial space as a 26-segment curve
     * warped through the 99th-degree CRT Fisheye lens.
     */
    private traceFisheyeCurve(
      ctx: CanvasRenderingContext2D,
      x0: number,
      y0: number,
      x1: number,
      y1: number,
      w: number,
      h: number,
      radialOffsetPx = 0
    ) {
      const SEGMENTS = 26;
      ctx.beginPath();
      for (let s = 0; s <= SEGMENTS; s++) {
        const t = s / SEGMENTS;
        const lx = x0 + (x1 - x0) * t;
        const ly = y0 + (y1 - y0) * t;
        const p = projectFisheyeCRT(lx, ly, w, h);
        const disp = radialOffsetPx * Math.pow(p.rNorm, 2.4);
        const fx = p.x + p.ux * disp;
        const fy = p.y + p.uy * disp;
        if (s === 0) ctx.moveTo(fx, fy);
        else ctx.lineTo(fx, fy);
      }
    }

    /**
     * Composites the 3 volumetric nebula depth planes with differential parallax
     * inside the CRT fisheye dome.
     */
    private drawVolumetricNebulaPlanes(
      ctx: CanvasRenderingContext2D,
      planes: HTMLCanvasElement[],
      w: number,
      h: number,
      rotOffsetX: number,
      rotOffsetY: number,
      masterAlpha: number
    ) {
      if (!planes || planes.length === 0 || masterAlpha <= 0.004) return;
      const parallaxFactors = [0.25, 0.72, 1.25];
      const pad = 36;

      for (let i = 0; i < planes.length; i++) {
        const plane = planes[i];
        if (!plane) continue;
        const pFactor = parallaxFactors[i] ?? 0.65;
        const ox = rotOffsetX * pFactor;
        const oy = rotOffsetY * pFactor;
        const breath = 1.08 + Math.sin(this.frameCount * 0.0055 + i * 1.7) * 0.016;

        ctx.save();
        ctx.globalAlpha = masterAlpha * (i === 1 ? 0.98 : 0.88);
        if (i === 1) {
          ctx.globalCompositeOperation = 'screen';
        }
        const dw = (w + pad * 2) * breath;
        const dh = (h + pad * 2) * breath;
        const dx = (w - dw) * 0.5 + ox;
        const dy = (h - dh) * 0.5 + oy;
        ctx.drawImage(plane, dx, dy, dw, dh);
        ctx.restore();
      }
    }

    /**
     * Renders curved J2000.0 Right Ascension & Declination celestial graticule arcs
     * warped through the 99th-degree CRT fisheye lens.
     */
    private renderCurvedEquatorialGraticule(
      ctx: CanvasRenderingContext2D,
      w: number,
      h: number,
      rotOffsetX: number,
      rotOffsetY: number
    ) {
      ctx.save();
      ctx.lineWidth = 0.65;
      ctx.strokeStyle = 'rgba(127, 212, 255, 0.065)';

      // 5 Declination parallels + 5 Right Ascension meridians warped through fisheye
      for (let i = -2; i <= 2; i++) {
        const yBase = h * 0.5 + i * (h * 0.21) + (rotOffsetY * 0.45) % (h * 0.21);
        this.traceFisheyeCurve(ctx, -w * 0.1, yBase, w * 1.1, yBase, w, h);
        ctx.stroke();

        const xBase = w * 0.5 + i * (w * 0.21) + (rotOffsetX * 0.45) % (w * 0.21);
        this.traceFisheyeCurve(ctx, xBase, -h * 0.1, xBase, h * 1.1, w, h);
        ctx.stroke();
      }

      // Optical Axis Center Crosshair & Fisheye Field-of-View Calibration Ring
      const cx = w * 0.5;
      const cy = h * 0.5;
      ctx.strokeStyle = 'rgba(218, 195, 142, 0.11)';
      ctx.setLineDash([2, 6]);
      ctx.beginPath();
      ctx.ellipse(cx, cy, w * 0.39, h * 0.39, 0, 0, Math.PI * 2);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.restore();
    }

    /**
     * Renders Deep-Field Galaxies, Uncharted Sub-Asterisms, Redacted Bok Occlusion Sector,
     * and the Principal Constellation Figure through the 99th-degree CRT Fisheye lens.
     */
    private renderConstellationFigure(
      ctx: CanvasRenderingContext2D,
      c: any,
      w: number,
      h: number,
      vaultRad: number,
      rotOffsetX: number,
      rotOffsetY: number,
      progress: number,
      opacityScale: number,
      isInteractivePrimary: boolean
    ) {
      if (!c || opacityScale <= 0.005) return;

      const padX = w * 0.16;
      const padY = h * 0.15;
      const drawW = w - padX * 2;
      const drawH = h - padY * 2;

      const driftScale = isInteractivePrimary ? 1 : 1 - (1 - opacityScale) * 0.04;
      const centerX = w * 0.5;
      const centerY = h * 0.5;

      // 1. Deep-Field Elliptical Galaxies & Globular Clusters (PGC / Palomar smudges)
      if (Array.isArray(c.deepFieldObjects)) {
        for (const dso of c.deepFieldObjects) {
          const [gx, gy, grx, gry, gAngle, gType, gDesig] = dso;
          const rawX = padX + (gx / 10000) * drawW + rotOffsetX * 0.35;
          const rawY = padY + (gy / 10000) * drawH + rotOffsetY * 0.35;
          const fp = projectFisheyeCRT(rawX, rawY, w, h);
          const rxPx = (grx / 10000) * w * fp.scale * 1.15;
          const ryPx = (gry / 10000) * w * fp.scale * 1.15;

          ctx.save();
          ctx.translate(fp.x, fp.y);
          ctx.rotate(gAngle);
          const gGrad = ctx.createRadialGradient(0, 0, 0, 0, 0, rxPx);
          gGrad.addColorStop(0, `rgba(255, 232, 188, ${(0.34 * opacityScale).toFixed(3)})`);
          gGrad.addColorStop(0.45, `rgba(214, 184, 138, ${(0.14 * opacityScale).toFixed(3)})`);
          gGrad.addColorStop(1, 'rgba(214, 184, 138, 0)');
          ctx.fillStyle = gGrad;
          ctx.scale(1, Math.max(0.32, ryPx / Math.max(1, rxPx)));
          ctx.beginPath();
          ctx.arc(0, 0, rxPx, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();

          if (progress > 0.55) {
            ctx.fillStyle = `rgba(127, 212, 255, ${(0.28 * opacityScale).toFixed(3)})`;
            ctx.font = '8.5px monospace';
            ctx.fillText(gDesig, fp.x + rxPx * 0.65, fp.y - 4);
          }
        }
      }

      // 2. Uncharted Background Sub-Asterisms (faint 3-star micro-triangles)
      if (Array.isArray(c.unchartedAsterisms) && progress > 0.35) {
        const subAlpha = Math.min(1, (progress - 0.35) / 0.45) * opacityScale;
        for (const ast of c.unchartedAsterisms) {
          const pts = (ast.stars || []).map((s: number[]) => {
            const rx = padX + (s[0] / 10000) * drawW + rotOffsetX * 0.45;
            const ry = padY + (s[1] / 10000) * drawH + rotOffsetY * 0.45;
            return { rawX: rx, rawY: ry, proj: projectFisheyeCRT(rx, ry, w, h) };
          });
          ctx.save();
          ctx.setLineDash([2, 4]);
          ctx.strokeStyle = `rgba(127, 212, 255, ${(0.16 * subAlpha).toFixed(3)})`;
          ctx.lineWidth = 0.65;
          for (const [u, v] of ast.edges || []) {
            if (pts[u] && pts[v]) {
              this.traceFisheyeCurve(ctx, pts[u].rawX, pts[u].rawY, pts[v].rawX, pts[v].rawY, w, h);
              ctx.stroke();
            }
          }
          ctx.setLineDash([]);
          for (const pt of pts) {
            ctx.fillStyle = `rgba(205, 228, 255, ${(0.45 * subAlpha).toFixed(3)})`;
            ctx.beginPath();
            ctx.arc(pt.proj.x, pt.proj.y, 1.3 * pt.proj.scale, 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.restore();
        }
      }

      // 3. Redacted Bok Globule Occlusion Anomaly Callout Box
      if (c.redactedSector && progress > 0.5) {
        const rs = c.redactedSector;
        const rxRaw = padX + (rs.x / 10000) * drawW + rotOffsetX * 0.52;
        const ryRaw = padY + (rs.y / 10000) * drawH + rotOffsetY * 0.52;
        const rp = projectFisheyeCRT(rxRaw, ryRaw, w, h);
        const boxR = Math.max(14, (rs.r / 10000) * Math.min(w, h) * rp.scale * 0.85);
        const rAlpha = Math.min(1, (progress - 0.5) / 0.4) * opacityScale;

        ctx.save();
        // Dark Bok Globule core occluding background light
        const bokGrad = ctx.createRadialGradient(rp.x, rp.y, 0, rp.x, rp.y, boxR * 1.35);
        bokGrad.addColorStop(0, `rgba(2, 3, 7, ${(0.88 * rAlpha).toFixed(3)})`);
        bokGrad.addColorStop(0.7, `rgba(2, 3, 7, ${(0.45 * rAlpha).toFixed(3)})`);
        bokGrad.addColorStop(1, 'rgba(2, 3, 7, 0)');
        ctx.fillStyle = bokGrad;
        ctx.beginPath();
        ctx.arc(rp.x, rp.y, boxR * 1.35, 0, Math.PI * 2);
        ctx.fill();

        // Dashed Redacted Telemetry Reticle
        ctx.strokeStyle = `rgba(255, 110, 95, ${(0.34 * rAlpha).toFixed(3)})`;
        ctx.lineWidth = 0.75;
        ctx.setLineDash([3, 3]);
        ctx.strokeRect(rp.x - boxR, rp.y - boxR * 0.72, boxR * 2, boxR * 1.44);
        ctx.setLineDash([]);

        ctx.fillStyle = `rgba(255, 135, 120, ${(0.52 * rAlpha).toFixed(3)})`;
        ctx.font = '8px monospace';
        ctx.fillText(`[REDACTED // ${rs.code}]`, rp.x - boxR, rp.y - boxR * 0.72 - 4);
        ctx.restore();
      }

      // 4. Project Principal Constellation Stars through the 99th-degree Fisheye CRT Dome
      let nextHovered = -1;
      const projected: ProjectedStar[] = c.stars.map(
        (s: [number, number, number, number], idx: number) => {
          const normX = s[0] > 1.5 ? s[0] / 10000 : s[0];
          const normY = s[1] > 1.5 ? s[1] / 10000 : s[1];

          const parallaxFactor = 0.72 + (idx % 3) * 0.14;
          const rawX0 = padX + normX * drawW + rotOffsetX * parallaxFactor;
          const rawY0 = padY + normY * drawH + rotOffsetY * parallaxFactor;

          // Kolmogorov atmospheric seeing micro-jitter (±0.22px)
          const seeX = Math.sin(this.frameCount * 0.09 + idx * 3.1) * 0.22;
          const seeY = Math.cos(this.frameCount * 0.08 + idx * 2.7) * 0.22;

          const undistX = centerX + (rawX0 - centerX) * driftScale + seeX;
          const undistY = centerY + (rawY0 - centerY) * driftScale + seeY;

          const fp = projectFisheyeCRT(undistX, undistY, w, h);
          const rgb = specToPlanckianRgb(s[3]);

          if (
            isInteractivePrimary &&
            !this.isDragging &&
            Math.hypot(fp.x - this.lastPointer.x, fp.y - this.lastPointer.y) < 24
          ) {
            nextHovered = idx;
          }

          return {
            idx,
            rawX: undistX,
            rawY: undistY,
            x: fp.x,
            y: fp.y,
            scale: fp.scale,
            rNorm: fp.rNorm,
            ux: fp.ux,
            uy: fp.uy,
            mag: s[2],
            spec: s[3],
            rgb,
          };
        }
      );

      if (isInteractivePrimary) {
        this.projectedPrincipalStars = projected;
        this.hoveredStarIdx = nextHovered;
      }

      // 4A. Secondary Ghost Construction Chords (warped through Fisheye lens)
      if (Array.isArray(c.ghostChords) && progress > 0.65) {
        const chordAlpha = Math.min(1, (progress - 0.65) / 0.35) * 0.24 * opacityScale;
        ctx.save();
        ctx.setLineDash([3, 7]);
        ctx.strokeStyle = `rgba(218, 195, 142, ${chordAlpha.toFixed(3)})`;
        ctx.lineWidth = 0.8;
        for (const [u, v] of c.ghostChords) {
          const p1 = projected[u];
          const p2 = projected[v];
          if (!p1 || !p2) continue;
          this.traceFisheyeCurve(ctx, p1.rawX, p1.rawY, p2.rawX, p2.rawY, w, h);
          ctx.stroke();
        }
        ctx.restore();
      }

      // 4B. Primary Intaglio Silverpoint Constellation Edges (Bowed Fisheye Chords + CRT Chromatic Dispersion)
      const totalEdges = c.edges.length;
      const easedProgress = 1 - Math.pow(1 - progress, 2.4);
      const activeEdges = easedProgress * totalEdges;

      c.edges.forEach((edge: [number, number], idx: number) => {
        if (idx > activeEdges) return;
        const p1 = projected[edge[0]];
        const p2 = projected[edge[1]];
        if (!p1 || !p2) return;

        const segProgress = Math.min(1, activeEdges - idx);
        const dx = p2.rawX - p1.rawX;
        const dy = p2.rawY - p1.rawY;
        const dist = Math.hypot(dx, dy);
        const gap = 8;
        if (dist <= gap * 2.2) return;

        const ux = dx / dist;
        const uy = dy / dist;

        const retractStart = isInteractivePrimary ? 0 : Math.pow(1 - opacityScale, 1.3);
        const sx0 = p1.rawX + ux * gap + (dist - gap * 2) * ux * retractStart;
        const sy0 = p1.rawY + uy * gap + (dist - gap * 2) * uy * retractStart;
        const fullEx = p2.rawX - ux * gap;
        const fullEy = p2.rawY - uy * gap;

        const ex = sx0 + (fullEx - sx0) * segProgress;
        const ey = sy0 + (fullEy - sy0) * segProgress;

        const linePhase = (edge[0] * 2.4 + edge[1] * 1.7) % (Math.PI * 2);
        const glimmer = Math.pow((Math.sin(this.frameCount * 0.014 + linePhase) + 1) * 0.5, 2);

        ctx.save();

        // 99th-Degree CRT Electron-Gun Lateral Chromatic Dispersion on Chords (Red & Cyan split near rim)
        ctx.strokeStyle = `rgba(255, 70, 90, ${(0.22 * opacityScale).toFixed(3)})`;
        ctx.lineWidth = 1.05;
        this.traceFisheyeCurve(ctx, sx0, sy0, ex, ey, w, h, +4.2);
        ctx.stroke();

        ctx.strokeStyle = `rgba(80, 220, 255, ${(0.22 * opacityScale).toFixed(3)})`;
        ctx.lineWidth = 1.05;
        this.traceFisheyeCurve(ctx, sx0, sy0, ex, ey, w, h, -4.2);
        ctx.stroke();

        // Outer phosphor bloom along the curved chord
        ctx.strokeStyle = `rgba(218, 195, 142, ${(0.16 * opacityScale).toFixed(3)})`;
        ctx.lineWidth = 3.4;
        this.traceFisheyeCurve(ctx, sx0, sy0, ex, ey, w, h, 0);
        ctx.stroke();

        // Core silverpoint engraved line
        const baseA = ((0.52 + glimmer * 0.18) * opacityScale).toFixed(3);
        ctx.strokeStyle = `rgba(255, 242, 205, ${baseA})`;
        ctx.lineWidth = 1.25 + glimmer * 0.35;
        this.traceFisheyeCurve(ctx, sx0, sy0, ex, ey, w, h, 0);
        ctx.stroke();

        ctx.restore();
      });

      // 5. Render Principal Constellation Stars with Newton's Interference Rings, Spider-Vane Spikes & CRT RGB Split
      projected.forEach((p, idx) => {
        const [r, g, b] = p.rgb;
        const baseRadius = Math.max(2.0, (4.5 - p.mag * 0.68) * Math.pow(p.scale, 0.55));
        const isHov = isInteractivePrimary && idx === this.hoveredStarIdx;
        const isSel = isInteractivePrimary && idx === this.selectedStarIdx;
        const radius = baseRadius * (isSel ? 1.48 : isHov ? 1.26 : 1);

        // 99th-Degree CRT Lateral Chromatic Aberration ghosts on peripheral stars
        const caOffset = Math.pow(p.rNorm, 2.3) * 5.2;
        if (caOffset > 0.45) {
          ctx.fillStyle = `rgba(255, 65, 85, ${(0.42 * opacityScale).toFixed(3)})`;
          ctx.beginPath();
          ctx.arc(p.x + p.ux * caOffset, p.y + p.uy * caOffset, radius * 0.72, 0, Math.PI * 2);
          ctx.fill();

          ctx.fillStyle = `rgba(75, 225, 255, ${(0.42 * opacityScale).toFixed(3)})`;
          ctx.beginPath();
          ctx.arc(p.x - p.ux * caOffset, p.y - p.uy * caOffset, radius * 0.72, 0, Math.PI * 2);
          ctx.fill();
        }

        // Zone C: Wide atmospheric halation
        const haloRadius = radius * 8.2;
        const halo = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, haloRadius);
        const coreHaloA = (isSel || isHov ? 0.64 : 0.44) * opacityScale;
        halo.addColorStop(0, `rgba(${r}, ${g}, ${b}, ${coreHaloA.toFixed(3)})`);
        halo.addColorStop(0.38, `rgba(${r}, ${g}, ${b}, ${(0.15 * opacityScale).toFixed(3)})`);
        halo.addColorStop(1, `rgba(${r}, ${g}, ${b}, 0)`);
        ctx.fillStyle = halo;
        ctx.beginPath();
        ctx.arc(p.x, p.y, haloRadius, 0, Math.PI * 2);
        ctx.fill();

        // Palomar Glass-Plate Concentric Dichroic Newton's Interference Ring on Alpha/Beta nodes
        if (idx <= 1 || isHov || isSel) {
          ctx.save();
          ctx.strokeStyle = `rgba(127, 212, 255, ${(0.18 * opacityScale).toFixed(3)})`;
          ctx.lineWidth = 0.7;
          ctx.beginPath();
          ctx.arc(p.x, p.y, radius * 3.8, 0, Math.PI * 2);
          ctx.stroke();

          ctx.strokeStyle = `rgba(232, 202, 145, ${(0.14 * opacityScale).toFixed(3)})`;
          ctx.beginPath();
          ctx.arc(p.x, p.y, radius * 5.1, 0, Math.PI * 2);
          ctx.stroke();
          ctx.restore();
        }

        // Zone B: 4-Point Secondary-Mirror Spider-Vane Diffraction Spikes
        if (p.mag < 2.2 || isHov || isSel) {
          const spikeLen = radius * (isSel ? 9.8 : 7.4);
          const spikeA = (isSel || isHov ? 0.75 : 0.52) * opacityScale;
          ctx.strokeStyle = `rgba(${r}, ${g}, ${b}, ${spikeA.toFixed(3)})`;
          ctx.lineWidth = 0.75;
          ctx.beginPath();
          ctx.moveTo(p.x - spikeLen, p.y);
          ctx.lineTo(p.x + spikeLen, p.y);
          ctx.moveTo(p.x, p.y - spikeLen);
          ctx.lineTo(p.x, p.y + spikeLen);
          ctx.stroke();
        }

        // Zone A: Pinpoint incandescent core
        ctx.fillStyle = `rgba(255, 255, 255, ${opacityScale.toFixed(3)})`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, radius * 0.78, 0, Math.PI * 2);
        ctx.fill();

        // Rotating 4-Corner Target Reticle on Hovered or Selected Star
        if (isHov || isSel) {
          const tSize = 14;
          const rot = this.frameCount * 0.018;
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate(rot);
          ctx.strokeStyle = `rgba(232, 222, 181, ${(0.92 * opacityScale).toFixed(3)})`;
          ctx.lineWidth = 1.1;
          for (let corner = 0; corner < 4; corner++) {
            ctx.beginPath();
            ctx.moveTo(-tSize, -tSize + tSize * 0.48);
            ctx.lineTo(-tSize, -tSize);
            ctx.lineTo(-tSize + tSize * 0.48, -tSize);
            ctx.stroke();
            ctx.rotate(Math.PI * 0.5);
          }
          ctx.restore();
        } else if (idx === 0 || idx === 1) {
          ctx.strokeStyle = `rgba(218, 195, 142, ${(0.42 * opacityScale).toFixed(3)})`;
          ctx.lineWidth = 0.75;
          ctx.beginPath();
          ctx.arc(p.x, p.y, 7.2, 0, Math.PI * 2);
          ctx.stroke();
        }

        // Bayer Greek letter designation
        if (idx < BAYER_GREEK.length && progress > 0.25) {
          const labelA = (isHov || isSel ? 1 : 0.84) * opacityScale;
          ctx.fillStyle = `rgba(218, 195, 142, ${labelA.toFixed(3)})`;
          ctx.font = '11.5px Georgia, serif';
          ctx.fillText(BAYER_GREEK[idx], p.x + 10, p.y - 7);
        }
      });
    }

    /**
     * Renders bowed horizontal CRT phosphor scanlines & peripheral CRT glass curvature shadow
     */
    private renderCRTScanlinesAndCurvature(ctx: CanvasRenderingContext2D, w: number, h: number) {
      ctx.save();
      ctx.strokeStyle = 'rgba(0, 0, 0, 0.26)';
      ctx.lineWidth = 1;

      // Bowed CRT scanlines that curve with the vertical barrel distortion of the tube
      const stepY = 4;
      for (let y = 0; y < h; y += stepY) {
        const ny = (y / h - 0.5) * 2;
        const bow = ny * 18;
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.quadraticCurveTo(w * 0.5, y + bow, w, y);
        ctx.stroke();
      }
      ctx.restore();
    }

    private renderFrame(
      time: number,
      ctx: CanvasRenderingContext2D,
      w: number,
      h: number
    ) {
      ctx.clearRect(0, 0, w, h);

      const cx = Math.cos(this.rotX);
      const sx = Math.sin(this.rotX);
      const cy = Math.cos(this.rotY);
      const sy = Math.sin(this.rotY);

      const maxEdge = Math.max(w, h);
      const minEdge = Math.min(w, h);
      const uniRad = maxEdge * 0.76;
      const uniFov = maxEdge * 1.25;
      const vaultRad = minEdge * 0.4 * this.zoom;

      const rotOffsetX = Math.sin(this.rotX * 1.35) * (vaultRad * 0.28);
      const rotOffsetY = Math.sin(this.rotY * 1.35) * (vaultRad * 0.28);

      // 0. Draw 3-Layer Volumetric Parallax Nebulae
      const smoothBlend = quinticSmoothstep(this.transitionBlend);
      if (this.outgoingNebulaPlanes.length > 0 && smoothBlend < 1) {
        this.drawVolumetricNebulaPlanes(
          ctx,
          this.outgoingNebulaPlanes,
          w,
          h,
          rotOffsetX,
          rotOffsetY,
          1 - smoothBlend
        );
      }
      this.drawVolumetricNebulaPlanes(
        ctx,
        this.currentNebulaPlanes,
        w,
        h,
        rotOffsetX,
        rotOffsetY,
        smoothBlend
      );

      // 0B. Curved J2000.0 Equatorial RA/DEC Graticule Sphere
      this.renderCurvedEquatorialGraticule(ctx, w, h, rotOffsetX, rotOffsetY);

      // 1. Hierarchical Clustered Starfield + Binary Systems + Kolmogorov Chromatic Scintillation
      for (const s of this.backgroundStars) {
        const x1 = s.x * cx - s.z * sx;
        const z1 = s.z * cx + s.x * sx;
        const y2 = s.y * cy - z1 * sy;
        const z2 = z1 * cy + s.y * sy;
        if (z2 < -0.55) continue;

        const scale3D = uniFov / (uniFov + z2 * uniRad);
        const rawX = w * 0.5 + x1 * uniRad * scale3D;
        const rawY = h * 0.5 + y2 * uniRad * scale3D;
        if (rawX < -30 || rawX > w + 30 || rawY < -30 || rawY > h + 30) continue;

        // Project every background star through the 99th-degree CRT Fisheye lens!
        const fp = projectFisheyeCRT(rawX, rawY, w, h);
        if (fp.rNorm > 1.16) continue;

        const w1 = Math.sin(this.frameCount * s.speed1 + s.phase1);
        const w2 = Math.cos(this.frameCount * s.speed2 + s.phase2);
        const wave = (w1 * 0.62 + w2 * 0.38 + 1) * 0.5;
        if (wave <= s.threshold) continue;

        const normWave = (wave - s.threshold) / (1 - s.threshold);
        const twinkle = normWave * normWave * (3 - 2 * normWave);
        const depthFade = Math.max(0.18, Math.min(1, (1 - z2 * 0.5) * 0.92));
        const rimFade = Math.max(0.1, 1 - Math.pow(fp.rNorm, 3.6) * 0.78);
        const alpha = twinkle * s.maxAlpha * depthFade * rimFade;
        if (alpha < 0.02) continue;

        // Kolmogorov chromatic scintillation: momentary cyan or crimson shift during high wavefront turbulence
        let [r, g, b] = s.rgb;
        if (s.isSupernova && w1 > 0.78) {
          r = Math.min(255, r + 35);
          b = Math.max(150, b - 30);
        } else if (w2 < -0.82) {
          b = Math.min(255, b + 40);
        }

        const starRad = s.r * Math.pow(fp.scale, 0.65);

        // Peripheral CRT RGB Chromatic Dispersion on bright background stars
        if (s.isSupernova && fp.rNorm > 0.38) {
          const ca = Math.pow(fp.rNorm, 2.2) * 3.4;
          ctx.fillStyle = `rgba(255, 65, 85, ${(alpha * 0.45).toFixed(3)})`;
          ctx.fillRect(fp.x + fp.ux * ca - 0.8, fp.y + fp.uy * ca - 0.8, 1.6, 1.6);
          ctx.fillStyle = `rgba(75, 225, 255, ${(alpha * 0.45).toFixed(3)})`;
          ctx.fillRect(fp.x - fp.ux * ca - 0.8, fp.y - fp.uy * ca - 0.8, 1.6, 1.6);
        }

        ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha.toFixed(3)})`;
        ctx.beginPath();
        ctx.arc(fp.x, fp.y, starRad, 0, Math.PI * 2);
        ctx.fill();

        // Render close binary companion star (1.5-4px separation with contrasting Planckian color)
        if (s.isBinaryPrimary && alpha > 0.22) {
          const [cr, cg, cb] = s.companionRgb;
          ctx.fillStyle = `rgba(${cr}, ${cg}, ${cb}, ${(alpha * 0.78).toFixed(3)})`;
          ctx.beginPath();
          ctx.arc(
            fp.x + s.companionDx * fp.scale,
            fp.y + s.companionDy * fp.scale,
            starRad * 0.68,
            0,
            Math.PI * 2
          );
          ctx.fill();
        }

        if (s.isSupernova && normWave > 0.55) {
          const flareAlpha = (normWave - 0.55) * 1.4 * depthFade * rimFade;
          const haloR = starRad * 3.8;
          ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${(flareAlpha * 0.26).toFixed(3)})`;
          ctx.beginPath();
          ctx.arc(fp.x, fp.y, haloR, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      // 2. Silent Keyhole / NOSS Reconnaissance Satellite Triplet Anomaly
      const sat = this.satelliteTriad;
      if (sat.progress >= 0 && sat.progress <= sat.shadowCutoff) {
        const sxRaw = (sat.startX + (sat.endX - sat.startX) * sat.progress) * w;
        const syRaw = (sat.startY + (sat.endY - sat.startY) * sat.progress) * h;
        // Fade smoothly as the triplet enters Earth's umbral shadow cone
        const shadowFade =
          sat.progress > sat.shadowCutoff - 0.12
            ? Math.max(0, (sat.shadowCutoff - sat.progress) / 0.12)
            : Math.min(1, sat.progress / 0.08);
        const offsets = [
          [0, 0],
          [-9, -5],
          [-11, 6],
        ];
        ctx.save();
        for (const [ox, oy] of offsets) {
          const sp = projectFisheyeCRT(sxRaw + ox, syRaw + oy, w, h);
          ctx.fillStyle = `rgba(218, 235, 255, ${(0.52 * shadowFade).toFixed(3)})`;
          ctx.beginPath();
          ctx.arc(sp.x, sp.y, 1.15 * sp.scale, 0, Math.PI * 2);
          ctx.fill();
        }
        const leadP = projectFisheyeCRT(sxRaw, syRaw, w, h);
        ctx.fillStyle = `rgba(127, 212, 255, ${(0.32 * shadowFade).toFixed(3)})`;
        ctx.font = '7.5px monospace';
        ctx.fillText('NOSS-3 // UNCATALOGUED TRIAD', leadP.x + 8, leadP.y - 6);
        ctx.restore();
      }

      // 3. Shooting Stars / Bolides warped through Fisheye Dome
      this.shootingStars = this.shootingStars.filter((m) => {
        const age = this.frameCount - m.born;
        if (age > 48) return false;
        const p = age / 48;
        const mxRaw = (m.x - p * 0.24) * w;
        const myRaw = (m.y + p * 0.24) * h;
        const txRaw = mxRaw + 58 * (1 - p);
        const tyRaw = myRaw - 58 * (1 - p);
        const head = projectFisheyeCRT(mxRaw, myRaw, w, h);
        const tail = projectFisheyeCRT(txRaw, tyRaw, w, h);

        const grad = ctx.createLinearGradient(head.x, head.y, tail.x, tail.y);
        grad.addColorStop(0, `rgba(255, 248, 225, ${(1 - p).toFixed(3)})`);
        grad.addColorStop(1, 'rgba(218, 195, 142, 0)');
        ctx.strokeStyle = grad;
        ctx.lineWidth = 1.6;
        ctx.beginPath();
        ctx.moveTo(head.x, head.y);
        ctx.lineTo(tail.x, tail.y);
        ctx.stroke();
        return true;
      });

      // 4. Outgoing & Current Constellation Figures (Warped through 99th-degree Fisheye Lens)
      if (this.outgoingConstellation && smoothBlend < 1) {
        this.renderConstellationFigure(
          ctx,
          this.outgoingConstellation,
          w,
          h,
          vaultRad,
          rotOffsetX,
          rotOffsetY,
          this.outgoingDrawProgress,
          1 - smoothBlend,
          false
        );
      }

      if (this.currentConstellation) {
        this.renderConstellationFigure(
          ctx,
          this.currentConstellation,
          w,
          h,
          vaultRad,
          rotOffsetX,
          rotOffsetY,
          this.drawProgress,
          smoothBlend,
          true
        );
      }

      // 5. Bowed CRT Scanlines & Tube Curvature Pass
      this.renderCRTScanlinesAndCurvature(ctx, w, h);
    }

    private exportHighResChart() {
      if (!this.currentConstellation) return;
      const exportCanvas = document.createElement('canvas');
      exportCanvas.width = 2400;
      exportCanvas.height = 1500;
      const eCtx = exportCanvas.getContext('2d')!;

      eCtx.fillStyle = '#04060b';
      eCtx.fillRect(0, 0, 2400, 1500);

      const prevProgress = this.drawProgress;
      const prevBlend = this.transitionBlend;
      this.drawProgress = 1;
      this.transitionBlend = 1;
      this.renderFrame(performance.now(), eCtx, 2400, 1500);
      this.drawProgress = prevProgress;
      this.transitionBlend = prevBlend;

      eCtx.fillStyle = '#e8deb5';
      eCtx.font = '38px Georgia, serif';
      eCtx.fillText(
        `${this.currentConstellation.name} — ${this.currentConstellation.meaning || ''}`,
        90,
        1380
      );
      eCtx.fillStyle = '#8e96aa';
      eCtx.font = '20px monospace';
      eCtx.fillText(
        `${this.currentConstellation.id} · RA ${this.currentConstellation.ra} · DEC ${this.currentConstellation.dec} · 99TH DEG CRT FISHEYE PLATE`,
        90,
        1425
      );

      const link = document.createElement('a');
      link.download = `${this.currentConstellation.id}-${this.currentConstellation.name.toLowerCase().replace(/\s+/g, '-')}.png`;
      link.href = exportCanvas.toDataURL('image/png');
      link.click();
    }
  }

  if (!customElements.get('drc-constellation-canvas')) {
    customElements.define('drc-constellation-canvas', DrcConstellationCanvas);
  }
</script>
