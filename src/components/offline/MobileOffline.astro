---
// src/components/offline/MobileOffline.astro
// Dedicated Mobile Sovereign Observatory Offline Experience
// Features: Smooth Celestial Constellation Sky, Metallic Sheen Translucent Modal,
// 4 Corner Chrome Hearts Clover Rivets, Spinning Pixelated & Blurred Star, No Header

interface Props {
  state: {
    offlineMode: boolean;
    updatedAt: string;
    featuredConstellationId?: string | null;
  };
  profile: {
    name: string;
    title: string;
    department: string;
    institution: string;
    email: string;
  };
  isMaintenance?: boolean;
}

const { state, profile, isMaintenance = false } = Astro.props;
---

<!-- Hidden SVG Definitions for Chrome Hearts Clover Rivet & Spinning Pixelated Star -->
<svg width="0" height="0" style="position:absolute;visibility:hidden" aria-hidden="true">
  <defs>
    <!-- Chrome Hearts Antique Sterling Silver Clover Rivet Gradients -->
    <radialGradient id="mChRivetFlangeGrad" cx="35%" cy="30%" r="70%">
      <stop offset="0%" stop-color="#f1f5f9" />
      <stop offset="25%" stop-color="#cbd5e1" />
      <stop offset="65%" stop-color="#64748b" />
      <stop offset="100%" stop-color="#1e293b" />
    </radialGradient>

    <linearGradient id="mChSilverPetalGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="20%" stop-color="#f1f5f9" />
      <stop offset="55%" stop-color="#94a3b8" />
      <stop offset="85%" stop-color="#475569" />
      <stop offset="100%" stop-color="#1e293b" />
    </linearGradient>

    <radialGradient id="mChCenterBossGrad" cx="30%" cy="30%" r="65%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="35%" stop-color="#e2e8f0" />
      <stop offset="75%" stop-color="#475569" />
      <stop offset="100%" stop-color="#0f172a" />
    </radialGradient>

    <!-- Chrome Hearts Gothic Clover Cross Rivet -->
    <g id="mobile-ch-clover-rivet-def">
      <!-- Outer Beveled Sterling Silver Flange Washer -->
      <circle cx="0" cy="0" r="14.5" fill="url(#mChRivetFlangeGrad)" stroke="#1e293b" stroke-width="0.8" />
      <circle cx="0" cy="0" r="13" fill="none" stroke="rgba(255, 255, 255, 0.45)" stroke-width="0.5" />
      <circle cx="0" cy="0" r="11.5" fill="none" stroke="#0f172a" stroke-width="0.5" stroke-dasharray="1.2 1.2" />
      
      <!-- Deep Recessed Oxidized Shadow Pit -->
      <circle cx="0" cy="0" r="10" fill="#070a12" />

      <!-- Chrome Hearts 4-Lobe Gothic Clover Petals (Sterling Silver) -->
      <path d="M-2.2,-2 C-4.2,-4.8 -6.5,-7.5 -3.8,-10.2 C-1.5,-11.2 1.5,-11.2 3.8,-10.2 C6.5,-7.5 4.2,-4.8 2.2,-2 Z" fill="url(#mChSilverPetalGrad)" stroke="#cbd5e1" stroke-width="0.4" />
      <path d="M-2.2,2 C-4.2,4.8 -6.5,7.5 -3.8,10.2 C-1.5,11.2 1.5,11.2 3.8,10.2 C6.5,7.5 4.2,4.8 2.2,2 Z" fill="url(#mChSilverPetalGrad)" stroke="#cbd5e1" stroke-width="0.4" />
      <path d="M-2,-2.2 C-4.8,-4.2 -7.5,-6.5 -10.2,-3.8 C-11.2,-1.5 -11.2,1.5 -10.2,3.8 C-7.5,6.5 -4.8,4.2 -2,2.2 Z" fill="url(#mChSilverPetalGrad)" stroke="#cbd5e1" stroke-width="0.4" />
      <path d="M2,-2.2 C4.8,-4.2 7.5,-6.5 10.2,-3.8 C11.2,-1.5 11.2,1.5 10.2,3.8 C7.5,6.5 4.8,4.2 2,2.2 Z" fill="url(#mChSilverPetalGrad)" stroke="#cbd5e1" stroke-width="0.4" />

      <!-- 4 Inter-Cardinal Diamond Fleuron Accents -->
      <rect x="-5.2" y="-5.2" width="2" height="2" transform="rotate(45 -4.2 -4.2)" fill="#cbd5e1" stroke="#334155" stroke-width="0.3" />
      <rect x="3.2" y="-5.2" width="2" height="2" transform="rotate(45 4.2 -4.2)" fill="#cbd5e1" stroke="#334155" stroke-width="0.3" />
      <rect x="-5.2" y="3.2" width="2" height="2" transform="rotate(45 -4.2 4.2)" fill="#cbd5e1" stroke="#334155" stroke-width="0.3" />
      <rect x="3.2" y="3.2" width="2" height="2" transform="rotate(45 4.2 4.2)" fill="#cbd5e1" stroke="#334155" stroke-width="0.3" />

      <!-- Central Domed Screw Boss -->
      <circle cx="0" cy="0" r="3.6" fill="url(#mChCenterBossGrad)" stroke="#1e293b" stroke-width="0.5" />
      <circle cx="-0.8" cy="-0.8" r="0.8" fill="rgba(255, 255, 255, 0.9)" />
      <line x1="-1.8" y1="0" x2="1.8" y2="0" stroke="#050811" stroke-width="0.7" />
      <line x1="0" y1="-1.8" x2="0" y2="1.8" stroke="#050811" stroke-width="0.7" />
    </g>

    <!-- Mobile Spinning Pixel Star Definition - Red Hot Core & Orange Outwards -->
    <g id="mobile-spinning-pixel-star-def" shape-rendering="crispEdges">
      <!-- Center Red Hot Core (4x4 px) -->
      <rect x="-2" y="-2" width="4" height="4" fill="#dc2626" />
      <rect x="-1" y="-1" width="2" height="2" fill="#ff2222" />
      
      <!-- Primary Cardinal Rays (North, South, East, West) - Red Hot Center -> Orange Outwards -->
      <!-- North -->
      <rect x="-2" y="-5" width="4" height="3" fill="#ea580c" />
      <rect x="-1" y="-9" width="2" height="4" fill="#f97316" />
      <rect x="-1" y="-14" width="2" height="5" fill="#fb923c" />
      <rect x="-0.5" y="-18" width="1" height="4" fill="#f97316" />

      <!-- South -->
      <rect x="-2" y="2" width="4" height="3" fill="#ea580c" />
      <rect x="-1" y="5" width="2" height="4" fill="#f97316" />
      <rect x="-1" y="9" width="2" height="5" fill="#fb923c" />
      <rect x="-0.5" y="14" width="1" height="4" fill="#f97316" />

      <!-- West -->
      <rect x="-5" y="-2" width="3" height="4" fill="#ea580c" />
      <rect x="-9" y="-1" width="4" height="2" fill="#f97316" />
      <rect x="-14" y="-1" width="5" height="2" fill="#fb923c" />
      <rect x="-18" y="-0.5" width="4" height="1" fill="#f97316" />

      <!-- East -->
      <rect x="2" y="-2" width="3" height="4" fill="#ea580c" />
      <rect x="5" y="-1" width="4" height="2" fill="#f97316" />
      <rect x="9" y="-1" width="5" height="2" fill="#fb923c" />
      <rect x="14" y="-0.5" width="4" height="1" fill="#f97316" />

      <!-- 4 Diagonal Stepped Pixel Rays (NW, NE, SW, SE) -->
      <!-- NW -->
      <rect x="-5" y="-5" width="3" height="3" fill="#ea580c" />
      <rect x="-8" y="-8" width="2" height="2" fill="#f97316" />
      <rect x="-11" y="-11" width="2" height="2" fill="#fb923c" />

      <!-- NE -->
      <rect x="2" y="-5" width="3" height="3" fill="#ea580c" />
      <rect x="6" y="-8" width="2" height="2" fill="#f97316" />
      <rect x="9" y="-11" width="2" height="2" fill="#fb923c" />

      <!-- SW -->
      <rect x="-5" y="2" width="3" height="3" fill="#ea580c" />
      <rect x="-8" y="6" width="2" height="2" fill="#f97316" />
      <rect x="-11" y="9" width="2" height="2" fill="#fb923c" />

      <!-- SE -->
      <rect x="2" y="2" width="3" height="3" fill="#ea580c" />
      <rect x="6" y="6" width="2" height="2" fill="#f97316" />
      <rect x="9" y="9" width="2" height="2" fill="#fb923c" />
    </g>
  </defs>
</svg>

<div class="offline-mobile-stage" id="offline-mobile-stage">
  <!-- Clean, Smooth Celestial Constellation Sky Backdrop -->
  <div class="mobile-constellation-container" aria-hidden="true">
    <canvas id="mobile-constellation-canvas" class="mobile-constellation-canvas"></canvas>
    <div class="mobile-vignette-scrim"></div>
  </div>

  <!-- Main Viewport: Centered Translucent Metallic Modal (NO HEADER) -->
  <main class="mobile-modal-viewport">
    <div class="mobile-offline-glass-modal" role="dialog" aria-labelledby="mobile-offline-headline">
      
      <!-- Metallic Sheen & Brushed Hairline Overlays -->
      <div class="m-modal-metallic-sheen" aria-hidden="true"></div>
      <div class="m-modal-brushed-texture" aria-hidden="true"></div>

      <!-- 4 Corner Chrome Hearts Clover Rivets -->
      <div class="m-corner-rivet m-corner-tl" aria-hidden="true">
        <svg class="m-ch-clover-rivet-svg" viewBox="-16 -16 32 32">
          <use href="#mobile-ch-clover-rivet-def" />
        </svg>
      </div>
      <div class="m-corner-rivet m-corner-tr" aria-hidden="true">
        <svg class="m-ch-clover-rivet-svg" viewBox="-16 -16 32 32">
          <use href="#mobile-ch-clover-rivet-def" />
        </svg>
      </div>
      <div class="m-corner-rivet m-corner-bl" aria-hidden="true">
        <svg class="m-ch-clover-rivet-svg" viewBox="-16 -16 32 32">
          <use href="#mobile-ch-clover-rivet-def" />
        </svg>
      </div>
      <div class="m-corner-rivet m-corner-br" aria-hidden="true">
        <svg class="m-ch-clover-rivet-svg" viewBox="-16 -16 32 32">
          <use href="#mobile-ch-clover-rivet-def" />
        </svg>
      </div>

      <!-- Ported Mechanical Iris Diaphragm Shutter Graphic (Mobile Scaled) -->
      <div class="mobile-iris-diaphragm" aria-hidden="true">
        <div class="mobile-iris-outer-bezel">
          <div class="mobile-bezel-track-dials"></div>
          <div class="mobile-bezel-notches">
            <span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span>
          </div>
        </div>

        <div class="mobile-iris-orbital-ring"></div>
        <div class="mobile-iris-counter-ring"></div>

        <!-- 3D METALLIC DEATH STAR SPHERE (MOBILE SCALE / SYMMETRIC POLAR CHASM) -->
        <div class="m-dreadnought-sphere-stage" role="img" aria-label="3D Metallic Death Star Sphere with Symmetric Polar Chasm">
          <svg class="m-deathstar-sphere-svg" viewBox="-135 -135 270 270">
            <defs>
              <radialGradient id="mDsLeftShellGrad" cx="24%" cy="20%" r="78%">
                <stop offset="0%" stop-color="#ffffff" stop-opacity="0.95" />
                <stop offset="14%" stop-color="#cbd5e1" />
                <stop offset="38%" stop-color="#64748b" />
                <stop offset="68%" stop-color="#1e293b" />
                <stop offset="92%" stop-color="#0a0f1d" />
                <stop offset="100%" stop-color="#04060c" />
              </radialGradient>

              <radialGradient id="mDsRightShellGrad" cx="76%" cy="28%" r="76%">
                <stop offset="0%" stop-color="#e2e8f0" stop-opacity="0.85" />
                <stop offset="22%" stop-color="#94a3b8" />
                <stop offset="55%" stop-color="#334155" />
                <stop offset="85%" stop-color="#0f172a" />
                <stop offset="100%" stop-color="#04060c" />
              </radialGradient>

              <radialGradient id="mChasmAOGrad" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.3" />
                <stop offset="35%" stop-color="#b45309" stop-opacity="0.15" />
                <stop offset="65%" stop-color="#190a02" />
                <stop offset="85%" stop-color="#060201" />
                <stop offset="100%" stop-color="#000000" />
              </radialGradient>

              <linearGradient id="mChasmLeftAO" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#000000" stop-opacity="0.95" />
                <stop offset="40%" stop-color="#0d0501" stop-opacity="0.8" />
                <stop offset="85%" stop-color="#331404" stop-opacity="0.3" />
                <stop offset="100%" stop-color="transparent" />
              </linearGradient>

              <linearGradient id="mChasmRightAO" x1="100%" y1="0%" x2="0%" y2="0%">
                <stop offset="0%" stop-color="#000000" stop-opacity="0.95" />
                <stop offset="40%" stop-color="#0d0501" stop-opacity="0.8" />
                <stop offset="85%" stop-color="#331404" stop-opacity="0.3" />
                <stop offset="100%" stop-color="transparent" />
              </linearGradient>

              <linearGradient id="mChasmRimHighlight" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#cbd5e1" stop-opacity="0.4" />
                <stop offset="30%" stop-color="#ffd700" stop-opacity="0.85" />
                <stop offset="50%" stop-color="#ffffff" stop-opacity="1" />
                <stop offset="70%" stop-color="#ffd700" stop-opacity="0.85" />
                <stop offset="100%" stop-color="#cbd5e1" stop-opacity="0.4" />
              </linearGradient>

              <radialGradient id="mVolumetricCoreLight" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#ff3333" stop-opacity="0.95" />
                <stop offset="25%" stop-color="#ea580c" stop-opacity="0.75" />
                <stop offset="50%" stop-color="#f97316" stop-opacity="0.45" />
                <stop offset="78%" stop-color="#c2410c" stop-opacity="0.15" />
                <stop offset="100%" stop-color="transparent" />
              </radialGradient>

              <linearGradient id="mSpindleGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#94a3b8" />
                <stop offset="40%" stop-color="#ffffff" />
                <stop offset="70%" stop-color="#cbd5e1" />
                <stop offset="100%" stop-color="#334155" />
              </linearGradient>

              <!-- Gritty Micro-Noise & Metallic Stipple Pattern -->
              <pattern id="mDsMicroStipple" width="6" height="6" patternUnits="userSpaceOnUse">
                <circle cx="1.5" cy="1.5" r="0.65" fill="#ffffff" opacity="0.16" />
                <circle cx="4.5" cy="4.5" r="0.8" fill="#000000" opacity="0.32" />
                <circle cx="1.5" cy="4.5" r="0.45" fill="#94a3b8" opacity="0.14" />
                <circle cx="4.5" cy="1.5" r="0.55" fill="#020617" opacity="0.25" />
              </pattern>
            </defs>

            <!-- 1. Outer Spherical Shadow Foundation -->
            <circle cx="0" cy="0" r="120" fill="#04060c" />

            <!-- 2. Volumetric Core Light Bleed -->
            <circle cx="0" cy="0" r="120" fill="url(#mChasmAOGrad)" />
            <ellipse cx="0" cy="0" rx="48" ry="120" fill="url(#mVolumetricCoreLight)" />

            <!-- 3. Chasm Substructure Girders / Collapse Bulkheads -->
            <g stroke="#334155" stroke-width="1.4" opacity="0.65">
              <line x1="-16" y1="-95" x2="16" y2="-95" />
              <line x1="-24" y1="-80" x2="24" y2="-80" />
              <line x1="-30" y1="-60" x2="30" y2="-60" />
              <line x1="-36" y1="-40" x2="36" y2="-40" />
              <line x1="-36" y1="40" x2="36" y2="40" />
              <line x1="-30" y1="60" x2="30" y2="60" />
              <line x1="-24" y1="80" x2="24" y2="80" />
              <line x1="-16" y1="95" x2="16" y2="95" />
            </g>

            <!-- 4. Left Outer Spherical Shell (Translucent Modular Titanium Plating) -->
            <path
              d="M 0,-120 A 120 120 0 0 0 0,120 C -24,70 -38,35 -38,0 C -38,-35 -24,-70 0,-120 Z"
              fill="url(#mDsLeftShellGrad)"
              opacity="0.48"
              stroke="rgba(255, 255, 255, 0.28)"
              stroke-width="0.8"
            />

            <!-- Randomly Spread Translucent Modular Armor Tiles (Left Hemisphere) -->
            <g class="m-translucent-tiles-left" stroke="rgba(255, 255, 255, 0.15)" stroke-width="0.5">
              <path d="M -18,-85 A 120 30 0 0 1 -75,-85 L -50,-115 A 120 120 0 0 1 -15,-119 Z" fill="#94a3b8" opacity="0.22" />
              <path d="M -30,-55 A 120 45 0 0 1 -70,-55 L -65,-85 A 120 30 0 0 0 -22,-85 Z" fill="#cbd5e1" opacity="0.62" />
              <path d="M -70,-55 A 120 45 0 0 1 -107,-55 L -85,-85 A 120 30 0 0 0 -65,-85 Z" fill="#64748b" opacity="0.18" />
              <path d="M -36,-25 A 120 55 0 0 1 -80,-25 L -75,-55 A 120 45 0 0 0 -30,-55 Z" fill="#cbd5e1" opacity="0.45" />
              <path d="M -80,-25 A 120 55 0 0 1 -117,-25 L -107,-55 A 120 45 0 0 0 -75,-55 Z" fill="#94a3b8" opacity="0.72" />
              <path d="M -36,25 A 120 55 0 0 1 -80,25 L -80,5.5 L -38,5.5 Z" fill="#64748b" opacity="0.25" />
              <path d="M -80,25 A 120 55 0 0 1 -117,25 L -120,5.5 L -80,5.5 Z" fill="#cbd5e1" opacity="0.55" />
              <path d="M -30,55 A 120 45 0 0 1 -70,55 L -65,85 A 120 30 0 0 0 -22,85 Z" fill="#94a3b8" opacity="0.2" />
              <path d="M -70,55 A 120 45 0 0 1 -107,55 L -85,85 A 120 30 0 0 0 -65,85 Z" fill="#cbd5e1" opacity="0.68" />
              <path d="M -18,85 A 120 30 0 0 1 -75,85 L -50,115 A 120 120 0 0 0 -15,119 Z" fill="#64748b" opacity="0.35" />
            </g>

            <!-- Left Equatorial Superstructure Trench -->
            <path d="M -120,-5.5 L -38,-5.5 L -38,5.5 L -120,5.5 Z" fill="#060912" stroke="#1e293b" stroke-width="0.75" />
            <rect x="-114" y="-3.5" width="16" height="7" fill="#1e293b" />
            <rect x="-92" y="-3.5" width="22" height="7" fill="#293548" />
            <rect x="-64" y="-3.5" width="18" height="7" fill="#1e293b" />

            <!-- Left Latitude Panel Seams -->
            <path d="M -85,-85 A 120 30 0 0 0 -18,-85" fill="none" stroke="rgba(203, 213, 225, 0.22)" stroke-width="0.7" />
            <path d="M -107,-55 A 120 45 0 0 0 -30,-55" fill="none" stroke="rgba(203, 213, 225, 0.22)" stroke-width="0.7" />
            <path d="M -117,-25 A 120 55 0 0 0 -36,-25" fill="none" stroke="rgba(203, 213, 225, 0.22)" stroke-width="0.7" />
            <path d="M -117,25 A 120 55 0 0 0 -36,25" fill="none" stroke="rgba(203, 213, 225, 0.22)" stroke-width="0.7" />
            <path d="M -107,55 A 120 45 0 0 0 -30,55" fill="none" stroke="rgba(203, 213, 225, 0.22)" stroke-width="0.7" />
            <path d="M -85,85 A 120 30 0 0 0 -18,85" fill="none" stroke="rgba(203, 213, 225, 0.22)" stroke-width="0.7" />

            <!-- 5. Right Outer Spherical Shell (Translucent Modular Titanium Plating) -->
            <path
              d="M 0,-120 A 120 120 0 0 1 0,120 C 24,70 38,35 38,0 C 38,-35 24,-70 0,-120 Z"
              fill="url(#mDsRightShellGrad)"
              opacity="0.45"
              stroke="rgba(255, 255, 255, 0.22)"
              stroke-width="0.8"
            />

            <!-- Randomly Spread Translucent Modular Armor Tiles (Right Hemisphere) -->
            <g class="m-translucent-tiles-right" stroke="rgba(255, 255, 255, 0.15)" stroke-width="0.5">
              <path d="M 18,-85 A 120 30 0 0 0 75,-85 L 50,-115 A 120 120 0 0 0 15,-119 Z" fill="#94a3b8" opacity="0.65" />
              <path d="M 30,-55 A 120 45 0 0 0 70,-55 L 65,-85 A 120 30 0 0 1 22,-85 Z" fill="#64748b" opacity="0.2" />
              <path d="M 70,-55 A 120 45 0 0 0 107,-55 L 85,-85 A 120 30 0 0 1 65,-85 Z" fill="#cbd5e1" opacity="0.52" />
              <path d="M 36,-25 A 120 55 0 0 0 80,-25 L 75,-55 A 120 45 0 0 1 30,-55 Z" fill="#94a3b8" opacity="0.28" />
              <path d="M 80,-25 A 120 55 0 0 0 117,-25 L 107,-55 A 120 45 0 0 1 75,-55 Z" fill="#64748b" opacity="0.75" />
              <path d="M 36,25 A 120 55 0 0 0 80,25 L 80,5.5 L 38,5.5 Z" fill="#cbd5e1" opacity="0.38" />
              <path d="M 80,25 A 120 55 0 0 0 117,25 L 120,5.5 L 80,5.5 Z" fill="#94a3b8" opacity="0.15" />
              <path d="M 30,55 A 120 45 0 0 0 70,55 L 65,85 A 120 30 0 0 1 22,85 Z" fill="#64748b" opacity="0.6" />
              <path d="M 70,55 A 120 45 0 0 0 107,55 L 85,85 A 120 30 0 0 1 65,85 Z" fill="#cbd5e1" opacity="0.24" />
              <path d="M 18,85 A 120 30 0 0 0 75,85 L 50,115 A 120 120 0 0 1 15,119 Z" fill="#94a3b8" opacity="0.48" />
            </g>

            <!-- Right Equatorial Superstructure Trench -->
            <path d="M 38,-5.5 L 120,-5.5 L 120,5.5 L 38,5.5 Z" fill="#060912" stroke="#1e293b" stroke-width="0.75" />
            <rect x="46" y="-3.5" width="18" height="7" fill="#1e293b" />
            <rect x="70" y="-3.5" width="22" height="7" fill="#293548" />
            <rect x="98" y="-3.5" width="16" height="7" fill="#1e293b" />

            <!-- Right Latitude Panel Seams -->
            <path d="M 18,-85 A 120 30 0 0 0 85,-85" fill="none" stroke="rgba(203, 213, 225, 0.2)" stroke-width="0.7" />
            <path d="M 30,-55 A 120 45 0 0 0 107,-55" fill="none" stroke="rgba(203, 213, 225, 0.2)" stroke-width="0.7" />
            <path d="M 36,-25 A 120 55 0 0 0 117,-25" fill="none" stroke="rgba(203, 213, 225, 0.2)" stroke-width="0.7" />
            <path d="M 36,25 A 120 55 0 0 0 117,25" fill="none" stroke="rgba(203, 213, 225, 0.2)" stroke-width="0.7" />
            <path d="M 30,55 A 120 45 0 0 0 107,55" fill="none" stroke="rgba(203, 213, 225, 0.2)" stroke-width="0.7" />
            <path d="M 18,85 A 120 30 0 0 0 85,85" fill="none" stroke="rgba(203, 213, 225, 0.2)" stroke-width="0.7" />

            <!-- 6. Ambient Occlusion (AO) Shadows along Chasm Walls -->
            <path d="M 0,-120 C -24,-70 -38,-35 -38,0 C -38,35 -24,70 0,120 L -10,120 C -30,70 -46,35 -46,0 C -46,-35 -30,-70 -10,-120 Z" fill="url(#mChasmLeftAO)" pointer-events="none" />
            <path d="M 0,-120 C 24,-70 38,-35 38,0 C 38,35 24,70 0,120 L 10,120 C 30,70 46,35 46,0 C 46,-35 30,-70 10,-120 Z" fill="url(#mChasmRightAO)" pointer-events="none" />

            <!-- 7. Searing Scorched Rim Light along Chasm Lips -->
            <path d="M 0,-120 C -24,-70 -38,-35 -38,0 C -38,35 -24,70 0,120" fill="none" stroke="url(#mChasmRimHighlight)" stroke-width="1.4" />
            <path d="M 0,-120 C 24,-70 38,-35 38,0 C 38,35 24,70 0,120" fill="none" stroke="url(#mChasmRimHighlight)" stroke-width="1.4" />

            <!-- 8. Polar Spindle Shafts & Gimbals -->
