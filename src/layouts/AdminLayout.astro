  }

  .btn-icon-control.is-active {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 22%, var(--bg-surface));
  }

  /* Public Folio Link: Tactile Elevated Key */
  .btn-folio-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.72rem;
    border-radius: 4px;
    border: 1px solid var(--border-hairline);
    background: var(--bg-surface);
    color: var(--text-secondary);
    font-family: var(--font-serif);
    font-size: 0.82rem;
    text-decoration: none;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 1px 2px rgba(0, 0, 0, 0.12);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
  }

  .btn-folio-link:hover {
    color: var(--text-primary);
    border-color: var(--accent);
    background: var(--bg-elevated);
    transform: translateY(-1px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.15), 0 3px 8px -2px rgba(0, 0, 0, 0.22);
  }

  .btn-folio-link:active {
    transform: translateY(1px);
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.2);
  }

  .folio-arrow {
    font-size: 0.85rem;
    opacity: 0.6;
    transition: transform 0.18s ease;
  }

  .btn-folio-link:hover .folio-arrow {
    transform: translate(2px, -2px);
    opacity: 1;
  }

  /* Sign Out Button */
  .logout-form {
    margin: 0;
    display: inline-flex;
  }

  .btn-signout {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.72rem;
    border-radius: 4px;
    font-family: var(--font-serif);
    font-size: 0.82rem;
    cursor: pointer;
    background: var(--bg-surface);
    color: var(--text-secondary);
    border: 1px solid var(--border-hairline);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 1px 2px rgba(0, 0, 0, 0.12);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
  }

  .btn-signout:hover {
    background: var(--bg-elevated);
    color: #e57373;
    border-color: color-mix(in srgb, #e57373 35%, transparent);
    transform: translateY(-1px);
    box-shadow: 0 3px 8px -2px rgba(0, 0, 0, 0.25);
  }

  .btn-signout:active {
    transform: translateY(1px);
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.2);
  }

  @media (max-width: 900px) {
    .admin-header {
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    .header-brand-tag {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .header-slash, .header-brand-name {
      display: none;
    }
    .session-pill {
      display: none;
    }
  }

  /* Main Workbench Layout: Symmetrical Left & Right Gutter Centering with Full Vertical Stretch */
  .admin-workbench-layout {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: var(--admin-rail-gutter);
    align-items: stretch;
    margin-top: 1rem;
    transition: grid-template-columns 0.38s cubic-bezier(0.16, 1, 0.3, 1), gap 0.38s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* When Pinned: expands the grid column track with identical symmetrical spacing */
  :root[data-sidebar-pinned="true"] .admin-workbench-layout {
    grid-template-columns: 280px minmax(0, 1fr);
    gap: var(--admin-rail-gutter);
  }

  .admin-sidebar-track {
    width: 56px;
    min-width: 56px;
    height: 100%;
    position: relative;
    z-index: 1000;
    transition: width 0.38s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :root[data-sidebar-pinned="true"] .admin-sidebar-track {
    width: 280px;
    min-width: 280px;
    height: 100%;
  }

  /* Floating / Sticky Sidebar Container (Pinned under header at top: 4.85rem, strictly under header z-index: 2000) */
  .admin-sidebar {
    position: sticky;
    top: 4.85rem;
    width: 56px;
    height: 370px;
    padding: 0.75rem 0 0;
    border-radius: 8px;
    border: 1px solid transparent;
    background: transparent;
    box-shadow: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: width 0.38s cubic-bezier(0.16, 1, 0.3, 1),
                height 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                background 0.35s ease,
                border-color 0.25s ease,
                box-shadow 0.35s ease;
    z-index: 1000;
    box-sizing: border-box;
    overflow: hidden;
  }

  /* Hover to Peek: Solidifies and expands into elevated lapis panel */
  :root:not([data-sidebar-pinned="true"]) .admin-sidebar:hover {
    width: 280px;
    height: 370px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    box-shadow: 0 16px 44px -8px rgba(0, 0, 0, 0.7);
    overflow: hidden;
  }

  /* Pinned State: Seamless Monolithic Pillar plunging rapidly into dark midnight blue and solid pure black */
  :root[data-sidebar-pinned="true"] .admin-sidebar {
    width: 280px;
    height: calc(100vh - 6.2rem);
    min-height: calc(100vh - 6.2rem);
    background: linear-gradient(
      180deg,
      var(--bg-surface) 0%,
      var(--bg-surface) 140px,
      #091126 210px,
      #050814 290px,
      #020308 380px,
      #000000 460px,
      #000000 100%
    );
    border: 1px solid var(--border-hairline);
    border-bottom: none;
    box-shadow: 0 16px 44px -8px rgba(0, 0, 0, 0.7);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    /* Softly fade side borders and background into black void at base */
    mask-image: linear-gradient(
      to bottom,
      black 0%,
      black calc(100% - 90px),
      rgba(0, 0, 0, 0.3) calc(100% - 20px),
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      black 0%,
      black calc(100% - 90px),
      rgba(0, 0, 0, 0.3) calc(100% - 20px),
      transparent 100%
    );
  }

  /* Fine Atmospheric Stippled Noise Grain blending into the fast-darkening pillar */
  :root[data-sidebar-pinned="true"] .admin-sidebar::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.16;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 160px 160px;
    mix-blend-mode: overlay;
    pointer-events: none;
    z-index: 1;
    mask-image: linear-gradient(to bottom, transparent 150px, black 260px);
    -webkit-mask-image: linear-gradient(to bottom, transparent 150px, black 260px);
  }

  /* Secret Interaction: Graceful Parabolic Curve Vertical Collapse */
  .admin-sidebar.is-secret-collapsing {
    animation: graceful-vertical-curve-collapse 0.85s cubic-bezier(0.45, 0, 0.15, 1) forwards !important;
    pointer-events: none !important;
    transform-origin: bottom center !important;
  }

  @keyframes graceful-vertical-curve-collapse {
    0% {
      transform: translateY(0) scaleY(1) scaleX(1);
      opacity: 1;
      filter: blur(0px);
    }
    18% {
      transform: translateY(-16px) scaleY(1.03) scaleX(0.99);
      opacity: 1;
      filter: blur(0px);
    }
    45% {
      transform: translateY(32vh) scaleY(0.68) scaleX(0.96) skewY(1.2deg);
      opacity: 0.85;
      filter: blur(2px);
    }
    75% {
      transform: translateY(85vh) scaleY(0.25) scaleX(0.9) skewY(2.4deg);
      opacity: 0.4;
      filter: blur(6px);
    }
    100% {
      transform: translateY(135vh) scaleY(0.02) scaleX(0.8) skewY(3.5deg);
      opacity: 0;
      filter: blur(14px);
    }
  }

  /* Continuous Golden Trim Line (Always glowing between numbers on recession/idle) */
  .spine-golden-axis {
    position: absolute;
    top: calc(0.75rem + 36px + 6px);
    height: 252px;
    left: 28px;
    width: 1.5px;
    transform: translateX(-50%);
    background: linear-gradient(
      180deg,
      transparent 0%,
      var(--accent) 12%,
      var(--accent) 88%,
      transparent 100%
    );
    box-shadow: 0 0 4px color-mix(in srgb, var(--accent) 50%, transparent);
    pointer-events: none;
    z-index: 1;
    animation: golden-pulse 4s ease-in-out infinite;
  }

  @keyframes golden-pulse {
    0%, 100% {
      box-shadow: 0 0 3px color-mix(in srgb, var(--accent) 35%, transparent);
      opacity: 0.75;
    }
    50% {
      box-shadow: 0 0 6px color-mix(in srgb, var(--accent) 55%, transparent);
      opacity: 0.95;
    }
  }

  /* Header of Rail (Height strictly locked at 36px to prevent ducking/shifting) */
  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    min-height: 36px;
    max-height: 36px;
    width: 56px;
    position: relative;
    z-index: 2;
    box-sizing: border-box;
    border-bottom: 1px solid transparent;
    padding: 0 0.65rem;
    transition: border-color 0.2s ease;
  }

  :root[data-sidebar-pinned="true"] .sidebar-header,
  .admin-sidebar:hover .sidebar-header {
    width: 100%;
    justify-content: space-between;
    border-bottom-color: var(--border-hairline);
  }

  .sidebar-kicker {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-variant-caps: all-small-caps;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    font-weight: 600;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-4px);
    pointer-events: none;
    white-space: nowrap;
    overflow: hidden;
    transition: opacity 0.15s ease 0s, transform 0.15s ease 0s;
  }

  :root[data-sidebar-pinned="true"] .sidebar-kicker,
  .admin-sidebar:hover .sidebar-kicker {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
    transition: opacity 0.26s cubic-bezier(0.16, 1, 0.3, 1) 0.08s,
                transform 0.26s cubic-bezier(0.16, 1, 0.3, 1) 0.08s;
  }

  .sidebar-kicker .fleuron {
    font-size: 0.9rem;
    color: var(--accent);
  }

  /* Pin Toggle Button */
  .sidebar-pin-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid color-mix(in oklch, var(--accent) 35%, transparent);
    background: var(--bg-canvas);
    color: var(--accent);
    box-shadow: 0 0 8px color-mix(in oklch, var(--accent) 30%, transparent);
    cursor: pointer;
    transition: all 0.2s ease;
    flex-shrink: 0;
    margin: 0 auto;
    z-index: 3;
  }

  :root[data-sidebar-pinned="true"] .sidebar-pin-btn,
  .admin-sidebar:hover .sidebar-pin-btn {
    margin: 0;
  }

  .sidebar-pin-btn:hover {
    color: #ffffff;
    border-color: var(--accent);
    box-shadow: 0 0 12px var(--accent);
    background: color-mix(in oklch, var(--accent) 25%, var(--bg-surface));
  }

  .sidebar-pin-btn.is-pinned,
  :root[data-sidebar-pinned="true"] .sidebar-pin-btn {
    color: #ffffff;
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 10px var(--accent);
  }

  :root[data-sidebar-pinned="true"] .sidebar-pin-btn .icon-pin {
    fill: currentColor;
    stroke: var(--bg-canvas);
    transform: rotate(0deg);
  }

  :root:not([data-sidebar-pinned="true"]) .sidebar-pin-btn .icon-pin {
    transform: rotate(-35deg);
  }

  /* Nav List & Centered Nodes */
  .admin-nav {
    margin: 0;
    position: relative;
    z-index: 2;
  }

  .admin-nav-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .admin-nav-item {
    display: flex;
    width: 100%;
    height: 56px;
    min-height: 56px;
    max-height: 56px;
    position: relative;
    justify-content: flex-start;
  }

  .admin-nav-link {
    width: 100%;
    height: 56px;
    min-height: 56px;
    max-height: 56px;
    display: flex;
    align-items: center;
    padding: 0;
    margin: 0;
    border-radius: 4px;
    border: none;
    background: transparent;
    text-decoration: none;
    transition: background 0.18s ease;
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
  }

  :root[data-sidebar-pinned="true"] .admin-nav-link,
  .admin-sidebar:hover .admin-nav-link {
    border-radius: 4px;
    overflow: visible;
  }

  .admin-nav-link:hover {
    background: color-mix(in oklch, var(--accent) 8%, transparent);
  }

  .admin-nav-link.is-active {
    background: color-mix(in oklch, var(--bg-elevated) 45%, transparent);
  }

  /* Node Anchor: Exactly 56px wide, centered on x = 28px */
  .nav-node-anchor {
    width: 56px;
    min-width: 56px;
    height: 56px;
    min-height: 56px;
    max-height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 2;
    flex-shrink: 0;
  }

  /* Number Node: Circular celestial cabochon with glowing numbers */
  .nav-node {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    background: var(--bg-canvas);
    border: 1.5px solid color-mix(in oklch, var(--accent) 45%, var(--border-hairline));
    box-shadow: 0 0 8px color-mix(in oklch, var(--accent) 35%, transparent);
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-code {
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--accent);
    text-shadow: 0 0 8px var(--accent);
    line-height: 1;
    transition: color 0.18s ease, text-shadow 0.18s ease;
  }

  .admin-nav-link:hover .nav-node {
    transform: scale(1.08);
    border-color: var(--accent);
    box-shadow: 0 0 14px var(--accent);
  }

  .admin-nav-link.is-active .nav-node {
    border-color: var(--accent);
    background: var(--bg-surface);
    box-shadow: 0 0 10px color-mix(in srgb, var(--accent) 40%, transparent), inset 0 0 6px color-mix(in srgb, var(--accent) 25%, transparent);
  }

  .admin-nav-link.is-active .nav-code {
    color: var(--accent);
    text-shadow: 0 0 10px color-mix(in srgb, var(--accent) 70%, transparent);
  }

  /* Active Node Halo Ring */
  .nav-node-halo {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px dashed var(--accent);
    box-shadow: 0 0 8px var(--accent);
    animation: halo-rotate 16s linear infinite;
    pointer-events: none;
    opacity: 0.8;
  }

  @keyframes halo-rotate {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  /* Fixed-Width Text Group: Serene Calligraphic Reveal with Focal Bloom */
  .nav-text-group {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.18rem;
    width: 214px;
    min-width: 214px;
    max-width: 214px;
    padding-left: 0.4rem;
    padding-right: 0.6rem;
    opacity: 0;
    transform: translateX(-6px);
    filter: blur(2px);
    pointer-events: none;
    transition: opacity 0.15s ease 0s, transform 0.15s ease 0s, filter 0.15s ease 0s;
    box-sizing: border-box;
  }

  :root[data-sidebar-pinned="true"] .nav-text-group,
  .admin-sidebar:hover .nav-text-group {
    opacity: 1;
    transform: translateX(0);
    filter: blur(0);
    pointer-events: auto;
    transition: opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1) 0.1s,
                transform 0.28s cubic-bezier(0.16, 1, 0.3, 1) 0.1s,
                filter 0.28s cubic-bezier(0.16, 1, 0.3, 1) 0.1s;
  }

  /* Staggered serene reveal for each chapter node */
  :root[data-sidebar-pinned="true"] .admin-nav-item:nth-child(1) .nav-text-group,
  .admin-sidebar:hover .admin-nav-item:nth-child(1) .nav-text-group {
    transition-delay: 0.08s;
  }
  :root[data-sidebar-pinned="true"] .admin-nav-item:nth-child(2) .nav-text-group,
  .admin-sidebar:hover .admin-nav-item:nth-child(2) .nav-text-group {
    transition-delay: 0.12s;
  }
  :root[data-sidebar-pinned="true"] .admin-nav-item:nth-child(3) .nav-text-group,
  .admin-sidebar:hover .admin-nav-item:nth-child(3) .nav-text-group {
    transition-delay: 0.16s;
  }
  :root[data-sidebar-pinned="true"] .admin-nav-item:nth-child(4) .nav-text-group,
  .admin-sidebar:hover .admin-nav-item:nth-child(4) .nav-text-group {
    transition-delay: 0.20s;
  }

  /* Instant exit transition on unhover to prevent clip flicker */
  :root:not([data-sidebar-pinned="true"]) .admin-sidebar:not(:hover) .nav-text-group {
    opacity: 0;
    transform: translateX(-6px);
    filter: blur(2px);
    transition: opacity 0.12s ease 0s, transform 0.12s ease 0s, filter 0.12s ease 0s;
  }

  .nav-label {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--text-primary);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .admin-nav-link.is-active .nav-label {
    color: var(--accent);
    font-weight: 600;
  }

  .nav-desc {
    font-family: var(--font-serif);
    font-size: 0.73rem;
    line-height: 1.28;
    color: var(--text-secondary);
    white-space: normal;
    word-break: normal;
    overflow-wrap: break-word;
  }

  /* Marginal Colophon (Strictly locked 40px height, 0.75rem margin, zero-clip alignment) */
  .sidebar-colophon {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    height: 40px;
    min-height: 40px;
    max-height: 40px;
    width: 100%;
    margin-top: 0.75rem;
    position: relative;
    z-index: 2;
    box-sizing: border-box;
    border-top: 1px solid var(--border-hairline);
    padding: 0;
    gap: 0;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .colophon-seal {
    font-size: 1.1rem;
    color: var(--accent);
    text-shadow: 0 0 8px var(--accent);
    flex-shrink: 0;
    width: 56px;
    min-width: 56px;
    max-width: 56px;
    height: 40px;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
  }

  :root[data-sidebar-pinned="true"] .colophon-seal,
  .admin-sidebar:hover .colophon-seal {
    width: 56px;
    min-width: 56px;
    max-width: 56px;
  }

  .colophon-meta {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.1rem;
    width: 214px;
    min-width: 214px;
    max-width: 214px;
    padding-left: 0.4rem;
    padding-right: 0.6rem;
    margin: 0;
    opacity: 0;
    transform: translateX(-6px);
    filter: blur(2px);
    pointer-events: none;
    transition: opacity 0.15s ease 0s, transform 0.15s ease 0s, filter 0.15s ease 0s;
    box-sizing: border-box;
  }

  :root[data-sidebar-pinned="true"] .colophon-meta,
  .admin-sidebar:hover .colophon-meta {
    opacity: 1;
    transform: translateX(0);
    filter: blur(0);
    pointer-events: auto;
    visibility: visible;
    transition: opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1) 0.18s,
                transform 0.28s cubic-bezier(0.16, 1, 0.3, 1) 0.18s,
                filter 0.28s cubic-bezier(0.16, 1, 0.3, 1) 0.18s;
  }

  :root:not([data-sidebar-pinned="true"]) .admin-sidebar:not(:hover) .colophon-meta {
    opacity: 0;
    transform: translateX(-6px);
    filter: blur(2px);
    pointer-events: none;
    visibility: hidden;
    transition: opacity 0.12s ease 0s, transform 0.12s ease 0s, filter 0.12s ease 0s;
  }

  .colophon-title {
    font-family: var(--font-display);
    font-size: 0.76rem;
    font-weight: 500;
    color: var(--text-primary);
    letter-spacing: 0.02em;
  }

  .colophon-author {
    font-family: var(--font-serif);
    font-size: 0.7rem;
    color: var(--text-secondary);
    font-style: italic;
  }

  /* Content Stage */
  .admin-content-stage {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    min-width: 0;
  }

  /* Default state for mobile-specific widgets on desktop */
  .admin-mobile-tabbar {
    display: none;
  }
  .admin-mobile-menu {
    display: none;
  }

  /* Responsive Breakpoints */
  @media (max-width: 1024px) {
    .admin-workbench-layout {
      grid-template-columns: 1fr !important;
      gap: 1.5rem;
    }

    .admin-sidebar-track {
      display: none !important;
    }
  }

  /* ==========================================================================
     SYNTHESIZED MOBILE WEBAPP SHELL (<= 768px)
     ========================================================================== */
  @media (max-width: 768px) {
    .admin-shell {
      padding: 0 0.75rem calc(5.5rem + env(safe-area-inset-bottom, 20px)) !important;
    }

    .admin-header {
      padding: 0.6rem 0.35rem !important;
      gap: 0.5rem !important;
    }

