---
export const prerender = false;

import BaseLayout from './BaseLayout.astro';
import '../styles/admin-buttons.css';
import MediaCropModal from '../components/admin/MediaCropModal.astro';
import ContentEditorModal from '../components/admin/ContentEditorModal.astro';
import ActionConfirmModal from '../components/admin/ActionConfirmModal.astro';
import { getCsrfToken, getSessionExpiry } from '../lib/admin-auth';
import { getSystemState, getFacultyProfile } from '../lib/system-state';

interface Props {
  title?: string;
  activeModule?: 'content' | 'identity' | 'constellations' | 'system';
}

const {
  title = 'Faculty Administration · The Study',
  activeModule = 'content',
} = Astro.props;

const csrfToken = getCsrfToken(Astro.cookies);
const systemState = await getSystemState();
const profile = await getFacultyProfile();
const sessionExpiry = getSessionExpiry(Astro.cookies);
const currentPath = Astro.url.pathname;

const navItems = [
  { id: 'content', href: '/admin', code: '01', label: '01 · Content & Syllabi', shortTitle: 'Content & Syllabi', desc: 'Publications, monographs, and syllabi' },
  { id: 'identity', href: '/admin/identity', code: '02', label: '02 · Faculty Identity', shortTitle: 'Faculty Identity', desc: 'Carte de visite, credentials, and portrait' },
  { id: 'constellations', href: '/admin/constellations', code: '03', label: '03 · Celestial Atlas', shortTitle: 'Celestial Atlas', desc: 'Uranometria catalog and plates' },
  { id: 'system', href: '/admin/system', code: '04', label: '04 · System & Maintenance', shortTitle: 'System & Maintenance', desc: 'Backups, offline status, and server operations' },
];

const activeItem = navItems.find((item) => {
  return activeModule === item.id || currentPath === item.href || (item.id === 'content' && (currentPath === '/admin' || currentPath === '/admin/'));
}) || navItems[0];
---

<BaseLayout
  title={`${title} — DRC Academic Archive`}
  description="Administrative management console for Professor Duncan R. Cordry."
  isAdmin={true}
>
  <div class="admin-shell" data-csrf={csrfToken} data-expiry={sessionExpiry || ''}>
    <!-- Sovereign Minimalist Admin Header (Zero Bloat, Dynamic Active Module Anchored) -->
    <header class="admin-header">
      <div class="admin-header-lead">
        <!-- Faculty Portrait Cameo Trigger -->
        <button
          type="button"
          id="btn-header-avatar"
          class="header-avatar-btn"
          title="Open Faculty Atelier (Portrait & Credentials)"
          aria-label="Open Faculty Atelier"
        >
          <img
            src={profile.portraitUrl}
            alt={profile.name}
            class="header-avatar-img"
            onerror="this.src='/images/duncan-cordry-portrait.svg';"
          />
        </button>

        <!-- Brand Lockup + Dynamic Active Module -->
        <div class="header-nav-station">
          <div class="header-identity-lockup">
            <span class="header-brand-name">{profile.name}</span>
            <span class="header-brand-tag">The Study</span>
          </div>

          <span class="header-slash" aria-hidden="true">/</span>

          <!-- Dynamic Active Module Breadcrumb with Smooth Dropdown & Ink Transition -->
          <details class="header-module-dropdown" id="module-dropdown">
            <summary class="header-module-badge" title="Click to view all faculty modules (Jump switch)" aria-current="page">
              <span class="module-code">{activeItem.code}</span>
              <span class="module-title">{activeItem.shortTitle}</span>
              <span class="module-active-pip" aria-hidden="true">✦</span>
              <span class="module-chevron" aria-hidden="true">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </summary>

            <div class="picker-menu" role="menu" aria-label="Faculty Module Switcher">
              <div class="picker-header">
                <span class="picker-kicker">FACULTY MODULES</span>
              </div>
              <ul class="picker-list" role="none">
                {navItems.map((item) => {
                  const isActive = activeItem.id === item.id;
                  return (
                    <li role="none">
                      <a
                        href={item.href}
                        class={`picker-item ${isActive ? 'is-current' : ''}`}
                        role="menuitem"
                        data-module-id={item.id}
                        aria-current={isActive ? 'page' : undefined}
                      >
                        <span class="picker-code">{item.code}</span>
                        <div class="picker-info">
                          <span class="picker-title">{item.shortTitle}</span>
                          <span class="picker-desc">{item.desc}</span>
                        </div>
                        {isActive && <span class="picker-pip" aria-hidden="true">✦</span>}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          </details>
        </div>
      </div>

      <div class="admin-header-actions">
        <!-- Live Telemetry Status Pill -->
        <div
          class={`status-pill ${systemState.offlineMode ? 'status-pill-offline' : 'status-pill-online'}`}
          title={systemState.offlineMode ? 'Site is in Offline Maintenance Mode' : 'Site is Live to Public'}
        >
          <span class="status-dot"></span>
          <span class="status-label">{systemState.offlineMode ? 'Offline' : 'Online'}</span>
        </div>

        <!-- Session Remaining Countdown -->
        <div class="session-pill tabular" id="session-time-display" title="Session duration remaining">
          Session Active
        </div>

        <!-- Display Settings (A11y + Theme Toggles) -->
        <div class="controls-group" role="group" aria-label="Display Settings">
          <button
            type="button"
            id="btn-admin-a11y"
            class="btn-icon-control"
            aria-label="Toggle Admin High-Contrast & Legibility Mode"
            title="Toggle Admin Accessibility Mode (High Contrast & Enhanced Legibility)"
            aria-pressed="false"
          >
            <svg
              class="icon-a11y"
              aria-hidden="true"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M3.5 19L8 6l4.5 13"></path>
              <path d="M5 14.5h6"></path>
              <circle cx="17.5" cy="15" r="3.2"></circle>
              <path d="M20.7 12v7"></path>
            </svg>
          </button>

          <button
            type="button"
            id="btn-admin-theme"
            class="btn-icon-control"
            aria-label="Toggle Admin Theme (Dark / Light)"
            title="Toggle Admin Theme (Dark / Light)"
          >
            <!-- Sun icon (shown in dark mode) -->
            <svg
              class="icon-admin-sun"
              aria-hidden="true"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <circle cx="12" cy="12" r="4.5"></circle>
              <path d="M12 2v2.5M12 19.5V22M4.93 4.93l1.77 1.77M17.3 17.3l1.77 1.77M2 12h2.5M19.5 12H22M4.93 19.07l1.77-1.77M17.3 6.7l1.77-1.77"></path>
            </svg>
            <!-- Moon icon (shown in light mode) -->
            <svg
              class="icon-admin-moon"
              aria-hidden="true"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              style="display: none;"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </div>

        <!-- Public Folio Link -->
        <a href="/" target="_blank" rel="noopener noreferrer" class="study-btn study-btn--ledger study-btn--sm btn-folio-link">
          <span>Public Folio</span>
          <span class="folio-arrow" aria-hidden="true">↗</span>
        </a>

        <!-- Sign Out Form -->
        <form method="POST" action="/api/admin/auth" class="logout-form">
          <input type="hidden" name="action" value="logout" />
          <button type="submit" class="study-btn study-btn--hazard study-btn--sm btn-signout" title="Sign out of administrative session">
            <span>Sign Out</span>
          </button>
        </form>

        <!-- Mobile Utility Menu (Compact trigger for mobile screens) -->
        <details class="admin-mobile-menu" id="admin-mobile-menu">
          <summary class="mobile-menu-trigger study-btn study-btn--ghost study-btn--icon-only study-btn--sm" aria-label="Open Administrative Options Menu" title="Open Administrative Menu">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="1.5"></circle>
              <circle cx="12" cy="5" r="1.5"></circle>
              <circle cx="12" cy="19" r="1.5"></circle>
            </svg>
          </summary>
          <div class="mobile-menu-sheet">
            <div class="mobile-menu-header">
              <span class="mobile-menu-kicker">OBSERVATORY UTILITIES</span>
            </div>
            <div class="mobile-menu-body">
              <div class="mobile-menu-row">
                <span class="mobile-menu-label">Status</span>
                <div class={`status-pill ${systemState.offlineMode ? 'status-pill-offline' : 'status-pill-online'}`}>
                  <span class="status-dot"></span>
                  <span class="status-label">{systemState.offlineMode ? 'Offline' : 'Online'}</span>
                </div>
              </div>
              <div class="mobile-menu-row">
                <span class="mobile-menu-label">Session</span>
                <span class="session-pill tabular" id="mobile-session-time-display">Active</span>
              </div>
              <div class="mobile-menu-actions">
                <button
                  type="button"
                  id="btn-mobile-a11y"
                  class="study-btn study-btn--ledger study-btn--sm mobile-action-btn"
                >
                  <span class="btn-icon">👁</span>
                  <span>A11y / High Contrast</span>
                </button>
                <button
                  type="button"
                  id="btn-mobile-theme"
                  class="study-btn study-btn--ledger study-btn--sm mobile-action-btn"
                >
                  <span class="btn-icon">◐</span>
                  <span>Toggle Dark / Light Theme</span>
                </button>
                <a href="/" target="_blank" rel="noopener noreferrer" class="study-btn study-btn--ledger study-btn--sm mobile-action-btn">
                  <span>Public Folio</span>
                  <span class="folio-arrow" aria-hidden="true">↗</span>
                </a>
                <form method="POST" action="/api/admin/auth" class="logout-form mobile-action-btn-form">
                  <input type="hidden" name="action" value="logout" />
                  <button type="submit" class="study-btn study-btn--hazard study-btn--sm mobile-action-btn" title="Sign out of administrative session">
                    <span>Sign Out</span>
                  </button>
                </form>
              </div>
            </div>
          </div>
        </details>
      </div>
    </header>

    <!-- Inline Pre-Hydration Sync to prevent sidebar layout flash -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('drc-admin-sidebar-pinned') === 'true') {
            document.documentElement.setAttribute('data-sidebar-pinned', 'true');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Main Workbench Layout: Left Side Tabs + Content Stage -->
    <div class="admin-workbench-layout" id="admin-workbench">
      <!-- Grid Column Track (Provides layout spacing) -->
      <div class="admin-sidebar-track">
        <!-- Floating / Sticky Sidebar Container -->
        <aside class="admin-sidebar" id="admin-sidebar" aria-label="Faculty Navigation Rail">
          <!-- Continuous Golden Trim Line (Glows between numbers even on recession/idle) -->
          <div class="spine-golden-axis" aria-hidden="true"></div>

          <!-- Sidebar Header: Kicker + Pin Toggle Button -->
          <div class="sidebar-header">
            <div class="sidebar-kicker">
              <span class="fleuron" aria-hidden="true">❧</span>
              <span class="kicker-title">FACULTY MODULES</span>
            </div>
            <button
              type="button"
              id="btn-pin-sidebar"
              class="study-btn study-btn--instrument study-btn--icon-only study-btn--sm sidebar-pin-btn"
              aria-label="Pin navigation rail open"
              title="Pin navigation rail open (click to toggle)"
              aria-pressed="false"
            >
              <svg class="icon-pin" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="12" y1="17" x2="12" y2="22"></line>
                <path d="M5 17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.89A2 2 0 0 1 15 10.77V5a3 3 0 0 0-6 0v5.77a2 2 0 0 1-1.11 1.79l-1.78.89A2 2 0 0 0 5 15.24Z"></path>
              </svg>
            </button>
          </div>

          <nav class="admin-nav" aria-label="Observatory Control Modules">
            <ul class="admin-nav-list" role="tablist" aria-orientation="vertical">
              {navItems.map((item) => {
                const isActive = activeItem.id === item.id;
                return (
                  <li class="admin-nav-item" role="presentation">
                    <a
                      href={item.href}
                      class={`admin-nav-link ${isActive ? 'is-active' : ''}`}
                      aria-current={isActive ? 'page' : undefined}
                      data-module-id={item.id}
                      role="tab"
                      aria-selected={isActive ? 'true' : 'false'}
                      data-tooltip={item.label}
                    >
                      <div class="nav-node-anchor">
                        <div class="nav-node">
                          <span class="nav-code">{item.code}</span>
                          {isActive && <span class="nav-node-halo" aria-hidden="true"></span>}
                        </div>
                      </div>
                      <div class="nav-text-group">
                        <span class="nav-label">{item.shortTitle}</span>
                        <span class="nav-desc">{item.desc}</span>
                      </div>
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>

          <!-- Scriptoria Colophon / Seal -->
          <div class="sidebar-colophon" aria-hidden="true">
            <span class="colophon-seal">✠</span>
            <div class="colophon-meta">
              <span class="colophon-title">The Study Archive</span>
              <span class="colophon-author">Duncan R. Cordry</span>
            </div>
          </div>
        </aside>
      </div>

      <!-- Main Module Slot -->
      <main class="admin-content-stage">
        <slot />
      </main>
    </div>

    <!-- Synthesized Mobile App Bottom Tabbar (Pinned Navigation) -->
    <nav class="admin-mobile-tabbar" aria-label="Faculty Administrative Navigation" id="admin-mobile-tabbar">
      {navItems.map((item) => {
        const isActive = activeItem.id === item.id;
        return (
          <a
            href={item.href}
            class={`mobile-tab-item ${isActive ? 'is-active' : ''}`}
            aria-current={isActive ? 'page' : undefined}
            data-module-id={item.id}
            data-astro-prefetch="hover"
          >
            <div class="mobile-tab-icon-wrap">
              <span class="mobile-tab-glyph" aria-hidden="true">
                {item.id === 'content' && '❧'}
                {item.id === 'identity' && '🪪'}
                {item.id === 'constellations' && '✦'}
                {item.id === 'system' && '⚙'}
              </span>
              <span class="mobile-tab-code">{item.code}</span>
              {isActive && <span class="mobile-tab-halo" aria-hidden="true"></span>}
            </div>
            <span class="mobile-tab-label">{item.shortTitle}</span>
            {isActive && <span class="mobile-tab-pip" aria-hidden="true">✦</span>}
          </a>
        );
      })}
    </nav>

    <!-- Global Persistent Modals -->
    <MediaCropModal />
    <ContentEditorModal />
    <ActionConfirmModal />

    <!-- Native Top-Layer Toast Notification (popover="manual") -->
    <div id="admin-toast" popover="manual" class="admin-toast" role="status" aria-live="polite">
      <div class="toast-inner">
        <span class="toast-indicator" id="toast-indicator"></span>
        <span class="toast-message" id="admin-toast-text">Observatory system ready.</span>
      </div>
    </div>
  </div>

  <script>
    // Expose global CSRF token & notification dispatch across all admin sub-pages
    const shell = document.querySelector('.admin-shell') as HTMLElement | null;
    const csrf = shell?.dataset.csrf || '';
    (window as any).csrfToken = csrf;

    const toast = document.getElementById('admin-toast') as HTMLElement & {
      showPopover?: () => void;
      hidePopover?: () => void;
    };
    const toastText = document.getElementById('admin-toast-text');
    const toastIndicator = document.getElementById('toast-indicator');
    let toastTimeout: any = null;

    (window as any).notify = (message: string, status: 'info' | 'success' | 'warn' | 'error' = 'info') => {
      if (toastText) toastText.textContent = message;
      if (toastIndicator) {
        toastIndicator.className = `toast-indicator indicator-${status}`;
      }
      try {
        clearTimeout(toastTimeout);
        toast?.showPopover?.();
        toastTimeout = setTimeout(() => {
          try { toast?.hidePopover?.(); } catch {}
        }, 4500);
      } catch {
        console.log(`[Observatory Notice]: ${message}`);
      }
    };

    // Global POST helper with CSRF
    (window as any).postAdmin = async (url: string, payload: Record<string, any>) => {
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...payload, csrfToken: csrf }),
      });
      return res.json();
    };

    // Header Avatar Click Handler: Navigates to /admin/identity or launches portrait cropper
    document.getElementById('btn-header-avatar')?.addEventListener('click', () => {
      if (window.location.pathname.startsWith('/admin/identity')) {
        (window as any).openMediaCropper?.({
          aspect: 'portrait',
          targetEntity: { type: 'portrait' },
          title: 'Faculty Portrait Adjuster',
          applyLabel: 'Apply Portrait Asset ✓',
        });
      } else {
        window.location.href = '/admin/identity';
      }
    });

    // Auto-open portrait cropper if redirected with query ?cropPortrait=true
    if (new URLSearchParams(window.location.search).get('cropPortrait') === 'true') {
      setTimeout(() => {
        (window as any).openMediaCropper?.({
          aspect: 'portrait',
          targetEntity: { type: 'portrait' },
          title: 'Faculty Portrait Adjuster',
          applyLabel: 'Apply Portrait Asset ✓',
        });
      }, 150);
      const cleanUrl = new URL(window.location.href);
      cleanUrl.searchParams.delete('cropPortrait');
      window.history.replaceState({}, '', cleanUrl.toString());
    }

    // Global Reactive Sync for Media Updates
    window.addEventListener('drc:media-updated', (e: any) => {
      const detail = e.detail;
      if (detail?.imageUrl) {
        document.querySelectorAll<HTMLImageElement>('img[src*="duncan-cordry-portrait"]').forEach((img) => {
          img.src = `${detail.imageUrl}?t=${Date.now()}`;
        });
      }
    });

    // Admin Sovereign Theme & Accessibility Toggles
    const a11yBtn = document.getElementById('btn-admin-a11y') as HTMLButtonElement | null;
    const themeBtn = document.getElementById('btn-admin-theme') as HTMLButtonElement | null;
    const sunIcon = themeBtn?.querySelector('.icon-admin-sun') as HTMLElement | null;
    const moonIcon = themeBtn?.querySelector('.icon-admin-moon') as HTMLElement | null;
    const metaColorScheme = document.querySelector('meta[name="color-scheme"]') as HTMLMetaElement | null;

    function syncAdminToggles() {
      const isA11y = document.documentElement.getAttribute('data-admin-a11y-mode') === 'true';
      if (a11yBtn) {
        a11yBtn.setAttribute('aria-pressed', String(isA11y));
        a11yBtn.classList.toggle('is-active', isA11y);
      }

      const activeTheme = document.documentElement.getAttribute('data-theme') || 'dark';
      if (sunIcon && moonIcon) {
        if (activeTheme === 'dark') {
          sunIcon.style.display = 'block';
          moonIcon.style.display = 'none';
        } else {
          sunIcon.style.display = 'none';
          moonIcon.style.display = 'block';
        }
      }
    }
    syncAdminToggles();

    a11yBtn?.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-admin-a11y-mode') === 'true';
      const target = !current;
      if (target) {
        document.documentElement.setAttribute('data-admin-a11y-mode', 'true');
        try { localStorage.setItem('drc-admin-a11y-mode', 'true'); } catch {}
        (window as any).notify?.('Admin Accessibility Mode: Enhanced Contrast active', 'info');
      } else {
        document.documentElement.removeAttribute('data-admin-a11y-mode');
        try { localStorage.removeItem('drc-admin-a11y-mode'); } catch {}
        (window as any).notify?.('Admin Accessibility Mode disabled', 'info');
      }
      syncAdminToggles();
    });

    themeBtn?.addEventListener('click', () => {
      const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
      const targetTheme = currentTheme === 'dark' ? 'light' : 'dark';

      document.documentElement.setAttribute('data-theme', targetTheme);
      if (metaColorScheme) metaColorScheme.content = targetTheme;
      try { localStorage.setItem('drc-admin-theme', targetTheme); } catch {}

      (window as any).notify?.(`Admin Theme switched to ${targetTheme === 'dark' ? 'Observatory Dark' : 'Daylight Light'}`, 'info');
      syncAdminToggles();
    });

    // Sidebar Pin / Recede Toggle Handler
    const pinBtn = document.getElementById('btn-pin-sidebar') as HTMLButtonElement | null;
    function syncPinBtn() {
      const isPinned = document.documentElement.getAttribute('data-sidebar-pinned') === 'true';
      if (pinBtn) {
        pinBtn.setAttribute('aria-pressed', String(isPinned));
        pinBtn.classList.toggle('is-pinned', isPinned);
        pinBtn.title = isPinned ? 'Unpin navigation rail (recede into edge spine)' : 'Pin navigation rail open';
      }
    }
    syncPinBtn();

    pinBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const current = document.documentElement.getAttribute('data-sidebar-pinned') === 'true';
      const target = !current;
      if (target) {
        document.documentElement.setAttribute('data-sidebar-pinned', 'true');
        try { localStorage.setItem('drc-admin-sidebar-pinned', 'true'); } catch {}
        (window as any).notify?.('Navigation rail pinned open', 'info');
      } else {
        document.documentElement.removeAttribute('data-sidebar-pinned');
        try { localStorage.setItem('drc-admin-sidebar-pinned', 'false'); } catch {}
        (window as any).notify?.('Navigation rail receded into edge spine (hover to peek)', 'info');
      }
      syncPinBtn();
    });

    // Session Expiry Telemetry
    const expiryTimestamp = Number(shell?.dataset.expiry || 0);
    const sessionDisplay = document.getElementById('session-time-display');
    if (expiryTimestamp && sessionDisplay) {
      function updateSessionTimer() {
        const remainingMs = expiryTimestamp - Date.now();
        if (remainingMs <= 0) {
          if (sessionDisplay) sessionDisplay.textContent = 'Session Expired';
          (window as any).notify('Your administrative session has expired. Please re-authenticate.', 'warn');
          setTimeout(() => { window.location.href = '/admin/login'; }, 2000);
          return;
        }
        const hours = Math.floor(remainingMs / (1000 * 60 * 60));
        const minutes = Math.floor((remainingMs % (1000 * 60 * 60)) / (1000 * 60));
        if (sessionDisplay) {
          sessionDisplay.textContent = `${hours}h ${minutes}m left`;
        }
      }
      updateSessionTimer();
      setInterval(updateSessionTimer, 60000);
    }

    // Breadcrumb Module Dropdown dismiss on outside click / escape
    const moduleDropdown = document.getElementById('module-dropdown') as HTMLDetailsElement | null;
    if (moduleDropdown) {
      document.addEventListener('click', (e) => {
        if (!moduleDropdown.contains(e.target as Node)) {
          moduleDropdown.removeAttribute('open');
        }
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && moduleDropdown.hasAttribute('open')) {
          moduleDropdown.removeAttribute('open');
        }
      });
    }

    // Mobile Utilities Menu Dismiss & Bridge
    const mobileMenu = document.getElementById('admin-mobile-menu') as HTMLDetailsElement | null;
    const btnMobileA11y = document.getElementById('btn-mobile-a11y');
    const btnMobileTheme = document.getElementById('btn-mobile-theme');
    const mobileSessionDisplay = document.getElementById('mobile-session-time-display');

    if (mobileMenu) {
      document.addEventListener('click', (e) => {
        if (!mobileMenu.contains(e.target as Node)) {
          mobileMenu.removeAttribute('open');
        }
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && mobileMenu.hasAttribute('open')) {
          mobileMenu.removeAttribute('open');
        }
      });
    }

    btnMobileA11y?.addEventListener('click', () => {
      a11yBtn?.click();
    });

    btnMobileTheme?.addEventListener('click', () => {
      themeBtn?.click();
    });

    if (expiryTimestamp && mobileSessionDisplay) {
      function syncMobileTimer() {
        const remainingMs = expiryTimestamp - Date.now();
        if (remainingMs <= 0) {
          if (mobileSessionDisplay) mobileSessionDisplay.textContent = 'Expired';
          return;
        }
        const hours = Math.floor(remainingMs / (1000 * 60 * 60));
        const minutes = Math.floor((remainingMs % (1000 * 60 * 60)) / (1000 * 60));
        if (mobileSessionDisplay) {
          mobileSessionDisplay.textContent = `${hours}h ${minutes}m`;
        }
      }
      syncMobileTimer();
      setInterval(syncMobileTimer, 60000);
    }
  </script>
</BaseLayout>

