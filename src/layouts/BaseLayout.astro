---
import '../styles/tokens.css';
import '../styles/scroll-choreography.css';
import '../styles/workspace-responsive.css';
import '../styles/contact-id-card.css';
import '../styles/artefact-modals.css';
import PublicMobileNav from '../components/chrome/PublicMobileNav.astro';

interface Props {
  title?: string;
  description?: string;
  isPortfolioRoot?: boolean;
  isAdmin?: boolean;
  citationMeta?: {
    title: string;
    authors: string[];
    year: number;
    venue: string;
    doi?: string;
    pdfUrl?: string;
  };
}

const {
  title = 'Duncan R. Cordry · Continental Philosophy & Philosophy of Technology',
  description = 'Academic archive, monographs, course syllabi, and generative celestial observatory of Dr. Duncan R. Cordry, Visiting Faculty of Philosophy at Ashoka University.',
  isPortfolioRoot = false,
  isAdmin = false,
  citationMeta,
} = Astro.props;

const showMobileNav = !isAdmin && !Astro.url.pathname.startsWith('/offline') && Astro.url.pathname !== '/cv';
const mobileNavActive = Astro.url.pathname.startsWith('/publications/')
  ? 'publications'
  : Astro.url.searchParams.get('section') === 'books'
    ? 'books'
    : Astro.url.searchParams.get('section') === 'classes'
      ? 'classes'
        : undefined;
---

<!DOCTYPE html>
<html lang="en" class={isPortfolioRoot ? 'portfolio-scroller' : ''} data-admin-page={isAdmin ? 'true' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link id="site-favicon" rel="icon" href="/icons/drc-mark.svg" type="image/svg+xml" />
    {!isAdmin && <>
      <meta name="theme-color" content="#070a16" />
      <meta name="mobile-web-app-capable" content="yes" />
      <meta name="apple-mobile-web-app-capable" content="yes" />
      <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
      <link rel="manifest" href="/manifest.webmanifest" />
      <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    </>}

    <!-- MANDATORY: Declare support for both light and dark themes & prevent FOUC -->
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        const isAdmin = document.documentElement.hasAttribute('data-admin-page');

        if (isAdmin) {
          // Admin Sovereign Theme & Accessibility Isolation
          const adminStoredTheme = localStorage.getItem('drc-admin-theme');
          const adminTheme = adminStoredTheme === 'light' || adminStoredTheme === 'dark' ? adminStoredTheme : 'dark';

          document.querySelector('meta[name="color-scheme"]').content = adminTheme;
          document.documentElement.setAttribute('data-theme', adminTheme);

          if (localStorage.getItem('drc-admin-a11y-mode') === 'true') {
            document.documentElement.setAttribute('data-admin-a11y-mode', 'true');
          }
        } else {
          // Public Portfolio Controls
          const stored = localStorage.getItem('color-scheme');
          if (stored === 'light' || stored === 'dark') {
            document.querySelector('meta[name="color-scheme"]').content = stored;
            document.documentElement.setAttribute('data-theme', stored);
          } else {
            const sysDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            document.documentElement.setAttribute('data-theme', sysDark ? 'dark' : 'light');
          }

          if (localStorage.getItem('drc-a11y-mode') === 'true') {
            document.documentElement.setAttribute('data-a11y-mode', 'true');
          }
        }

        // Synchronous pre-hydration: Set intro state to prevent FOUC
        if (document.documentElement.classList.contains('portfolio-scroller')) {
          const hasVisited = localStorage.getItem('drc-has-visited') === 'true';
          const isReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

          document.documentElement.setAttribute('data-drc-visit', hasVisited ? 'subsequent' : 'first');
          if (isReduced) {
            document.documentElement.setAttribute('data-drc-state', 'snapped');
          } else {
            document.documentElement.setAttribute('data-drc-state', 'centering');
          }
        }

        // Global console helper: unconditionally available in global window scope
        window.__drcResetIntro = () => {
          try {
            localStorage.clear();
            sessionStorage.clear();
          } catch {}
          window.location.reload();
        };
      } catch {}
    </script>
    <script is:inline>
      (() => {
        const favicon = document.getElementById('site-favicon');
        const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
        const syncFavicon = (scheme) => {
          if (favicon) favicon.href = scheme === 'light' ? '/icons/drc-mark-light.svg' : '/icons/drc-mark.svg';
        };
        syncFavicon(document.documentElement.getAttribute('data-theme') || (systemTheme.matches ? 'dark' : 'light'));
        window.addEventListener('drc-theme-changed', (event) => syncFavicon(event.detail?.scheme));
        systemTheme.addEventListener('change', (event) => {
          const preferenceKey = document.documentElement.hasAttribute('data-admin-page') ? 'drc-admin-theme' : 'color-scheme';
          if (!localStorage.getItem(preferenceKey)) syncFavicon(event.matches ? 'dark' : 'light');
        });
      })();
    </script>

    <!-- Scholar typography: Newsreader & IM Fell English (Oxford Fell types) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IM+Fell+English:ital@0;1&family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&display=swap"
      rel="stylesheet"
    />

    {citationMeta && (
      <>
        <meta name="citation_title" content={citationMeta.title} />
        <meta name="citation_author" content="Cordry, Duncan R." />
        {citationMeta.authors.map((a) => (
          <meta name="citation_author" content={a} />
        ))}
        <meta name="citation_publication_date" content={String(citationMeta.year)} />
        <meta name="citation_journal_title" content={citationMeta.venue} />
        {citationMeta.doi && <meta name="citation_doi" content={citationMeta.doi} />}
        {citationMeta.pdfUrl && <meta name="citation_pdf_url" content={citationMeta.pdfUrl} />}
      </>
    )}

    <!-- Observatory Sovereign Service Worker & Network Lifecycle Engine -->
    {!isAdmin && (
      <script is:inline>
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js', { scope: '/' })
              .catch((err) => {
                console.debug('[DRC Observatory] SW registration notice:', err);
              });

            if (document.documentElement.classList.contains('portfolio-scroller') &&
                window.matchMedia('(max-width: 767px)').matches && navigator.onLine) {
              navigator.serviceWorker.ready.then(() => {
                fetch('/api/public/v1/bootstrap', { headers: { Accept: 'application/json' } }).catch(() => undefined);
              }).catch(() => undefined);
            }
          });
        }

        window.addEventListener('drc-theme-changed', (event) => {
          const scheme = event.detail?.scheme;
          const themeColor = document.querySelector('meta[name="theme-color"]');
          if (themeColor) themeColor.setAttribute('content', scheme === 'light' ? '#f4efe6' : '#070a16');
        });

        // Auto-reconnect when physical network is restored while on offline screen
        window.addEventListener('online', () => {
          if (window.location.pathname.startsWith('/offline')) {
            window.location.href = '/';
          }
        });
      </script>
    )}
  </head>
  <body data-stage="stage-1" data-mobile-view={isPortfolioRoot ? 'sky' : undefined} data-portfolio-root={isPortfolioRoot ? 'true' : undefined}>
    <slot />
    {showMobileNav && <PublicMobileNav active={mobileNavActive as any} />}
    {showMobileNav && <div id="pwa-network-status" role="status" aria-live="polite" hidden>Offline · showing saved pages where available</div>}
    {showMobileNav && <script is:inline>
      const statusBanner = document.getElementById('pwa-network-status');
      const updateNetworkStatus = () => {
        if (!statusBanner) return;
        statusBanner.hidden = navigator.onLine;
      };
      window.addEventListener('online', updateNetworkStatus);
      window.addEventListener('offline', updateNetworkStatus);
      updateNetworkStatus();
    </script>}
    <style is:global>
      #pwa-network-status {
        position: fixed;
        z-index: 1100;
        inset-block-start: calc(env(safe-area-inset-top, 0px) + 0.45rem);
        inset-inline: 50% auto;
        transform: translateX(-50%);
        padding: 0.45rem 0.75rem;
        border: 1px solid var(--border-subtle);
        border-radius: 999px;
        background: var(--bg-surface);
        color: var(--text-primary);
        font: 600 0.68rem/1.2 var(--font-mono);
        box-shadow: 0 4px 18px rgb(0 0 0 / 0.24);
        white-space: nowrap;
      }
      #pwa-network-status[hidden] { display: none; }
    </style>
  </body>
</html>
